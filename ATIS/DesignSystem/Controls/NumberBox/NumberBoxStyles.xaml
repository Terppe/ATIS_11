
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <Style x:Key="AtisNumberBox" TargetType="NumberBox">

        <!--  Enabled + Disabled (WinUI übernimmt diese Werte in beiden States)  -->
        <Setter Property="Background" Value="{ThemeResource AtisNumberBoxBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AtisNumberBoxBorderBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource AtisNumberBoxForegroundBrush}" />
        <!--  Typografie  -->
        <Setter Property="FontSize" Value="14" />

        <!--  Layout  -->
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Margin" Value="0,4" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />

        <!--  Hintergrund + Border wie TextBox  -->

        <!--  Verhalten  -->
        <Setter Property="SpinButtonPlacementMode" Value="Inline" />
        <Setter Property="SmallChange" Value="1" />
        <Setter Property="LargeChange" Value="5" />

        <!--  Header  -->
        <Setter Property="HeaderTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Style="{StaticResource AtisInputHeaderTextStyle}" Text="{Binding}" />
                </DataTemplate>
            </Setter.Value>
        </Setter>

    </Style>

    <!--  Header Style  -->
    <Style x:Key="AtisInputHeaderTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource AtisFontSizeM}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

