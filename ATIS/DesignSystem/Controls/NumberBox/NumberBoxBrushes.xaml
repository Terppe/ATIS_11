<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <!--  =========================================================  -->
    <!--  THEME BRUSHES (Light / Dark)  -->
    <!--  =========================================================  -->
    <ResourceDictionary.ThemeDictionaries>
        <!--  LIGHT THEME  -->
        <ResourceDictionary x:Key="Light">
            <!--  Enabled  -->
            <SolidColorBrush x:Key="AtisNumberBoxBackgroundBrush"
                             Color="#F5F5F5" />
            <SolidColorBrush x:Key="AtisNumberBoxBorderBrush"
                             Color="#C8C8C8" />
            <SolidColorBrush x:Key="AtisNumberBoxForegroundBrush"
                             Color="#000000" />
            <!--  Disabled  -->
            <SolidColorBrush x:Key="AtisNumberBoxDisabledBackgroundBrush"
                             Color="#E5E5E5" />
            <SolidColorBrush x:Key="AtisNumberBoxDisabledBorderBrush"
                             Color="#D0D0D0" />
            <SolidColorBrush x:Key="AtisNumberBoxDisabledForegroundBrush"
                             Color="#8A8A8A" />
            <!--  WinUI-intern benötigte Keys  -->
            <SolidColorBrush x:Key="NumberBoxBackground"
                             Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="NumberBoxForeground"
                             Color="#333333" />
            <SolidColorBrush x:Key="NumberBoxBorderBrush"
                             Color="#CCCCCC" />
            <!--  Deine Atis-Brushes  -->
            <!--

            <SolidColorBrush x:Key="AtisNumberBoxBackgroundBrush" Color="#F5F5F5" />
            -->
            <!--  oder deine AlternateRow-Farbe  -->
            <!--
            <SolidColorBrush x:Key="AtisNumberBoxForegroundBrush" Color="#000000" />
            <SolidColorBrush x:Key="AtisNumberBoxBorderBrush" Color="#C8C8C8" />
            <SolidColorBrush x:Key="AtisNumberBoxHoverBorderBrush" Color="#9A9A9A" />-->
        </ResourceDictionary>
        <!--  DARK THEME  -->
        <ResourceDictionary x:Key="Dark">
            <!--  Enabled  -->
            <SolidColorBrush x:Key="AtisNumberBoxBackgroundBrush"
                             Color="#2A2A2A" />
            <SolidColorBrush x:Key="AtisNumberBoxBorderBrush"
                             Color="#3A3A3A" />
            <SolidColorBrush x:Key="AtisNumberBoxForegroundBrush"
                             Color="#FFFFFF" />
            <!--  Disabled  -->
            <SolidColorBrush x:Key="AtisNumberBoxDisabledBackgroundBrush"
                             Color="#1F1F1F" />
            <SolidColorBrush x:Key="AtisNumberBoxDisabledBorderBrush"
                             Color="#2A2A2A" />
            <SolidColorBrush x:Key="AtisNumberBoxDisabledForegroundBrush"
                             Color="#6A6A6A" />
            <!--  WinUI-intern benötigte Keys  -->
            <SolidColorBrush x:Key="NumberBoxBackground"
                             Color="#2A2A2A" />
            <SolidColorBrush x:Key="NumberBoxForeground"
                             Color="#E6E6E6" />
            <SolidColorBrush x:Key="NumberBoxBorderBrush"
                             Color="#3A3A3A" />

            <!--  Deine Atis-Brushes  -->
            <!--

            <SolidColorBrush x:Key="AtisNumberBoxBackgroundBrush" Color="#2A2A2A" />
            <SolidColorBrush x:Key="AtisNumberBoxForegroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AtisNumberBoxBorderBrush" Color="#3A3A3A" />
            <SolidColorBrush x:Key="AtisNumberBoxHoverBorderBrush" Color="#5A5A5A" />-->
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>



