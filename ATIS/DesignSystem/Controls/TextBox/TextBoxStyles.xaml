<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="AtisTextBox"
           TargetType="TextBox">
        <Setter Property="Background" Value="{ThemeResource AtisTextBoxBackgroundBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource AtisTextBoxForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AtisTextBoxBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="FontSize" Value="14" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">

                    <!--  EIN Root-Grid  -->
                    <Grid RowDefinitions="Auto,*">

                        <!--  HEADER  -->
                        <ContentPresenter x:Name="HeaderPresenter"
                                          Grid.Row="0"
                                          Margin="0,0,0,4"
                                          Content="{TemplateBinding Header}"
                                          ContentTemplate="{TemplateBinding HeaderTemplate}"
                                          FontSize="12"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          Visibility="{Binding Header, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource NullToCollapsedConverter}}" />

                        <!--  BORDER + CONTENT  -->
                        <Border x:Name="BorderElement"
                                Grid.Row="1"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}">

                            <ScrollViewer x:Name="ContentElement"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalScrollBarVisibility="Hidden"
                                          IsTabStop="False"
                                          VerticalScrollBarVisibility="Hidden" />
                        </Border>

                    </Grid>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

