<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:textBox="using:ATIS.DesignSystem.Controls.TextBox">

    <Style x:Key="DefaultTextBoxStyle"
           TargetType="TextBox" />


    <Style x:Key="AtisTextBox"
           TargetType="TextBox">
        <Setter Property="Background" Value="{ThemeResource AtisTextBoxBackgroundBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource AtisTextBoxForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AtisTextBoxBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="FontSize" Value="14" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">

                    <!--  ⭐ VisualStates müssen HIER stehen  -->
                    <VisualStateManager.VisualStateGroups>

                        <VisualStateGroup x:Name="ValidationStates">

                            <VisualState x:Name="Valid" />

                            <VisualState x:Name="Invalid">
                                <VisualState.Setters>
                                    <Setter Target="BorderElement.BorderBrush" Value="Red" />
                                </VisualState.Setters>
                            </VisualState>

                        </VisualStateGroup>

                    </VisualStateManager.VisualStateGroups>

                    <!--  EIN Root-Grid  -->
                    <Grid RowDefinitions="Auto,*">

                        <!--  HEADER  -->
                        <ContentPresenter x:Name="HeaderPresenter"
                                          Grid.Row="0"
                                          Margin="0,0,0,4"
                                          Content="{TemplateBinding Header}"
                                          ContentTemplate="{TemplateBinding HeaderTemplate}"
                                          FontSize="12"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          Visibility="{Binding Header, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource NullToCollapsedConverter}}" />

                        <!--  BORDER + CONTENT  -->
                        <Border x:Name="BorderElement"
                                Grid.Row="1"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}">

                            <ScrollViewer x:Name="ContentElement"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalScrollBarVisibility="Hidden"
                                          IsTabStop="False"
                                          VerticalScrollBarVisibility="Hidden" />
                        </Border>

                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Kleine Felder (varchar 4 → exakt 4 Zeichen breit)  -->
    <Style x:Key="AtisTextBoxYear"
           BasedOn="{StaticResource AtisTextBox}"
           TargetType="TextBox">
        <Setter Property="MinWidth" Value="50" />
        <Setter Property="MaxWidth" Value="80" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!--  Kleine Felder (varchar 4 → exakt 4 Zeichen breit)  -->
    <Style x:Key="AtisTextBoxSmall"
           BasedOn="{StaticResource AtisTextBox}"
           TargetType="TextBox">
        <Setter Property="MinWidth" Value="60" />
        <Setter Property="MaxWidth" Value="80" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!--  Mittlere Felder (varchar 100 → dynamisch bis Pagebreite)  -->
    <Style x:Key="AtisTextBoxMedium"
           BasedOn="{StaticResource AtisTextBox}"
           TargetType="TextBox">
        <Setter Property="MinWidth" Value="200" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!--  Große Felder (varchar 300 → groß, dynamisch)  -->
    <Style x:Key="AtisTextBoxLarge"
           BasedOn="{StaticResource AtisTextBox}"
           TargetType="TextBox">
        <Setter Property="MinWidth" Value="600" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style x:Key="AtisFormFieldLarge"
           TargetType="textBox:LabeledTextBoxWithError">
        <Setter Property="MinWidth" Value="600" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style x:Key="AtisFormFieldMedium"
           TargetType="textBox:LabeledTextBoxWithError">
        <Setter Property="MinWidth" Value="200" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style x:Key="AtisFormFieldYear"
           TargetType="textBox:LabeledTextBoxWithError">
        <Setter Property="MinWidth" Value="4" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Width" Value="70" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style TargetType="textBox:LabeledTextBoxWithError">
        <Setter Property="Background" Value="White" />
        <!--<Setter Property="Background" Value="{ThemeResource AtisTextBoxBackgroundBrush}" />-->
        <Setter Property="Foreground" Value="{ThemeResource AtisTextBoxForegroundBrush}" />
        <Setter Property="BorderBrush" Value="Black" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="MinWidth" Value="600" />
    </Style>


    <Style x:Key="AtisLabeledTextBox"
           TargetType="textBox:LabeledTextBoxWithError">

        <!--  dieselben Properties wie AtisTextBox  -->
        <Setter Property="Background" Value="{ThemeResource AtisTextBoxBackgroundBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource AtisTextBoxForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AtisTextBoxBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="FontSize" Value="14" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="textBox:LabeledTextBoxWithError">

                    <Grid RowDefinitions="Auto,Auto,Auto">

                        <!--  HEADER  -->
                        <TextBlock x:Name="HeaderElement"
                                   Grid.Row="0"
                                   Margin="0,0,0,4"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="{TemplateBinding Header}" />

                        <!--  BORDER + TEXTBOX  -->
                        <Border x:Name="BorderElement"
                                Grid.Row="1"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}">

                            <TextBox x:Name="InputElement"
                                     Padding="{TemplateBinding Padding}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontFamily="{TemplateBinding FontFamily}"
                                     FontSize="{TemplateBinding FontSize}"
                                     Foreground="{TemplateBinding Foreground}"
                                     IsReadOnly="{TemplateBinding IsReadOnly}"
                                     Text="{TemplateBinding Text}"
                                     UseSystemFocusVisuals="False" />
                        </Border>

                        <!--  ERROR  -->
                        <TextBlock x:Name="ErrorElement"
                                   Grid.Row="2"
                                   Margin="0,4,0,0"
                                   Foreground="Red"
                                   Text="{TemplateBinding ErrorText}"
                                   Visibility="Collapsed" />

                    </Grid>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

