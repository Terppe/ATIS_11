<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>

        <!--  =========================================================  -->
        <!--  LIGHT MODE  -->
        <!--  =========================================================  -->
        <ResourceDictionary x:Key="Light">



            <!--  CHECKBOX  -->
            <SolidColorBrush x:Key="AtisCheckBoxBackgroundBrush"
                             Color="#FFFFFF" />
            <SolidColorBrush x:Key="AtisCheckBoxBorderBrush"
                             Color="#D1D5DB" />
            <SolidColorBrush x:Key="AtisCheckBoxHoverBorderBrush"
                             Color="#9CA3AF" />
            <SolidColorBrush x:Key="AtisCheckBoxCheckBrush"
                             Color="#2563EB" />
            <SolidColorBrush x:Key="AtisCheckBoxDisabledBackgroundBrush"
                             Color="#F3F4F6" />
            <SolidColorBrush x:Key="AtisCheckBoxDisabledBorderBrush"
                             Color="#E5E7EB" />
            <SolidColorBrush x:Key="AtisCheckBoxDisabledCheckBrush"
                             Color="#9CA3AF" />


        </ResourceDictionary>

        <!--  =========================================================  -->
        <!--  DARK MODE  -->
        <!--  =========================================================  -->
        <ResourceDictionary x:Key="Dark">


            <!--  CHECKBOX  -->
            <SolidColorBrush x:Key="AtisCheckBoxBackgroundBrush"
                             Color="#1F2937" />
            <SolidColorBrush x:Key="AtisCheckBoxBorderBrush"
                             Color="#4B5563" />
            <SolidColorBrush x:Key="AtisCheckBoxHoverBorderBrush"
                             Color="#6B7280" />
            <SolidColorBrush x:Key="AtisCheckBoxCheckBrush"
                             Color="#3B82F6" />
            <SolidColorBrush x:Key="AtisCheckBoxDisabledBackgroundBrush"
                             Color="#111827" />
            <SolidColorBrush x:Key="AtisCheckBoxDisabledBorderBrush"
                             Color="#374151" />
            <SolidColorBrush x:Key="AtisCheckBoxDisabledCheckBrush"
                             Color="#6B7280" />

        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>



