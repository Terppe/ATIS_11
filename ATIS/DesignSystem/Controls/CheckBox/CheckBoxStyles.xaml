<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="AtisCheckBox"
           TargetType="CheckBox">
        <Setter Property="Foreground" Value="{ThemeResource AtisTextForegroundBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="HorizontalAlignment" Value="Left" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">

                    <Grid x:Name="RootGrid"
                          ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!--  VISUAL STATES  -->
                        <VisualStateManager.VisualStateGroups>

                            <!--  COMMON STATES  -->
                            <VisualStateGroup x:Name="CommonStates">

                                <VisualState x:Name="Normal" />

                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Box.BorderBrush" Value="{ThemeResource AtisCheckBoxHoverBorderBrush}" />
                                    </VisualState.Setters>
                                </VisualState>

                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Box.BorderBrush" Value="{ThemeResource AtisPrimaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>

                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Box.Background" Value="{ThemeResource AtisCheckBoxDisabledBackgroundBrush}" />
                                        <Setter Target="Box.BorderBrush" Value="{ThemeResource AtisCheckBoxDisabledBorderBrush}" />
                                        <Setter Target="CheckIcon.Foreground" Value="{ThemeResource AtisCheckBoxDisabledCheckBrush}" />
                                        <Setter Target="CheckIcon.Opacity" Value="0.3" />
                                        <Setter Target="RootGrid.Opacity" Value="0.6" />
                                    </VisualState.Setters>
                                </VisualState>

                            </VisualStateGroup>

                            <!--  CHECK STATES  -->
                            <VisualStateGroup x:Name="CheckStates">

                                <VisualState x:Name="Unchecked">
                                    <VisualState.Setters>
                                        <Setter Target="CheckIcon.Opacity" Value="0" />
                                        <Setter Target="Box.Background" Value="{ThemeResource AtisCheckBoxBackgroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>

                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="CheckIcon.Opacity" Value="1" />
                                        <Setter Target="Box.Background" Value="{ThemeResource AtisPrimaryBrush}" />
                                        <Setter Target="Box.BorderBrush" Value="{ThemeResource AtisPrimaryBrush}" />
                                        <Setter Target="CheckIcon.Foreground" Value="{ThemeResource AtisPrimaryForegroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>

                                <VisualState x:Name="Indeterminate">
                                    <VisualState.Setters>
                                        <Setter Target="CheckIcon.Glyph" Value="&#xE73C;" />
                                        <Setter Target="CheckIcon.Opacity" Value="1" />
                                        <Setter Target="Box.Background" Value="{ThemeResource AtisPrimaryBrush}" />
                                        <Setter Target="CheckIcon.Foreground" Value="{ThemeResource AtisPrimaryForegroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>

                            </VisualStateGroup>

                        </VisualStateManager.VisualStateGroups>

                        <!--  BOX  -->
                        <Border x:Name="Box"
                                Width="20"
                                Height="20"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{ThemeResource AtisCheckBoxBackgroundBrush}"
                                BorderBrush="{ThemeResource AtisCheckBoxBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4" />

                        <!--  CHECK ICON  -->
                        <FontIcon x:Name="CheckIcon"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  FontSize="14"
                                  Foreground="{ThemeResource AtisCheckBoxCheckBrush}"
                                  Glyph="&#xE73E;"
                                  Opacity="0" />

                        <!--  LABEL  -->
                        <ContentPresenter Grid.Column="1"
                                          VerticalAlignment="Center"
                                          Foreground="{TemplateBinding Foreground}" />

                    </Grid>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>



