<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <Style x:Key="AtisCheckBox"
           TargetType="CheckBox">
        <Setter Property="Margin" Value="8,18,8,0" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!--  Box  -->
                        <Border Width="20"
                                Height="20"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{ThemeResource AtisTextBoxBackgroundBrush}"
                                BorderBrush="{ThemeResource AtisTextBoxBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4" />

                        <!--  Haken  -->
                        <FontIcon HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  FontSize="14"
                                  Foreground="{ThemeResource AtisTextBoxForegroundBrush}"
                                  Glyph="&#xE73E;">
                            <FontIcon.Opacity>
                                <Binding Converter="{StaticResource BoolToOpacityConverter}"
                                         Path="IsChecked"
                                         RelativeSource="{RelativeSource TemplatedParent}" />
                            </FontIcon.Opacity>
                        </FontIcon>

                        <!--  Label  -->
                        <ContentPresenter Grid.Column="1"
                                          VerticalAlignment="Center"
                                          Foreground="{ThemeResource AtisTextBoxForegroundBrush}" />
                    </Grid>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>



