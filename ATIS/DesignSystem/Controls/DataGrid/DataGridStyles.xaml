    <DataTemplate x:Key="AtisDataGridSortIndicatorTemplate">
    <Grid>
    <FontIcon
    x:Name="SortIcon"
    FontSize="12"
    Foreground="{ThemeResource DataGridHeaderForegroundBrush}"
    Glyph="&#xE74A;"
    Visibility="Collapsed" />

    <VisualStateManager.VisualStateGroups>
    <VisualStateGroup x:Name="SortStates">

    --><!--  Not sorted  --><!--
    <VisualState x:Name="Unsorted">
    <VisualState.Setters>
    <Setter Target="SortIcon.Visibility" Value="Collapsed" />
    </VisualState.Setters>
    </VisualState>

    --><!--  Ascending  --><!--
    <VisualState x:Name="Ascending">
    <VisualState.Setters>
    <Setter Target="SortIcon.Visibility" Value="Visible" />
    <Setter Target="SortIcon.Glyph" Value="&#xE74A;" />
