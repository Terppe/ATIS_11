<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  =========================================================  -->
    <!--  1) THEME COLORS (Light + Dark)  -->
    <!--  =========================================================  -->

    <ResourceDictionary.ThemeDictionaries>

        <!--  LIGHT THEME  -->
        <ResourceDictionary x:Key="Light">

            <!--  Header  -->
            <SolidColorBrush x:Key="DataGridHeaderBackgroundBrush" Color="#F3F3F3" />
            <SolidColorBrush x:Key="DataGridHeaderForegroundBrush" Color="#333333" />
            <SolidColorBrush x:Key="DataGridHeaderBorderBrush" Color="#DDDDDD" />

            <!--  Rows  -->
            <SolidColorBrush x:Key="DataGridRowBackgroundBrush" Color="#FFFFFF" />

            <SolidColorBrush x:Key="DataGridRowForegroundBrush" Color="#333333" />
            <SolidColorBrush x:Key="DataGridAlternatingRowBackgroundBrush" Color="#FAFAFA" />

            <!--  Hover  -->
            <SolidColorBrush x:Key="DataGridRowHoverBrush" Color="#11000000" />

            <!--  Selection  -->
            <SolidColorBrush x:Key="DataGridRowSelectionBackgroundBrush" Color="#007ACC" />
            <SolidColorBrush x:Key="DataGridRowSelectionForegroundBrush" Color="#FFFFFF" />

            <!--  GridLines  -->
            <SolidColorBrush x:Key="DataGridGridLinesBrush" Color="#E0E0E0" />
            <SolidColorBrush x:Key="AtisNeutralBorderBrush" Color="#DDDDDD" />


            <!--  CellBorder  -->
            <SolidColorBrush x:Key="DataGridCellBorderBrush" Color="#33000000" />
            <!--  Alternate  -->
            <SolidColorBrush x:Key="AtisGridRowBackground" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="AtisGridRowAlternateBackground" Color="#FFF5F5F5" />


        </ResourceDictionary>

        <!--  DARK THEME  -->
        <ResourceDictionary x:Key="Dark">

            <!--  Header  -->
            <SolidColorBrush x:Key="DataGridHeaderBackgroundBrush" Color="#3A3A3A" />
            <SolidColorBrush x:Key="DataGridHeaderForegroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="DataGridHeaderBorderBrush" Color="#4A4A4A" />

            <!--  Rows  -->
            <SolidColorBrush x:Key="DataGridRowBackgroundBrush" Color="#1E1E1E" />
            <SolidColorBrush x:Key="DataGridRowForegroundBrush" Color="#E6E6E6" />
            <SolidColorBrush x:Key="DataGridAlternatingRowBackgroundBrush" Color="#262626" />

            <!--  Hover  -->
            <SolidColorBrush x:Key="DataGridRowHoverBrush" Color="#22FFFFFF" />

            <!--  Selection  -->
            <SolidColorBrush x:Key="DataGridRowSelectionBackgroundBrush" Color="#3399FF" />
            <SolidColorBrush x:Key="DataGridRowSelectionForegroundBrush" Color="#FFFFFF" />

            <!--  GridLines  -->
            <SolidColorBrush x:Key="DataGridGridLinesBrush" Color="#3A3A3A" />
            <SolidColorBrush x:Key="AtisNeutralBorderBrush" Color="#3A3A3A" />


            <!--  CellBorder  -->
            <SolidColorBrush x:Key="DataGridCellBorderBrush" Color="#33FFFFFF" />

            <!--  alternate  -->
            <SolidColorBrush x:Key="AtisGridRowBackground" Color="#FF1E1E1E" />
            <SolidColorBrush x:Key="AtisGridRowAlternateBackground" Color="#FF2A2A2A" />
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
