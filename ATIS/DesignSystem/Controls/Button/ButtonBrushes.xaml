<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>

        <!--  =========================================================  -->
        <!--  LIGHT MODE  -->
        <!--  =========================================================  -->
        <ResourceDictionary x:Key="Light">

            <!--  PRIMARY BUTTON  -->
            <SolidColorBrush x:Key="AtisPrimaryBrush"
                             Color="#0078D4" />
            <SolidColorBrush x:Key="AtisPrimaryForegroundBrush"
                             Color="#FFFFFF" />
            <SolidColorBrush x:Key="AtisPrimaryHoverBrush"
                             Color="#1D4ED8" />
            <SolidColorBrush x:Key="AtisPrimaryPressedBrush"
                             Color="#1E40AF" />
            <SolidColorBrush x:Key="AtisPrimaryDisabledBrush"
                             Color="#A5B4FC" />
            <SolidColorBrush x:Key="AtisPrimaryDisabledForegroundBrush"
                             Color="#E5E7EB" />

            <!--  SECONDARY BUTTON  -->
            <SolidColorBrush x:Key="AtisSecondaryBackgroundBrush"
                             Color="#F0F0F0" />
            <SolidColorBrush x:Key="AtisSecondaryHoverBrush"
                             Color="#E5E5E5" />
            <SolidColorBrush x:Key="AtisSecondaryPressedBrush"
                             Color="#DADADA" />
            <SolidColorBrush x:Key="AtisSecondaryDisabledBrush"
                             Color="#C8C8C8" />
            <SolidColorBrush x:Key="AtisSecondaryBorderBrush"
                             Color="#CCCCCC" />

            <SolidColorBrush x:Key="AtisSecondaryForegroundBrush"
                             Color="#333333" />
            <SolidColorBrush x:Key="AtisSecondaryDisabledForegroundBrush"
                             Color="#9CA3AF" />

            <!--  SUBTLE BUTTON  -->
            <SolidColorBrush x:Key="AtisSubtleForegroundBrush"
                             Color="#374151" />
            <SolidColorBrush x:Key="AtisSubtleHoverBrush"
                             Color="#F3F4F6" />
            <SolidColorBrush x:Key="AtisSubtlePressedBrush"
                             Color="#E5E7EB" />
            <SolidColorBrush x:Key="AtisSubtleDisabledForegroundBrush"
                             Color="#9CA3AF" />
            <SolidColorBrush x:Key="AtisNeutralForegroundBrush"
                             Color="#333333" />

        </ResourceDictionary>

        <!--  =========================================================  -->
        <!--  DARK MODE  -->
        <!--  =========================================================  -->
        <ResourceDictionary x:Key="Dark">

            <!--  PRIMARY BUTTON  -->
            <SolidColorBrush x:Key="AtisPrimaryBrush"
                             Color="#3399FF" />
            <SolidColorBrush x:Key="AtisPrimaryForegroundBrush"
                             Color="#FFFFFF" />
            <SolidColorBrush x:Key="AtisPrimaryHoverBrush"
                             Color="#2563EB" />
            <SolidColorBrush x:Key="AtisPrimaryPressedBrush"
                             Color="#1D4ED8" />
            <SolidColorBrush x:Key="AtisPrimaryDisabledBrush"
                             Color="#1E3A8A" />
            <SolidColorBrush x:Key="AtisPrimaryDisabledForegroundBrush"
                             Color="#6B7280" />

            <!--  SECONDARY BUTTON  -->
            <SolidColorBrush x:Key="AtisSecondaryBackgroundBrush"
                             Color="#2A2A2A" />
            <SolidColorBrush x:Key="AtisSecondaryForegroundBrush"
                             Color="#E6E6E6" />
            <SolidColorBrush x:Key="AtisSecondaryBorderBrush"
                             Color="#3A3A3A" />
            <SolidColorBrush x:Key="AtisSecondaryHoverBrush"
                             Color="#4B5563" />
            <SolidColorBrush x:Key="AtisSecondaryPressedBrush"
                             Color="#6B7280" />
            <SolidColorBrush x:Key="AtisSecondaryDisabledBrush"
                             Color="#1F2937" />
            <SolidColorBrush x:Key="AtisSecondaryDisabledForegroundBrush"
                             Color="#6B7280" />

            <!--  SUBTLE BUTTON  -->
            <SolidColorBrush x:Key="AtisSubtleForegroundBrush"
                             Color="#D1D5DB" />
            <SolidColorBrush x:Key="AtisSubtleHoverBrush"
                             Color="#4B5563" />
            <SolidColorBrush x:Key="AtisSubtlePressedBrush"
                             Color="#374151" />
            <SolidColorBrush x:Key="AtisSubtleDisabledForegroundBrush"
                             Color="#6B7280" />



            <SolidColorBrush x:Key="AtisNeutralForegroundBrush"
                             Color="#E6E6E6" />
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
