    <!--  =========================================================  -->
    <!--  Primary ToggleAppBarButton  -->
    <!--  =========================================================  -->

    <Style x:Key="AtisToggleAppBarButtonPrimary"
           TargetType="ToggleButton">

        <!--  Unchecked (OFF)  -->
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource AtisPrimaryBrush}" />

        <!--  Layout  -->
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="MinWidth" Value="80" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">

                    <Border x:Name="Root"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}">

                        <!--  Visual States  -->
                        <VisualStateManager.VisualStateGroups>

                            <!--  UNCHECKED STATES  -->
                            <VisualStateGroup x:Name="CommonStates">

                                <VisualState x:Name="Normal" />

                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource AtisPrimaryBrushLow}" />
                                    </VisualState.Setters>
                                </VisualState>

                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource AtisPrimaryBrushLowDark}" />
                                    </VisualState.Setters>
                                </VisualState>

                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>

                            </VisualStateGroup>

                            <!--  CHECKED STATES  -->
                            <VisualStateGroup x:Name="CheckStates">

                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource AtisPrimaryBrush}" />
                                        <Setter Target="IconElement.Foreground" Value="{ThemeResource AtisPrimaryForegroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>

                                <VisualState x:Name="CheckedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource AtisPrimaryBrushLight}" />
                                    </VisualState.Setters>
                                </VisualState>

                                <VisualState x:Name="CheckedPressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource AtisPrimaryBrushDark}" />
                                    </VisualState.Setters>
                                </VisualState>

                            </VisualStateGroup>

                        </VisualStateManager.VisualStateGroups>

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!--  Icon  -->
                            <FontIcon x:Name="IconElement"
                                      VerticalAlignment="Center"
                                      FontSize="16"
                                      Glyph="{TemplateBinding Tag}" />

                            <!--  Label  -->
                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}"
                                       Text="{TemplateBinding Content}" />
                        </Grid>

                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

    </Style>

