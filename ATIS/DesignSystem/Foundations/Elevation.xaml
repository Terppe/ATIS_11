<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Minimale, garantiert stabile ThemeShadow-Definitionen  -->
    <ThemeShadow x:Key="Elevation1Shadow" />
    <ThemeShadow x:Key="Elevation2Shadow" />
    <ThemeShadow x:Key="Elevation3Shadow" />
    <ThemeShadow x:Key="Elevation4Shadow" />

    <!--  Minimale Opacity-Werte (alle = 1, damit nichts schiefgeht)  -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <x:Double x:Key="Elevation1Opacity">1</x:Double>
            <x:Double x:Key="Elevation2Opacity">1</x:Double>
            <x:Double x:Key="Elevation3Opacity">1</x:Double>
            <x:Double x:Key="Elevation4Opacity">1</x:Double>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <x:Double x:Key="Elevation1Opacity">1</x:Double>
            <x:Double x:Key="Elevation2Opacity">1</x:Double>
            <x:Double x:Key="Elevation3Opacity">1</x:Double>
            <x:Double x:Key="Elevation4Opacity">1</x:Double>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>



