<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>

        <!--  =========================================================  -->
        <!--  LIGHT THEME  -->
        <!--  =========================================================  -->
        <ResourceDictionary x:Key="Light">

            <!--  Page Background  -->
            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="{StaticResource AtisGray10}" />

            <!--  Card  -->
            <SolidColorBrush x:Key="AtisCardBackgroundBrush" Color="{StaticResource AtisWhite}" />
            <SolidColorBrush x:Key="AtisCardBorderBrush" Color="{StaticResource AtisGray30}" />

            <!--  Primary  -->
            <SolidColorBrush x:Key="AtisPrimaryBrush" Color="#007ACC" />
            <SolidColorBrush x:Key="AtisPrimaryBrushLight" Color="#3385C8" />
            <SolidColorBrush x:Key="AtisPrimaryBrushDark" Color="#004F8C" />
            <SolidColorBrush x:Key="AtisPrimaryBrushLow" Color="#110063B1" />
            <SolidColorBrush x:Key="AtisPrimaryBrushLowDark" Color="#220063B1" />

            <!--  Neutral  -->
            <SolidColorBrush x:Key="AtisNeutralHighBrush" Color="#F5F5F5" />
            <SolidColorBrush x:Key="AtisNeutralDarkBrush" Color="#333333" />
            <SolidColorBrush x:Key="AtisNeutralBorderBrush" Color="#DDDDDD" />

            <!--  DataGrid  -->
            <SolidColorBrush x:Key="DataGridRowBackgroundBrush" Color="{StaticResource AtisWhite}" />
            <SolidColorBrush x:Key="DataGridRowAlternateBackgroundBrush" Color="{StaticResource AtisGray20}" />
            <SolidColorBrush x:Key="DataGridColumnHeaderBackgroundBrush" Color="{StaticResource AtisGray20}" />
            <SolidColorBrush x:Key="DataGridColumnHeaderForegroundBrush" Color="{StaticResource AtisGray80}" />

            <!--  Overlay  -->
            <SolidColorBrush x:Key="AtisOverlayLight" Color="#11000000" />

        </ResourceDictionary>


        <!--  =========================================================  -->
        <!--  DARK THEME  -->
        <!--  =========================================================  -->
        <ResourceDictionary x:Key="Dark">

            <!--  Page Background  -->
            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#111111" />

            <!--  Card  -->
            <SolidColorBrush x:Key="AtisCardBackgroundBrush" Color="#1A1A1A" />
            <SolidColorBrush x:Key="AtisCardBorderBrush" Color="#3A3A3A" />

            <!--  Primary  -->
            <SolidColorBrush x:Key="AtisPrimaryBrush" Color="#3B82F6" />
            <SolidColorBrush x:Key="AtisPrimaryBrushLight" Color="#3385C8" />
            <SolidColorBrush x:Key="AtisPrimaryBrushDark" Color="#004F8C" />
            <SolidColorBrush x:Key="AtisPrimaryBrushLow" Color="#110063B1" />
            <SolidColorBrush x:Key="AtisPrimaryBrushLowDark" Color="#220063B1" />

            <!--  Neutral  -->
            <SolidColorBrush x:Key="AtisNeutralHighBrush" Color="#1E1E1E" />
            <SolidColorBrush x:Key="AtisNeutralDarkBrush" Color="#E6E6E6" />
            <SolidColorBrush x:Key="AtisNeutralBorderBrush" Color="#3A3A3A" />

            <!--  DataGrid  -->
            <SolidColorBrush x:Key="DataGridRowBackgroundBrush" Color="#1E1E1E" />
            <SolidColorBrush x:Key="DataGridRowAlternateBackgroundBrush" Color="#2A2A2A" />
            <SolidColorBrush x:Key="DataGridColumnHeaderBackgroundBrush" Color="#2A2A2A" />
            <SolidColorBrush x:Key="DataGridColumnHeaderForegroundBrush" Color="#E6E6E6" />

            <!--  Overlay  -->
            <SolidColorBrush x:Key="AtisOverlayLight" Color="#11000000" />

        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>




