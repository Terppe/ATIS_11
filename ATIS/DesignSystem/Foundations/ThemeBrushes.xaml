<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  =========================================================  -->
    <!--  1) Spacing Tokens (Abstände)  -->
    <!--  =========================================================  -->
    <x:Double x:Key="AtisSpacingXS">4</x:Double>
    <x:Double x:Key="AtisSpacingS">8</x:Double>
    <x:Double x:Key="AtisSpacingM">12</x:Double>
    <x:Double x:Key="AtisSpacingL">16</x:Double>
    <x:Double x:Key="AtisSpacingXL">24</x:Double>
    <x:Double x:Key="AtisSpacingXXL">32</x:Double>

    <!--  =========================================================  -->
    <!--  2) Gap Tokens (Zwischenräume)  -->
    <!--  =========================================================  -->
    <x:Double x:Key="AtisGapXS">4</x:Double>
    <x:Double x:Key="AtisGapS">8</x:Double>
    <x:Double x:Key="AtisGapM">12</x:Double>
    <x:Double x:Key="AtisGapL">16</x:Double>
    <x:Double x:Key="AtisGapXL">24</x:Double>

    <!--  =========================================================  -->
    <!--  3) Control Heights  -->
    <!--  =========================================================  -->
    <x:Double x:Key="AtisControlHeightS">28</x:Double>
    <x:Double x:Key="AtisControlHeightM">32</x:Double>
    <x:Double x:Key="AtisControlHeightL">40</x:Double>

    <!--  Einheitliche Höhe für alle Eingabefelder  -->
    <x:Double x:Key="AtisTextControlHeight">32</x:Double>

    <!--  =========================================================  -->
    <!--  4) Corner Radius Tokens  -->
    <!--  =========================================================  -->
    <CornerRadius x:Key="AtisCornerXS">2</CornerRadius>
    <CornerRadius x:Key="AtisCornerS">4</CornerRadius>
    <CornerRadius x:Key="AtisCornerM">6</CornerRadius>
    <CornerRadius x:Key="AtisCornerL">8</CornerRadius>

    <!--  Einheitlicher CornerRadius für Inputs  -->
    <CornerRadius x:Key="AtisTextControlCornerRadius">6</CornerRadius>

    <!--  =========================================================  -->
    <!--  5) Border Thickness Tokens  -->
    <!--  =========================================================  -->
    <Thickness x:Key="AtisBorderThin">1</Thickness>
    <Thickness x:Key="AtisBorderMedium">2</Thickness>

    <!--  Einheitliche Border für Inputs  -->
    <Thickness x:Key="AtisTextControlBorderThickness">1</Thickness>

    <!--  =========================================================  -->
    <!--  6) Font Size Tokens  -->
    <!--  =========================================================  -->
    <x:Double x:Key="AtisTextControlFontSize">14</x:Double>

    <!--  =========================================================  -->
    <!--  7) Layout Tokens  -->
    <!--  =========================================================  -->
    <Thickness x:Key="AtisPagePadding">24,24,24,24</Thickness>

    <x:Double x:Key="HeaderHeight">32</x:Double>
    <GridLength x:Key="GridHeaderHeight">32</GridLength>

    <!--  Snap Points  -->
    <x:Double x:Key="MinWindowSnapPoint">0</x:Double>
    <x:Double x:Key="MediumWindowSnapPoint">641</x:Double>
    <x:Double x:Key="LargeWindowSnapPoint">1008</x:Double>

    <!--  ContentDialog  -->
    <x:Double x:Key="ContentDialogMaxWidth">9999</x:Double>
    <x:Double x:Key="ContentDialogMaxHeight">9999</x:Double>

</ResourceDictionary>
