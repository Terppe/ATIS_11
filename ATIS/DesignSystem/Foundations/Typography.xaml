<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Font Family  -->
    <FontFamily x:Key="AtisFontFamily">Segoe UI</FontFamily>

    <!--  Font Sizes  -->
    <x:Double x:Key="AtisFontSizeXs">10</x:Double>
    <x:Double x:Key="AtisFontSizeS">12</x:Double>
    <x:Double x:Key="AtisFontSizeM">14</x:Double>
    <x:Double x:Key="AtisFontSizeL">16</x:Double>
    <x:Double x:Key="AtisFontSizeXl">20</x:Double>
    <x:Double x:Key="AtisFontSizeXxl">24</x:Double>

    <!--  Input Font Size  -->
    <x:Double x:Key="AtisInputFontSize">14</x:Double>

</ResourceDictionary>
