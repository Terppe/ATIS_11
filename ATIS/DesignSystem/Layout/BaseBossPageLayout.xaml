<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="ATIS.DesignSystem.Layout.BaseBossPageLayout"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
          RowDefinitions="Auto,Auto,*,Auto">

        <!--  HEADER + APPBAR in einer Zeile  -->
        <Grid Grid.Row="0"
              Padding="8"
              VerticalAlignment="Center"
              ColumnDefinitions="*,Auto">

            <!--  HEADER LEFT  -->
            <ContentPresenter Grid.Column="0"
                              Content="{x:Bind Header, Mode=OneWay}" />

            <!--  APPBAR RIGHT  -->
            <ContentPresenter Grid.Column="1"
                              Content="{x:Bind AppBar, Mode=OneWay}" />
        </Grid>

        <!--  LIST  -->
        <ContentPresenter Grid.Row="1"
                          Content="{x:Bind ListContent, Mode=OneWay}" />

        <!--  DETAILS  -->
        <ContentPresenter Grid.Row="2"
                          Content="{x:Bind DetailContent, Mode=OneWay}" />

    </Grid>
</UserControl>
