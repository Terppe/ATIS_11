<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:helpers="using:Atis.Helpers">



    <!--  =========================================================  -->
    <!--  SPACING TOKENS (globales Abstands-System)  -->
    <!--  =========================================================  -->

    <x:Double x:Key="AtisSpacingXs">4</x:Double>
    <x:Double x:Key="AtisSpacingS">8</x:Double>
    <x:Double x:Key="AtisSpacingM">12</x:Double>
    <x:Double x:Key="AtisSpacingL">16</x:Double>
    <x:Double x:Key="AtisSpacingXl">24</x:Double>
    <x:Double x:Key="AtisSpacingXxl">32</x:Double>


    <!--  =========================================================  -->
    <!--  PAGE CONTAINER  -->
    <!--  =========================================================  -->

    <Style x:Key="AtisPageContainer"
           TargetType="Grid">
        <Setter Property="Padding" Value="24" />
        <Setter Property="RowSpacing" Value="{StaticResource AtisSpacingL}" />
        <Setter Property="ColumnSpacing" Value="{StaticResource AtisSpacingL}" />
        <Setter Property="Background" Value="{ThemeResource AtisNeutralHighBrush}" />
    </Style>


    <!--  =========================================================  -->
    <!--  SECTION HEADER  -->
    <!--  =========================================================  -->

    <Style x:Key="AtisSectionHeader"
           TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource AtisFontSizeL}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource AtisNeutralDarkBrush}" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>


    <!--  =========================================================  -->
    <!--  CARD / PANEL  -->
    <!--  =========================================================  -->

    <!--<Style x:Key="AtisCard"
           TargetType="Border">
        <Setter Property="Padding" Value="16" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="{ThemeResource AtisNeutralHighBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AtisNeutralBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>-->


    <!--  =========================================================  -->
    <!--  SECTION CONTAINER  -->
    <!--  =========================================================  -->

    <Style x:Key="AtisSection"
           TargetType="StackPanel">
        <Setter Property="Spacing" Value="{StaticResource AtisSpacingM}" />
        <Setter Property="Margin" Value="0,0,0,24" />
    </Style>


    <!--  =========================================================  -->
    <!--  GRID LAYOUTS  -->
    <!--  =========================================================  -->

    <!--  2-Spalten Layout  -->
    <Style x:Key="AtisTwoRowGrid"
           TargetType="Grid">
        <Setter Property="helpers:AtisRowExtensions.Rows" Value="2" />
        <Setter Property="RowSpacing" Value="{StaticResource AtisSpacingM}" />
    </Style>

    <Style x:Key="AtisThreeRowGrid"
           TargetType="Grid">
        <Setter Property="helpers:AtisRowExtensions.Rows" Value="3" />
        <Setter Property="RowSpacing" Value="{StaticResource AtisSpacingM}" />
    </Style>

    <Style x:Key="AtisTwoColumnGrid"
           TargetType="Grid">
        <Setter Property="helpers:AtisGridExtensions.Columns" Value="2" />
        <Setter Property="helpers:AtisGridSpacing.ColumnSpacing" Value="{StaticResource AtisSpacingL}" />
        <Setter Property="helpers:AtisGridSpacing.RowSpacing" Value="{StaticResource AtisSpacingM}" />
    </Style>
    <!--  =========================================================  -->
    <!--  THEME-SPECIFIC VALUES (Light/Dark)  -->
    <!--  =========================================================  -->

    <ResourceDictionary.ThemeDictionaries>

        <!--  LIGHT  -->
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="AtisCardShadowBrush"
                             Color="#22000000" />
        </ResourceDictionary>

        <!--  DARK  -->
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="AtisCardShadowBrush"
                             Color="#33FFFFFF" />
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
