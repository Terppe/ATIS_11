<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="ATIS.DesignSystem.Components.LoadingOverlayControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="using:ATIS.DesignSystem.Converters"
             x:Name="OverlayRoot">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          Background="#80000000"
          Visibility="{Binding IsLoading, ElementName=OverlayRoot, Converter={StaticResource BooleanToVisibilityConverter}}">
        <ProgressRing Width="60"
                      Height="60"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      IsActive="{Binding IsLoading, ElementName=OverlayRoot}" />
    </Grid>
