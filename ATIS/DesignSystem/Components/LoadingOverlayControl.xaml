<?xml version="1.0" encoding="utf-8" ?>

<UserControl x:Class="ATIS.DesignSystem.Components.LoadingOverlayControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:WinUI3Localizer"
             x:Name="OverlayRoot">

    <Grid HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          Background="#80000000"
          Visibility="{Binding IsLoading, ElementName=OverlayRoot, Converter={StaticResource BooleanToVisibilityConverter}}">
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12">
            <ProgressRing Width="60"
                          Height="60"
                          IsActive="{Binding IsLoading, ElementName=OverlayRoot}" />
            <TextBlock HorizontalAlignment="Center"
                       loc:Uids.Uid="TextBlock_Dataload"
                       Foreground="White" />
        </StackPanel>
    </Grid>
</UserControl>

