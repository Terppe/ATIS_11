<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:ATIS.DesignSystem.Controls">

    <ResourceDictionary.ThemeDictionaries>

        <!--  LIGHT  -->
        <ResourceDictionary x:Key="Light">

            <!--  Input Brushes (Light)  -->
            <SolidColorBrush x:Key="AtisInputBackgroundBrush"
                             Color="#FFFFFF" />
            <SolidColorBrush x:Key="AtisInputBorderBrush"
                             Color="#CCCCCC" />

            <!--  Optional  -->
            <SolidColorBrush x:Key="AtisNeutralBorderBrush"
                             Color="#33000000" />

            <!--  AtisCard  -->
            <Style x:Key="AtisCard"
                   TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource AtisInputBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource AtisInputBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="16" />
                <Setter Property="Margin" Value="0" />
            </Style>

        </ResourceDictionary>


        <!--  DARK  -->
        <ResourceDictionary x:Key="Dark">

            <!--  Input Brushes (Dark)  -->
            <SolidColorBrush x:Key="AtisInputBackgroundBrush"
                             Color="#2A2A2A" />
            <SolidColorBrush x:Key="AtisInputBorderBrush"
                             Color="#444444" />

            <!--  Optional  -->
            <SolidColorBrush x:Key="AtisNeutralBorderBrush"
                             Color="#33FFFFFF" />
            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush"
                             Color="#111111" />

            <!--  AtisCard  -->
            <Style x:Key="AtisCard"
                   TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource AtisInputBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource AtisInputBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="16" />
                <Setter Property="Margin" Value="0" />
            </Style>

