<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:ATIS.DesignSystem.Converters">

    <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    <converters:BoolToVisibilityConverter x:Key="BoolToCollapsedConverter" Invert="True" />
    <converters:InvertBoolConverter x:Key="InvertBoolConverter" />
    <converters:BoolToRowBackgroundConverter x:Key="BoolToRowBackgroundConverter" />
