<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--  Brand  --><!--
    <Color x:Key="BrandPrimaryColor">#2563EB</Color>
    <Color x:Key="BrandSecondaryColor">#EFF6FF</Color>
    <Color x:Key="BrandAccentColor">#3B82F6</Color>
    --><!--Neutral Layers--><!--
    <Color x:Key="NeutralLayer0Light">#FFFFFFFF</Color>
    <Color x:Key="NeutralLayer1Light">#FFF5F5F5</Color>
    <Color x:Key="NeutralLayer0Dark">#FF1E1E1E</Color>
    <Color x:Key="NeutralLayer1Dark">#FF2A2A2A</Color>
    --><!--Text--><!--
    <Color x:Key="TextPrimaryLight">#FF111827</Color>
    <Color x:Key="TextSecondaryLight">#FF4B5563</Color>
    <Color x:Key="TextPrimaryDark">#FFF9FAFB</Color>
    <Color x:Key="TextSecondaryDark">#FF9CA3AF</Color>
    --><!--Status--><!--
    <Color x:Key="SuccessColor">#16A34A</Color>
    <Color x:Key="WarningColor">#EAB308</Color>
    <Color x:Key="ErrorColor">#DC2626</Color>-->
</ResourceDictionary>
