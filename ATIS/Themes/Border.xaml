<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  ATIS: Grundfarben für Rahmen  -->
    <SolidColorBrush x:Key="AtisBorderBrush"
                     Color="{ThemeResource SystemBaseLowColor}" />
    <SolidColorBrush x:Key="AtisBorderBrushStrong"
                     Color="{ThemeResource SystemBaseMediumColor}" />
    <SolidColorBrush x:Key="AtisCardBackground"
                     Color="{ThemeResource CardBackgroundFillColorDefault}" />

    <!--  ATIS: Standard Border Style (für Controls, Container, UserControls)  -->
    <Style x:Key="AtisBorderStyle"
           TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource AtisBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="Background" Value="{StaticResource AtisCardBackground}" />
    </Style>

    <!--  ATIS: Page Border Style (größerer Rahmen, mehr Abstand)  -->
    <Style x:Key="AtisPageBorderStyle"
           BasedOn="{StaticResource AtisBorderStyle}"
           TargetType="Border">
        <Setter Property="Margin" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="4" />
    </Style>

    <!--  ATIS: Card Style (für Panels, Sections, Gruppen)  -->
    <Style x:Key="AtisCardStyle"
           BasedOn="{StaticResource AtisBorderStyle}"
           TargetType="Border">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="BorderBrush" Value="{StaticResource AtisBorderBrushStrong}" />
    </Style>

    <!--  ATIS: Trennlinie (Bottom Border)  -->
    <Style x:Key="AtisSeparatorStyle"
           TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource AtisBorderBrushStrong}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Margin" Value="0,8,0,8" />
    </Style>
</ResourceDictionary>
