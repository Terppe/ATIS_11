<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  FONT SIZES  -->
    <x:Double x:Key="AtisFontSizeXs">10</x:Double>
    <x:Double x:Key="AtisFontSizeS">12</x:Double>
    <x:Double x:Key="AtisFontSizeM">14</x:Double>
    <x:Double x:Key="AtisFontSizeL">16</x:Double>
    <x:Double x:Key="AtisFontSizeXl">20</x:Double>
    <x:Double x:Key="AtisFontSizeXxl">24</x:Double>

    <!--  TEXT STYLES  -->

    <Style x:Key="BodyStrongTextBlockStyle" TargetType="TextBlock"/>

    <Style x:Key="AtisHeadlineStyle"
           TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource AtisFontSizeXxl}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource AtisNeutralDarkBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="AtisTitleStyle"
           TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource AtisFontSizeXl}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource AtisNeutralDarkBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="AtisSubtitleStyle"
           TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource AtisFontSizeL}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{ThemeResource AtisNeutralDarkBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="AtisBodyStyle"
           TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource AtisFontSizeM}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{ThemeResource AtisNeutralDarkBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="AtisCaptionStyle"
           TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource AtisFontSizeS}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{ThemeResource AtisNeutralDarkBrush}" />
        <Setter Property="Opacity" Value="0.75" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!--  Page Title  -->
    <Style x:Key="PageTitleTextStyle"
           TargetType="TextBlock">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimary}" />
    </Style>

    <!--  Page Subtitle  -->
    <Style x:Key="PageSubtitleTextStyle"
           TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--  Section Header  -->
    <Style x:Key="SectionHeaderTextStyle"
           TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimary}" />
        <Setter Property="Margin" Value="0,16,0,8" />
    </Style>

    <!--  Body Text  -->
    <Style x:Key="BodyTextStyle"
           TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimary}" />
    </Style>


</ResourceDictionary>
