<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>


        <!--  LIGHT MODE  -->
        <ResourceDictionary x:Key="Light">

            <!--  Primary  -->
            <SolidColorBrush x:Key="AtisPrimaryBrush"
                             Color="#007ACC" />

            <!--  Neutral  -->
            <SolidColorBrush x:Key="AtisNeutralHighBrush"
                             Color="#F5F5F5" />
            <SolidColorBrush x:Key="AtisNeutralDarkBrush"
                             Color="#333333" />
            <SolidColorBrush x:Key="AtisNeutralBorderBrush"
                             Color="#DDDDDD" />

            <!--  DataGrid  -->
            <SolidColorBrush x:Key="DataGridHeaderBackgroundBrush"
                             Color="#F3F3F3" />
            <SolidColorBrush x:Key="DataGridHeaderForegroundBrush"
                             Color="#333333" />
            <SolidColorBrush x:Key="DataGridHeaderBorderBrush"
                             Color="#DDDDDD" />

            <SolidColorBrush x:Key="DataGridRowBackgroundBrush"
                             Color="#FFFFFF" />
            <SolidColorBrush x:Key="DataGridRowForegroundBrush"
                             Color="#333333" />
            <SolidColorBrush x:Key="DataGridAlternatingRowBackgroundBrush"
                             Color="#FAFAFA" />

            <SolidColorBrush x:Key="DataGridRowHoverBrush"
                             Color="#11000000" />

            <SolidColorBrush x:Key="DataGridRowSelectionBackgroundBrush"
                             Color="#007ACC" />
            <SolidColorBrush x:Key="DataGridRowSelectionForegroundBrush"
                             Color="#FFFFFF" />

            <SolidColorBrush x:Key="DataGridGridLinesBrush"
                             Color="#E0E0E0" />

            <!--  PRIMARY BUTTON  -->
            <SolidColorBrush x:Key="AtisPrimaryForegroundBrush"
                             Color="#FFFFFF" />
            <SolidColorBrush x:Key="AtisPrimaryHoverBrush"
                             Color="#1D4ED8" />
            <SolidColorBrush x:Key="AtisPrimaryPressedBrush"
                             Color="#1E40AF" />
            <SolidColorBrush x:Key="AtisPrimaryDisabledBrush"
                             Color="#A5B4FC" />
            <SolidColorBrush x:Key="AtisPrimaryDisabledForegroundBrush"
                             Color="#E5E7EB" />

            <!--  SECONDARY BUTTON  -->
            <SolidColorBrush x:Key="AtisSecondaryBackgroundBrush"
                             Color="#F3F4F6" />
            <SolidColorBrush x:Key="AtisSecondaryForegroundBrush"
                             Color="#111827" />
            <SolidColorBrush x:Key="AtisSecondaryBorderBrush"
                             Color="#D1D5DB" />
            <SolidColorBrush x:Key="AtisSecondaryHoverBrush"
                             Color="#E5E7EB" />
            <SolidColorBrush x:Key="AtisSecondaryPressedBrush"
                             Color="#D1D5DB" />
            <SolidColorBrush x:Key="AtisSecondaryDisabledBrush"
                             Color="#F9FAFB" />
            <SolidColorBrush x:Key="AtisSecondaryDisabledForegroundBrush"
                             Color="#9CA3AF" />

            <!--  SUBTLE BUTTON  -->
            <SolidColorBrush x:Key="AtisSubtleForegroundBrush"
                             Color="#374151" />
            <SolidColorBrush x:Key="AtisSubtleHoverBrush"
                             Color="#F3F4F6" />
            <SolidColorBrush x:Key="AtisSubtlePressedBrush"
                             Color="#E5E7EB" />
            <SolidColorBrush x:Key="AtisSubtleDisabledForegroundBrush"
                             Color="#9CA3AF" />

            <!--  TextBox + ComboBox  -->
            <SolidColorBrush x:Key="AtisTextBoxBackgroundBrush"
                             Color="#FFFFFF" />
            <SolidColorBrush x:Key="AtisTextBoxForegroundBrush"
                             Color="#111827" />
            <SolidColorBrush x:Key="AtisTextBoxBorderBrush"
                             Color="#D1D5DB" />
            <SolidColorBrush x:Key="AtisTextBoxHoverBorderBrush"
                             Color="#9CA3AF" />
            <SolidColorBrush x:Key="AtisTextBoxDisabledBackgroundBrush"
                             Color="#F3F4F6" />
            <SolidColorBrush x:Key="AtisTextBoxDisabledBorderBrush"
                             Color="#E5E7EB" />
            <SolidColorBrush x:Key="AtisTextBoxDisabledForegroundBrush"
                             Color="#9CA3AF" />

            <!--  TextBlock  -->
            <SolidColorBrush x:Key="AtisTextForegroundBrush"
                             Color="#111827" />
            <SolidColorBrush x:Key="AtisTextCaptionBrush"
                             Color="#6B7280" />

            <!--  CheckBox  -->
            <SolidColorBrush x:Key="AtisCheckBoxBackgroundBrush"
                             Color="#FFFFFF" />
            <SolidColorBrush x:Key="AtisCheckBoxBorderBrush"
                             Color="#D1D5DB" />
            <SolidColorBrush x:Key="AtisCheckBoxHoverBorderBrush"
                             Color="#9CA3AF" />
            <SolidColorBrush x:Key="AtisCheckBoxCheckBrush"
                             Color="#2563EB" />

            <SolidColorBrush x:Key="AtisCheckBoxDisabledBackgroundBrush"
                             Color="#F3F4F6" />
            <SolidColorBrush x:Key="AtisCheckBoxDisabledBorderBrush"
                             Color="#E5E7EB" />
            <SolidColorBrush x:Key="AtisCheckBoxDisabledCheckBrush"
                             Color="#9CA3AF" />

            <SolidColorBrush x:Key="AtisPrimaryBrushLight"
                             Color="#FF4DA3FF" />
            <SolidColorBrush x:Key="AtisPrimaryBrushDark"
                             Color="#FF0060D0" />

            <SolidColorBrush x:Key="AtisSecondaryBrushLight"
                             Color="#FFE5E5E5" />
            <SolidColorBrush x:Key="AtisSecondaryBrushDark"
                             Color="#FFB0B0B0" />
        </ResourceDictionary>


        <!--  DARK MODE  -->
        <ResourceDictionary x:Key="Dark">

            <!--  Neutral  -->
            <SolidColorBrush x:Key="AtisNeutralHighBrush"
                             Color="#1E1E1E" />
            <SolidColorBrush x:Key="AtisNeutralDarkBrush"
                             Color="#E6E6E6" />
            <SolidColorBrush x:Key="AtisNeutralBorderBrush"
                             Color="#3A3A3A" />

            <!--  DataGrid  -->
            <SolidColorBrush x:Key="DataGridHeaderBackgroundBrush"
                             Color="#2E2E2E" />
            <SolidColorBrush x:Key="DataGridHeaderForegroundBrush"
                             Color="#FFFFFF" />
            <SolidColorBrush x:Key="DataGridHeaderBorderBrush"
                             Color="#3F3F3F" />

            <SolidColorBrush x:Key="DataGridRowBackgroundBrush"
                             Color="#1C1C1C" />
            <SolidColorBrush x:Key="DataGridRowForegroundBrush"
                             Color="#E6E6E6" />
            <SolidColorBrush x:Key="DataGridAlternatingRowBackgroundBrush"
                             Color="#2E2E2E" />

            <SolidColorBrush x:Key="DataGridAlternatingRowBrush"
                             Color="{ThemeResource CardBackgroundFillColorSecondary}" />

            <SolidColorBrush x:Key="DataGridRowHoverBrush"
                             Color="#22FFFFFF" />

            <SolidColorBrush x:Key="DataGridRowSelectionBackgroundBrush"
                             Color="#3399FF" />
            <SolidColorBrush x:Key="DataGridRowSelectionForegroundBrush"
                             Color="#FFFFFF" />

            <SolidColorBrush x:Key="DataGridGridLinesBrush"
                             Color="#3A3A3A" />

            <!--  PRIMARY BUTTON  -->
            <SolidColorBrush x:Key="AtisPrimaryBrush"
                             Color="#3B82F6" />
            <SolidColorBrush x:Key="AtisPrimaryForegroundBrush"
                             Color="#FFFFFF" />
            <SolidColorBrush x:Key="AtisPrimaryHoverBrush"
                             Color="#2563EB" />
            <SolidColorBrush x:Key="AtisPrimaryPressedBrush"
                             Color="#1D4ED8" />
            <SolidColorBrush x:Key="AtisPrimaryDisabledBrush"
                             Color="#1E3A8A" />
            <SolidColorBrush x:Key="AtisPrimaryDisabledForegroundBrush"
                             Color="#6B7280" />

            <!--  SECONDARY BUTTON  -->
            <SolidColorBrush x:Key="AtisSecondaryBackgroundBrush"
                             Color="#374151" />
            <SolidColorBrush x:Key="AtisSecondaryForegroundBrush"
                             Color="#F9FAFB" />
            <SolidColorBrush x:Key="AtisSecondaryBorderBrush"
                             Color="#4B5563" />
            <SolidColorBrush x:Key="AtisSecondaryHoverBrush"
                             Color="#4B5563" />
            <SolidColorBrush x:Key="AtisSecondaryPressedBrush"
                             Color="#6B7280" />
            <SolidColorBrush x:Key="AtisSecondaryDisabledBrush"
                             Color="#1F2937" />
            <SolidColorBrush x:Key="AtisSecondaryDisabledForegroundBrush"
                             Color="#6B7280" />

            <!--  SUBTLE BUTTON  -->
            <SolidColorBrush x:Key="AtisSubtleForegroundBrush"
                             Color="#D1D5DB" />
            <SolidColorBrush x:Key="AtisSubtleHoverBrush"
                             Color="#4B5563" />
            <SolidColorBrush x:Key="AtisSubtlePressedBrush"
                             Color="#374151" />
            <SolidColorBrush x:Key="AtisSubtleDisabledForegroundBrush"
                             Color="#6B7280" />

            <!--  TextBox + ComboBox  -->
            <SolidColorBrush x:Key="AtisTextBoxBackgroundBrush"
                             Color="#1F2937" />
            <SolidColorBrush x:Key="AtisTextBoxForegroundBrush"
                             Color="#F9FAFB" />
            <SolidColorBrush x:Key="AtisTextBoxBorderBrush"
                             Color="#4B5563" />
            <SolidColorBrush x:Key="AtisTextBoxHoverBorderBrush"
                             Color="#6B7280" />
            <SolidColorBrush x:Key="AtisTextBoxDisabledBackgroundBrush"
                             Color="#111827" />
            <SolidColorBrush x:Key="AtisTextBoxDisabledBorderBrush"
                             Color="#374151" />
            <SolidColorBrush x:Key="AtisTextBoxDisabledForegroundBrush"
                             Color="#6B7280" />

            <!--  TextBlock  -->
            <SolidColorBrush x:Key="AtisTextForegroundBrush"
                             Color="#F9FAFB" />
            <SolidColorBrush x:Key="AtisTextCaptionBrush"
                             Color="#9CA3AF" />

            <!--  CheckBox  -->
            <SolidColorBrush x:Key="AtisCheckBoxBackgroundBrush"
                             Color="#1F2937" />
            <SolidColorBrush x:Key="AtisCheckBoxBorderBrush"
                             Color="#4B5563" />
            <SolidColorBrush x:Key="AtisCheckBoxHoverBorderBrush"
                             Color="#6B7280" />
            <SolidColorBrush x:Key="AtisCheckBoxCheckBrush"
                             Color="#3B82F6" />

            <SolidColorBrush x:Key="AtisCheckBoxDisabledBackgroundBrush"
                             Color="#111827" />
            <SolidColorBrush x:Key="AtisCheckBoxDisabledBorderBrush"
                             Color="#374151" />
            <SolidColorBrush x:Key="AtisCheckBoxDisabledCheckBrush"
                             Color="#6B7280" />

        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
