<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>

        <!--  =========================================================  -->
        <!--  LIGHT MODE  -->
        <!--  =========================================================  -->
        <ResourceDictionary x:Key="Light">

            <!--  Header  -->
            <SolidColorBrush x:Key="DataGridHeaderBackgroundBrush"
                             Color="#F3F3F3" />
            <SolidColorBrush x:Key="DataGridHeaderForegroundBrush"
                             Color="#333333" />
            <SolidColorBrush x:Key="DataGridHeaderBorderBrush"
                             Color="#DDDDDD" />

            <!--  Rows  -->
            <SolidColorBrush x:Key="DataGridRowBackgroundBrush"
                             Color="White" />
            <SolidColorBrush x:Key="DataGridRowForegroundBrush"
                             Color="#333333" />

            <!--  Alternating  -->
            <SolidColorBrush x:Key="DataGridAlternatingRowBackgroundBrush"
                             Color="#FAFAFA" />

            <!--  Hover  -->
            <SolidColorBrush x:Key="DataGridRowHoverBrush"
                             Color="#11000000" />

            <!--  Selection  -->
            <SolidColorBrush x:Key="DataGridRowSelectionBackgroundBrush"
                             Color="#007ACC" />
            <SolidColorBrush x:Key="DataGridRowSelectionForegroundBrush"
                             Color="White" />

            <!--  GridLines  -->
            <SolidColorBrush x:Key="DataGridGridLinesBrush"
                             Color="#E0E0E0" />

        </ResourceDictionary>

        <!--  =========================================================  -->
        <!--  DARK MODE (optimiert für AtisCard #141414)  -->
        <!--  =========================================================  -->
        <ResourceDictionary x:Key="Dark">

            <!-- HEADER (klar abgegrenzt, dunkler als Rows) -->
            <SolidColorBrush x:Key="DataGridHeaderBackgroundBrush" Color="#101010" />
            <SolidColorBrush x:Key="DataGridHeaderForegroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="DataGridHeaderBorderBrush" Color="#2A2A2A" />

            <!-- ROWS (sichtbar heller als Header, aber dunkel) -->
            <SolidColorBrush x:Key="DataGridRowBackgroundBrush" Color="#1A1A1A" />

            <!-- Schrift leicht gedimmt, nicht grell -->
            <SolidColorBrush x:Key="DataGridRowForegroundBrush" Color="#E6E6E6" />

            <!-- ALTERNATING ROWS (klar sichtbar, aber nicht zu hell) -->
            <SolidColorBrush x:Key="DataGridAlternatingRowBackgroundBrush" Color="#242424" />

            <!-- Hover (dezentes Weiß‑Overlay) -->
            <SolidColorBrush x:Key="DataGridRowHoverBrush" Color="#22FFFFFF" />

            <!-- Selection (Fluent‑2 Blau) -->
            <SolidColorBrush x:Key="DataGridRowSelectionBackgroundBrush" Color="#3399FF" />
            <SolidColorBrush x:Key="DataGridRowSelectionForegroundBrush" Color="#FFFFFF" />

            <!-- GridLines (leicht sichtbar, nicht dominant) -->
            <SolidColorBrush x:Key="DataGridGridLinesBrush" Color="#303030" />

        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
