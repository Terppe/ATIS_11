<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="AtisPageBorderBrush" Color="#DDDDDD" />
            <SolidColorBrush x:Key="DataGridRowBackgroundBrush" Color="#00000000" />
            <SolidColorBrush x:Key="DataGridAlternatingRowBackgroundBrush" Color="#0A000000" />
            <SolidColorBrush x:Key="DataGridRowBorderBrush" Color="#1A000000" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="AtisPageBorderBrush" Color="#3A3A3A" />
            <SolidColorBrush x:Key="DataGridRowBackgroundBrush" Color="#00000000" />
            <SolidColorBrush x:Key="DataGridAlternatingRowBackgroundBrush" Color="#15FFFFFF" />
            <SolidColorBrush x:Key="DataGridRowBorderBrush" Color="#33FFFFFF" />
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>

