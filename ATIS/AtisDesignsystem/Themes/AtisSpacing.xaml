<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========================================================= -->
    <!-- 1) Spacing Tokens (Abstände in px)                        -->
    <!-- ========================================================= -->

    <!-- Extra Small -->
    <x:Double x:Key="AtisSpacingXS">4</x:Double>

    <!-- Small -->
    <x:Double x:Key="AtisSpacingS">8</x:Double>

    <!-- Medium -->
    <x:Double x:Key="AtisSpacingM">12</x:Double>

    <!-- Large -->
    <x:Double x:Key="AtisSpacingL">16</x:Double>

    <!-- Extra Large -->
    <x:Double x:Key="AtisSpacingXL">24</x:Double>

    <!-- Extra Extra Large -->
    <x:Double x:Key="AtisSpacingXXL">32</x:Double>


    <!-- ========================================================= -->
    <!-- 2) Padding Tokens (für Controls, Cards, Dialoge)          -->
    <!-- ========================================================= -->

    <Thickness x:Key="AtisPaddingXS">4</Thickness>
    <Thickness x:Key="AtisPaddingS">8</Thickness>
    <Thickness x:Key="AtisPaddingM">12</Thickness>
    <Thickness x:Key="AtisPaddingL">16</Thickness>
    <Thickness x:Key="AtisPaddingXL">24</Thickness>


    <!-- ========================================================= -->
    <!-- 3) Gap Tokens (für StackPanel, Grid, ItemsRepeater)       -->
    <!-- ========================================================= -->

    <x:Double x:Key="AtisGapXS">4</x:Double>
    <x:Double x:Key="AtisGapS">8</x:Double>
    <x:Double x:Key="AtisGapM">12</x:Double>
    <x:Double x:Key="AtisGapL">16</x:Double>
    <x:Double x:Key="AtisGapXL">24</x:Double>


    <!-- ========================================================= -->
    <!-- 4) Control Heights (optional, aber sehr nützlich)         -->
    <!-- ========================================================= -->

    <x:Double x:Key="AtisControlHeightS">28</x:Double>
    <x:Double x:Key="AtisControlHeightM">32</x:Double>
    <x:Double x:Key="AtisControlHeightL">40</x:Double>

</ResourceDictionary>
