<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========================================================= -->
    <!-- 1) Border Depth (Rahmenstärken für UI-Hierarchie)         -->
    <!-- ========================================================= -->

    <Thickness x:Key="AtisBorderThin">1</Thickness>
    <Thickness x:Key="AtisBorderMedium">2</Thickness>
    <Thickness x:Key="AtisBorderThick">3</Thickness>

    <!-- ========================================================= -->
    <!-- 2) Corner Radius Tokens                                   -->
    <!-- ========================================================= -->

    <CornerRadius x:Key="AtisCornerXS">2</CornerRadius>
    <CornerRadius x:Key="AtisCornerS">4</CornerRadius>
    <CornerRadius x:Key="AtisCornerM">8</CornerRadius>
    <CornerRadius x:Key="AtisCornerL">12</CornerRadius>

    <!-- ========================================================= -->
    <!-- 3) Elevation (Shadows)                                    -->
    <!-- ========================================================= -->
    <!-- WinUI 3 unterstützt DropShadowPanel, aber nicht als Resource.
         Darum definieren wir Shadow-Brushes und Opacity-Layer,
         die du in Panels, Cards, Dialogen usw. verwenden kannst. -->

    <!-- Low Elevation (z. B. Cards, Panels) -->
    <SolidColorBrush x:Key="AtisShadowLowColor" Color="#33000000" />
    <x:Double x:Key="AtisShadowLowBlur">8</x:Double>
    <x:Double x:Key="AtisShadowLowOffsetY">2</x:Double>

    <!-- Medium Elevation (z. B. Flyouts, Menüs) -->
    <SolidColorBrush x:Key="AtisShadowMediumColor" Color="#44000000" />
    <x:Double x:Key="AtisShadowMediumBlur">16</x:Double>
    <x:Double x:Key="AtisShadowMediumOffsetY">4</x:Double>

    <!-- High Elevation (z. B. Dialoge, Overlays) -->
    <SolidColorBrush x:Key="AtisShadowHighColor" Color="#55000000" />
    <x:Double x:Key="AtisShadowHighBlur">24</x:Double>
    <x:Double x:Key="AtisShadowHighOffsetY">6</x:Double>

    <!-- ========================================================= -->
    <!-- 4) Overlay Layers (für Dialoge, Modals, Backdrops)        -->
    <!-- ========================================================= -->

    <SolidColorBrush x:Key="AtisOverlayLight" Color="#33000000" />
    <SolidColorBrush x:Key="AtisOverlayMedium" Color="#55000000" />
    <SolidColorBrush x:Key="AtisOverlayDark" Color="#77000000" />

    <!-- ========================================================= -->
    <!-- 5) Z-Index Tokens                                         -->
    <!-- ========================================================= -->

    <x:Int32 x:Key="AtisZIndexBase">0</x:Int32>
    <x:Int32 x:Key="AtisZIndexRaised">10</x:Int32>
    <x:Int32 x:Key="AtisZIndexOverlay">100</x:Int32>
    <x:Int32 x:Key="AtisZIndexDialog">1000</x:Int32>

</ResourceDictionary>
