<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  =========================  -->
    <!--  1) Globale Font-Ressourcen  -->
    <!--  =========================  -->

    <!--
    WinUI 3 erlaubt KEINE FontFamily-Objekte als Resource.
    Darum speichern wir die FontFamily als String.
    -->

    <x:String x:Key="AtisFontFamily">Segoe UI</x:String>

    <!--  =========================  -->
    <!--  2) Textgrößen  -->
    <!--  =========================  -->

    <x:Double x:Key="AtisFontSizeCaption">12</x:Double>
    <x:Double x:Key="AtisFontSizeBody">14</x:Double>
    <x:Double x:Key="AtisFontSizeSubtitle">16</x:Double>
    <x:Double x:Key="AtisFontSizeTitle">20</x:Double>
    <x:Double x:Key="AtisFontSizeHeadline">24</x:Double>
    <x:Double x:Key="AtisFontSizeDisplay">32</x:Double>

    <!--  =========================  -->
    <!--  3) TextStyles  -->
    <!--  =========================  -->

    <!--  Headline  -->
    <Style x:Key="AtisHeadlineText"
           TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource AtisFontSizeHeadline}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontFamily" Value="{StaticResource AtisFontFamily}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!--  Title  -->
    <Style x:Key="AtisTitleText"
           TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource AtisFontSizeTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontFamily" Value="{StaticResource AtisFontFamily}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!--  Subtitle  -->
    <Style x:Key="AtisSubtitleText"
           TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource AtisFontSizeSubtitle}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontFamily" Value="{StaticResource AtisFontFamily}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!--  Body  -->
    <Style x:Key="AtisBodyText"
           TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource AtisFontSizeBody}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontFamily" Value="{StaticResource AtisFontFamily}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!--  Caption  -->
    <Style x:Key="AtisCaptionText"
           TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource AtisFontSizeCaption}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontFamily" Value="{StaticResource AtisFontFamily}" />
        <Setter Property="Opacity" Value="0.8" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!--  =========================  -->
    <!--  4) ThemeDictionaries (optional)  -->
    <!--  =========================  -->

    <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="AtisTextColor"
                             Color="#1A1A1A" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="AtisTextColor"
                             Color="#FFFFFF" />
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
