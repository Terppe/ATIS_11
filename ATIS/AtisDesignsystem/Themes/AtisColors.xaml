<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========================================================= -->
    <!-- 1) Global Color Tokens (nicht theme-spezifisch)           -->
    <!-- ========================================================= -->

    <!-- Primärfarben -->
    <Color x:Key="AtisPrimaryColor">#0063B1</Color>
    <Color x:Key="AtisPrimaryColorDark">#005A9E</Color>

    <!-- Sekundärfarben -->
    <Color x:Key="AtisSecondaryColor">#E5E5E5</Color>
    <Color x:Key="AtisSecondaryColorDark">#CCCCCC</Color>

    <!-- Statusfarben -->
    <Color x:Key="AtisSuccessColor">#107C10</Color>
    <Color x:Key="AtisWarningColor">#FFB900</Color>
    <Color x:Key="AtisDangerColor">#D13438</Color>
    <Color x:Key="AtisInfoColor">#0178D4</Color>

    <!-- Neutralfarben (Basis für Text, Hintergründe, Rahmen) -->
    <Color x:Key="AtisNeutralHighColor">#FFFFFF</Color>
    <Color x:Key="AtisNeutralMidColor">#C8C8C8</Color>
    <Color x:Key="AtisNeutralLowColor">#1A1A1A</Color>

    <!-- ========================================================= -->
    <!-- 2) Brushes (werden in ThemeDictionaries überschrieben)     -->
    <!-- ========================================================= -->

    <!-- Platzhalter (werden durch ThemeDictionaries ersetzt) -->
    <SolidColorBrush x:Key="AtisPrimaryBrush" Color="{StaticResource AtisPrimaryColor}" />
    <SolidColorBrush x:Key="AtisSecondaryBrush" Color="{StaticResource AtisSecondaryColor}" />

    <SolidColorBrush x:Key="AtisSuccessBrush" Color="{StaticResource AtisSuccessColor}" />
    <SolidColorBrush x:Key="AtisWarningBrush" Color="{StaticResource AtisWarningColor}" />
    <SolidColorBrush x:Key="AtisDangerBrush" Color="{StaticResource AtisDangerColor}" />
    <SolidColorBrush x:Key="AtisInfoBrush" Color="{StaticResource AtisInfoColor}" />

    <SolidColorBrush x:Key="AtisNeutralHighBrush" Color="{StaticResource AtisNeutralHighColor}" />
    <SolidColorBrush x:Key="AtisNeutralMidBrush" Color="{StaticResource AtisNeutralMidColor}" />
    <SolidColorBrush x:Key="AtisNeutralLowBrush" Color="{StaticResource AtisNeutralLowColor}" />

    <!-- ========================================================= -->
    <!-- 3) ThemeDictionaries (Light / Dark)                       -->
    <!-- ========================================================= -->

    <ResourceDictionary.ThemeDictionaries>

        <!-- ================= LIGHT THEME ================= -->
        <ResourceDictionary x:Key="Light">

            <SolidColorBrush x:Key="AtisBackgroundBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="AtisForegroundBrush" Color="#1A1A1A" />

            <SolidColorBrush x:Key="AtisCardBackgroundBrush" Color="#F8F8F8" />
            <SolidColorBrush x:Key="AtisCardBorderBrush" Color="#DDDDDD" />

            <SolidColorBrush x:Key="AtisDividerBrush" Color="#E0E0E0" />
        </ResourceDictionary>

        <!-- ================= DARK THEME ================= -->
        <ResourceDictionary x:Key="Dark">

            <SolidColorBrush x:Key="AtisBackgroundBrush" Color="#1A1A1A" />
            <SolidColorBrush x:Key="AtisForegroundBrush" Color="#FFFFFF" />

            <SolidColorBrush x:Key="AtisCardBackgroundBrush" Color="#2A2A2A" />
            <SolidColorBrush x:Key="AtisCardBorderBrush" Color="#3A3A3A" />

            <SolidColorBrush x:Key="AtisDividerBrush" Color="#3F3F3F" />
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
