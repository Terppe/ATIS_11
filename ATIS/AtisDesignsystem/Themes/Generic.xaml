<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ATIS.AtisDesignsystem.Controls">

    <!-- ========================= -->
    <!-- 1) Default Styles für Controls -->
    <!-- ========================= -->

    <Style TargetType="local:AtisIcon">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:AtisIcon">
                    <ContentPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:AtisButton" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="{ThemeResource AtisButtonPrimaryBackground}" />
        <Setter Property="Foreground" Value="{ThemeResource AtisButtonPrimaryForeground}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AtisButtonPrimaryBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:AtisButton">
                    <Grid x:Name="RootGrid"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          CornerRadius="{TemplateBinding CornerRadius}">

                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Content}"
                            Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:AtisCard">
        <Setter Property="Background" Value="{ThemeResource AtisCardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AtisCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource AtisBorderThin}" />
        <Setter Property="CornerRadius" Value="{StaticResource AtisCornerM}" />
        <Setter Property="Padding" Value="{StaticResource AtisPaddingM}" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:AtisCard">
                    <Grid x:Name="RootGrid">

                        <!-- Simulierter Shadow: einfach ein leicht dunkler Hintergrund-Rahmen -->
                        <Border x:Name="ShadowLayer"
                            Background="{StaticResource AtisOverlayLight}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Margin="0,2,0,0"
                            Opacity="0"
                            IsHitTestVisible="False" />

                        <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">

                            <ContentPresenter />
                        </Border>

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="ElevationStates">

                                <VisualState x:Name="Normal">
                                    <VisualState.Setters>
                                        <Setter Target="ShadowLayer.Opacity" Value="0" />
                                    </VisualState.Setters>
                                </VisualState>

                                <VisualState x:Name="Elevated">
                                    <VisualState.Setters>
                                        <Setter Target="ShadowLayer.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>

                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

