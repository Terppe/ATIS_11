<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="ATIS.AtisDesignsystem.UserControls.AtisPageLayout"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid RowSpacing="16">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header + AppBar -->
            <RowDefinition Height="Auto"/>
            <!-- List -->
            <RowDefinition Height="*"/>
            <!-- Detail -->
        </Grid.RowDefinitions>

        <!-- HEADER + APPBAR in EINER Zeile -->
        <Grid Grid.Row="0"
              ColumnSpacing="12"
              VerticalAlignment="Center">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- HEADER LINKS -->
            <ContentPresenter x:Name="HeaderPresenter"
                              Grid.Column="0"
                              VerticalAlignment="Center"/>

            <!-- APPBAR RECHTS -->
            <ContentPresenter x:Name="AppBarPresenter"
                              Grid.Column="1"
                              VerticalAlignment="Center"/>
        </Grid>

        <!-- LIST -->
        <ContentPresenter x:Name="ListPresenter"
                          Grid.Row="1"/>

        <!-- DETAIL -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      VerticalScrollMode="Auto">

            <ContentPresenter x:Name="DetailPresenter"/>
        </ScrollViewer>

    </Grid>
</UserControl>

