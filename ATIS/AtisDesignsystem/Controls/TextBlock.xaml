<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========================================================= -->
    <!--  BASE TEXTBLOCK STYLE                                     -->
    <!-- ========================================================= -->
    <Style x:Key="AtisTextBlockBase" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource AtisTextForegroundBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>


    <!-- ========================================================= -->
    <!--  TITLE (H1)                                               -->
    <!-- ========================================================= -->
    <Style x:Key="AtisTextTitle" TargetType="TextBlock" BasedOn="{StaticResource AtisTextBlockBase}">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <!-- ========================================================= -->
    <!--  TITLE (H2)                                               -->
    <!-- ========================================================= -->

    <Style x:Key="AtisPageSectionTitleTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource AtisTextBlockBase}">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <!-- ========================================================= -->
    <!--  SUBTITLE (H2)                                            -->
    <!-- ========================================================= -->
    <Style x:Key="AtisTextSubtitle" TargetType="TextBlock" BasedOn="{StaticResource AtisTextBlockBase}">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>


    <!-- ========================================================= -->
    <!--  BODY TEXT                                                -->
    <!-- ========================================================= -->
    <Style x:Key="AtisTextBody" TargetType="TextBlock" BasedOn="{StaticResource AtisTextBlockBase}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>


    <!-- ========================================================= -->
    <!--  CAPTION / SMALL TEXT                                     -->
    <!-- ========================================================= -->
    <Style x:Key="AtisTextCaption" TargetType="TextBlock" BasedOn="{StaticResource AtisTextBlockBase}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{ThemeResource AtisTextCaptionBrush}" />
        <Setter Property="Margin" Value="0,0,0,2" />
    </Style>

</ResourceDictionary>




