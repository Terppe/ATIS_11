<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:primitives="using:CommunityToolkit.WinUI.UI.Controls.Primitives"
                    xmlns:toolkit="using:CommunityToolkit.WinUI.UI.Controls">

    <!--  =========================================================  -->
    <!--  1) THEME COLORS (Light + Dark)  -->
    <!--  =========================================================  -->

    <ResourceDictionary.ThemeDictionaries>

        <!--  LIGHT THEME  -->
        <ResourceDictionary x:Key="Light">

            <!--  Header  -->
            <SolidColorBrush x:Key="DataGridHeaderBackgroundBrush"
                             Color="#F3F3F3" />
            <SolidColorBrush x:Key="DataGridHeaderForegroundBrush"
                             Color="#333333" />
            <SolidColorBrush x:Key="DataGridHeaderBorderBrush"
                             Color="#DDDDDD" />

            <!--  Rows  -->
            <SolidColorBrush x:Key="DataGridRowBackgroundBrush"
                             Color="#FFFFFF" />
            <SolidColorBrush x:Key="DataGridRowForegroundBrush"
                             Color="#333333" />
            <SolidColorBrush x:Key="DataGridAlternatingRowBackgroundBrush"
                             Color="#FAFAFA" />

            <!--  Hover  -->
            <SolidColorBrush x:Key="DataGridRowHoverBrush"
                             Color="#11000000" />

            <!--  Selection  -->
            <SolidColorBrush x:Key="DataGridRowSelectionBackgroundBrush"
                             Color="#007ACC" />
            <SolidColorBrush x:Key="DataGridRowSelectionForegroundBrush"
                             Color="#FFFFFF" />

            <!--  GridLines  -->
            <SolidColorBrush x:Key="DataGridGridLinesBrush"
                             Color="#E0E0E0" />
            <SolidColorBrush x:Key="AtisNeutralBorderBrush"
                             Color="#DDDDDD" />

        </ResourceDictionary>

        <!--  DARK THEME  -->
        <ResourceDictionary x:Key="Dark">

            <!--  Header  -->
            <SolidColorBrush x:Key="DataGridHeaderBackgroundBrush"
                             Color="#3A3A3A" />
            <SolidColorBrush x:Key="DataGridHeaderForegroundBrush"
                             Color="#FFFFFF" />
            <SolidColorBrush x:Key="DataGridHeaderBorderBrush"
                             Color="#4A4A4A" />

            <!--  Rows  -->
            <SolidColorBrush x:Key="DataGridRowBackgroundBrush"
                             Color="#1E1E1E" />
            <SolidColorBrush x:Key="DataGridRowForegroundBrush"
                             Color="#E6E6E6" />
            <SolidColorBrush x:Key="DataGridAlternatingRowBackgroundBrush"
                             Color="#262626" />

            <!--  Hover  -->
            <SolidColorBrush x:Key="DataGridRowHoverBrush"
                             Color="#22FFFFFF" />

            <!--  Selection  -->
            <SolidColorBrush x:Key="DataGridRowSelectionBackgroundBrush"
                             Color="#3399FF" />
            <SolidColorBrush x:Key="DataGridRowSelectionForegroundBrush"
                             Color="#FFFFFF" />

            <!--  GridLines  -->
            <SolidColorBrush x:Key="DataGridGridLinesBrush"
                             Color="#3A3A3A" />
            <SolidColorBrush x:Key="AtisNeutralBorderBrush"
                             Color="#3A3A3A" />

        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>


    <!--  =========================================================  -->
    <!--  2) SORT INDICATOR TEMPLATE  -->
    <!--  =========================================================  -->

    <DataTemplate x:Key="AtisDataGridSortIndicatorTemplate">
        <TextBlock VerticalAlignment="Center"
                   FontSize="12"
                   FontWeight="SemiBold"
                   Foreground="{ThemeResource DataGridHeaderForegroundBrush}"
                   Text="{Binding SortDirection, RelativeSource={RelativeSource Mode=TemplatedParent}, Converter={StaticResource EnumToStringConverter}}" />
    </DataTemplate>


    <!--  =========================================================  -->
    <!--  3) HEADER TEMPLATE  -->
    <!--  =========================================================  -->

    <DataTemplate x:Key="AtisDataGridHeaderTemplate">
        <Grid ColumnDefinitions="*,Auto">

            <!--  Header Text  -->
            <TextBlock VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource DataGridHeaderForegroundBrush}"
                       Text="{Binding Header, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                       TextTrimming="CharacterEllipsis" />

            <!--  Sort Indicator  -->
            <ContentPresenter Grid.Column="1"
                              Margin="8,0,0,0"
                              VerticalAlignment="Center"
                              ContentTemplate="{StaticResource AtisDataGridSortIndicatorTemplate}" />

        </Grid>
    </DataTemplate>

    <Style x:Key="AtisDataGridColumnHeaderStyle"
           TargetType="primitives:DataGridColumnHeader">

        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="MinHeight" Value="40" />

        <Setter Property="Background" Value="{ThemeResource DataGridHeaderBackgroundBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource DataGridHeaderForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DataGridHeaderBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,1,1" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="primitives:DataGridColumnHeader">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                        </Grid.ColumnDefinitions>

                        <!--  Header Content  -->
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}" />

                        <!--  Vertical Line  -->
                        <Border Grid.Column="1"
                                Width="1"
                                Background="{TemplateBinding BorderBrush}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

    </Style>

    <!--  =========================================================  -->
    <!--  4) CELL STYLES  -->
    <!--  =========================================================  -->

    <!--  Standard Text Cell  -->
    <Style x:Key="AtisDataGridTextCellStyle"
           TargetType="toolkit:DataGridCell">
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--  Centered Cell  -->
    <Style x:Key="AtisDataGridCenteredCellStyle"
           BasedOn="{StaticResource AtisDataGridTextCellStyle}"
           TargetType="toolkit:DataGridCell">
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <!--  Numeric Cell  -->
    <Style x:Key="AtisDataGridNumericCellStyle"
           BasedOn="{StaticResource AtisDataGridTextCellStyle}"
           TargetType="toolkit:DataGridCell">
        <Setter Property="HorizontalContentAlignment" Value="Right" />
    </Style>

    <!--  =========================================================  -->
    <!--  5) ROW STYLES  -->
    <!--  =========================================================  -->


    <!--  =========================================================  -->
    <!--  6) MAIN DATAGRID STYLE  -->
    <!--  =========================================================  -->

    <Style x:Key="AtisDataGridStyle"
           TargetType="toolkit:DataGrid">

        <!--  Layout  -->
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="GridLinesVisibility" Value="All" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{ThemeResource AtisNeutralBorderBrush}" />

        <!--  GridLines Fix  -->
        <Setter Property="HorizontalGridLinesBrush" Value="{ThemeResource DataGridGridLinesBrush}" />
        <Setter Property="VerticalGridLinesBrush" Value="{ThemeResource DataGridGridLinesBrush}" />

        <!--  Backgrounds  -->
        <Setter Property="Background" Value="{ThemeResource DataGridRowBackgroundBrush}" />
        <Setter Property="RowBackground" Value="{ThemeResource DataGridRowBackgroundBrush}" />
        <Setter Property="AlternatingRowBackground" Value="{ThemeResource DataGridAlternatingRowBackgroundBrush}" />
        <Setter Property="RowForeground" Value="{ThemeResource DataGridRowForegroundBrush}" />

        <!--  Selection  -->
        <Setter Property="SelectionMode" Value="Single" />

        <!--  Header  -->
        <Setter Property="ColumnHeaderHeight" Value="40" />
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource AtisDataGridColumnHeaderStyle}" />

        <!--  Row Height  -->
        <Setter Property="RowHeight" Value="32" />

        <!--  Row Style  -->
        <Setter Property="RowStyle">
            <Setter.Value>
                <Style TargetType="toolkit:DataGridRow">
                    <Setter Property="Padding" Value="12,0" />
                    <Setter Property="Background" Value="{ThemeResource DataGridRowBackgroundBrush}" />
                    <Setter Property="Foreground" Value="{ThemeResource DataGridRowForegroundBrush}" />
                    <Setter Property="BorderBrush" Value="{ThemeResource DataGridGridLinesBrush}" />
                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                </Style>
            </Setter.Value>
        </Setter>

    </Style>

</ResourceDictionary>
