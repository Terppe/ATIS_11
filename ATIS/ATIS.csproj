<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
	<OutputType>WinExe</OutputType>
	<TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
	<TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
	<RootNamespace>ATIS</RootNamespace>
	<ApplicationManifest>app.manifest</ApplicationManifest>
	<Platforms>x64</Platforms>
	<RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
	<PublishProfile>win-$(Platform).pubxml</PublishProfile>
	<UseWinUI>true</UseWinUI>
	<EnableMsixTooling>true</EnableMsixTooling>
	<Nullable>enable</Nullable>
		<TrimMode>partial</TrimMode>
		<SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	<ImplicitUsings>true</ImplicitUsings>
	<LangVersion>Latest</LangVersion>
		<!--Uncomment this to make the app non-packaged.-->
		<WindowsPackageType>None</WindowsPackageType>
		<WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
		<PublishAot>False</PublishAot>

		<IsAotCompatible>False</IsAotCompatible>
	<ApplicationIcon>Assets\icon.ico</ApplicationIcon>
	<Version>10.6.0.2610</Version>

		<!--Remove git hash from assembly informational version in .NET >= 8, Example: false = 1.0.0, true = 1.0.0+xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-->
	<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

	<PublishSingleFile>true</PublishSingleFile>
	<AppendTargetFrameworkToOutputsPathOutputsPath>false</AppendTargetFrameworkToOutputsPathOutputsPath>
	<AppendRuntimeIdentifierTooutputsPath>false</AppendRuntimeIdentifierTooutputsPath>
	</PropertyGroup>

	<!-- Remove Languages without German de-DE, English en-US, French fr-FR, Spanish es-ES -->
	<Target Name="RemoveFoldersWithMuiFilesExceptSomeSpecified" AfterTargets="Build">
		<ItemGroup>
			<RemovingFiles Include="$(OutDir)*\*.mui" Exclude="$(OutDir)de-DE\*.mui; $(OutDir)en-US\*.mui; $(OutDir)fr-FR\*.mui; $(OutDir)es-ES\*.mui" />
			<RemovingFolders Include="@(RemovingFiles->'%(RootDir)%(Directory)')" />
		</ItemGroup>
		<RemoveDir Directories="@(RemovingFolders)" />
	</Target>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Common" Version="8.4.2" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="CommunityToolkit.WinUI.UI.Controls.DataGrid" Version="7.1.2" />
		<PackageReference Include="log4net" Version="3.3.0" />
		<PackageReference Include="MailKit" Version="4.15.1" />
		<PackageReference Include="Mapsui.WinUI" Version="5.0.2" />
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.5" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.5" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.5" />
		<PackageReference Include="Microsoft.Extensions.Localization" Version="10.0.5" />
		<PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.7705" />
		<PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260317003" />
		<PackageReference Include="Microsoft.Xaml.Behaviors.WinUI.Managed" Version="3.0.1" />
		<PackageReference Include="MimeKit" Version="4.15.1" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="nucs.JsonSettings" Version="2.0.2" />
		<PackageReference Include="nucs.JsonSettings.Autosave" Version="2.0.2" />
		<PackageReference Include="QuestPDF" Version="2026.2.4" />
		<PackageReference Include="WinUI3Localizer" Version="2.3.0" />
		<PackageReference Include="WinUICommunity.Components" Version="7.1.0" />
		<PackageReference Include="WinUICommunity.Core" Version="7.1.0" />
		<PackageReference Include="WinUICommunity.LandingPages" Version="7.1.0" />
	</ItemGroup>
	<PropertyGroup Label="Globals">
		<WebView2EnableCsWinRTProjection>False</WebView2EnableCsWinRTProjection>
	</PropertyGroup>

	<PropertyGroup>
		<ExcludeAssetsFromBuild>true</ExcludeAssetsFromBuild>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3856.49" ExcludeAssets="buildTransitive" />
		<PackageReference Include="WinUIEx" Version="2.9.0" />
	</ItemGroup>

	<!--<PropertyGroup>
		--><!-- Unterdrückt Obsolete-Warnungen global NICHT, nur für generierte Dateien --><!--
		<NoWarn>$(NoWarn)</NoWarn>
	</PropertyGroup>-->

	<!--<PropertyGroup Condition="'$(Configuration)'=='Debug'">
			--><!--Debug: keine Filter, alles sichtbar--><!-- 
		 <NoWarn>$(NoWarn)</NoWarn>
	</PropertyGroup>-->

	<ItemGroup>
		 <!-- WinUI generierte XAML TypeInfo-Dateien -->
		 <Compile Update="obj\**\XamlTypeInfo.g.cs">
				<NoWarn>SYSLIB0050;SYSLIB0039;SYSLIB0014</NoWarn>
		 </Compile>
		 <!-- Falls WinUI weitere .g.cs-Dateien erzeugt -->
		 <Compile Update="obj\**\*.g.cs">
				<NoWarn>SYSLIB0050;SYSLIB0039;SYSLIB0014</NoWarn>
		 </Compile>
	</ItemGroup>

	<PropertyGroup Condition="'$(Configuration)'=='Release'">
		 <!-- Release: WinUI-Warnungen ausblenden -->
		 <NoWarn>$(NoWarn);SYSLIB0050;SYSLIB0039;SYSLIB0014</NoWarn>
	</PropertyGroup>
	<ItemGroup Condition="'$(Configuration)'=='Release'">
		 <Compile Update="obj\**\*.g.cs">
				<NoWarn>SYSLIB0050;SYSLIB0039;SYSLIB0014</NoWarn>
		 </Compile>
	</ItemGroup>

	<ItemGroup>
		<Content Include="Strings\**\*.resw">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<!-- Publish Properties -->
	<PropertyGroup>
		<PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
		<PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
		<PublishTrimmed Condition="'$(Configuration)' == 'Debug'">False</PublishTrimmed>
		<PublishTrimmed Condition="'$(Configuration)' != 'Debug'">True</PublishTrimmed>
	</PropertyGroup>

	<!-- Copy all "Resources.resw" files in the "Strings" folder to the output folder. -->
	<ItemGroup>
		<Content Include="Strings\**\*.resw">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>
