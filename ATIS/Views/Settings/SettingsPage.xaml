<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ATIS.Views.Settings.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="850"
            Margin="24"
            HorizontalAlignment="Left"
            Spacing="24">

            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Einstellungen" />

            <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Sprache" />
                <ComboBox
                    x:Name="LanguageBox"
                    MinWidth="240"
                    Header="Anwendungssprache">
                    <ComboBoxItem Content="Deutsch" Tag="de-DE" />
                    <ComboBoxItem Content="English" Tag="en-US" />
                    <ComboBoxItem Content="Français" Tag="fr-FR" />
                    <ComboBoxItem Content="Español" Tag="es-ES" />
                </ComboBox>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Darstellung" />
                <ComboBox
                    x:Name="ThemeBox"
                    MinWidth="240"
                    Header="App-Design">
                    <ComboBoxItem Content="Systemeinstellung" Tag="Default" />
                    <ComboBoxItem Content="Hell" Tag="Light" />
                    <ComboBoxItem Content="Dunkel" Tag="Dark" />
                </ComboBox>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Datenbank" />
                <ComboBox
                    x:Name="ServerBox"
                    Header="SQL-Server"
                    PlaceholderText="Installierten SQL-Server auswählen"
                    SelectionChanged="ServerBox_SelectionChanged" />
                <Button
                    x:Name="RefreshServersButton"
                    Click="RefreshServersButton_Click"
                    Content="Serverliste aktualisieren" />
                <Button
                    x:Name="TestConnectionButton"
                    Content="Verbindung testen"
                    IsEnabled="False" />

                <Button
                    x:Name="SaveServerButton"
                    Content="Server speichern"
                    IsEnabled="False" />

                <TextBlock
                    x:Name="ConnectionStatusText"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />

                <TextBlock
                    x:Name="RestartRequiredText"
                    Text="Änderung wird nach einem Neustart wirksam. Bis dahin verwendet ATIS weiterhin den bisherigen SQL-Server."
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Updates" />

                <ToggleSwitch x:Name="AutomaticUpdates" Header="Beim Start nach Updates suchen" />

                <Button
                    x:Name="CheckUpdatesButton"
                    Click="CheckUpdatesButton_Click"
                    Content="Jetzt nach Updates suchen" />

                <TextBlock
                    x:Name="UpdateStatusText"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="Diagnose und Support" />

                <Button
                    Content="Aktuelles Protokoll anzeigen"
                    Click="ShowLogFileButton_Click" />
                <Button
                    Content="Diagnoseinformationen kopieren"
                    Click="CopyDiagnosticsButton_Click" />

                <TextBlock
                    Text="Die Diagnose enthält Versions- und Serverangaben, aber keine Passwörter oder Protokollinhalte."
                    TextWrapping="Wrap" />

                <TextBlock
                    x:Name="DiagnosticsStatusText"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Über ATIS" />
                <TextBlock x:Name="VersionText" Text="ATIS" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
