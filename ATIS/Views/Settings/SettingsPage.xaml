<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="ATIS.Views.Settings.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="using:ATIS"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:settings="using:ATIS.Views.Settings"
      xmlns:wuc="using:WinUICommunity"
      mc:Ignorable="d">
    <ScrollView Margin="{ThemeResource ContentPageMargin}"
                HorizontalAlignment="Stretch"
                VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10"
                    wuc:PanelAttach.ChildrenTransitions="Default"
                    Spacing="5">
            <wuc:SettingsCard wuc:NavigationHelperEx.NavigateToSetting="settings:GeneralSettingPage"
                              Description="Change your app Settings"
                              Header="General"
                              HeaderIcon="{wuc:BitmapIcon Source=Assets/Fluent/settings.png}"
                              IsClickEnabled="True" />
            <wuc:SettingsCard wuc:NavigationHelperEx.NavigateToSetting="settings:ThemeSettingPage"
                              Description="Explore the different ways to customize the appearance and behavior of your app. You can change the material, theme, accent, and more options to suit your style and preference."
                              Header="Appearance &amp; behavior"
                              HeaderIcon="{wuc:BitmapIcon Source=Assets/Fluent/theme.png}"
                              IsClickEnabled="True" />
            <wuc:SettingsCard wuc:NavigationHelperEx.NavigateToSetting="settings:AppUpdateSettingPage"
                              Description="Check for Updates"
                              Header="Update App"
                              HeaderIcon="{wuc:BitmapIcon Source=Assets/Fluent/update.png}"
                              IsClickEnabled="True" />
            <wuc:SettingsCard wuc:NavigationHelperEx.NavigateToSetting="settings:GitUpdateSettingPage"
                              Description="Check for Updates from Git"
                              Header="Git Update App"
                              HeaderIcon="{wuc:BitmapIcon Source=Assets/Fluent/update.png}"
                              IsClickEnabled="True" />
            <wuc:SettingsCard wuc:NavigationHelperEx.NavigateToSetting="settings:SqlConnectionSettingPage"
                              Description="Configure the database connection string."
                              Header="Database Connection"
                              HeaderIcon="{wuc:BitmapIcon Source=Assets/Fluent/info.png}"
                              IsClickEnabled="True" />
            <wuc:SettingsCard wuc:NavigationHelperEx.NavigateToSetting="settings:AboutUsSettingPage"
                              Description="About ATIS and Developer"
                              Header="About us"
                              HeaderIcon="{wuc:BitmapIcon Source=Assets/Fluent/info.png}"
                              IsClickEnabled="True" />

        </StackPanel>
    </ScrollView>
</Page>

