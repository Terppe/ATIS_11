<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="ATIS.Views.Auth.ChangePasswordView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:WinUI3Localizer">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///DesignSystem/Controls/TextBox/PasswordBoxFocusResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>


    <StackPanel
        Width="420"
        Padding="24"
        Spacing="12">
        <TextBlock loc:Uids.Uid="TextBlock_Email" />

        <TextBox
            InputScope="EmailSmtpAddress" Margin="0,-20,0,0"
            IsSpellCheckEnabled="False"
            IsTextPredictionEnabled="False"
            Style="{StaticResource AtisTextBox}"
            Text="{x:Bind ViewModel.Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock loc:Uids.Uid="TextBlock_Current_Password" />
        <PasswordBox x:Name="OldPwdBox" Style="{StaticResource AtisPasswordBox}" />

        <TextBlock loc:Uids.Uid="TextBlock_New_Password" />
        <PasswordBox x:Name="NewPwdBox" Style="{StaticResource AtisPasswordBox}" />

        <Button
            loc:Uids.Uid="Button_Change_Password"
            Click="ChangeButton_Click"
            Style="{StaticResource AtisSecondaryButtonFocus}" />
        <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />

        <TextBlock
            Foreground="OrangeRed"
            Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            TextWrapping="Wrap" />
        <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
