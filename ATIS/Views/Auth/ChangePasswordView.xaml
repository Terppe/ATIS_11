<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ATIS.Views.Auth.ChangePasswordView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Width="420" Spacing="12" Padding="24">
        <TextBlock Text="E-Mail"/>
        <TextBox Text="{x:Bind ViewModel.Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Text="Aktuelles Passwort"/>
        <PasswordBox x:Name="OldPwdBox"/>

        <TextBlock Text="Neues Passwort"/>
        <PasswordBox x:Name="NewPwdBox"/>

        <Button Content="Passwort ändern" Click="ChangeButton_Click"/>
        <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"/>

        <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Foreground="OrangeRed" TextWrapping="Wrap"/>
        <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" TextWrapping="Wrap"/>
    </StackPanel>
</UserControl>
