<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="ATIS.Views.Auth.ChangePasswordView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:WinUI3Localizer">
    <StackPanel
        Width="420"
        Padding="24"
        Spacing="12">
        <TextBlock loc:Uids.Uid="TextBlock_Email" />
        <TextBox Text="{x:Bind ViewModel.Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock loc:Uids.Uid="TextBlock_Current_Password" />
        <PasswordBox x:Name="OldPwdBox" />

        <TextBlock loc:Uids.Uid="TextBlock_New_Password" />
        <PasswordBox x:Name="NewPwdBox" />

        <Button loc:Uids.Uid="Button_Change_Password" Click="ChangeButton_Click" />
        <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />

        <TextBlock
            Foreground="OrangeRed"
            Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            TextWrapping="Wrap" />
        <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
