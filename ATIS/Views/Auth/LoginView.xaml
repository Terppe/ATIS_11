<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="ATIS.Views.Auth.LoginView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="using:WinUI3Localizer"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///DesignSystem/Controls/TextBox/PasswordBoxFocusResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid
        Width="420"
        MinHeight="320"
        Padding="24">
        <StackPanel Spacing="12">

            <TextBlock loc:Uids.Uid="TextBlock_Email" />
            <TextBox
                InputScope="EmailSmtpAddress"
                IsSpellCheckEnabled="False"
                IsTextPredictionEnabled="False"
                Style="{StaticResource AtisTextBox}"
                Text="{x:Bind ViewModel.Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock loc:Uids.Uid="TextBlock_Password" />
            <!--<PasswordBox x:Name="PwdBox" Style="{StaticResource AtisPasswordBox}" />-->

            <!--<PasswordBox
            x:Name="PwdBox"
            Style="{StaticResource AtisPasswordBox}">

            <PasswordBox.Resources>
            <SolidColorBrush
            x:Key="TextControlBackgroundFocused"
            Color="{ThemeResource SolidBackgroundFillColorSecondary}" />
            </PasswordBox.Resources>
            </PasswordBox>-->

            <PasswordBox x:Name="PwdBox" Style="{StaticResource AtisPasswordBox}" />

            <Button
                loc:Uids.Uid="Button_Login"
                Click="LoginButton_Click"
                IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource InverseBooleanConverter}}"
                Style="{StaticResource AtisSecondaryButtonFocus}" />

            <!--<Button
            loc:Uids.Uid="Button_Login"
            Click="LoginButton_Click"
            IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource InverseBooleanConverter}}"
            Style="{StaticResource AtisSecondaryButton}"
            UseSystemFocusVisuals="True"
            FocusVisualPrimaryThickness="2"
            FocusVisualSecondaryThickness="0">
            <Button.FocusVisualPrimaryBrush>
            <SolidColorBrush Color="#0067C0" />
            </Button.FocusVisualPrimaryBrush>
            </Button>-->

            <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />

            <TextBlock
                Foreground="OrangeRed"
                Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                TextWrapping="Wrap" />
            <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
