<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="ATIS.Views.Auth.RegisterView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:WinUI3Localizer">

    <Grid
        Width="420"
        MinHeight="380"
        Padding="24">
        <StackPanel Spacing="12">

            <TextBlock loc:Uids.Uid="TextBlock_Email" />
            <TextBox Text="{x:Bind ViewModel.Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock loc:Uids.Uid="TextBlock_Password" />
            <PasswordBox x:Name="PwdBox" />

            <TextBlock loc:Uids.Uid="TextBlock_Confirm_Password" />
            <PasswordBox x:Name="ConfirmPwdBox" />

            <Button
                loc:Uids.Uid="Button_Register"
                Click="RegisterButton_Click"
                IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource InverseBooleanConverter}}" />

            <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />

            <TextBlock
                Foreground="OrangeRed"
                Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                TextWrapping="Wrap" />
            <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
