<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="ATIS.Views.Auth.RegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Width="420"
          MinHeight="380"
          Padding="24">
        <StackPanel Spacing="12">
            <TextBlock FontSize="24"
                       FontWeight="SemiBold"
                       Text="REGISTER" />

            <TextBlock Text="E-Mail" />
            <TextBox Text="{x:Bind ViewModel.Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <!--<TextBlock Text="Vorname" />
            <TextBox Text="{x:Bind ViewModel.FirstName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Nachname" />
            <TextBox Text="{x:Bind ViewModel.LastName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />-->

            <TextBlock Text="Passwort" />
            <PasswordBox x:Name="PwdBox" />

            <TextBlock Text="Passwort wiederholen" />
            <PasswordBox x:Name="ConfirmPwdBox" />

            <Button Click="RegisterButton_Click"
                    Content="Registrieren"
                    IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource InverseBooleanConverter}}" />

            <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />

            <TextBlock Foreground="OrangeRed"
                       Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                       TextWrapping="Wrap" />
            <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                       TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
