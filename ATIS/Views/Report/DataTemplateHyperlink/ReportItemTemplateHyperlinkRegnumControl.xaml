<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="ATIS.Views.Report.DataTemplateHyperlink.ReportItemTemplateHyperlinkRegnumControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel>
            <TextBlock x:Uid="TextBlock_Regnum"
                       Width="Auto"
                       Margin="8,0,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="1"
                    Orientation="Horizontal">
            <!--<TextBlock Width="Auto">
            <Hyperlink>
            <Hyperlink.Inlines>
            <Run Text="{Binding RegnumName}" />
            <Run Text="" />
            <Run Text="{Binding Subregnum}" />
            </Hyperlink.Inlines>
            </Hyperlink>
            </TextBlock>-->
            <RelativePanel>
                <TextBlock x:Name="TbRegnum"
                           Width="Auto"
                           Foreground="DarkBlue"
                           Tag="{Binding RegnumId}"
                           Tapped="TextBlock_Tapped"
                           Text="{Binding RegnumName}"
                           TextDecorations="Underline" />
                <TextBlock Margin="2,0,0,0"
                           Foreground="DarkBlue"
                           RelativePanel.RightOf="TbRegnum"
                           Text="{Binding Subregnum}"
                           TextDecorations="Underline" />
            </RelativePanel>
            <TextBlock Margin="2,0,0,0"
                       Text="{Binding EngName}" />
            <TextBlock Margin="2,0,0,0"
                       Text="{Binding GerName}" />
            <TextBlock Margin="2,0,0,0"
                       Text="{Binding FraName}" />
            <TextBlock Margin="2,0,0,0"
                       Text="{Binding PorName}" />
        </StackPanel>
    </Grid>
</UserControl>
