            <Run Text="" />
            <Run Text="{Binding FiSpeciesName}" />
            -->
            <!--<Run Text="" />
            <Run Text="{x:Bind Subspecies}" />
            <Run Text="" />
            <Run Text="{x:Bind Divers}" />-->
            <!--
            </Hyperlink.Inlines>
            </Hyperlink>
            </TextBlock>-->
            <!--<TextBlock
            x:Name="TbFiSpecies"
            Width="Auto"
            Foreground="DarkBlue"
            Tag="{Binding FiSpeciesId}"
            Tapped="TextBlock_Tapped2"
            Text="{Binding FiSpeciesName}"
            TextDecorations="Underline" />-->
            <RelativePanel>
                <TextBlock x:Name="TbSpecies"
                           Width="Auto"
                           Foreground="DarkBlue"
                           Tag="{Binding FiSpeciesId}"
                           Tapped="TextBlock_Tapped"
                           Text="{Binding Tbl66Genusses.GenusName}"
                           TextDecorations="Underline" />
                <TextBlock Margin="2,0,0,0"
                           Foreground="DarkBlue"
                           RelativePanel.RightOf="TbSpecies"
                           Text="{Binding FiSpeciesName}"
                           TextDecorations="Underline" />
            </RelativePanel>
            <TextBlock Margin="2,0,0,0"
                       Text="{Binding Author}" />
            <TextBlock Margin="2,0,0,0"
                       Text="{Binding AuthorYear}" />
        </StackPanel>
    </Grid>
