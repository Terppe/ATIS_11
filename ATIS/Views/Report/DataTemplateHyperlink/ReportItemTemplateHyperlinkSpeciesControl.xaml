        </Grid.ColumnDefinitions>
        <StackPanel>
            <TextBlock x:Uid="TextBlock_Species"
                       Width="Auto"
                       Margin="168,0,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="1"
                    Orientation="Horizontal">
