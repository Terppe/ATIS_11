<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="ATIS.Views.Report.DataTemplateHyperlink.ReportItemTemplateHyperlinkSubfamilyControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loca="using:WinUI3Localizer"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel>
            <TextBlock Width="Auto"
                       Margin="112,0,0,0"
                       loca:Uids.Uid="TextBlock_Subfamily" />
        </StackPanel>
        <StackPanel Grid.Column="1"
                    Orientation="Horizontal">
            <TextBlock x:Name="TbSubfamily"
                       Width="Auto"
                       Foreground="DarkBlue"
                       Tag="{Binding SubfamilyId}"
                       Tapped="TextBlock_Tapped"
                       Text="{Binding SubfamilyName}"
                       TextDecorations="Underline" />
            <TextBlock Margin="2,0,0,0"
                       Text="{Binding EngName}" />
            <TextBlock Margin="2,0,0,0"
                       Text="{Binding GerName}" />
            <TextBlock Margin="2,0,0,0"
                       Text="{Binding FraName}" />
            <TextBlock Margin="2,0,0,0"
                       Text="{Binding PorName}" />
        </StackPanel>
    </Grid>
</UserControl>
