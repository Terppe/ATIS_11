<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="ATIS.Views.Report.DataTemplateHyperlink.TemplateTbl39InfraordoWithOptionalHyperlinkControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loca="using:WinUI3Localizer"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel>
            <TextBlock Margin="{Binding HeaderMargin}"
                       loca:Uids.Uid="TextBlock_Infraordo" />
        </StackPanel>

        <Grid Grid.Column="1">
            <!--  Hyperlink-Variante  -->
            <Grid x:Name="HyperlinkPanel">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TbInfraordo"
                           Grid.Column="0"
                           Foreground="DarkBlue"
                           Tag="{Binding Item.InfraordoId, Mode=OneWay}"
                           Tapped="TextBlock_Tapped"
                           Text="{Binding Item.InfraordoName, Mode=OneWay}"
                           TextDecorations="Underline" />

                <TextBlock x:Name="TbAuthorDisplay"
                           Grid.Column="1"
                           Margin="4,0,0,0" />

                <TextBlock x:Name="TbLanguageNamesDisplay"
                           Grid.Column="2"
                           Margin="4,0,0,0"
                           TextWrapping="WrapWholeWords" />
            </Grid>

            <!-- Plain-Text-Variante (überlagert, standardmäßig aus) -->
            <TextBlock x:Name="TbInfraordoLine"
                       Margin="0"
                       Padding="0"
                       TextWrapping="WrapWholeWords"
                       Visibility="Collapsed" />

        </Grid>

    </Grid>
</UserControl>     
