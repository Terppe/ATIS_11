            Padding="0" />-->

            <!--<TextBlock x:Name="TbLanguageNamesDisplay"
            Margin="4,0,0,0"
            Padding="0" />-->

            <TextBlock x:Name="TbRegnumLine"
                       TextWrapping="WrapWholeWords"
                       Visibility="Collapsed" />
        </Grid>

