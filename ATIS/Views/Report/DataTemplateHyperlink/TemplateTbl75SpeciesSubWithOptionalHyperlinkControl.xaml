<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="ATIS.Views.Report.DataTemplateHyperlink.TemplateTbl75SpeciesSubWithOptionalHyperlinkControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loca="using:WinUI3Localizer"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel>
            <TextBlock Width="Auto"
                       Margin="176,0,0,0"
                       loca:Uids.Uid="TextBlock_Subspecies" />
        </StackPanel>
        <StackPanel Grid.Column="1"
                    Orientation="Horizontal">
            <!--<TextBlock Width="Auto">
            <Hyperlink>
            <Hyperlink.Inlines>
            <Run Text="{Binding Tbl66Genusses.GenusName}" />
            <Run Text="" />
            <Run Text="{Binding SpeciesName}" />
            <Run Text="" />
            <Run Text="{Binding Subspecies}" />
            <Run Text="" />
            <Run Text="{Binding Divers}" />
            </Hyperlink.Inlines>
            </Hyperlink>
            </TextBlock>-->
            <RelativePanel>
                <TextBlock x:Name="TbSpecies"
                           Width="Auto"
                           Text="{Binding Tbl66Genusses.GenusName}" />
                <TextBlock x:Name="TbSpeciesName"
                           Margin="2,0,0,0"
                           RelativePanel.RightOf="TbSpecies"
                           Text="{Binding SpeciesName}" />
                <TextBlock x:Name="TbSubspecies"
                           Margin="2,0,0,0"
                           RelativePanel.RightOf="TbSpeciesName"
                           Text="{Binding Subspecies}" />
                <TextBlock Margin="2,0,0,0"
                           RelativePanel.RightOf="TbSubspecies"
                           Text="{Binding Divers}" />
            </RelativePanel>

            <TextBlock Margin="2,0,0,0"
                       Text="{Binding Author}" />
            <TextBlock Margin="2,0,0,0"
                       Text="{Binding AuthorYear}" />
        </StackPanel>
    </Grid>
</UserControl>
