<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="ATIS.Views.Report.DataTemplateHeaderTaxoNomen.ReportItemTemplateHeaderTaxoNomenHeaderControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="using:WinUI3Localizer"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Column="0"
                    Grid.ColumnSpan="2">
            <TextBlock loc:Uids.Uid="TextBlock_TaxonomyAndNomenclatura"
                       FontSize="18"
                       FontWeight="Bold" />
        </StackPanel>
        <StackPanel Grid.Row="1"
                    Grid.Column="0">
            <TextBlock Margin="8,0,0,0"
                       loc:Uids.Uid="TextBlock_Kingdom" />
        </StackPanel>
        <StackPanel Grid.Row="1"
                    Grid.Column="1"
                    Orientation="Horizontal">
            <TextBlock Width="Auto"
                       Text="{Binding RegnumName}" />
            <TextBlock Width="Auto"
                       Margin="2,0,0,0"
                       Text="{Binding Subregnum}" />
        </StackPanel>
    </Grid>
</UserControl>
