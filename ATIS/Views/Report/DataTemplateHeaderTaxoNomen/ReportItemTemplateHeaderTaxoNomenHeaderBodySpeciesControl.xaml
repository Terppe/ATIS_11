<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="ATIS.Views.Report.DataTemplateHeaderTaxoNomen.ReportItemTemplateHeaderTaxoNomenHeaderBodySpeciesControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loca="using:WinUI3Localizer"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="1"
                    Grid.Column="0">
            <TextBlock Margin="8,0,0,0"
                       loca:Uids.Uid="TextBlock_TaxonomicStatus"
                       FontWeight="Bold" />
        </StackPanel>
        <StackPanel Grid.Row="2"
                    Grid.Column="0">
            <TextBlock Margin="8,0,0,0"
                       loca:Uids.Uid="TextBlock_CurrentStanding" />
        </StackPanel>
        <StackPanel Grid.Row="2"
                    Grid.Column="1"
                    Orientation="Horizontal">
            <TextBlock Width="Auto"
                       Text="{Binding Valid}" />
            <TextBlock Width="Auto"
                       Margin="2,0,0,0"
                       Text="{Binding ValidYear}" />
        </StackPanel>
        <StackPanel Grid.Row="3"
                    Grid.Column="0">
            <TextBlock Margin="8,0,0,0"
                       loca:Uids.Uid="TextBlock_DataQualityIndicator"
                       FontWeight="Bold" />
        </StackPanel>
        <StackPanel Grid.Row="4"
                    Grid.Column="0">
            <TextBlock Margin="8,0,0,0"
                       loca:Uids.Uid="TextBlock_RecordCredibilityRating" />
        </StackPanel>
        <StackPanel Grid.Row="5"
                    Grid.Column="0">
            <TextBlock Margin="8,0,0,0"
                       loca:Uids.Uid="TextBlock_RecordUpdate" />
        </StackPanel>
        <StackPanel Grid.Row="5"
                    Grid.Column="1">
            <TextBlock Text="{Binding UpdaterDate}" />
        </StackPanel>
        <StackPanel Grid.Row="6"
                    Grid.Column="0">
            <TextBlock Margin="8,0,0,0"
                       loca:Uids.Uid="TextBlock_TradeName" />
        </StackPanel>
        <StackPanel Grid.Row="6"
                    Grid.Column="1">
            <TextBlock Text="{Binding TradeName}"
                       TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Row="9"
                    Grid.Column="0">
            <TextBlock Margin="8,0,0,0"
                       loca:Uids.Uid="TextBlock_MemoSpecies" />
        </StackPanel>
        <StackPanel Grid.Row="9"
                    Grid.Column="1">
            <TextBlock Text="{Binding MemoSpecies}"
                       TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Row="10"
                    Grid.Column="0">
            <TextBlock Margin="8,0,0,0"
                       loca:Uids.Uid="TextBlock_Importer" />
        </StackPanel>
        <StackPanel Grid.Row="10"
                    Grid.Column="1">
            <TextBlock Text="{Binding Importer}"
                       TextWrapping="Wrap" />
        </StackPanel>
        <!--<StackPanel Grid.Row="11" Grid.Column="0">
            <TextBlock loca:Uids.Uid="TextBlock_LNummer" Margin="8,0,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="11" Grid.Column="1">
            <TextBlock Text="{Binding LNumber}" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Row="12" Grid.Column="0">
            <TextBlock loca:Uids.Uid="TextBlock_LDANummer" Margin="8,0,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="12" Grid.Column="1">
            <TextBlock Text="{Binding LdaNumber}" TextWrapping="Wrap" />
        </StackPanel>-->
        <StackPanel x:Name="Sp1BasinLength"
                    Grid.Row="13"
                    Grid.Column="0">
            <TextBlock Margin="8,0,0,0"
                       loca:Uids.Uid="TextBlock_BasinLength" />
        </StackPanel>
        <StackPanel x:Name="Sp2BasinLength"
                    Grid.Row="13"
                    Grid.Column="1">
            <TextBlock x:Name="Tb2BasinLength"
                       Text="{Binding BasinLength}"
                       TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel x:Name="Sp1BasinHeight"
                    Grid.Row="14"
                    Grid.Column="0">
            <TextBlock Margin="8,0,0,0"
                       loca:Uids.Uid="TextBlock_BasinHeight" />
        </StackPanel>
        <StackPanel x:Name="Sp2BasinHeight"
                    Grid.Row="14"
                    Grid.Column="1">
            <TextBlock x:Name="Tb2BasinHeight"
                       Text="{Binding BasinLength}"
                       TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Row="15"
                    Grid.Column="0">
            <TextBlock Margin="8,0,0,0"
                       loca:Uids.Uid="TextBlock_FishLength" />
        </StackPanel>
        <StackPanel Grid.Row="15"
                    Grid.Column="1">
            <TextBlock Text="{Binding FishLength}"
                       TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Row="16"
                    Grid.Column="0">
            <TextBlock Margin="8,0,0,0"
                       loca:Uids.Uid="TextBlock_PlantLength" />
        </StackPanel>
        <StackPanel Grid.Row="16"
                    Grid.Column="1">
            <TextBlock Text="{Binding PlantLength}"
                       TextWrapping="Wrap" />
        </StackPanel>
        <!--<StackPanel Grid.Row="17" Grid.Column="0">
            <TextBlock loca:Uids.Uid="TextBlock_MemoSpecial" Margin="8,0,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="17" Grid.Column="1">
            <TextBlock Text="{Binding MemoSpecial}" TextWrapping="Wrap" />
        </StackPanel>-->
    </Grid>
</UserControl>
