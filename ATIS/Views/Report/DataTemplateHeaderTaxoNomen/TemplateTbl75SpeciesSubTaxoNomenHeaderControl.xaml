<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="ATIS.Views.Report.DataTemplateHeaderTaxoNomen.TemplateTbl75SpeciesSubTaxoNomenHeaderControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="using:WinUI3Localizer"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:dataTemplateHeaderTaxoNomen="using:ATIS.Views.Report.DataTemplateHeaderTaxoNomen"
             mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Column="0">
            <TextBlock Margin="8,0,0,0"
                       loc:Uids.Uid="TextBlock_TaxonomicRank" />
        </StackPanel>

        <StackPanel Grid.Row="0"
                    Grid.Column="1">
            <TextBlock Width="Auto"
                       loc:Uids.Uid="TextBlock_Subspecies" />
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Grid.Column="0">
            <TextBlock Margin="8,0,0,0"
                       loc:Uids.Uid="TextBlock_SynonymsReport" />
        </StackPanel>

        <dataTemplateHeaderTaxoNomen:TemplateTbl75SpeciesSynonymsControl
            Grid.Row="1"
            Grid.Column="1"
            Species="{Binding Item}" />

        <StackPanel Grid.Row="2"
                    Grid.Column="0">
            <TextBlock Margin="8,0,0,0"
                       loc:Uids.Uid="TextBlock_NamesReport" />
        </StackPanel>

        <dataTemplateHeaderTaxoNomen:TemplateTbl75SpeciesNamesControl
            Grid.Row="2"
            Grid.Column="1"
            Species="{Binding Item}" />

        <StackPanel Grid.Row="3"
                    Grid.Column="0">
            <TextBlock Margin="8,0,0,0"
                       loc:Uids.Uid="TextBlock_TaxonomicStatus"
                       FontWeight="Bold" />
        </StackPanel>
        <StackPanel Grid.Row="4"
                    Grid.Column="0">
            <TextBlock Margin="8,0,0,0"
                       loc:Uids.Uid="TextBlock_CurrentStanding" />
        </StackPanel>
        <StackPanel Grid.Row="4"
                    Grid.Column="1">
            <TextBlock x:Name="ValidityTextBlock" />
        </StackPanel>

        <StackPanel Grid.Row="5"
                    Grid.Column="0">
            <TextBlock Margin="8,0,0,0"
                       loc:Uids.Uid="TextBlock_DataQualityIndicator"
                       FontWeight="Bold" />
        </StackPanel>
        <StackPanel Grid.Row="6"
                    Grid.Column="0">
            <TextBlock Margin="8,0,0,0"
                       loc:Uids.Uid="TextBlock_RecordCredibilityRating" />
        </StackPanel>
        <StackPanel Grid.Row="7"
                    Grid.Column="0">
            <TextBlock Margin="8,0,0,0"
                       loc:Uids.Uid="TextBlock_RecordUpdate" />
        </StackPanel>
        <StackPanel Grid.Row="7"
                    Grid.Column="1">
            <TextBlock Text="{Binding Item.UpdaterDate}" />
        </StackPanel>
        <StackPanel Grid.Row="8"
                    Grid.Column="0">
            <TextBlock Margin="8,0,0,0"
                       loc:Uids.Uid="TextBlock_TradeName" />
        </StackPanel>
        <StackPanel Grid.Row="8"
                    Grid.Column="1">
            <TextBlock Text="{Binding Item.TradeName}"
                       TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Row="9"
                    Grid.Column="0">
            <TextBlock Margin="8,0,0,0"
                       loc:Uids.Uid="TextBlock_MemoSpecies" />
        </StackPanel>
        <StackPanel Grid.Row="9"
                    Grid.Column="1">
            <TextBlock Text="{Binding Item.MemoSpecies}"
                       TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Row="10"
                    Grid.Column="0">
            <TextBlock Margin="8,0,0,0"
                       loc:Uids.Uid="TextBlock_Importer" />
        </StackPanel>
        <StackPanel Grid.Row="10"
                    Grid.Column="1">
            <TextBlock Text="{Binding Item.Importer}"
                       TextWrapping="Wrap" />
        </StackPanel>
        <!--<StackPanel Grid.Row="11" Grid.Column="0">
        <TextBlock loc:Uids.Uid="TextBlock_LNummer" Margin="8,0,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="11" Grid.Column="1">
        <TextBlock Text="{Binding LNumber}" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Row="12" Grid.Column="0">
        <TextBlock loc:Uids.Uid="TextBlock_LDANummer" Margin="8,0,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="12" Grid.Column="1">
        <TextBlock Text="{Binding LdaNumber}" TextWrapping="Wrap" />
        </StackPanel>-->
        <StackPanel x:Name="Sp1BasinLength"
                    Grid.Row="13"
                    Grid.Column="0">
            <TextBlock Margin="8,0,0,0"
                       loc:Uids.Uid="TextBlock_BasinLength" />
        </StackPanel>
        <StackPanel x:Name="Sp2BasinLength"
                    Grid.Row="13"
                    Grid.Column="1">
            <TextBlock x:Name="Tb2BasinLength"
                       Text="{Binding Item.BasinLength}"
                       TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel x:Name="Sp1BasinHeight"
                    Grid.Row="14"
                    Grid.Column="0">
            <TextBlock Margin="8,0,0,0"
                       loc:Uids.Uid="TextBlock_BasinHeight" />
        </StackPanel>
        <StackPanel x:Name="Sp2BasinHeight"
                    Grid.Row="14"
                    Grid.Column="1">
            <TextBlock x:Name="Tb2BasinHeight"
                       Text="{Binding Item.BasinLength}"
                       TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Row="15"
                    Grid.Column="0">
            <TextBlock Margin="8,0,0,0"
                       loc:Uids.Uid="TextBlock_FishLength" />
        </StackPanel>
        <StackPanel Grid.Row="15"
                    Grid.Column="1">
            <TextBlock Text="{Binding Item.FishLength}"
                       TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Row="16"
                    Grid.Column="0">
            <TextBlock Margin="8,0,0,0"
                       loc:Uids.Uid="TextBlock_PlantLength" />
        </StackPanel>
        <StackPanel Grid.Row="16"
                    Grid.Column="1">
            <TextBlock Text="{Binding Item.PlantLength}"
                       TextWrapping="Wrap" />
        </StackPanel>
        <!--<StackPanel Grid.Row="17" Grid.Column="0">
        <TextBlock loc:Uids.Uid="TextBlock_MemoSpecial" Margin="8,0,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="17" Grid.Column="1">
        <TextBlock Text="{Binding MemoSpecial}" TextWrapping="Wrap" />
        </StackPanel>-->
    </Grid>
</UserControl>
