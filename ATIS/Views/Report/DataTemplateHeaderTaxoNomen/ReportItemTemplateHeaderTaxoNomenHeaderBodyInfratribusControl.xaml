<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="ATIS.Views.Report.DataTemplateHeaderTaxoNomen.ReportItemTemplateHeaderTaxoNomenHeaderBodyInfratribusControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loca="using:WinUI3Localizer"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Column="0">
            <TextBlock Margin="8,0,0,0"
                       loca:Uids.Uid="TextBlock_TaxonomicRank" />
        </StackPanel>
        <StackPanel Grid.Row="0"
                    Grid.Column="1">
            <TextBlock Width="Auto"
                       loca:Uids.Uid="TextBlock_Infratribus" />
        </StackPanel>
        <StackPanel Grid.Row="1"
                    Grid.Column="0">
            <TextBlock Margin="8,0,0,0"
                       loca:Uids.Uid="TextBlock_SynonymsReport" />
        </StackPanel>
        <StackPanel Grid.Row="1"
                    Grid.Column="1">
            <TextBlock Width="Auto"
                       Text="{Binding Synonym}"
                       TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Row="2"
                    Grid.Column="0">
            <TextBlock Margin="8,0,0,0"
                       loca:Uids.Uid="TextBlock_NamesReport" />
        </StackPanel>
        <StackPanel Grid.Row="2"
                    Grid.Column="1"
                    Orientation="Horizontal">
            <TextBlock Width="Auto"
                       Text="{Binding EngName}" />
            <TextBlock Width="Auto"
                       Margin="2,0,0,0"
                       Text="{Binding GerName}" />
            <TextBlock Width="Auto"
                       Margin="2,0,0,0"
                       Text="{Binding FraName}" />
            <TextBlock Width="Auto"
                       Margin="2,0,0,0"
                       Text="{Binding PorName}" />
        </StackPanel>
        <StackPanel Grid.Row="3"
                    Grid.Column="0">
            <TextBlock Margin="8,0,0,0"
                       loca:Uids.Uid="TextBlock_TaxonomicStatus"
                       FontWeight="Bold" />
        </StackPanel>
        <StackPanel Grid.Row="4"
                    Grid.Column="0">
            <TextBlock Margin="8,0,0,0"
                       loca:Uids.Uid="TextBlock_CurrentStanding" />
        </StackPanel>
        <StackPanel Grid.Row="4"
                    Grid.Column="1"
                    Orientation="Horizontal">
            <TextBlock Width="Auto"
                       Text="{Binding Valid}" />
            <TextBlock Width="Auto"
                       Margin="2,0,0,0"
                       Text="{Binding ValidYear}" />
        </StackPanel>
        <StackPanel Grid.Row="5"
                    Grid.Column="0">
            <TextBlock Margin="8,0,0,0"
                       loca:Uids.Uid="TextBlock_DataQualityIndicator"
                       FontWeight="Bold" />
        </StackPanel>
        <StackPanel Grid.Row="6"
                    Grid.Column="0">
            <TextBlock Margin="8,0,0,0"
                       loca:Uids.Uid="TextBlock_RecordCredibilityRating" />
        </StackPanel>
        <StackPanel Grid.Row="7"
                    Grid.Column="0">
            <TextBlock Margin="8,0,0,0"
                       loca:Uids.Uid="TextBlock_RecordUpdate" />
        </StackPanel>
        <StackPanel Grid.Row="7"
                    Grid.Column="1">
            <TextBlock Text="{Binding UpdaterDate}" />
        </StackPanel>
        <StackPanel Grid.Row="8"
                    Grid.Column="0">
            <TextBlock Margin="8,0,0,0"
                       loca:Uids.Uid="TextBlock_Info" />
        </StackPanel>
        <StackPanel Grid.Row="8"
                    Grid.Column="1">
            <TextBlock Text="{Binding Info}"
                       TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Row="9"
                    Grid.Column="0">
            <TextBlock Margin="8,0,0,0"
                       loca:Uids.Uid="TextBlock_Memo" />
        </StackPanel>
        <StackPanel Grid.Row="9"
                    Grid.Column="1">
            <TextBlock Text="{Binding Memo}"
                       TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
