<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="ATIS.Views.Report.DataTemplateHeaderTaxoNomen.ReportItemTemplateHeaderTaxoNomenHeaderBodyPlSpeciesControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="1"
                    Grid.Column="0">
            <TextBlock x:Uid="TextBlock_TaxonomicStatus"
                       Margin="8,0,0,0"
                       FontWeight="Bold" />
        </StackPanel>
        <StackPanel Grid.Row="2"
                    Grid.Column="0">
            <TextBlock x:Uid="TextBlock_CurrentStanding"
                       Margin="8,0,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="2"
                    Grid.Column="1"
                    Orientation="Horizontal">
            <TextBlock Width="Auto"
                       Text="{Binding Valid}" />
            <TextBlock Width="Auto"
                       Margin="2,0,0,0"
                       Text="{Binding ValidYear}" />
        </StackPanel>
        <StackPanel Grid.Row="3"
                    Grid.Column="0">
            <TextBlock x:Uid="TextBlock_DataQualityIndicator"
                       Margin="8,0,0,0"
                       FontWeight="Bold" />
        </StackPanel>
        <StackPanel Grid.Row="4"
                    Grid.Column="0">
            <TextBlock x:Uid="TextBlock_RecordCredibilityRating"
                       Margin="8,0,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="5"
                    Grid.Column="0">
            <TextBlock x:Uid="TextBlock_RecordUpdate"
                       Margin="8,0,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="5"
                    Grid.Column="1">
            <TextBlock Text="{Binding UpdaterDate}" />
        </StackPanel>
        <StackPanel Grid.Row="6"
                    Grid.Column="0">
            <TextBlock x:Uid="TextBlock_TradeName"
                       Margin="8,0,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="6"
                    Grid.Column="1">
            <TextBlock Text="{Binding TradeName}"
                       TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Row="9"
                    Grid.Column="0">
            <TextBlock x:Uid="TextBlock_MemoCulture"
                       Margin="8,0,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="9"
                    Grid.Column="1">
            <TextBlock Text="{Binding MemoCulture}"
                       TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Row="10"
                    Grid.Column="0">
            <TextBlock x:Uid="TextBlock_Importer"
                       Margin="8,0,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="10"
                    Grid.Column="1">
            <TextBlock Text="{Binding Importer}"
                       TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Row="13"
                    Grid.Column="0">
            <TextBlock x:Uid="TextBlock_PlantLength"
                       Margin="8,0,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="13"
                    Grid.Column="1">
            <TextBlock Text="{Binding PlantLength}"
                       TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Row="14"
                    Grid.Column="0">
            <TextBlock x:Uid="TextBlock_MemoReproduction"
                       Margin="8,0,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="14"
                    Grid.Column="1">
            <TextBlock Text="{Binding MemoReproduction}"
                       TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Row="15"
                    Grid.Column="0">
            <TextBlock x:Uid="TextBlock_MemoGlobal"
                       Margin="8,0,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="15"
                    Grid.Column="1">
            <TextBlock Text="{Binding MemoGlobal}"
                       TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
