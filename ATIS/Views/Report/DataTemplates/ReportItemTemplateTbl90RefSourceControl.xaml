<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="ATIS.Views.Report.DataTemplates.ReportItemTemplateTbl90RefSourceControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loca="using:WinUI3Localizer"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Width="Auto"
                       Margin="8,0,0,0"
                       loca:Uids.Uid="TextBlock_Source" />
        </StackPanel>
        <StackPanel Grid.Row="0"
                    Grid.Column="1">
            <TextBlock Width="Auto"
                       Text="{Binding Tbl90RefSources.RefSourceName}"
                       TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Row="1"
                    Grid.Column="0">
            <TextBlock Width="Auto"
                       Margin="8,0,0,0"
                       loca:Uids.Uid="TextBlock_Acquired" />
        </StackPanel>
        <StackPanel Grid.Row="1"
                    Grid.Column="1">
            <TextBlock Width="Auto"
                       Text="{Binding ValidYear}" />
        </StackPanel>
        <StackPanel Grid.Row="2"
                    Grid.Column="0">
            <TextBlock Width="Auto"
                       Margin="8,0,0,0"
                       loca:Uids.Uid="TextBlock_Notes1" />
        </StackPanel>
        <StackPanel Grid.Row="2"
                    Grid.Column="1">
            <TextBlock Width="Auto"
                       Text="{Binding Tbl90RefSources.Notes}"
                       TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Row="3"
                    Grid.Column="0">
            <TextBlock Width="Auto"
                       Margin="8,0,0,5"
                       loca:Uids.Uid="TextBlock_Referencefor" />
        </StackPanel>
        <StackPanel Grid.Row="3"
                    Grid.Column="1">
            <TextBlock Width="Auto"
                       Margin="0,0,0,5"
                       Text="{Binding Info}"
                       TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
