<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="ATIS.Views.Report.DataTemplates.ReportItemTemplateFiSpeciesControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Margin="0,10,0,10"
                   FontSize="18"
                   FontWeight="Bold"
                   Text="Technic" />
        <TextBlock x:Uid="TextBlock_BasinLength"
                   Grid.Row="1"
                   Grid.Column="0"
                   Width="Auto"
                   Margin="8,0,0,10" />
        <TextBlock Grid.Row="1"
                   Grid.Column="1"
                   Width="Auto"
                   Text="{Binding BasinLength}" />
        <TextBlock x:Uid="TextBlock_FishLength"
                   Grid.Row="2"
                   Grid.Column="0"
                   Width="Auto"
                   Margin="8,0,0,0" />
        <TextBlock Grid.Row="2"
                   Grid.Column="1"
                   Width="Auto"
                   Text="{Binding FishLength}" />
        <TextBlock x:Uid="TextBlock_LNummer"
                   Grid.Row="3"
                   Grid.Column="0"
                   Width="Auto"
                   Margin="8,0,0,0" />
        <TextBlock Grid.Row="3"
                   Grid.Column="1"
                   Width="Auto"
                   Text="{Binding LNumber}" />
        <TextBlock x:Uid="TextBlock_LDANummer"
                   Grid.Row="4"
                   Grid.Column="0"
                   Width="Auto"
                   Margin="8,0,0,0" />
        <TextBlock Grid.Row="4"
                   Grid.Column="1"
                   Width="Auto"
                   Text="{Binding LDANumber}" />
        <TextBlock x:Uid="TextBlock_Domorphism"
                   Grid.Row="5"
                   Grid.Column="0"
                   Margin="0,0,0,10"
                   FontSize="18"
                   FontWeight="Bold" />
        <TextBlock x:Uid="TextBlock_MemoDomorphism"
                   Grid.Row="6"
                   Grid.Column="0"
                   Width="Auto"
                   Margin="8,0,0,0" />
        <TextBlock Grid.Row="6"
                   Grid.Column="1"
                   Width="Auto"
                   Text="{Binding MemoDomorphism}"
                   TextWrapping="Wrap" />
        <TextBlock x:Uid="TextBlock_Sozial"
                   Grid.Row="7"
                   Grid.Column="0"
                   Margin="0,0,0,10"
                   FontSize="18"
                   FontWeight="Bold" />
        <TextBlock x:Uid="TextBlock_MemoSozial"
                   Grid.Row="8"
                   Grid.Column="0"
                   Width="Auto"
                   Margin="8,0,0,0" />
        <TextBlock Grid.Row="8"
                   Grid.Column="1"
                   Width="Auto"
                   Text="{Binding MemoSozial}"
                   TextWrapping="Wrap" />
        <TextBlock x:Uid="TextBlock_Husbandry"
                   Grid.Row="9"
                   Grid.Column="0"
                   Margin="0,0,0,10"
                   FontSize="18"
                   FontWeight="Bold" />
        <TextBlock x:Uid="TextBlock_MemoHusbandry"
                   Grid.Row="10"
                   Grid.Column="0"
                   Width="Auto"
                   Margin="8,0,0,0" />
        <TextBlock Grid.Row="10"
                   Grid.Column="1"
                   Width="Auto"
                   Text="{Binding MemoHusbandry}"
                   TextWrapping="Wrap" />
        <TextBlock x:Uid="TextBlock_Breeding"
                   Grid.Row="11"
                   Grid.Column="0"
                   Margin="0,0,0,10"
                   FontSize="18"
                   FontWeight="Bold" />
        <TextBlock x:Uid="TextBlock_MemoBreeding"
                   Grid.Row="12"
                   Grid.Column="0"
                   Width="Auto"
                   Margin="8,0,0,0" />
        <TextBlock Grid.Row="12"
                   Grid.Column="1"
                   Width="Auto"
                   Text="{Binding MemoBreeding}"
                   TextWrapping="Wrap" />
        <TextBlock x:Uid="TextBlock_Foods"
                   Grid.Row="13"
                   Grid.Column="0"
                   Margin="0,0,0,10"
                   FontSize="18"
                   FontWeight="Bold" />
        <TextBlock x:Uid="TextBlock_MemoFoods"
                   Grid.Row="14"
                   Grid.Column="0"
                   Width="Auto"
                   Margin="8,0,0,0" />
        <TextBlock Grid.Row="14"
                   Grid.Column="1"
                   Width="Auto"
                   Text="{Binding MemoFoods}"
                   TextWrapping="Wrap" />
        <TextBlock x:Uid="TextBlock_Reproduction"
                   Grid.Row="17"
                   Grid.Column="0"
                   Margin="0,0,0,10"
                   FontSize="18"
                   FontWeight="Bold" />
        <TextBlock x:Uid="TextBlock_MemoReproduction"
                   Grid.Row="18"
                   Grid.Column="0"
                   Width="Auto"
                   Margin="8,0,0,0" />
        <TextBlock Grid.Row="18"
                   Grid.Column="1"
                   Width="Auto"
                   Text="{Binding MemoReproduction}"
                   TextWrapping="Wrap" />
        <TextBlock x:Uid="TextBlock_Culture"
                   Grid.Row="19"
                   Grid.Column="0"
                   Margin="0,0,0,10"
                   FontSize="18"
                   FontWeight="Bold" />
        <TextBlock x:Uid="TextBlock_MemoCulture"
                   Grid.Row="20"
                   Grid.Column="0"
                   Width="Auto"
                   Margin="8,0,0,0" />
        <TextBlock Grid.Row="20"
                   Grid.Column="1"
                   Width="Auto"
                   Text="{Binding MemoCulture}"
                   TextWrapping="Wrap" />
        <TextBlock x:Uid="TextBlock_Global"
                   Grid.Row="21"
                   Grid.Column="0"
                   Margin="0,0,0,10"
                   FontSize="18"
                   FontWeight="Bold" />
        <TextBlock x:Uid="TextBlock_MemoGlobal"
                   Grid.Row="22"
                   Grid.Column="0"
                   Width="Auto"
                   Margin="8,0,0,0" />
        <TextBlock Grid.Row="22"
                   Grid.Column="1"
                   Width="Auto"
                   Text="{Binding MemoGlobal}"
                   TextWrapping="Wrap" />
    </Grid>
</UserControl>
