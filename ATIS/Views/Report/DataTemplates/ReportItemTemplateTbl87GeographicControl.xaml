<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="ATIS.Views.Report.DataTemplates.ReportItemTemplateTbl87GeographicControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="using:WinUI3Localizer"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Grid.Column="0">
            <TextBlock Width="Auto"
                       Margin="8,0,0,0"
                       loc:Uids.Uid="TextBlock_Address" />
        </StackPanel>
        <StackPanel Grid.Row="0"
                    Grid.Column="1">
            <TextBlock Width="Auto"
                       Text="{Binding Address}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Grid.Column="0">
            <TextBlock Width="Auto"
                       Margin="8,0,0,0"
                       loc:Uids.Uid="TextBlock_Continent" />
        </StackPanel>
        <StackPanel Grid.Row="1"
                    Grid.Column="1">
            <TextBlock Width="Auto"
                       Text="{Binding Continent}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="2"
                    Grid.Column="0">
            <TextBlock Width="Auto"
                       Margin="8,0,0,0"
                       loc:Uids.Uid="TextBlock_Jurisdiction" />
        </StackPanel>
        <StackPanel Grid.Row="2"
                    Grid.Column="1">
            <TextBlock Width="Auto"
                       Text="{Binding Jurisdiction}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="3"
                    Grid.Column="0">
            <TextBlock Width="Auto"
                       Margin="8,0,0,0"
                       loc:Uids.Uid="TextBlock_Country" />
        </StackPanel>
        <StackPanel Grid.Row="3"
                    Grid.Column="1">
            <TextBlock Width="Auto"
                       Text="{Binding Country}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="4"
                    Grid.Column="0">
            <TextBlock Width="Auto"
                       Margin="8,0,0,0"
                       loc:Uids.Uid="Info" />
        </StackPanel>
        <StackPanel Grid.Row="4"
                    Grid.Column="1">
            <TextBlock Width="Auto"
                       Text="{Binding Info}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="5"
                    Grid.Column="0">
            <TextBlock Width="Auto"
                       Margin="8,0,0,5"
                       loc:Uids.Uid="Notes" />
        </StackPanel>
        <StackPanel Grid.Row="5"
                    Grid.Column="1">
            <TextBlock Width="Auto"
                       Margin="0,0,0,5"
                       Text="{Binding Memo}"
                       TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
