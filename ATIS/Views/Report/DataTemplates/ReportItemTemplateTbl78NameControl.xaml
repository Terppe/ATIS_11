<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="ATIS.Views.Report.DataTemplates.ReportItemTemplateTbl78NameControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="using:WinUI3Localizer"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel
            Grid.Row="0"
            Grid.Column="0"
            Orientation="Horizontal">
            <TextBlock Width="Auto" Text="{Binding NameName}" />
            <TextBlock
                Width="Auto"
                Margin="2,0,0,0"
                Text="[" />
            <TextBlock
                Width="Auto"
                Margin="2,0,0,0"
                Text="{Binding Language}" />
            <TextBlock
                Width="Auto"
                Margin="2,0,0,0"
                Text="]" />
        </StackPanel>
        <!--<StackPanel Grid.Row="1" Grid.Column="0">
        <TextBlock loc:Uids.Uid="TextBlock_Memo" />
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="1">
        <TextBlock Text="{Binding MemoForDisplay}" TextWrapping="Wrap" />
        </StackPanel>-->

    </Grid>
</UserControl>
