<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="ATIS.Views.Report.DataTemplates.ReportItemTemplateTbl75SpeciesControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="using:WinUI3Localizer"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Margin="0,10,0,10"
                   FontSize="18"
                   FontWeight="Bold"
                   Text="Technic" />
        <TextBlock Grid.Row="1"
                   Grid.Column="0"
                   Width="Auto"
                   Margin="8,0,0,10"
                   loc:Uids.Uid="TextBlock_BasinLength" />
        <TextBlock Grid.Row="1"
                   Grid.Column="1"
                   Width="Auto"
                   Text="{Binding Item.BasinLength}" />
        <TextBlock Grid.Row="2"
                   Grid.Column="0"
                   Width="Auto"
                   Margin="8,0,0,0"
                   loc:Uids.Uid="TextBlock_FishLength" />
        <TextBlock Grid.Row="2"
                   Grid.Column="1"
                   Width="Auto"
                   Text="{Binding Item.FishLength}" />
        <TextBlock Grid.Row="3"
                   Grid.Column="0"
                   Width="Auto"
                   Margin="8,0,0,0"
                   loc:Uids.Uid="TextBlock_LNummer" />
        <TextBlock Grid.Row="3"
                   Grid.Column="1"
                   Width="Auto"
                   Text="{Binding Item.LNumber}" />
        <TextBlock Grid.Row="4"
                   Grid.Column="0"
                   Width="Auto"
                   Margin="8,0,0,0"
                   loc:Uids.Uid="TextBlock_LDANummer" />
        <TextBlock Grid.Row="4"
                   Grid.Column="1"
                   Width="Auto"
                   Text="{Binding Item.LDANumber}" />
        <TextBlock Grid.Row="5"
                   Grid.Column="0"
                   Margin="0,0,0,10"
                   loc:Uids.Uid="TextBlock_Domorphism"
                   FontSize="18"
                   FontWeight="Bold" />
        <TextBlock Grid.Row="6"
                   Grid.Column="0"
                   Width="Auto"
                   Margin="8,0,0,0"
                   loc:Uids.Uid="TextBlock_MemoDomorphism" />
        <TextBlock Grid.Row="6"
                   Grid.Column="1"
                   Width="Auto"
                   Text="{Binding Item.MemoDomorphism}"
                   TextWrapping="Wrap" />
        <TextBlock Grid.Row="7"
                   Grid.Column="0"
                   Margin="0,0,0,10"
                   loc:Uids.Uid="TextBlock_Sozial"
                   FontSize="18"
                   FontWeight="Bold" />
        <TextBlock Grid.Row="8"
                   Grid.Column="0"
                   Width="Auto"
                   Margin="8,0,0,0"
                   loc:Uids.Uid="TextBlock_MemoSozial" />
        <TextBlock Grid.Row="8"
                   Grid.Column="1"
                   Width="Auto"
                   Text="{Binding Item.MemoSozial}"
                   TextWrapping="Wrap" />
        <TextBlock Grid.Row="9"
                   Grid.Column="0"
                   Margin="0,0,0,10"
                   loc:Uids.Uid="TextBlock_Husbandry"
                   FontSize="18"
                   FontWeight="Bold" />
        <TextBlock Grid.Row="10"
                   Grid.Column="0"
                   Width="Auto"
                   Margin="8,0,0,0"
                   loc:Uids.Uid="TextBlock_MemoHusbandry" />
        <TextBlock Grid.Row="10"
                   Grid.Column="1"
                   Width="Auto"
                   Text="{Binding Item.MemoHusbandry}"
                   TextWrapping="Wrap" />
        <TextBlock Grid.Row="11"
                   Grid.Column="0"
                   Margin="0,0,0,10"
                   loc:Uids.Uid="TextBlock_Breeding"
                   FontSize="18"
                   FontWeight="Bold" />
        <TextBlock Grid.Row="12"
                   Grid.Column="0"
                   Width="Auto"
                   Margin="8,0,0,0"
                   loc:Uids.Uid="TextBlock_MemoBreeding" />
        <TextBlock Grid.Row="12"
                   Grid.Column="1"
                   Width="Auto"
                   Text="{Binding Item.MemoBreeding}"
                   TextWrapping="Wrap" />
        <TextBlock Grid.Row="13"
                   Grid.Column="0"
                   Margin="0,0,0,10"
                   loc:Uids.Uid="TextBlock_Foods"
                   FontSize="18"
                   FontWeight="Bold" />
        <TextBlock Grid.Row="14"
                   Grid.Column="0"
                   Width="Auto"
                   Margin="8,0,0,0"
                   loc:Uids.Uid="TextBlock_MemoFoods" />
        <TextBlock Grid.Row="14"
                   Grid.Column="1"
                   Width="Auto"
                   Text="{Binding Item.MemoFoods}"
                   TextWrapping="Wrap" />
        <TextBlock Grid.Row="17"
                   Grid.Column="0"
                   Margin="0,0,0,10"
                   loc:Uids.Uid="TextBlock_Reproduction"
                   FontSize="18"
                   FontWeight="Bold" />
        <TextBlock Grid.Row="18"
                   Grid.Column="0"
                   Width="Auto"
                   Margin="8,0,0,0"
                   loc:Uids.Uid="TextBlock_MemoReproduction" />
        <TextBlock Grid.Row="18"
                   Grid.Column="1"
                   Width="Auto"
                   Text="{Binding Item.MemoReproduction}"
                   TextWrapping="Wrap" />
        <TextBlock Grid.Row="19"
                   Grid.Column="0"
                   Margin="0,0,0,10"
                   loc:Uids.Uid="TextBlock_Culture"
                   FontSize="18"
                   FontWeight="Bold" />
        <TextBlock Grid.Row="20"
                   Grid.Column="0"
                   Width="Auto"
                   Margin="8,0,0,0"
                   loc:Uids.Uid="TextBlock_MemoCulture" />
        <TextBlock Grid.Row="20"
                   Grid.Column="1"
                   Width="Auto"
                   Text="{Binding Item.MemoCulture}"
                   TextWrapping="Wrap" />
        <TextBlock Grid.Row="21"
                   Grid.Column="0"
                   Margin="0,0,0,10"
                   loc:Uids.Uid="TextBlock_Global"
                   FontSize="18"
                   FontWeight="Bold" />
        <TextBlock Grid.Row="22"
                   Grid.Column="0"
                   Width="Auto"
                   Margin="8,0,0,0"
                   loc:Uids.Uid="TextBlock_MemoGlobal" />
        <TextBlock Grid.Row="22"
                   Grid.Column="1"
                   Width="Auto"
                   Text="{Binding Item.MemoGlobal}"
                   TextWrapping="Wrap" />
    </Grid>
</UserControl>
