<?xml version="1.0" encoding="utf-8" ?>
<winUiEx:WindowEx x:Class="ATIS.Views.Report.Pdf.Tbl18Superclasses.ReportSuperclassesWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:dataTemplateHeader="using:ATIS.Views.Report.DataTemplateHeader"
                  xmlns:dataTemplateHeaderTaxoNomen="using:ATIS.Views.Report.DataTemplateHeaderTaxoNomen"
                  xmlns:dataTemplateHyperlink="using:ATIS.Views.Report.DataTemplateHyperlink"
                  xmlns:dataTemplatesReport="using:ATIS.Views.Report.DataTemplates"
                  xmlns:dataTemplatesSearch="using:ATIS.Views.Search.DataTemplates"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:models="using:ATIS.Models"
                  xmlns:winUiEx="using:WinUIEx"
                  mc:Ignorable="d">

    <!--  ReportSuperclasssWindow.xaml  Skriptdatum:  15.06.2024  12:32  -->

    <Grid>
        <Grid.Resources>
            <DataTemplate x:Key="SearchItemTemplateTbl03Regnum"
                          x:DataType="models:Tbl03Regnum">
                <dataTemplatesSearch:SearchItemTemplateTbl03RegnumControl />
            </DataTemplate>

            <DataTemplate x:Key="SearchItemTemplateTbl06Phylum"
                          x:DataType="models:Tbl06Phylum">
                <dataTemplatesSearch:SearchItemTemplateTbl06PhylumControl />
            </DataTemplate>
            <!--<DataTemplate x:Key="SearchItemTemplateTbl09Division"
                          x:DataType="models:Tbl09Division">
                <dataTemplatesSearch:SearchItemTemplateTbl09DivisionControl />
            </DataTemplate>-->
            <DataTemplate x:Key="SearchItemTemplateTbl12Subphylum"
                          x:DataType="models:Tbl12Subphylum">
                <dataTemplatesSearch:SearchItemTemplateTbl12SubphylumControl />
            </DataTemplate>
            <!--<DataTemplate x:Key="SearchItemTemplateTbl15Subdivision"
                          x:DataType="models:Tbl15Subdivision">
                <dataTemplatesSearch:SearchItemTemplateTbl15SubdivisionControl />
            </DataTemplate>-->
            <DataTemplate x:Key="SearchItemTemplateTbl18Superclass"
                          x:DataType="models:Tbl18Superclass">
                <dataTemplatesSearch:SearchItemTemplateTbl18SuperclassControl />
            </DataTemplate>
            <DataTemplate x:Key="SearchItemTemplateTbl21Class"
                          x:DataType="models:Tbl21Class">
                <dataTemplatesSearch:SearchItemTemplateTbl21ClassControl />
            </DataTemplate>


            <Style x:Key="NoSpacesListViewItemStyle"
                   TargetType="ListViewItem">
                <Setter Property="MinHeight" Value="24" />
            </Style>

            <!--  Report.Listviews  -->
            <!--  Header  -->
            <DataTemplate x:Key="ReportItemTemplateHeaderRegnum"
                          x:DataType="models:Tbl03Regnum">
                <dataTemplateHeader:ReportItemTemplateHeaderRegnumControl />
            </DataTemplate>
            <DataTemplate x:Key="ReportItemTemplateHeaderPhylum"
                          x:DataType="models:Tbl06Phylum">
                <dataTemplateHeader:ReportItemTemplateHeaderPhylumControl />
            </DataTemplate>
            <!--<DataTemplate x:Key="ReportItemTemplateHeaderDivision"
                          x:DataType="models:Tbl09Division">
                <dataTemplateHeader:ReportItemTemplateHeaderDivisionControl />
            </DataTemplate>-->
            <DataTemplate x:Key="ReportItemTemplateHeaderSubphylum"
                          x:DataType="models:Tbl12Subphylum">
                <dataTemplateHeader:ReportItemTemplateHeaderSubphylumControl />
            </DataTemplate>
            <!--<DataTemplate x:Key="ReportItemTemplateHeaderSubdivision"
                          x:DataType="models:Tbl15Subdivision">
                <dataTemplateHeader:ReportItemTemplateHeaderSubdivisionControl />
            </DataTemplate>-->
            <DataTemplate x:Key="ReportItemTemplateHeaderSuperclass"
                          x:DataType="models:Tbl18Superclass">
                <dataTemplateHeader:ReportItemTemplateHeaderSuperclassControl />
            </DataTemplate>
            <DataTemplate x:Key="ReportItemTemplateHeaderClass"
                          x:DataType="models:Tbl21Class">
                <dataTemplateHeader:ReportItemTemplateHeaderClassControl />
            </DataTemplate>

            <!--  Taxonomy-Header  -->
            <DataTemplate x:Key="ReportItemTemplateHeaderTaxoNomenHeader"
                          x:DataType="models:Tbl03Regnum">
                <dataTemplateHeaderTaxoNomen:ReportItemTemplateHeaderTaxoNomenHeaderControl />
            </DataTemplate>

            <!--  Taxonomy-Header-Body  -->
            <DataTemplate x:Key="ReportItemTemplateHeaderTaxoNomenHeaderBodyRegnum"
                          x:DataType="models:Tbl03Regnum">
                <dataTemplateHeaderTaxoNomen:ReportItemTemplateHeaderTaxoNomenHeaderBodyRegnumControl />
            </DataTemplate>
            <DataTemplate x:Key="ReportItemTemplateHeaderTaxoNomenHeaderBodyPhylum"
                          x:DataType="models:Tbl06Phylum">
                <dataTemplateHeaderTaxoNomen:ReportItemTemplateHeaderTaxoNomenHeaderBodyPhylumControl />
            </DataTemplate>
            <!--<DataTemplate x:Key="ReportItemTemplateHeaderTaxoNomenHeaderBodyDivision"
                          x:DataType="models:Tbl09Division">
                <dataTemplateHeaderTaxoNomen:ReportItemTemplateHeaderTaxoNomenHeaderBodyDivisionControl />
            </DataTemplate>-->
            <DataTemplate x:Key="ReportItemTemplateHeaderTaxoNomenHeaderBodySubphylum"
                          x:DataType="models:Tbl12Subphylum">
                <dataTemplateHeaderTaxoNomen:ReportItemTemplateHeaderTaxoNomenHeaderBodySubphylumControl />
            </DataTemplate>
            <!--<DataTemplate x:Key="ReportItemTemplateHeaderTaxoNomenHeaderBodySubdivision"
                          x:DataType="models:Tbl15Subdivision">
                <dataTemplateHeaderTaxoNomen:ReportItemTemplateHeaderTaxoNomenHeaderBodySubdivisionControl />
            </DataTemplate>-->
            <DataTemplate x:Key="ReportItemTemplateHeaderTaxoNomenHeaderBodySuperclass"
                          x:DataType="models:Tbl18Superclass">
                <dataTemplateHeaderTaxoNomen:ReportItemTemplateHeaderTaxoNomenHeaderBodySuperclassControl />
            </DataTemplate>
            <DataTemplate x:Key="ReportItemTemplateHeaderTaxoNomenHeaderBodyClass"
                          x:DataType="models:Tbl21Class">
                <dataTemplateHeaderTaxoNomen:ReportItemTemplateHeaderTaxoNomenHeaderBodyClassControl />
            </DataTemplate>

            <!--  Hyperlink-ListViews  -->
            <DataTemplate x:Key="ReportItemTemplateHyperlinkRegnum"
                          x:DataType="models:Tbl03Regnum">
                <dataTemplateHyperlink:ReportItemTemplateHyperlinkRegnumControl />
            </DataTemplate>
            <DataTemplate x:Key="ReportItemTemplateHyperlinkPhylum"
                          x:DataType="models:Tbl06Phylum">
                <dataTemplateHyperlink:ReportItemTemplateHyperlinkPhylumControl />
            </DataTemplate>
            <!--<DataTemplate x:Key="ReportItemTemplateHyperlinkDivision"
                          x:DataType="models:Tbl09Division">
                <dataTemplateHyperlink:ReportItemTemplateHyperlinkDivisionControl />
            </DataTemplate>-->
            <DataTemplate x:Key="ReportItemTemplateHyperlinkSubphylum"
                          x:DataType="models:Tbl12Subphylum">
                <dataTemplateHyperlink:ReportItemTemplateHyperlinkSubphylumControl />
            </DataTemplate>
            <!--<DataTemplate x:Key="ReportItemTemplateHyperlinkSubdivision"
                          x:DataType="models:Tbl15Subdivision">
                <dataTemplateHyperlink:ReportItemTemplateHyperlinkSubdivisionControl />
            </DataTemplate>-->
            <DataTemplate x:Key="ReportItemTemplateHyperlinkSuperclass"
                          x:DataType="models:Tbl18Superclass">
                <dataTemplateHyperlink:ReportItemTemplateHyperlinkSuperclassControl />
            </DataTemplate>
            <DataTemplate x:Key="ReportItemTemplateHyperlinkClass"
                          x:DataType="models:Tbl21Class">
                <dataTemplateHyperlink:ReportItemTemplateHyperlinkClassControl />
            </DataTemplate>

            <!--  Rest-ListViews  -->

            <DataTemplate x:Key="ReportItemTemplateTbl90RefExpert"
                          x:DataType="models:Tbl90Reference">
                <dataTemplatesReport:ReportItemTemplateTbl90RefExpertControl />
            </DataTemplate>
            <DataTemplate x:Key="ReportItemTemplateTbl90RefSource"
                          x:DataType="models:Tbl90Reference">
                <dataTemplatesReport:ReportItemTemplateTbl90RefSourceControl />
            </DataTemplate>
            <DataTemplate x:Key="ReportItemTemplateTbl90RefAuthor"
                          x:DataType="models:Tbl90Reference">
                <dataTemplatesReport:ReportItemTemplateTbl90RefAuthorControl />
            </DataTemplate>
            <DataTemplate x:Key="ReportItemTemplateTbl93Comment"
                          x:DataType="models:Tbl93Comment">
                <dataTemplatesReport:ReportItemTemplateTbl93CommentControl />
            </DataTemplate>

        </Grid.Resources>

        <!--  Part 1  -->

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button x:Uid="Button_PrintPdf"
                        Margin="50,5,10,5"
                        Click="PdfSuperclassCommand"
                        Style="{StaticResource CrudButtonStyle}" />
                <Button x:Uid="Button_Close_Window"
                        Margin="50,5,10,5"
                        HorizontalAlignment="Right"
                        Click="OnCloseClick"
                        Style="{StaticResource CrudButtonStyle}" />
            </StackPanel>
            <ScrollViewer Grid.Row="1"
                          Padding="{StaticResource SmallDetailPageMargin}"
                          HorizontalAlignment="Stretch"
                          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                          IsTabStop="True"
                          VerticalScrollMode="Enabled">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ListView Grid.Row="0"
                              Grid.Column="0"
                              Grid.ColumnSpan="2"
                              Margin="-12,0,0,0"
                              ItemContainerStyle="{StaticResource NoSpacesListViewItemStyle}"
                              ItemTemplate="{StaticResource ReportItemTemplateHeaderSuperclass}"
                              ItemsSource="{x:Bind ViewModel.SuperclassItems}" />
                    <ListView Grid.Row="1"
                              Grid.Column="0"
                              Grid.ColumnSpan="2"
                              Margin="-12,0,0,0"
                              ItemContainerStyle="{StaticResource NoSpacesListViewItemStyle}"
                              ItemTemplate="{StaticResource ReportItemTemplateHeaderTaxoNomenHeader}"
                              ItemsSource="{x:Bind ViewModel.RegnumItems}" />
                    <ListView Grid.Row="2"
                              Grid.Column="0"
                              Grid.ColumnSpan="2"
                              Margin="-12,0,0,0"
                              ItemContainerStyle="{StaticResource NoSpacesListViewItemStyle}"
                              ItemTemplate="{StaticResource ReportItemTemplateHeaderTaxoNomenHeaderBodySuperclass}"
                              ItemsSource="{x:Bind ViewModel.SuperclassItems}" />
                    <TextBlock x:Uid="TextBlock_TaxonomicHierarchy"
                               Grid.Row="3"
                               Grid.Column="0"
                               FontSize="18"
                               FontWeight="Bold" />
                    <ListView Grid.Row="4"
                              Grid.Column="0"
                              Grid.ColumnSpan="2"
                              Margin="-12,0,0,0"
                              ItemContainerStyle="{StaticResource NoSpacesListViewItemStyle}"
                              ItemTemplate="{StaticResource ReportItemTemplateHyperlinkRegnum}"
                              ItemsSource="{x:Bind ViewModel.RegnumItems}"
                              SelectedValuePath="RegnumId" />
                    <ListView Grid.Row="5"
                              Grid.Column="0"
                              Grid.ColumnSpan="2"
                              Margin="-12,0,0,0"
                              ItemContainerStyle="{StaticResource NoSpacesListViewItemStyle}"
                              ItemTemplate="{StaticResource ReportItemTemplateHyperlinkPhylum}"
                              ItemsSource="{x:Bind ViewModel.PhylumItems}"
                              SelectedValuePath="PhylumId" />
                    <!--<ListView Grid.Row="6"
                              Grid.Column="0"
                              Grid.ColumnSpan="2"
                              Margin="-12,0,0,0"
                              ItemContainerStyle="{StaticResource NoSpacesListViewItemStyle}"
                              ItemTemplate="{StaticResource ReportItemTemplateHyperlinkDivision}"
                              ItemsSource="{x:Bind ViewModel.DivisionItems}"
                              SelectedValuePath="DivisionId" />-->
                    <ListView Grid.Row="7"
                              Grid.Column="0"
                              Grid.ColumnSpan="2"
                              Margin="-12,0,0,0"
                              ItemContainerStyle="{StaticResource NoSpacesListViewItemStyle}"
                              ItemTemplate="{StaticResource ReportItemTemplateHyperlinkSubphylum}"
                              ItemsSource="{x:Bind ViewModel.SubphylumItems}"
                              SelectedValuePath="SubphylumId" />
                    <!--<ListView Grid.Row="8"
                              Grid.Column="0"
                              Grid.ColumnSpan="2"
                              Margin="-12,0,0,0"
                              ItemContainerStyle="{StaticResource NoSpacesListViewItemStyle}"
                              ItemTemplate="{StaticResource ReportItemTemplateHyperlinkSubdivision}"
                              ItemsSource="{x:Bind ViewModel.SubdivisionItems}"
                              SelectedValuePath="SubdivisionId" />-->
                    <TextBlock x:Uid="TextBlock_Superclass"
                               Grid.Row="9"
                               Grid.Column="0"
                               Width="Auto"
                               Margin="32,0,0,0" />
                    <StackPanel Grid.Row="9"
                                Grid.Column="1"
                                Orientation="Horizontal">
                        <TextBlock Width="Auto"
                                   Text="{x:Bind ViewModel.SuperclassSelected.SuperclassName, Mode=OneWay}" />
                        <TextBlock Width="Auto"
                                   Margin="2,0,0,0"
                                   Text="{x:Bind ViewModel.SuperclassSelected.Author, Mode=OneWay}" />
                        <TextBlock Width="Auto"
                                   Margin="2,0,0,0"
                                   Text="{x:Bind ViewModel.SuperclassSelected.AuthorYear, Mode=OneWay}" />
                        <TextBlock Width="Auto"
                                   Margin="2,0,0,0"
                                   Text="{x:Bind ViewModel.SuperclassSelected.EngName, Mode=OneWay}" />
                        <TextBlock Width="Auto"
                                   Margin="2,0,0,0"
                                   Text="{x:Bind ViewModel.SuperclassSelected.GerName, Mode=OneWay}" />
                        <TextBlock Width="Auto"
                                   Margin="2,0,0,0"
                                   Text="{x:Bind ViewModel.SuperclassSelected.FraName, Mode=OneWay}" />
                        <TextBlock Width="Auto"
                                   Margin="2,0,0,0"
                                   Text="{x:Bind ViewModel.SuperclassSelected.PorName, Mode=OneWay}" />
                    </StackPanel>

                    <!--  Part 2  -->

                    <TextBlock x:Name="TbDirectChildren"
                               x:Uid="TextBlock_DirectChildren"
                               Grid.Row="10"
                               Grid.Column="1"
                               Width="Auto"
                               Margin="0,5,0,10"
                               FontWeight="Bold" />
                    <ListView Grid.Row="11"
                              Grid.Column="0"
                              Grid.ColumnSpan="2"
                              Margin="-12,0,0,0"
                              ItemContainerStyle="{StaticResource NoSpacesListViewItemStyle}"
                              ItemsSource="{x:Bind ViewModel.ClassItems}"
                              SelectedItem="{x:Bind ViewModel.ClassSelected, Mode=TwoWay}"
                              SelectedValuePath="ClassId">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock x:Uid="TextBlock_Class1"
                                                   Width="Auto"
                                                   Margin="40,0,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal">
                                        <TextBlock Text="{Binding ClassId}"
                                                   Visibility="Collapsed" />
                                        <TextBlock Text="{Binding ClassName}" />
                                        <TextBlock Margin="2,0,0,0"
                                                   Text="{Binding EngName}" />
                                        <TextBlock Margin="2,0,0,0"
                                                   Text="{Binding GerName}" />
                                        <TextBlock Margin="2,0,0,0"
                                                   Text="{Binding FraName}" />
                                        <TextBlock Margin="2,0,0,0"
                                                   Text="{Binding PorName}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!--  Part 3  -->

                    <TextBlock x:Uid="TextBlock_References"
                               Grid.Row="12"
                               Grid.Column="0"
                               FontSize="18"
                               FontWeight="Bold" />
                    <TextBlock x:Uid="TextBlock_Experts"
                               Grid.Row="13"
                               Grid.Column="0"
                               Width="Auto"
                               Margin="8,0,0,10"
                               FontWeight="Bold" />
                    <ListView Grid.Row="14"
                              Grid.Column="0"
                              Grid.ColumnSpan="2"
                              Margin="-12,-12,10,10"
                              ItemTemplate="{StaticResource ReportItemTemplateTbl90RefExpert}"
                              ItemsSource="{x:Bind ViewModel.ReferenceExpertItems}" />
                    <TextBlock x:Uid="TextBlock_Sources"
                               Grid.Row="15"
                               Grid.Column="0"
                               Width="Auto"
                               Margin="8,0,0,10"
                               FontWeight="Bold" />
                    <ListView Grid.Row="16"
                              Grid.Column="0"
                              Grid.ColumnSpan="2"
                              Margin="-12,-12,10,10"
                              ItemTemplate="{StaticResource ReportItemTemplateTbl90RefSource}"
                              ItemsSource="{x:Bind ViewModel.ReferenceSourceItems}" />
                    <TextBlock x:Uid="TextBlock_Publications"
                               Grid.Row="17"
                               Grid.Column="0"
                               Width="Auto"
                               Margin="8,0,0,10"
                               FontWeight="Bold" />
                    <ListView Grid.Row="18"
                              Grid.Column="0"
                              Grid.ColumnSpan="2"
                              Margin="-12,-12,10,10"
                              ItemTemplate="{StaticResource ReportItemTemplateTbl90RefAuthor}"
                              ItemsSource="{x:Bind ViewModel.ReferenceAuthorItems}" />
                    <TextBlock x:Uid="TextBlock_Comments"
                               Grid.Row="19"
                               Grid.Column="0"
                               Margin="0,0,0,10"
                               FontSize="18"
                               FontWeight="Bold" />
                    <ListView Grid.Row="20"
                              Grid.Column="0"
                              Grid.ColumnSpan="2"
                              Margin="-12,-12,10,10"
                              ItemTemplate="{StaticResource ReportItemTemplateTbl93Comment}"
                              ItemsSource="{x:Bind ViewModel.CommentItems}" />
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</winUiEx:WindowEx>
