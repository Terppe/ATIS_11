<?xml version="1.0" encoding="utf-8" ?>
<winUiEx:WindowEx x:Class="ATIS.Views.Report.Pdf.TblDisease.ReportDiseasesWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:loca="using:WinUI3Localizer"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:winUiEx="using:WinUIEx"
                  mc:Ignorable="d">

    <!--  ReportDiseasesWindow.xaml  Skriptdatum:  15.06.2024  12:32  -->

    <Grid>

        <!--  Part 1  -->

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button Margin="50,5,10,5"
                        loca:Uids.Uid="Button_PrintPdf"
                        Click="PdfDiseaseCommand"
                        Style="{StaticResource AtisButtonPrimary}" />
                <Button Margin="50,5,10,5"
                        HorizontalAlignment="Right"
                        loca:Uids.Uid="Button_Close_Window"
                        Click="OnCloseClick"
                        Style="{StaticResource AtisButtonPrimary}" />
            </StackPanel>
            <ScrollViewer Grid.Row="1"
                          Padding="{StaticResource SmallDetailPageMargin}"
                          HorizontalAlignment="Stretch"
                          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                          IsTabStop="True"
                          VerticalScrollMode="Enabled">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               loca:Uids.Uid="TextBlock_Food"
                               FontSize="18"
                               FontWeight="Bold" />
                    <TextBlock Grid.Row="1"
                               Grid.Column="1"
                               Width="Auto"
                               Text="{x:Bind ViewModel.DiseaseSelected.DiseaseName, Mode=OneWay}" />
                    <TextBlock Grid.Row="2"
                               Grid.Column="0"
                               loca:Uids.Uid="TextBlock_CountId" />
                    <TextBlock Grid.Row="2"
                               Grid.Column="1"
                               Width="Auto"
                               Text="{x:Bind ViewModel.DiseaseSelected.CountId, Mode=OneWay}" />
                    <TextBlock Grid.Row="3"
                               Grid.Column="0"
                               loca:Uids.Uid="TextBlock_Valid" />
                    <CheckBox Grid.Row="3"
                              Grid.Column="1"
                              Width="Auto"
                              Margin="{StaticResource SmallRightCheckBoxMargin}"
                              VerticalAlignment="Bottom"
                              loca:Uids.Uid="CheckBox_Valid" />
                    <TextBlock Grid.Row="4"
                               Grid.Column="0"
                               loca:Uids.Uid="TextBlock_ValidYear" />
                    <TextBlock Grid.Row="4"
                               Grid.Column="1"
                               Width="Auto"
                               Text="{x:Bind ViewModel.DiseaseSelected.ValidYear, Mode=OneWay}" />
                    <TextBlock Grid.Row="5"
                               Grid.Column="0"
                               loca:Uids.Uid="TextBlock_ShortInfo" />
                    <TextBlock Grid.Row="5"
                               Grid.Column="1"
                               Width="Auto"
                               Text="{x:Bind ViewModel.DiseaseSelected.ShortInfo, Mode=OneWay}" />
                    <TextBlock Grid.Row="6"
                               Grid.Column="0"
                               loca:Uids.Uid="TextBlock_Symptom" />
                    <TextBlock Grid.Row="6"
                               Grid.Column="1"
                               Width="Auto"
                               Text="{x:Bind ViewModel.DiseaseSelected.Symptom, Mode=OneWay}" />
                    <TextBlock Grid.Row="7"
                               Grid.Column="0"
                               loca:Uids.Uid="TextBlock_Reason" />
                    <TextBlock Grid.Row="7"
                               Grid.Column="1"
                               Width="Auto"
                               Text="{x:Bind ViewModel.DiseaseSelected.Reason, Mode=OneWay}" />
                    <TextBlock Grid.Row="8"
                               Grid.Column="0"
                               loca:Uids.Uid="TextBlock_Therapie" />
                    <TextBlock Grid.Row="8"
                               Grid.Column="1"
                               Width="Auto"
                               Text="{x:Bind ViewModel.DiseaseSelected.Therapie, Mode=OneWay}"
                               TextWrapping="Wrap" />
                    <TextBlock Grid.Row="9"
                               Grid.Column="0"
                               loca:Uids.Uid="TextBlock_Info" />
                    <TextBlock Grid.Row="9"
                               Grid.Column="1"
                               Width="Auto"
                               Text="{x:Bind ViewModel.DiseaseSelected.Info, Mode=OneWay}"
                               TextWrapping="Wrap" />
                    <TextBlock Grid.Row="10"
                               Grid.Column="0"
                               loca:Uids.Uid="TextBlock_Memo" />
                    <TextBlock Grid.Row="10"
                               Grid.Column="1"
                               Width="Auto"
                               Text="{x:Bind ViewModel.DiseaseSelected.Memo, Mode=OneWay}"
                               TextWrapping="Wrap" />
                </Grid>
            </ScrollViewer>

        </Grid>
    </Grid>
</winUiEx:WindowEx>
