<?xml version="1.0" encoding="utf-8" ?>
<winUiEx:WindowEx x:Class="ATIS.Views.Report.Pdf.Tbl03Regnums.ReportRegnumsWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:dataTemplateHeader="using:ATIS.Views.Report.DataTemplateHeader"
                  xmlns:dataTemplateHeaderTaxoNomen="using:ATIS.Views.Report.DataTemplateHeaderTaxoNomen"
                  xmlns:dataTemplateHyperlink="using:ATIS.Views.Report.DataTemplateHyperlink"
                  xmlns:dataTemplatesReport="using:ATIS.Views.Report.DataTemplates"
                  xmlns:dataTemplatesSearch="using:ATIS.Views.Search.DataTemplates"
                  xmlns:loca="using:WinUI3Localizer"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:models="using:ATIS.Models"
                  xmlns:winUiEx="using:WinUIEx"
                  mc:Ignorable="d">

    <!--  ReportRegnumsWindow.xaml  Skriptdatum:  15.06.2024  12:32  -->

    <Grid>
        <Grid.Resources>
            <DataTemplate x:Key="SearchItemTemplateTbl03Regnum"
                          x:DataType="models:Tbl03Regnum">
                <dataTemplatesSearch:SearchItemTemplateTbl03RegnumControl />
            </DataTemplate>

            <DataTemplate x:Key="SearchItemTemplateTbl06Phylum"
                          x:DataType="models:Tbl06Phylum">
                <dataTemplatesSearch:SearchItemTemplateTbl06PhylumControl />
            </DataTemplate>
            <!--<DataTemplate x:Key="SearchItemTemplateTbl09Division"
                          x:DataType="models:Tbl09Division">
                <dataTemplatesSearch:SearchItemTemplateTbl09DivisionControl />
            </DataTemplate>-->


            <Style x:Key="NoSpacesListViewItemStyle"
                   TargetType="ListViewItem">
                <Setter Property="MinHeight" Value="24" />
            </Style>

            <!--  Report.Listviews  -->
            <!--  Header  -->
            <DataTemplate x:Key="ReportItemTemplateHeaderRegnum"
                          x:DataType="models:Tbl03Regnum">
                <dataTemplateHeader:ReportItemTemplateHeaderRegnumControl />
            </DataTemplate>
            <DataTemplate x:Key="ReportItemTemplateHeaderPhylum"
                          x:DataType="models:Tbl06Phylum">
                <dataTemplateHeader:ReportItemTemplateHeaderPhylumControl />
            </DataTemplate>
            <!--<DataTemplate x:Key="ReportItemTemplateHeaderDivision"
                          x:DataType="models:Tbl09Division">
                <dataTemplateHeader:ReportItemTemplateHeaderDivisionControl />
            </DataTemplate>-->

            <!--  Taxonomy-Header  -->
            <DataTemplate x:Key="ReportItemTemplateHeaderTaxoNomenHeader"
                          x:DataType="models:Tbl03Regnum">
                <dataTemplateHeaderTaxoNomen:ReportItemTemplateHeaderTaxoNomenHeaderControl />
            </DataTemplate>

            <!--  Taxonomy-Header-Body  -->
            <DataTemplate x:Key="ReportItemTemplateHeaderTaxoNomenHeaderBodyRegnum"
                          x:DataType="models:Tbl03Regnum">
                <dataTemplateHeaderTaxoNomen:ReportItemTemplateHeaderTaxoNomenHeaderBodyRegnumControl />
            </DataTemplate>
            <DataTemplate x:Key="ReportItemTemplateHeaderTaxoNomenHeaderBodyPhylum"
                          x:DataType="models:Tbl06Phylum">
                <dataTemplateHeaderTaxoNomen:ReportItemTemplateHeaderTaxoNomenHeaderBodyPhylumControl />
            </DataTemplate>
            <!--<DataTemplate x:Key="ReportItemTemplateHeaderTaxoNomenHeaderBodyDivision"
                          x:DataType="models:Tbl09Division">
                <dataTemplateHeaderTaxoNomen:ReportItemTemplateHeaderTaxoNomenHeaderBodyDivisionControl />
            </DataTemplate>-->
            <!--  Hyperlink-ListViews  -->
            <DataTemplate x:Key="ReportItemTemplateHyperlinkRegnum"
                          x:DataType="models:Tbl03Regnum">
                <dataTemplateHyperlink:ReportItemTemplateHyperlinkRegnumControl />
            </DataTemplate>
            <DataTemplate x:Key="ReportItemTemplateHyperlinkPhylum"
                          x:DataType="models:Tbl06Phylum">
                <dataTemplateHyperlink:ReportItemTemplateHyperlinkPhylumControl />
            </DataTemplate>
            <!--<DataTemplate x:Key="ReportItemTemplateHyperlinkDivision"
                          x:DataType="models:Tbl09Division">
                <dataTemplateHyperlink:ReportItemTemplateHyperlinkDivisionControl />
            </DataTemplate>-->

            <!--  Rest-ListViews  -->

            <DataTemplate x:Key="ReportItemTemplateTbl90RefExpert"
                          x:DataType="models:Tbl90Reference">
                <dataTemplatesReport:ReportItemTemplateTbl90RefExpertControl />
            </DataTemplate>
            <DataTemplate x:Key="ReportItemTemplateTbl90RefSource"
                          x:DataType="models:Tbl90Reference">
                <dataTemplatesReport:ReportItemTemplateTbl90RefSourceControl />
            </DataTemplate>
            <DataTemplate x:Key="ReportItemTemplateTbl90RefAuthor"
                          x:DataType="models:Tbl90Reference">
                <dataTemplatesReport:ReportItemTemplateTbl90RefAuthorControl />
            </DataTemplate>
            <DataTemplate x:Key="ReportItemTemplateTbl93Comment"
                          x:DataType="models:Tbl93Comment">
                <dataTemplatesReport:ReportItemTemplateTbl93CommentControl />
            </DataTemplate>

        </Grid.Resources>

        <!--  Part 1  -->

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button Margin="50,5,10,5"
                        loca:Uids.Uid="Button_PrintPdf"
                        Click="PdfRegnumCommand"
                        Style="{StaticResource CrudButtonStyle}" />
                <Button Margin="50,5,10,5"
                        HorizontalAlignment="Right"
                        loca:Uids.Uid="Button_Close_Window"
                        Click="OnCloseClick"
                        Style="{StaticResource CrudButtonStyle}" />
            </StackPanel>
            <ScrollViewer Grid.Row="1"
                          Padding="{StaticResource SmallDetailPageMargin}"
                          HorizontalAlignment="Stretch"
                          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                          IsTabStop="True"
                          VerticalScrollMode="Enabled">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ListView Grid.Row="0"
                              Grid.Column="0"
                              Grid.ColumnSpan="2"
                              Margin="-12,0,0,0"
                              ItemContainerStyle="{StaticResource NoSpacesListViewItemStyle}"
                              ItemTemplate="{StaticResource ReportItemTemplateHeaderRegnum}"
                              ItemsSource="{x:Bind ViewModel.RegnumItems}" />
                    <ListView Grid.Row="1"
                              Grid.Column="0"
                              Grid.ColumnSpan="2"
                              Margin="-12,0,0,0"
                              ItemContainerStyle="{StaticResource NoSpacesListViewItemStyle}"
                              ItemTemplate="{StaticResource ReportItemTemplateHeaderTaxoNomenHeader}"
                              ItemsSource="{x:Bind ViewModel.RegnumItems}" />
                    <ListView Grid.Row="2"
                              Grid.Column="0"
                              Grid.ColumnSpan="2"
                              Margin="-12,0,0,0"
                              ItemContainerStyle="{StaticResource NoSpacesListViewItemStyle}"
                              ItemTemplate="{StaticResource ReportItemTemplateHeaderTaxoNomenHeaderBodyRegnum}"
                              ItemsSource="{x:Bind ViewModel.RegnumItems}" />
                    <TextBlock x:Uid="TextBlock_TaxonomicHierarchy"
                               Grid.Row="3"
                               Grid.Column="0"
                               FontSize="18"
                               FontWeight="Bold" />
                    <TextBlock Grid.Row="4"
                               Grid.Column="0"
                               Width="Auto"
                               Margin="8,0,0,0"
                               loca:Uids.Uid="TextBlock_Regnum" />
                    <StackPanel Grid.Row="4"
                                Grid.Column="1"
                                Orientation="Horizontal">
                        <TextBlock Width="Auto"
                                   Text="{x:Bind ViewModel.RegnumSelected.RegnumName, Mode=OneWay}" />
                        <TextBlock Width="Auto"
                                   Margin="2,0,0,0"
                                   Text="{x:Bind ViewModel.RegnumSelected.Subregnum, Mode=OneWay}" />
                        <TextBlock Width="Auto"
                                   Margin="2,0,0,0"
                                   Text="{x:Bind ViewModel.RegnumSelected.Author, Mode=OneWay}" />
                        <TextBlock Width="Auto"
                                   Margin="2,0,0,0"
                                   Text="{x:Bind ViewModel.RegnumSelected.AuthorYear, Mode=OneWay}" />
                        <TextBlock Width="Auto"
                                   Margin="2,0,0,0"
                                   Text="{x:Bind ViewModel.RegnumSelected.EngName, Mode=OneWay}" />
                        <TextBlock Width="Auto"
                                   Margin="2,0,0,0"
                                   Text="{x:Bind ViewModel.RegnumSelected.GerName, Mode=OneWay}" />
                        <TextBlock Width="Auto"
                                   Margin="2,0,0,0"
                                   Text="{x:Bind ViewModel.RegnumSelected.FraName, Mode=OneWay}" />
                        <TextBlock Width="Auto"
                                   Margin="2,0,0,0"
                                   Text="{x:Bind ViewModel.RegnumSelected.PorName, Mode=OneWay}" />
                    </StackPanel>

                    <!--  Part 2  -->

                    <TextBlock x:Name="TbDirectChildren"
                               Grid.Row="5"
                               Grid.Column="1"
                               Width="Auto"
                               Margin="0,5,0,10"
                               loca:Uids.Uid="TextBlock_DirectChildren"
                               FontWeight="Bold" />
                    <ListView Grid.Row="6"
                              Grid.Column="0"
                              Grid.ColumnSpan="2"
                              Margin="-12,0,0,0"
                              ItemContainerStyle="{StaticResource NoSpacesListViewItemStyle}"
                              ItemsSource="{x:Bind ViewModel.PhylumItems}"
                              SelectedItem="{x:Bind ViewModel.PhylumSelected, Mode=TwoWay}"
                              SelectedValuePath="PhylumId">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Width="Auto"
                                                   Margin="16,0,0,0"
                                                   loca:Uids.Uid="TextBlock_Phylum1" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal">
                                        <TextBlock Text="{Binding PhylumId}"
                                                   Visibility="Collapsed" />
                                        <TextBlock Text="{Binding PhylumName}" />

                                        <TextBlock Margin="2,0,0,0"
                                                   Text="{Binding EngName}" />
                                        <TextBlock Margin="2,0,0,0"
                                                   Text="{Binding GerName}" />
                                        <TextBlock Margin="2,0,0,0"
                                                   Text="{Binding FraName}" />
                                        <TextBlock Margin="2,0,0,0"
                                                   Text="{Binding PorName}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <!--<ListView Grid.Row="7"
                              Grid.Column="0"
                              Grid.ColumnSpan="2"
                              Margin="-12,0,0,0"
                              ItemContainerStyle="{StaticResource NoSpacesListViewItemStyle}"
                              ItemsSource="{x:Bind ViewModel.DivisionItems}"
                              SelectedItem="{x:Bind ViewModel.DivisionSelected, Mode=TwoWay}"
                              SelectedValuePath="DivisionId">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock x:Uid="TextBlock_Division1"
                                                   Width="Auto"
                                                   Margin="16,0,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal">
                                        <TextBlock Text="{Binding DivisionId}"
                                                   Visibility="Collapsed" />
                                        <TextBlock Text="{Binding DivisionName}"
                                                   TextDecorations="Underline" />
                                        <TextBlock Margin="2,0,0,0"
                                                   Text="{Binding EngName}" />
                                        <TextBlock Margin="2,0,0,0"
                                                   Text="{Binding GerName}" />
                                        <TextBlock Margin="2,0,0,0"
                                                   Text="{Binding FraName}" />
                                        <TextBlock Margin="2,0,0,0"
                                                   Text="{Binding PorName}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>-->

                    <!--  Part 3  -->

                    <TextBlock Grid.Row="8"
                               Grid.Column="0"
                               loca:Uids.Uid="TextBlock_References"
                               FontSize="18"
                               FontWeight="Bold" />
                    <TextBlock Grid.Row="9"
                               Grid.Column="0"
                               Width="Auto"
                               Margin="8,0,0,10"
                               loca:Uids.Uid="TextBlock_Experts"
                               FontWeight="Bold" />
                    <ListView Grid.Row="10"
                              Grid.Column="0"
                              Grid.ColumnSpan="2"
                              Margin="-12,-12,10,10"
                              ItemTemplate="{StaticResource ReportItemTemplateTbl90RefExpert}"
                              ItemsSource="{x:Bind ViewModel.ReferenceExpertItems}" />
                    <TextBlock Grid.Row="11"
                               Grid.Column="0"
                               Width="Auto"
                               Margin="8,0,0,10"
                               loca:Uids.Uid="TextBlock_Sources"
                               FontWeight="Bold" />
                    <ListView Grid.Row="12"
                              Grid.Column="0"
                              Grid.ColumnSpan="2"
                              Margin="-12,-12,10,10"
                              ItemTemplate="{StaticResource ReportItemTemplateTbl90RefSource}"
                              ItemsSource="{x:Bind ViewModel.ReferenceSourceItems}" />
                    <TextBlock Grid.Row="13"
                               Grid.Column="0"
                               Width="Auto"
                               Margin="8,0,0,10"
                               loca:Uids.Uid="TextBlock_Publications"
                               FontWeight="Bold" />
                    <ListView Grid.Row="14"
                              Grid.Column="0"
                              Grid.ColumnSpan="2"
                              Margin="-12,-12,10,10"
                              ItemTemplate="{StaticResource ReportItemTemplateTbl90RefAuthor}"
                              ItemsSource="{x:Bind ViewModel.ReferenceAuthorItems}" />
                    <TextBlock Grid.Row="15"
                               Grid.Column="0"
                               Margin="0,0,0,10"
                               loca:Uids.Uid="TextBlock_Comments"
                               FontSize="18"
                               FontWeight="Bold" />
                    <ListView Grid.Row="16"
                              Grid.Column="0"
                              Grid.ColumnSpan="2"
                              Margin="-12,-12,10,10"
                              ItemTemplate="{StaticResource ReportItemTemplateTbl93Comment}"
                              ItemsSource="{x:Bind ViewModel.CommentItems}" />
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</winUiEx:WindowEx>
