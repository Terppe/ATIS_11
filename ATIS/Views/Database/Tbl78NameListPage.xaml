<?xml version="1.0" encoding="utf-8" ?>

<Page x:Class="ATIS.Views.Database.Tbl78NameListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:conv="using:ATIS.Helpers.Converters"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:loca="using:WinUI3Localizer"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:models="using:ATIS.Models"
      xmlns:toolkit="using:CommunityToolkit.WinUI.UI.Controls"
      xmlns:winUiCommunity="using:WinUICommunity"
      NavigationCacheMode="Disabled"
      mc:Ignorable="d">

    <!--  NameListPage.xaml  Skriptdatum: 02.01.2025  10:32  -->

    <Page.Resources>

        <conv:DoubleToStringConverter x:Key="DoubleConverter" />
        <MenuFlyout x:Key="NameDataContextMenu">
            <MenuFlyoutItem loca:Uids.Uid="MenuFlyout_Save_Name"
                            Click="SaveName_Click">
                <MenuFlyoutItem.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/save.png" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem loca:Uids.Uid="MenuFlyout_Delete_Name"
                            Click="DeleteName_Click">
                <MenuFlyoutItem.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/delete.png" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem loca:Uids.Uid="MenuFlyout_Add_Name"
                            Click="AddName_Click">
                <MenuFlyoutItem.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/add.png" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem loca:Uids.Uid="MenuFlyout_Refresh"
                            Click="Refresh_Click">
                <MenuFlyoutItem.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/refresh.png" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>
    </Page.Resources>


    <RelativePanel x:Name="NameRoot"
                   Margin="{StaticResource SmallLeftTopRightBottomMargin}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource LargeWindowSnapPoint}" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource MediumWindowSnapPoint}" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource MinWindowSnapPoint}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="NameCommandBar.DefaultLabelPosition" Value="Bottom" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <TextBlock x:Name="PageTitle"
                   loca:Uids.Uid="TextBlock_Names"
                   RelativePanel.AlignLeftWithPanel="True"
                   Style="{StaticResource PageTitleTextBlockStyle}" />
        <TextBlock x:Name="NameDatasetText"
                   Margin="5,17,0,0"
                   loca:Uids.Uid="TextBlock_DataSetCount"
                   RelativePanel.RightOf="PageTitle"
                   Style="{StaticResource DatasetTitleStyle}" />
        <TextBlock x:Name="NameDatasetCountText"
                   Margin="5,17,0,0"
                   RelativePanel.RightOf="NameDatasetText"
                   Style="{StaticResource DatasetTitleStyle}"
                   Text="{x:Bind ViewModel.NameDataSetCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <CommandBar x:Name="NameCommandBar"
                    HorizontalAlignment="Stretch"
                    Background="Transparent"
                    DefaultLabelPosition="Right"
                    RelativePanel.LeftOf="NameSearchBox"
                    RelativePanel.RightOf="NameDatasetCountText">
            <AppBarButton x:Name="AppBarButtonDeleteName"
                          loca:Uids.Uid="AppBarButtonDeleteName"
                          Click="DeleteName_Click"
                          IsEnabled="{x:Bind conv:NotConverter.IsNotNull(ViewModel.NameSelected), Mode=OneWay}">
                <AppBarButton.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/delete.png" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton x:Name="AppBarButtonAddName"
                          loca:Uids.Uid="AppBarButtonAddName"
                          Background="{ThemeResource SystemAccentColor}"
                          Click="AddName_Click"
                          Foreground="White">
                <AppBarButton.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/add.png" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="AppBarButtonSync"
                          loca:Uids.Uid="AppBarButtonSync"
                          Click="Refresh_Click"
                          IsEnabled="{x:Bind conv:NotConverter.IsNotNull(ViewModel.NameSelected), Mode=OneWay}">
                <AppBarButton.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/refresh.png" />
                </AppBarButton.Icon>
            </AppBarButton>
        </CommandBar>

        <AutoSuggestBox Name="NameSearchBox"
                        Width="200"
                        Margin="4,8,4,0"
                        loca:Uids.Uid="AutoSuggestBox_Search"
                        Loaded="NameSearchBox_OnLoaded"
                        QuerySubmitted="GetNamesByNameOrId"
                        RelativePanel.AlignRightWithPanel="True">
            <AutoSuggestBox.QueryIcon>
                <BitmapIcon ShowAsMonochrome="False"
                            UriSource="/Assets/Fluent/search.png" />
            </AutoSuggestBox.QueryIcon>
        </AutoSuggestBox>

        <ScrollViewer x:Name="PanelName"
                      RelativePanel.AlignLeftWithPanel="True"
                      RelativePanel.AlignRightWithPanel="True"
                      RelativePanel.Below="PageTitle"
                      VerticalScrollBarVisibility="Auto"
                      VerticalScrollMode="Auto">
            <StackPanel Margin="-10,8,4,0">
                <StackPanel.Resources>
                    <Style TargetType="Expander">
                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                    </Style>
                </StackPanel.Resources>
                <toolkit:DataGrid x:Name="NameDataGrid"
                                  MaxHeight="330"
                                  Margin="0,0,20,0"
                                  VerticalAlignment="Top"
                                  x:FieldModifier="public"
                                  AlternatingRowBackground="LightGray"
                                  AutoGenerateColumns="False"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  CanUserReorderColumns="False"
                                  CanUserResizeColumns="False"
                                  ContextFlyout="{StaticResource NameDataContextMenu}"
                                  CurrentCellChanged="NameDataGrid_OnCurrentCellChanged"
                                  GridLinesVisibility="Horizontal"
                                  ItemsSource="{x:Bind ViewModel.NameItems}"
                                  SelectedItem="{x:Bind ViewModel.NameSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  SelectionMode="Single"
                                  Sorting="NameDataGrid_Sorting">
                    <toolkit:DataGrid.Columns>
                        <toolkit:DataGridTemplateColumn loca:Uids.Uid="DataGridTemplateColumn_NameId"
                                                        Tag="NameId">
                            <toolkit:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:Tbl78Name">
                                    <HyperlinkButton Margin="12,0"
                                                     BorderThickness="0"
                                                     Click="ViewNameHyperlinkButton_Click"
                                                     Content="{Binding NameId}" />
                                </DataTemplate>
                            </toolkit:DataGridTemplateColumn.CellTemplate>
                        </toolkit:DataGridTemplateColumn>
                        <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_NameName"
                                                    Binding="{Binding NameName}"
                                                    CanUserSort="True"
                                                    Tag="NameName" />
                        <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_Language"
                                                    Binding="{Binding Language}"
                                                    Tag="Language" />
                        <toolkit:DataGridCheckBoxColumn loca:Uids.Uid="DataGridCheckBoxColumn_Valid"
                                                        Binding="{Binding Valid}"
                                                        Tag="Valid" />
                        <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_Info"
                                                    Binding="{Binding Info}"
                                                    Tag="Info" />
                    </toolkit:DataGrid.Columns>
                </toolkit:DataGrid>

                <!--  NameDetailExpander  -->
                <Expander x:Name="NameDetailExpander"
                          Margin="{StaticResource XSmallTopBottomMargin}"
                          Visibility="Collapsed">
                    <Expander.Header>
                        <Grid>
                            <TextBlock loca:Uids.Uid="TextBlock_Name"
                                       Style="{ThemeResource SubtitleTextBlockStyle}" />
                            <TextBlock HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Text="{x:Bind ViewModel.NameSelected.NameName, Mode=OneWay}" />
                        </Grid>
                    </Expander.Header>

                    <RelativePanel x:Name="NameDetailRoot"
                                   Margin="{StaticResource SmallLeftRightMargin}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup>
                                <VisualState>
                                    <VisualState.StateTriggers>
                                        <AdaptiveTrigger MinWindowWidth="{StaticResource LargeWindowSnapPoint}" />
                                    </VisualState.StateTriggers>
                                </VisualState>
                                <VisualState>
                                    <VisualState.StateTriggers>
                                        <AdaptiveTrigger MinWindowWidth="{StaticResource MediumWindowSnapPoint}" />
                                    </VisualState.StateTriggers>
                                </VisualState>
                                <VisualState>
                                    <VisualState.StateTriggers>
                                        <AdaptiveTrigger MinWindowWidth="{StaticResource MinWindowSnapPoint}" />
                                    </VisualState.StateTriggers>
                                    <VisualState.Setters>
                                        <Setter Target="NameCommandBar.DefaultLabelPosition" Value="Bottom" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <CommandBar x:Name="NameDetailCommandBar"
                                    Margin="{StaticResource SmallLeftRightCommandBarMargin}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Top"
                                    Background="Transparent"
                                    DefaultLabelPosition="Right"
                                    RelativePanel.AlignRightWithPanel="True">
                            <AppBarButton loca:Uids.Uid="AppBarButtonSave"
                                          Background="{ThemeResource SystemBaseLowColor}"
                                          Click="SaveName_Click"
                                          Foreground="White"
                                          Visibility="{x:Bind ViewModel.IsInEditName, Mode=OneWay}">
                                <AppBarButton.Icon>
                                    <BitmapIcon ShowAsMonochrome="False"
                                                UriSource="/Assets/Fluent/save.png" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton loca:Uids.Uid="AppBarButtonCancel"
                                          Click="CancelEditsNameAsync"
                                          Visibility="{x:Bind ViewModel.IsInEditName, Mode=OneWay}">
                                <AppBarButton.Icon>
                                    <BitmapIcon ShowAsMonochrome="False"
                                                UriSource="/Assets/Fluent/cancel.png" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarSeparator Visibility="{x:Bind ViewModel.IsInEditName, Mode=OneWay}" />
                            <AppBarButton loca:Uids.Uid="AppBarButtonBack"
                                          Background="{ThemeResource SystemAccentColor}"
                                          Click="BackName_Click"
                                          Foreground="White">
                                <AppBarButton.Icon>
                                    <BitmapIcon ShowAsMonochrome="False"
                                                UriSource="/Assets/Fluent/arrowleft.png" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton loca:Uids.Uid="AppBarButtonEdit"
                                          Click="{x:Bind ViewModel.StartEditName}"
                                          IsEnabled="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditName), Mode=OneWay}"
                                          Visibility="{x:Bind conv:NotConverter.CollapsedIf(ViewModel.IsNewName), Mode=OneWay}">
                                <AppBarButton.Icon>
                                    <BitmapIcon ShowAsMonochrome="False"
                                                UriSource="/Assets/Fluent/edit.png" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                        </CommandBar>
                        <ScrollViewer x:Name="DetailPanelName"
                                      Margin="0,36,0,0"
                                      RelativePanel.AlignLeftWithPanel="True"
                                      RelativePanel.AlignRightWithPanel="True"
                                      VerticalScrollBarVisibility="Auto"
                                      VerticalScrollMode="Auto">
                            <RelativePanel Margin="4,0,0,0">
                                <TextBox x:Name="NameId"
                                         MinWidth="110"
                                         Margin="{StaticResource XSmallRightMargin}"
                                         loca:Uids.Uid="TextBox_NameId"
                                         IsReadOnly="True"
                                         RelativePanel.AlignLeftWithPanel="True"
                                         Text="{x:Bind ViewModel.NameSelected.NameId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox x:Name="NameName"
                                         MinWidth="150"
                                         Margin="{StaticResource XSmallRightMargin}"
                                         loca:Uids.Uid="TextBox_NameName"
                                         Background="SlateGray"
                                         Foreground="White"
                                         IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditName), Mode=OneWay}"
                                         MaxLength="100"
                                         RelativePanel.RightOf="NameId"
                                         Text="{x:Bind ViewModel.NameSelected.NameName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <ComboBox x:Name="LanguageCombo"
                                          Width="150"
                                          Margin="{StaticResource XSmallRightComboBoxMargin}"
                                          loca:Uids.Uid="ComboBox_Language"
                                          IsEnabled="{x:Bind conv:NotConverter.NotCombo(ViewModel.IsInEditName), Mode=OneWay}"
                                          PlaceholderText="Pick a Language"
                                          RelativePanel.AlignLeftWithPanel="True"
                                          RelativePanel.Below="NameId"
                                          SelectedValue="{x:Bind ViewModel.NameSelected.Language, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <x:String>GER</x:String>
                                    <x:String>ENG</x:String>
                                    <x:String>FRA</x:String>
                                    <x:String>SPA</x:String>
                                </ComboBox>
                                <CheckBox x:Name="ValidCheckName"
                                          Width="80"
                                          Margin="{StaticResource SmallRightCheckBoxMargin}"
                                          VerticalAlignment="Bottom"
                                          loca:Uids.Uid="CheckBox_Valid"
                                          IsChecked="{x:Bind ViewModel.NameSelected.Valid, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{x:Bind conv:NotConverter.NotCombo(ViewModel.IsInEditName), Mode=OneWay}"
                                          RelativePanel.Below="NameId"
                                          RelativePanel.RightOf="LanguageCombo" />
                                <TextBox x:Name="InfoName"
                                         MinWidth="1120"
                                         Margin="{StaticResource XSmallRightMargin}"
                                         HorizontalAlignment="Stretch"
                                         loca:Uids.Uid="TextBox_Info"
                                         IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditName), Mode=OneWay}"
                                         MaxLength="100"
                                         RelativePanel.AlignLeftWithPanel="True"
                                         RelativePanel.Below="LanguageCombo"
                                         Text="{x:Bind ViewModel.NameSelected.Info, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox x:Name="MemoName"
                                         MinWidth="1120"
                                         MinHeight="75"
                                         MaxWidth="1300"
                                         MaxHeight="300"
                                         Margin="{StaticResource XSmallRightMargin}"
                                         loca:Uids.Uid="TextBox_Memo"
                                         AcceptsReturn="True"
                                         IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditName), Mode=OneWay}"
                                         RelativePanel.AlignLeftWithPanel="True"
                                         RelativePanel.Below="InfoName"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         Text="{x:Bind ViewModel.NameSelected.Memo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         TextWrapping="Wrap" />
                            </RelativePanel>
                        </ScrollViewer>
                    </RelativePanel>
                </Expander>

                <!--  SpeciesDetailExpander  -->
                <Expander x:Name="SpeciesDetailExpander"
                          Margin="{StaticResource XSmallTopBottomMargin}"
                          Visibility="Collapsed">
                    <Expander.Header>
                        <Grid>
                            <TextBlock loca:Uids.Uid="TextBlock_FiSpecies"
                                       Style="{ThemeResource SubtitleTextBlockStyle}" />
                            <StackPanel HorizontalAlignment="Right"
                                        Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Text="{x:Bind ViewModel.SpeciesSelected.Tbl66Genusses.GenusName, Mode=OneWay}" />
                                <TextBlock Margin="2,0,0,0"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Text="{x:Bind ViewModel.SpeciesSelected.FiSpeciesName, Mode=OneWay}" />
                                <TextBlock Margin="2,0,0,0"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Text="{x:Bind ViewModel.SpeciesSelected.Subspecies, Mode=OneWay}" />
                                <TextBlock Margin="2,0,0,0"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Text="{x:Bind ViewModel.SpeciesSelected.Divers, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                    </Expander.Header>
                    <RelativePanel x:Name="SpeciesDetailRoot"
                                   Margin="{StaticResource SmallLeftRightMargin}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup>
                                <VisualState>
                                    <VisualState.StateTriggers>
                                        <AdaptiveTrigger MinWindowWidth="{StaticResource LargeWindowSnapPoint}" />
                                    </VisualState.StateTriggers>
                                </VisualState>
                                <VisualState>
                                    <VisualState.StateTriggers>
                                        <AdaptiveTrigger MinWindowWidth="{StaticResource MediumWindowSnapPoint}" />
                                    </VisualState.StateTriggers>
                                </VisualState>
                                <VisualState>
                                    <VisualState.StateTriggers>
                                        <AdaptiveTrigger MinWindowWidth="{StaticResource MinWindowSnapPoint}" />
                                    </VisualState.StateTriggers>
                                    <VisualState.Setters>
                                        <Setter Target="FiSpeciesCommandBar.DefaultLabelPosition" Value="Bottom" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <CommandBar x:Name="SpeciesDetailCommandBar"
                                    Margin="{StaticResource SmallLeftRightCommandBarMargin}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Top"
                                    Background="Transparent"
                                    DefaultLabelPosition="Right"
                                    RelativePanel.AlignRightWithPanel="True">
                            <AppBarButton loca:Uids.Uid="AppBarButtonSave"
                                          Background="{ThemeResource SystemBaseLowColor}"
                                          Click="SaveSpecies_Click"
                                          Foreground="White"
                                          Visibility="{x:Bind ViewModel.IsInEditSpecies, Mode=OneWay}">
                                <AppBarButton.Icon>
                                    <BitmapIcon ShowAsMonochrome="False"
                                                UriSource="/Assets/Fluent/save.png" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton loca:Uids.Uid="AppBarButtonCancel"
                                          Click="CancelEditsSpeciesAsync"
                                          Visibility="{x:Bind ViewModel.IsInEditSpecies, Mode=OneWay}">
                                <AppBarButton.Icon>
                                    <BitmapIcon ShowAsMonochrome="False"
                                                UriSource="/Assets/Fluent/cancel.png" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarSeparator Visibility="{x:Bind ViewModel.IsInEditSpecies, Mode=OneWay}" />
                            <AppBarButton loca:Uids.Uid="AppBarButtonBack"
                                          Background="{ThemeResource SystemAccentColor}"
                                          Click="BackSpecies_Click"
                                          Foreground="White">
                                <AppBarButton.Icon>
                                    <BitmapIcon ShowAsMonochrome="False"
                                                UriSource="/Assets/Fluent/arrowleft.png" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton loca:Uids.Uid="AppBarButtonEdit"
                                          Click="{x:Bind ViewModel.StartEditSpecies}"
                                          IsEnabled="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditSpecies), Mode=OneWay}"
                                          Visibility="{x:Bind conv:NotConverter.CollapsedIf(ViewModel.IsNewSpecies), Mode=OneWay}">
                                <AppBarButton.Icon>
                                    <BitmapIcon ShowAsMonochrome="False"
                                                UriSource="/Assets/Fluent/edit.png" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                        </CommandBar>
                        <ScrollViewer x:Name="DetailPanelSpecies"
                                      Margin="0,36,0,0"
                                      RelativePanel.AlignLeftWithPanel="True"
                                      RelativePanel.AlignRightWithPanel="True"
                                      VerticalScrollBarVisibility="Auto"
                                      VerticalScrollMode="Auto">
                            <StackPanel Margin="0,8,4,0">
                                <StackPanel.Resources>
                                    <Style TargetType="Expander">
                                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                                    </Style>
                                </StackPanel.Resources>
                                <RelativePanel Margin="8,0,0,0">
                                    <TextBox x:Name="FiSpeciesId"
                                             MinWidth="110"
                                             Margin="{StaticResource XSmallRightMargin}"
                                             loca:Uids.Uid="TextBox_FiSpeciesId"
                                             IsReadOnly="True"
                                             RelativePanel.AlignLeftWithPanel="True"
                                             Text="{x:Bind ViewModel.SpeciesSelected.FiSpeciesId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <ComboBox x:Name="GenusComboFiSpecies"
                                              MinWidth="200"
                                              Margin="{StaticResource XSmallRightComboBoxMargin}"
                                              loca:Uids.Uid="ComboBox_GenusName"
                                              DisplayMemberPath="GenusName"
                                              IsDropDownOpen="False"
                                              IsEditable="False"
                                              IsEnabled="False"
                                              ItemsSource="{x:Bind ViewModel.Tbl66GenussesAllList}"
                                              RelativePanel.RightOf="FiSpeciesId"
                                              SelectedValue="{x:Bind ViewModel.SpeciesSelected.GenusId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="GenusId" />
                                    <TextBox x:Name="FiSpeciesName"
                                             MinWidth="150"
                                             Margin="{StaticResource XSmallRightMargin}"
                                             loca:Uids.Uid="TextBox_FiSpeciesName"
                                             Background="SlateGray"
                                             CharacterCasing="Lower"
                                             Foreground="White"
                                             IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditSpecies), Mode=OneWay}"
                                             MaxLength="100"
                                             RelativePanel.RightOf="GenusComboFiSpecies"
                                             Text="{x:Bind ViewModel.SpeciesSelected.FiSpeciesName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox x:Name="FiSpeciesSubspecies"
                                             MinWidth="150"
                                             Margin="{StaticResource XSmallRightMargin}"
                                             loca:Uids.Uid="TextBox_Subspecies"
                                             CharacterCasing="Lower"
                                             IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditSpecies), Mode=OneWay}"
                                             MaxLength="100"
                                             RelativePanel.RightOf="FiSpeciesName"
                                             Text="{x:Bind ViewModel.SpeciesSelected.Subspecies, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox x:Name="FiSpeciesDivers"
                                             MinWidth="150"
                                             Margin="{StaticResource XSmallRightMargin}"
                                             loca:Uids.Uid="TextBox_Divers"
                                             CharacterCasing="Lower"
                                             IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditSpecies), Mode=OneWay}"
                                             MaxLength="100"
                                             RelativePanel.RightOf="FiSpeciesSubspecies"
                                             Text="{x:Bind ViewModel.SpeciesSelected.Divers, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <ComboBox x:Name="SpeciesgroupComboFiSpecies"
                                              MinWidth="200"
                                              Margin="{StaticResource XSmallRightComboBoxMargin}"
                                              loca:Uids.Uid="ComboBox_SpeciesgroupFullName"
                                              DisplayMemberPath="SpeciesgroupFullName"
                                              IsEnabled="{x:Bind conv:NotConverter.NotCombo(ViewModel.IsInEditSpecies), Mode=OneWay}"
                                              ItemsSource="{x:Bind ViewModel.Tbl68SpeciesgroupsAllList}"
                                              RelativePanel.AlignLeftWithPanel="True"
                                              RelativePanel.Below="FiSpeciesId"
                                              SelectedValue="{x:Bind ViewModel.SpeciesSelected.SpeciesgroupId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="SpeciesgroupId" />
                                    <CheckBox x:Name="ValidCheckFiSpecies"
                                              Width="80"
                                              Margin="{StaticResource SmallRightCheckBoxMargin}"
                                              VerticalAlignment="Bottom"
                                              loca:Uids.Uid="CheckBox_Valid"
                                              IsChecked="{x:Bind ViewModel.SpeciesSelected.Valid, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              IsEnabled="{x:Bind conv:NotConverter.NotCombo(ViewModel.IsInEditSpecies), Mode=OneWay}"
                                              RelativePanel.Below="FiSpeciesId"
                                              RelativePanel.RightOf="SpeciesgroupComboFiSpecies" />
                                    <ComboBox x:Name="ComboCreature"
                                              Width="150"
                                              Margin="{StaticResource XSmallRightComboBoxMargin}"
                                              loca:Uids.Uid="ComboBox_Creature"
                                              IsEnabled="{x:Bind conv:NotConverter.NotCombo(ViewModel.IsInEditSpecies), Mode=OneWay}"
                                              PlaceholderText="Select Creature"
                                              RelativePanel.Below="FiSpeciesId"
                                              RelativePanel.RightOf="ValidCheckFiSpecies"
                                              SelectedValue="{x:Bind ViewModel.SpeciesSelected.Creature, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              SelectionChanged="ComboCreature_OnSelectionChangedComboBox_SelectionChanged">
                                        <x:String>Animalia</x:String>
                                        <x:String>Plantae</x:String>
                                        <x:String>Fungi</x:String>
                                        <x:String>Archaea</x:String>
                                        <x:String>Bacteria</x:String>
                                        <x:String>Chromista</x:String>
                                        <x:String>Protozoa</x:String>
                                    </ComboBox>
                                    <TextBox x:Name="AuthorTextFiSpecies"
                                             MinWidth="150"
                                             Margin="{StaticResource XSmallRightMargin}"
                                             HorizontalAlignment="Stretch"
                                             loca:Uids.Uid="TextBox_Author"
                                             CharacterCasing="Upper"
                                             IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditSpecies), Mode=OneWay}"
                                             MaxLength="60"
                                             RelativePanel.AlignLeftWithPanel="True"
                                             RelativePanel.Below="SpeciesgroupComboFiSpecies"
                                             Text="{x:Bind ViewModel.SpeciesSelected.Author, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
