<?xml version="1.0" encoding="utf-8" ?>

<Page x:Class="ATIS.Views.Database.Tbl90RefSourceListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:conv="using:ATIS.Helpers.Converters"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:loca="using:WinUI3Localizer"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:models="using:ATIS.Models"
      xmlns:toolkit="using:CommunityToolkit.WinUI.UI.Controls"
      xmlns:winUiCommunity="using:WinUICommunity"
      NavigationCacheMode="Disabled"
      mc:Ignorable="d">

    <!--  RefSourceListPage.xaml  Skriptdatum:  06.01.2025  10:32  -->

    <Page.Resources>

        <MenuFlyout x:Key="RefSourceDataContextMenu">
            <MenuFlyoutItem loca:Uids.Uid="MenuFlyout_Save_RefSource"
                            Click="SaveRefSource_Click">
                <MenuFlyoutItem.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/save.png" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem loca:Uids.Uid="MenuFlyout_Delete_RefSource"
                            Click="DeleteRefSource_Click">
                <MenuFlyoutItem.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/delete.png" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem loca:Uids.Uid="MenuFlyout_Add_RefSource"
                            Click="AddRefSource_Click">
                <MenuFlyoutItem.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/add.png" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem loca:Uids.Uid="MenuFlyout_Refresh"
                            Click="Refresh_Click">
                <MenuFlyoutItem.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/refresh.png" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>
    </Page.Resources>

    <RelativePanel x:Name="RefSourceRoot"
                   Margin="{StaticResource SmallLeftTopRightBottomMargin}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource LargeWindowSnapPoint}" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource MediumWindowSnapPoint}" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource MinWindowSnapPoint}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RefSourceCommandBar.DefaultLabelPosition" Value="Bottom" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <TextBlock x:Name="PageTitle"
                   loca:Uids.Uid="TextBlock_RefSources"
                   RelativePanel.AlignLeftWithPanel="True"
                   Style="{StaticResource PageTitleTextBlockStyle}" />
        <TextBlock x:Name="RefSourceDatasetText"
                   Margin="5,17,0,0"
                   loca:Uids.Uid="TextBlock_DataSetCount"
                   RelativePanel.RightOf="PageTitle"
                   Style="{StaticResource DatasetTitleStyle}" />
        <TextBlock x:Name="RefSourceDatasetCountText"
                   Margin="5,17,0,0"
                   RelativePanel.RightOf="RefSourceDatasetText"
                   Style="{StaticResource DatasetTitleStyle}"
                   Text="{x:Bind ViewModel.RefSourceDataSetCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <CommandBar x:Name="RefSourceCommandBar"
                    HorizontalAlignment="Stretch"
                    Background="Transparent"
                    DefaultLabelPosition="Right"
                    RelativePanel.LeftOf="RefSourceSearchBox"
                    RelativePanel.RightOf="RefSourceDatasetCountText">
            <AppBarButton x:Name="AppBarButtonDeleteRefSource"
                          loca:Uids.Uid="AppBarButtonDeleteRefSource"
                          Click="DeleteRefSource_Click"
                          IsEnabled="{x:Bind conv:NotConverter.IsNotNull(ViewModel.RefSourceSelected), Mode=OneWay}">
                <AppBarButton.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/delete.png" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton loca:Uids.Uid="AppBarButtonAddRefSource"
                          Background="{ThemeResource SystemAccentColor}"
                          Click="AddRefSource_Click"
                          Foreground="White">
                <AppBarButton.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/add.png" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="AppBarButtonSync"
                          loca:Uids.Uid="AppBarButtonSync"
                          Click="Refresh_Click"
                          IsEnabled="{x:Bind conv:NotConverter.IsNotNull(ViewModel.RefSourceSelected), Mode=OneWay}">
                <AppBarButton.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/refresh.png" />
                </AppBarButton.Icon>
            </AppBarButton>
        </CommandBar>

        <AutoSuggestBox Name="RefSourceSearchBox"
                        Width="200"
                        Margin="4,8,4,0"
                        loca:Uids.Uid="AutoSuggestBox_Search"
                        Loaded="RefSourceSearchBox_OnLoaded"
                        QuerySubmitted="GetRefSourcesByNameOrId"
                        RelativePanel.AlignRightWithPanel="True">
            <AutoSuggestBox.QueryIcon>
                <BitmapIcon ShowAsMonochrome="False"
                            UriSource="/Assets/Fluent/search.png" />
            </AutoSuggestBox.QueryIcon>
        </AutoSuggestBox>

        <ScrollViewer x:Name="PanelRefSource"
                      RelativePanel.AlignLeftWithPanel="True"
                      RelativePanel.AlignRightWithPanel="True"
                      RelativePanel.Below="PageTitle"
                      VerticalScrollBarVisibility="Auto"
                      VerticalScrollMode="Auto">
            <StackPanel Margin="-10,8,4,0">
                <StackPanel.Resources>
                    <Style TargetType="Expander">
                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                    </Style>
                </StackPanel.Resources>
                <toolkit:DataGrid x:Name="RefSourceDataGrid"
                                  MaxHeight="330"
                                  Margin="0,0,20,0"
                                  VerticalAlignment="Top"
                                  x:FieldModifier="public"
                                  AlternatingRowBackground="LightGray"
                                  AutoGenerateColumns="False"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  CanUserReorderColumns="False"
                                  CanUserResizeColumns="False"
                                  ContextFlyout="{StaticResource RefSourceDataContextMenu}"
                                  CurrentCellChanged="RefSourceDataGrid_OnCurrentCellChanged"
                                  GridLinesVisibility="Horizontal"
                                  ItemsSource="{x:Bind ViewModel.RefSourceItems}"
                                  SelectedItem="{x:Bind ViewModel.RefSourceSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  SelectionMode="Single"
                                  Sorting="RefSourceDataGrid_Sorting">
                    <toolkit:DataGrid.Columns>
                        <toolkit:DataGridTemplateColumn loca:Uids.Uid="DataGridTemplateColumn_RefSourceId"
                                                        Tag="RefSourceId">
                            <toolkit:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:Tbl90RefSource">
                                    <HyperlinkButton Margin="12,0"
                                                     BorderThickness="0"
                                                     Click="ViewRefSourceHyperlinkButton_Click"
                                                     Content="{Binding RefSourceId}" />
                                </DataTemplate>
                            </toolkit:DataGridTemplateColumn.CellTemplate>
                        </toolkit:DataGridTemplateColumn>
                        <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_RefSourceName"
                                                    Binding="{Binding RefSourceName}"
                                                    CanUserSort="True"
                                                    Tag="RefSourceName" />
                        <toolkit:DataGridCheckBoxColumn loca:Uids.Uid="DataGridCheckBoxColumn_Valid"
                                                        Binding="{Binding Valid}"
                                                        Tag="Valid" />
                        <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_ValidYear"
                                                    Binding="{Binding ValidYear}"
                                                    Tag="ValidYear" />
                        <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_Author"
                                                    Binding="{Binding Author}"
                                                    Tag="Author" />
                        <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_AuthorYear"
                                                    Binding="{Binding SourceYear}"
                                                    Tag="SourceYear" />
                        <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_Info"
                                                    Binding="{Binding Info}"
                                                    Tag="Info" />
                    </toolkit:DataGrid.Columns>
                </toolkit:DataGrid>

                <!--  RefSourceDetailExpander  -->
                <Expander x:Name="RefSourceDetailExpander"
                          Margin="{StaticResource XSmallTopBottomMargin}"
                          Visibility="Collapsed">
                    <Expander.Header>
                        <Grid>
                            <TextBlock loca:Uids.Uid="TextBlock_RefSource"
                                       Style="{ThemeResource SubtitleTextBlockStyle}" />
                            <TextBlock HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Text="{x:Bind ViewModel.RefSourceSelected.RefSourceName, Mode=OneWay}" />
                        </Grid>
                    </Expander.Header>

                    <RelativePanel x:Name="RefSourceDetailRoot"
                                   Margin="{StaticResource SmallLeftRightMargin}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup>
                                <VisualState>
                                    <VisualState.StateTriggers>
                                        <AdaptiveTrigger MinWindowWidth="{StaticResource LargeWindowSnapPoint}" />
                                    </VisualState.StateTriggers>
                                </VisualState>
                                <VisualState>
                                    <VisualState.StateTriggers>
                                        <AdaptiveTrigger MinWindowWidth="{StaticResource MediumWindowSnapPoint}" />
                                    </VisualState.StateTriggers>
                                </VisualState>
                                <VisualState>
                                    <VisualState.StateTriggers>
                                        <AdaptiveTrigger MinWindowWidth="{StaticResource MinWindowSnapPoint}" />
                                    </VisualState.StateTriggers>
                                    <VisualState.Setters>
                                        <Setter Target="RefSourceCommandBar.DefaultLabelPosition" Value="Bottom" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <CommandBar x:Name="RefSourceDetailCommandBar"
                                    Margin="{StaticResource SmallLeftRightCommandBarMargin}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Top"
                                    Background="Transparent"
                                    DefaultLabelPosition="Right"
                                    RelativePanel.AlignRightWithPanel="True">
                            <AppBarButton loca:Uids.Uid="AppBarButtonSave"
                                          Background="{ThemeResource SystemBaseLowColor}"
                                          Click="SaveRefSource_Click"
                                          Foreground="White"
                                          Visibility="{x:Bind ViewModel.IsInEditRefSource, Mode=OneWay}">
                                <AppBarButton.Icon>
                                    <BitmapIcon ShowAsMonochrome="False"
                                                UriSource="/Assets/Fluent/save.png" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton loca:Uids.Uid="AppBarButtonCancel"
                                          Click="CancelEditsRefSourceAsync"
                                          Visibility="{x:Bind ViewModel.IsInEditRefSource, Mode=OneWay}">
                                <AppBarButton.Icon>
                                    <BitmapIcon ShowAsMonochrome="False"
                                                UriSource="/Assets/Fluent/cancel.png" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarSeparator Visibility="{x:Bind ViewModel.IsInEditRefSource, Mode=OneWay}" />
                            <AppBarButton loca:Uids.Uid="AppBarButtonBack"
                                          Background="{ThemeResource SystemAccentColor}"
                                          Click="BackRefSource_Click"
                                          Foreground="White">
                                <AppBarButton.Icon>
                                    <BitmapIcon ShowAsMonochrome="False"
                                                UriSource="/Assets/Fluent/arrowleft.png" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton loca:Uids.Uid="AppBarButtonEdit"
                                          Click="{x:Bind ViewModel.StartEditRefSource}"
                                          IsEnabled="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditRefSource), Mode=OneWay}"
                                          Visibility="{x:Bind conv:NotConverter.CollapsedIf(ViewModel.IsNewRefSource), Mode=OneWay}">
                                <AppBarButton.Icon>
                                    <BitmapIcon ShowAsMonochrome="False"
                                                UriSource="/Assets/Fluent/edit.png" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                        </CommandBar>
                        <ScrollViewer x:Name="DetailPanelRefSource"
                                      Margin="0,36,0,0"
                                      RelativePanel.AlignLeftWithPanel="True"
                                      RelativePanel.AlignRightWithPanel="True"
                                      VerticalScrollBarVisibility="Auto"
                                      VerticalScrollMode="Auto">
                            <RelativePanel Margin="4,0,0,0">
                                <TextBox x:Name="RefSourceId"
                                         MinWidth="110"
                                         Margin="{StaticResource XSmallRightMargin}"
                                         loca:Uids.Uid="TextBox_RefSourceId"
                                         IsReadOnly="True"
                                         RelativePanel.AlignLeftWithPanel="True"
                                         Text="{x:Bind ViewModel.RefSourceSelected.RefSourceId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox x:Name="RefSourceName"
                                         MinWidth="300"
                                         Margin="{StaticResource XSmallRightMargin}"
                                         loca:Uids.Uid="TextBox_RefSourceName"
                                         Background="SlateGray"
                                         CharacterCasing="Upper"
                                         Foreground="White"
                                         IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditRefSource), Mode=OneWay}"
                                         MaxLength="300"
                                         RelativePanel.RightOf="RefSourceId"
                                         Text="{x:Bind ViewModel.RefSourceSelected.RefSourceName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <CheckBox x:Name="ValidCheckRefSource"
                                          Width="80"
                                          Margin="{StaticResource SmallRightCheckBoxMargin}"
                                          VerticalAlignment="Bottom"
                                          loca:Uids.Uid="CheckBox_Valid"
                                          IsChecked="{x:Bind ViewModel.RefSourceSelected.Valid, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{x:Bind conv:NotConverter.NotCombo(ViewModel.IsInEditRefSource), Mode=OneWay}"
                                          RelativePanel.AlignLeftWithPanel="True"
                                          RelativePanel.Below="RefSourceId" />
                                <TextBox x:Name="ValidYearTextRefSource"
                                         Width="70"
                                         Margin="{StaticResource XSmallRightMargin}"
                                         loca:Uids.Uid="TextBox_ValidYear"
                                         winUiCommunity:TextBoxExtensions.Mask="9999"
                                         winUiCommunity:TextBoxExtensions.MaskPlaceholder=" "
                                         CornerRadius="3"
                                         IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditRefSource), Mode=OneWay}"
                                         RelativePanel.Below="RefSourceId"
                                         RelativePanel.RightOf="ValidCheckRefSource"
                                         Style="{StaticResource BodyTextBoxStyle}"
                                         Text="{x:Bind ViewModel.RefSourceSelected.ValidYear, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox x:Name="AuthorTextRefSource"
                                         Width="872"
                                         Margin="{StaticResource XSmallRightMargin}"
                                         HorizontalAlignment="Stretch"
                                         loca:Uids.Uid="TextBox_Author"
                                         CharacterCasing="Upper"
                                         IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditRefSource), Mode=OneWay}"
                                         MaxLength="400"
                                         RelativePanel.AlignLeftWithPanel="True"
                                         RelativePanel.Below="ValidCheckRefSource"
                                         Text="{x:Bind ViewModel.RefSourceSelected.Author, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox x:Name="AuthorYearTextRefSource"
                                         Width="70"
                                         Margin="{StaticResource XSmallRightMargin}"
                                         loca:Uids.Uid="TextBox_AuthorYear"
                                         winUiCommunity:TextBoxExtensions.Mask="9999"
                                         winUiCommunity:TextBoxExtensions.MaskPlaceholder=" "
                                         CornerRadius="3"
                                         IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditRefSource), Mode=OneWay}"
                                         RelativePanel.Below="ValidCheckRefSource"
                                         RelativePanel.RightOf="AuthorTextRefSource"
                                         Text="{x:Bind ViewModel.RefSourceSelected.SourceYear, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox x:Name="NotesRefSource"
                                         MinWidth="1120"
                                         MinHeight="50"
                                         MaxWidth="1300"
                                         MaxHeight="200"
                                         Margin="{StaticResource XSmallRightMargin}"
                                         loca:Uids.Uid="TextBox_Notes"
                                         AcceptsReturn="True"
                                         IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditRefSource), Mode=OneWay}"
                                         RelativePanel.AlignLeftWithPanel="True"
                                         RelativePanel.Below="AuthorTextRefSource"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         Text="{x:Bind ViewModel.RefSourceSelected.Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         TextWrapping="Wrap" />
                                <TextBox x:Name="InfoRefSource"
                                         MinWidth="1120"
                                         Margin="{StaticResource XSmallRightMargin}"
                                         HorizontalAlignment="Stretch"
                                         loca:Uids.Uid="TextBox_Info"
                                         IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditRefSource), Mode=OneWay}"
                                         MaxLength="100"
                                         RelativePanel.AlignLeftWithPanel="True"
                                         RelativePanel.Below="NotesRefSource"
                                         Text="{x:Bind ViewModel.RefSourceSelected.Info, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox x:Name="MemoRefSource"
                                         MinWidth="1120"
                                         MinHeight="200"
                                         MaxWidth="1300"
                                         MaxHeight="300"
                                         Margin="{StaticResource XSmallRightMargin}"
                                         loca:Uids.Uid="TextBox_Memo"
                                         AcceptsReturn="True"
                                         IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditRefSource), Mode=OneWay}"
                                         RelativePanel.AlignLeftWithPanel="True"
                                         RelativePanel.Below="InfoRefSource"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         Text="{x:Bind ViewModel.RefSourceSelected.Memo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         TextWrapping="Wrap" />
                            </RelativePanel>
                        </ScrollViewer>
                    </RelativePanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <ProgressRing x:Name="LoadingProgressRing"
                      Width="40"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                      RelativePanel.AlignHorizontalCenterWithPanel="True"
                      RelativePanel.AlignVerticalCenterWithPanel="True"
                      Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
    </RelativePanel>
</Page>
