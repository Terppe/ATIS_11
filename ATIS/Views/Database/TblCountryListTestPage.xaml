<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="ATIS.Views.Database.TblCountryListTestPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:toolkit="using:CommunityToolkit.WinUI.UI.Controls"
      xmlns:vm="using:ATIS.ViewModels">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Nur zum Test: zeigt, ob ColCountryName überhaupt Text hat -->
        <TextBlock Grid.Row="0"
                   Margin="8"
                   Text="{Binding ColCountryName}" />

        <toolkit:DataGrid Grid.Row="1"
                          ItemsSource="{Binding Countries}"
                          SelectedItem="{Binding CountrySelected, Mode=TwoWay}">
            <toolkit:DataGrid.Columns>
                <toolkit:DataGridTextColumn Binding="{Binding Name}"
                                            Header="{Binding ColCountryName}" />
            </toolkit:DataGrid.Columns>
        </toolkit:DataGrid>
    </Grid>
</Page>
