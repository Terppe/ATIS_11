<?xml version="1.0" encoding="utf-8" ?>

<Page x:Class="ATIS.Views.Database.Tbl68SpeciesgroupListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:conv="using:ATIS.Helpers.Converters"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:loca="using:WinUI3Localizer"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:models="using:ATIS.Models"
      xmlns:toolkit="using:CommunityToolkit.WinUI.UI.Controls"
      xmlns:winUiCommunity="using:WinUICommunity"
      NavigationCacheMode="Disabled"
      mc:Ignorable="d">


    <!--  SpeciesgroupListPage.xaml  Skriptdatum: 10.01.2025  10:32  -->



    <Page.Resources>
        <conv:IntToStringConverter x:Key="IntConverter" />
        <conv:DoubleToStringConverter x:Key="DoubleConverter" />

        <MenuFlyout x:Key="SpeciesgroupDataContextMenu">
            <MenuFlyoutItem loca:Uids.Uid="MenuFlyout_Save_Speciesgroup"
                            Click="SaveSpeciesgroup_Click">
                <MenuFlyoutItem.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/save.png" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem loca:Uids.Uid="MenuFlyout_Delete_Speciesgroup"
                            Click="DeleteSpeciesgroup_Click">
                <MenuFlyoutItem.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/delete.png" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem loca:Uids.Uid="MenuFlyout_Add_Speciesgroup"
                            Click="AddSpeciesgroup_Click">
                <MenuFlyoutItem.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/add.png" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem loca:Uids.Uid="MenuFlyout_Refresh"
                            Click="Refresh_Click">
                <MenuFlyoutItem.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/refresh.png" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>
    </Page.Resources>

    <RelativePanel x:Name="SpeciesgroupRoot"
                   Margin="{StaticResource SmallLeftTopRightBottomMargin}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource LargeWindowSnapPoint}" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource MediumWindowSnapPoint}" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource MinWindowSnapPoint}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SpeciesgroupCommandBar.DefaultLabelPosition" Value="Bottom" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <TextBlock x:Name="PageTitle"
                   loca:Uids.Uid="TextBlock_Speciesgroups"
                   RelativePanel.AlignLeftWithPanel="True"
                   Style="{StaticResource PageTitleTextBlockStyle}" />
        <TextBlock x:Name="SpeciesgroupDatasetText"
                   Margin="5,17,0,0"
                   loca:Uids.Uid="TextBlock_DataSetCount"
                   RelativePanel.RightOf="PageTitle"
                   Style="{StaticResource DatasetTitleStyle}" />
        <TextBlock x:Name="SpeciesgroupDatasetCountText"
                   Margin="5,17,0,0"
                   RelativePanel.RightOf="SpeciesgroupDatasetText"
                   Style="{StaticResource DatasetTitleStyle}"
                   Text="{x:Bind ViewModel.SpeciesgroupDataSetCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <CommandBar x:Name="SpeciesgroupCommandBar"
                    HorizontalAlignment="Stretch"
                    Background="Transparent"
                    DefaultLabelPosition="Right"
                    RelativePanel.LeftOf="SpeciesgroupSearchBox"
                    RelativePanel.RightOf="SpeciesgroupDatasetCountText">
            <AppBarButton x:Name="AppBarButtonDeleteSpeciesgroup"
                          loca:Uids.Uid="AppBarButtonDeleteSpeciesgroup"
                          Click="DeleteSpeciesgroup_Click"
                          IsEnabled="{x:Bind conv:NotConverter.IsNotNull(ViewModel.SpeciesgroupSelected), Mode=OneWay}">
                <AppBarButton.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/delete.png" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton x:Name="AppBarButtonAddSpeciesgroup"
                          loca:Uids.Uid="AppBarButtonAddSpeciesgroup"
                          Background="{ThemeResource SystemAccentColor}"
                          Click="AddSpeciesgroup_Click"
                          Foreground="White">
                <AppBarButton.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/add.png" />
                </AppBarButton.Icon>
            </AppBarButton>
            <!--<AppBarButton x:Name="AppBarButtonAddSpecies"
                          loca:Uids.Uid="AppBarButtonAddSpecies"
                          Click="AddSpecies_Click"
                          IsEnabled="{x:Bind conv:NotConverter.IsNotNull(ViewModel.SpeciesgroupSelected), Mode=OneWay}">
                <AppBarButton.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/add.png" />
                </AppBarButton.Icon>
            </AppBarButton>-->
            <AppBarButton x:Name="AppBarButtonSync"
                          loca:Uids.Uid="AppBarButtonSync"
                          Click="Refresh_Click"
                          IsEnabled="{x:Bind conv:NotConverter.IsNotNull(ViewModel.SpeciesgroupSelected), Mode=OneWay}">
                <AppBarButton.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/refresh.png" />
                </AppBarButton.Icon>
            </AppBarButton>
        </CommandBar>

        <AutoSuggestBox Name="SpeciesgroupSearchBox"
                        Width="200"
                        Margin="4,8,4,0"
                        loca:Uids.Uid="AutoSuggestBox_Search"
                        Loaded="SpeciesgroupSearchBox_OnLoaded"
                        QuerySubmitted="GetSpeciesgroupsByNameOrId"
                        RelativePanel.AlignRightWithPanel="True">
            <AutoSuggestBox.QueryIcon>
                <BitmapIcon ShowAsMonochrome="False"
                            UriSource="/Assets/Fluent/search.png" />
            </AutoSuggestBox.QueryIcon>
        </AutoSuggestBox>

        <ScrollViewer x:Name="PanelSpeciesgroup"
                      RelativePanel.AlignLeftWithPanel="True"
                      RelativePanel.AlignRightWithPanel="True"
                      RelativePanel.Below="PageTitle"
                      VerticalScrollBarVisibility="Auto"
                      VerticalScrollMode="Auto">

            <StackPanel Margin="-10,8,4,0">
                <StackPanel.Resources>
                    <Style TargetType="Expander">
                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                    </Style>
                </StackPanel.Resources>
                <toolkit:DataGrid x:Name="SpeciesgroupDataGrid"
                                  MaxHeight="330"
                                  Margin="0,0,20,0"
                                  VerticalAlignment="Top"
                                  x:FieldModifier="public"
                                  AlternatingRowBackground="LightGray"
                                  AutoGenerateColumns="False"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  CanUserReorderColumns="False"
                                  CanUserResizeColumns="False"
                                  ContextFlyout="{StaticResource SpeciesgroupDataContextMenu}"
                                  CurrentCellChanged="SpeciesgroupDataGrid_OnCurrentCellChanged"
                                  GridLinesVisibility="Horizontal"
                                  ItemsSource="{x:Bind ViewModel.SpeciesgroupItems}"
                                  SelectedItem="{x:Bind ViewModel.SpeciesgroupSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  SelectionMode="Single"
                                  Sorting="SpeciesgroupDataGrid_Sorting">
                    <toolkit:DataGrid.Columns>
                        <toolkit:DataGridTemplateColumn loca:Uids.Uid="DataGridTemplateColumn_SpeciesgroupId"
                                                        Tag="SpeciesgroupId">
                            <toolkit:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:Tbl68Speciesgroup">
                                    <HyperlinkButton Margin="12,0"
                                                     BorderThickness="0"
                                                     Click="ViewSpeciesgroupHyperlinkButton_Click"
                                                     Content="{Binding SpeciesgroupId}" />
                                </DataTemplate>
                            </toolkit:DataGridTemplateColumn.CellTemplate>
                        </toolkit:DataGridTemplateColumn>
                        <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_SpeciesgroupName"
                                                    Binding="{Binding SpeciesgroupName}"
                                                    CanUserSort="True"
                                                    Tag="SpeciesgroupName" />
                        <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_Subspeciesgroup"
                                                    Binding="{Binding Subspeciesgroup}"
                                                    CanUserSort="True"
                                                    Tag="Subspeciesgroup" />
                        <toolkit:DataGridCheckBoxColumn loca:Uids.Uid="DataGridCheckBoxColumn_Valid"
                                                        Binding="{Binding Valid}"
                                                        Tag="Valid" />
                        <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_ValidYear"
                                                    Binding="{Binding ValidYear}"
                                                    Tag="ValidYear" />
                        <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_Author"
                                                    Binding="{Binding Author}"
                                                    Tag="Author" />
                        <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_AuthorYear"
                                                    Binding="{Binding AuthorYear}"
                                                    Tag="AuthorYear" />
                        <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_Info"
                                                    Binding="{Binding Info}"
                                                    Tag="Info" />
                    </toolkit:DataGrid.Columns>
                </toolkit:DataGrid>

                <!--  SpeciesgroupDetailExpander  -->
                <Expander x:Name="SpeciesgroupDetailExpander"
                          Margin="{StaticResource XSmallTopBottomMargin}"
                          Visibility="Collapsed">
                    <Expander.Header>
                        <Grid>
                            <TextBlock loca:Uids.Uid="TextBlock_Speciesgroup"
                                       Style="{ThemeResource SubtitleTextBlockStyle}" />
                            <TextBlock HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Text="{x:Bind ViewModel.SpeciesgroupSelected.SpeciesgroupName, Mode=OneWay}" />
                        </Grid>
                    </Expander.Header>

                    <RelativePanel x:Name="SpeciesgroupDetailRoot"
                                   Margin="{StaticResource SmallLeftRightMargin}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup>
                                <VisualState>
                                    <VisualState.StateTriggers>
                                        <AdaptiveTrigger MinWindowWidth="{StaticResource LargeWindowSnapPoint}" />
                                    </VisualState.StateTriggers>
                                </VisualState>
                                <VisualState>
                                    <VisualState.StateTriggers>
                                        <AdaptiveTrigger MinWindowWidth="{StaticResource MediumWindowSnapPoint}" />
                                    </VisualState.StateTriggers>
                                </VisualState>
                                <VisualState>
                                    <VisualState.StateTriggers>
                                        <AdaptiveTrigger MinWindowWidth="{StaticResource MinWindowSnapPoint}" />
                                    </VisualState.StateTriggers>
                                    <VisualState.Setters>
                                        <Setter Target="SpeciesgroupCommandBar.DefaultLabelPosition" Value="Bottom" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <CommandBar x:Name="SpeciesgroupDetailCommandBar"
                                    Margin="{StaticResource SmallLeftRightCommandBarMargin}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Top"
                                    Background="Transparent"
                                    DefaultLabelPosition="Right"
                                    RelativePanel.AlignRightWithPanel="True">
                            <AppBarButton loca:Uids.Uid="AppBarButtonSave"
                                          Background="{ThemeResource SystemBaseLowColor}"
                                          Click="SaveSpeciesgroup_Click"
                                          Foreground="White"
                                          Visibility="{x:Bind ViewModel.IsInEditSpeciesgroup, Mode=OneWay}">
                                <AppBarButton.Icon>
                                    <BitmapIcon ShowAsMonochrome="False"
                                                UriSource="/Assets/Fluent/save.png" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton loca:Uids.Uid="AppBarButtonCancel"
                                          Click="CancelEditsSpeciesgroupAsync"
                                          Visibility="{x:Bind ViewModel.IsInEditSpeciesgroup, Mode=OneWay}">
                                <AppBarButton.Icon>
                                    <BitmapIcon ShowAsMonochrome="False"
                                                UriSource="/Assets/Fluent/cancel.png" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarSeparator Visibility="{x:Bind ViewModel.IsInEditSpeciesgroup, Mode=OneWay}" />
                            <AppBarButton loca:Uids.Uid="AppBarButtonBack"
                                          Background="{ThemeResource SystemAccentColor}"
                                          Click="BackSpeciesgroup_Click"
                                          Foreground="White">
                                <AppBarButton.Icon>
                                    <BitmapIcon ShowAsMonochrome="False"
                                                UriSource="/Assets/Fluent/arrowleft.png" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton loca:Uids.Uid="AppBarButtonEdit"
                                          Click="{x:Bind ViewModel.StartEditSpeciesgroup}"
                                          IsEnabled="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditSpeciesgroup), Mode=OneWay}"
                                          Visibility="{x:Bind conv:NotConverter.CollapsedIf(ViewModel.IsNewSpeciesgroup), Mode=OneWay}">
                                <AppBarButton.Icon>
                                    <BitmapIcon ShowAsMonochrome="False"
                                                UriSource="/Assets/Fluent/edit.png" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                        </CommandBar>
                        <ScrollViewer x:Name="DetailPanelSpeciesgroup"
                                      Margin="0,36,0,0"
                                      RelativePanel.AlignLeftWithPanel="True"
                                      RelativePanel.AlignRightWithPanel="True"
                                      VerticalScrollBarVisibility="Auto"
                                      VerticalScrollMode="Auto">
                            <RelativePanel Margin="4,0,0,0">
                                <TextBox x:Name="SpeciesgroupId"
                                         MinWidth="110"
                                         Margin="{StaticResource XSmallRightMargin}"
                                         loca:Uids.Uid="TextBox_SpeciesgroupId"
                                         IsReadOnly="True"
                                         RelativePanel.AlignLeftWithPanel="True"
                                         Text="{x:Bind ViewModel.SpeciesgroupSelected.SpeciesgroupId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox x:Name="SpeciesgroupName"
                                         MinWidth="150"
                                         Margin="{StaticResource XSmallRightMargin}"
                                         loca:Uids.Uid="TextBox_SpeciesgroupName"
                                         Background="SlateGray"
                                         Foreground="White"
                                         IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditSpeciesgroup), Mode=OneWay}"
                                         LostFocus="SpeciesgroupName_OnLostFocus"
                                         MaxLength="100"
                                         RelativePanel.RightOf="SpeciesgroupId"
                                         Text="{x:Bind ViewModel.SpeciesgroupSelected.SpeciesgroupName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox x:Name="SubspeciesgroupName"
                                         MinWidth="150"
                                         Margin="{StaticResource XSmallRightMargin}"
                                         loca:Uids.Uid="TextBox_Subspeciesgroup"
                                         CharacterCasing="Lower"
                                         IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditSpeciesgroup), Mode=OneWay}"
                                         MaxLength="100"
                                         RelativePanel.RightOf="SpeciesgroupName"
                                         Text="{x:Bind ViewModel.SpeciesgroupSelected.Subspeciesgroup, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <CheckBox x:Name="ValidCheckSpeciesgroup"
                                          Width="80"
                                          Margin="{StaticResource SmallRightCheckBoxMargin}"
                                          VerticalAlignment="Bottom"
                                          loca:Uids.Uid="CheckBox_Valid"
                                          IsChecked="{x:Bind ViewModel.SpeciesgroupSelected.Valid, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{x:Bind conv:NotConverter.NotCombo(ViewModel.IsInEditSpeciesgroup), Mode=OneWay}"
                                          RelativePanel.RightOf="SubspeciesgroupName" />
                                <TextBox x:Name="ValidYearTextSpeciesgroup"
                                         Width="70"
                                         Margin="{StaticResource XSmallRightMargin}"
                                         loca:Uids.Uid="TextBox_ValidYear"
                                         winUiCommunity:TextBoxExtensions.Mask="9999"
                                         winUiCommunity:TextBoxExtensions.MaskPlaceholder=" "
                                         CornerRadius="3"
                                         IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditSpeciesgroup), Mode=OneWay}"
                                         RelativePanel.RightOf="ValidCheckSpeciesgroup"
                                         Style="{StaticResource BodyTextBoxStyle}"
                                         Text="{x:Bind ViewModel.SpeciesgroupSelected.ValidYear, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox x:Name="AuthorTextSpeciesgroup"
                                         MinWidth="150"
                                         Margin="{StaticResource XSmallRightMargin}"
                                         HorizontalAlignment="Stretch"
                                         loca:Uids.Uid="TextBox_Author"
                                         CharacterCasing="Upper"
                                         IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditSpeciesgroup), Mode=OneWay}"
                                         MaxLength="60"
                                         RelativePanel.AlignLeftWithPanel="True"
                                         RelativePanel.Below="SpeciesgroupId"
                                         Text="{x:Bind ViewModel.SpeciesgroupSelected.Author, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox x:Name="AuthorYearTextSpeciesgroup"
                                         Width="70"
                                         Margin="{StaticResource XSmallRightMargin}"
                                         loca:Uids.Uid="TextBox_AuthorYear"
                                         winUiCommunity:TextBoxExtensions.Mask="9999"
                                         winUiCommunity:TextBoxExtensions.MaskPlaceholder=" "
                                         CornerRadius="3"
                                         IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditSpeciesgroup), Mode=OneWay}"
                                         RelativePanel.Below="SpeciesgroupId"
                                         RelativePanel.RightOf="AuthorTextSpeciesgroup"
                                         Text="{x:Bind ViewModel.SpeciesgroupSelected.AuthorYear, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox x:Name="InfoSpeciesgroup"
                                         MinWidth="1120"
                                         Margin="{StaticResource XSmallRightMargin}"
                                         HorizontalAlignment="Stretch"
                                         loca:Uids.Uid="TextBox_Info"
                                         IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditSpeciesgroup), Mode=OneWay}"
                                         MaxLength="100"
                                         RelativePanel.AlignLeftWithPanel="True"
                                         RelativePanel.Below="AuthorTextSpeciesgroup"
                                         Text="{x:Bind ViewModel.SpeciesgroupSelected.Info, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox x:Name="SynonymSpeciesgroup"
                                         MinWidth="1120"
                                         MinHeight="75"
                                         MaxWidth="1300"
                                         MaxHeight="150"
                                         Margin="{StaticResource XSmallRightMargin}"
                                         loca:Uids.Uid="TextBox_Synonym"
                                         AcceptsReturn="True"
                                         IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditSpeciesgroup), Mode=OneWay}"
                                         RelativePanel.AlignLeftWithPanel="True"
                                         RelativePanel.Below="InfoSpeciesgroup"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         Text="{x:Bind ViewModel.SpeciesgroupSelected.Synonym, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         TextWrapping="Wrap" />
                                <TabView x:Name="TabViewLanguageSpeciesgroup"
                                         MinWidth="1120"
                                         MaxWidth="1300"
                                         Margin="{StaticResource XSmallRightMargin}"
                                         Background="LightBlue"
                                         CornerRadius="3"
                                         IsAddTabButtonVisible="False"
                                         RelativePanel.AlignLeftWithPanel="True"
                                         RelativePanel.Below="SynonymSpeciesgroup">
                                    <TabView.TabItems>
                                        <TabViewItem loca:Uids.Uid="TabViewItem_EngName"
                                                     IsClosable="False">
                                            <TextBox Margin="{StaticResource XSmallRightMargin}"
                                                     IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditSpeciesgroup), Mode=OneWay}"
                                                     MaxLength="200"
                                                     Text="{x:Bind ViewModel.SpeciesgroupSelected.EngName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </TabViewItem>
                                        <TabViewItem loca:Uids.Uid="TabViewItem_GerName"
                                                     IsClosable="False">
                                            <TextBox Margin="{StaticResource XSmallRightMargin}"
                                                     IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditSpeciesgroup), Mode=OneWay}"
                                                     MaxLength="200"
                                                     Text="{x:Bind ViewModel.SpeciesgroupSelected.GerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </TabViewItem>
                                        <TabViewItem loca:Uids.Uid="TabViewItem_FraName"
                                                     IsClosable="False">
                                            <TextBox Margin="{StaticResource XSmallRightMargin}"
                                                     IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditSpeciesgroup), Mode=OneWay}"
                                                     MaxLength="200"
                                                     Text="{x:Bind ViewModel.SpeciesgroupSelected.FraName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </TabViewItem>
                                        <TabViewItem loca:Uids.Uid="TabViewItem_SpaName"
                                                     IsClosable="False">
                                            <TextBox Margin="{StaticResource XSmallRightMargin}"
                                                     IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditSpeciesgroup), Mode=OneWay}"
                                                     MaxLength="200"
                                                     Text="{x:Bind ViewModel.SpeciesgroupSelected.PorName, Mode=TwoWay}" />
                                        </TabViewItem>
                                    </TabView.TabItems>
                                </TabView>
                                <TextBox x:Name="MemoSpeciesgroup"
                                         MinWidth="1120"
                                         MinHeight="75"
                                         MaxWidth="1300"
                                         MaxHeight="150"
                                         Margin="{StaticResource XSmallRightMargin}"
                                         loca:Uids.Uid="TextBox_Memo"
                                         AcceptsReturn="True"
                                         IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditSpeciesgroup), Mode=OneWay}"
                                         RelativePanel.AlignLeftWithPanel="True"
                                         RelativePanel.Below="TabViewLanguageSpeciesgroup"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         Text="{x:Bind ViewModel.SpeciesgroupSelected.Memo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         TextWrapping="Wrap" />
                            </RelativePanel>
                        </ScrollViewer>
                    </RelativePanel>
                </Expander>

                <!--  SpeciesDetailExpander  -->
                <Expander x:Name="SpeciesDetailExpander"
                          Margin="{StaticResource XSmallTopBottomMargin}"
                          Visibility="Collapsed">
                    <Expander.Header>
                        <Grid>
                            <TextBlock loca:Uids.Uid="TextBlock_FiSpecies"
                                       Style="{ThemeResource SubtitleTextBlockStyle}" />
                            <StackPanel HorizontalAlignment="Right"
                                        Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Text="{x:Bind ViewModel.SpeciesSelected.Tbl66Genusses.GenusName, Mode=OneWay}" />
                                <TextBlock Margin="2,0,0,0"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Text="{x:Bind ViewModel.SpeciesSelected.SpeciesName, Mode=OneWay}" />
                                <TextBlock Margin="2,0,0,0"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Text="{x:Bind ViewModel.SpeciesSelected.Subspecies, Mode=OneWay}" />
                                <TextBlock Margin="2,0,0,0"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Text="{x:Bind ViewModel.SpeciesSelected.Divers, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                    </Expander.Header>
                    <RelativePanel x:Name="SpeciesDetailRoot"
                                   Margin="{StaticResource SmallLeftRightMargin}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup>
                                <VisualState>
                                    <VisualState.StateTriggers>
                                        <AdaptiveTrigger MinWindowWidth="{StaticResource LargeWindowSnapPoint}" />
                                    </VisualState.StateTriggers>
                                </VisualState>
                                <VisualState>
                                    <VisualState.StateTriggers>
                                        <AdaptiveTrigger MinWindowWidth="{StaticResource MediumWindowSnapPoint}" />
                                    </VisualState.StateTriggers>
                                </VisualState>
                                <VisualState>
                                    <VisualState.StateTriggers>
                                        <AdaptiveTrigger MinWindowWidth="{StaticResource MinWindowSnapPoint}" />
                                    </VisualState.StateTriggers>
                                    <VisualState.Setters>
                                        <Setter Target="FiSpeciesCommandBar.DefaultLabelPosition" Value="Bottom" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <CommandBar x:Name="SpeciesDetailCommandBar"
                                    Margin="{StaticResource SmallLeftRightCommandBarMargin}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Top"
                                    Background="Transparent"
                                    DefaultLabelPosition="Right"
                                    RelativePanel.AlignRightWithPanel="True">
                            <AppBarButton loca:Uids.Uid="AppBarButtonSave"
                                          Background="{ThemeResource SystemBaseLowColor}"
                                          Click="SaveSpecies_Click"
                                          Foreground="White"
                                          Visibility="{x:Bind ViewModel.IsInEditSpecies, Mode=OneWay}">
                                <AppBarButton.Icon>
                                    <BitmapIcon ShowAsMonochrome="False"
                                                UriSource="/Assets/Fluent/save.png" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <!--<AppBarButton loca:Uids.Uid="AppBarButtonAddSpecies"
                                          Click="AddSpecies_Click"
                                          IsEnabled="{x:Bind conv:NotConverter.IsNotNull(ViewModel.SpeciesSelected), Mode=OneWay}">
                                <AppBarButton.Icon>
                                    <BitmapIcon ShowAsMonochrome="False"
                                                UriSource="/Assets/Fluent/add.png" />
                                </AppBarButton.Icon>
                            </AppBarButton>-->
                            <AppBarButton loca:Uids.Uid="AppBarButtonCancel"
                                          Click="CancelEditsSpeciesAsync"
                                          Visibility="{x:Bind ViewModel.IsInEditSpecies, Mode=OneWay}">
                                <AppBarButton.Icon>
                                    <BitmapIcon ShowAsMonochrome="False"
                                                UriSource="/Assets/Fluent/cancel.png" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarSeparator Visibility="{x:Bind ViewModel.IsInEditSpecies, Mode=OneWay}" />
                            <AppBarButton loca:Uids.Uid="AppBarButtonBack"
                                          Background="{ThemeResource SystemAccentColor}"
                                          Click="BackSpecies_Click"
                                          Foreground="White">
                                <AppBarButton.Icon>
                                    <BitmapIcon ShowAsMonochrome="False"
                                                UriSource="/Assets/Fluent/arrowleft.png" />
