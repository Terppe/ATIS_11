                                                 Text="{x:Bind ViewModel.SpeciesSelected.MemoSozial, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 TextWrapping="Wrap" />
                                        <TextBox x:Name="MemoDomorphismFiSpecies"
                                                 MinWidth="1120"
                                                 MinHeight="75"
                                                 MaxWidth="1300"
                                                 MaxHeight="100"
                                                 Margin="{StaticResource XSmallRightMargin}"
                                                 loca:Uids.Uid="TextBox_MemoDomorphism"
                                                 AcceptsReturn="True"
                                                 IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditSpecies), Mode=OneWay}"
                                                 RelativePanel.Below="MemoSozialFiSpecies"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 Text="{x:Bind ViewModel.SpeciesSelected.MemoDomorphism, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 TextWrapping="Wrap" />
                                    </RelativePanel>
                                </Expander>
                                <Expander x:Name="SpecialExpanderFiSpecies">
                                    <Expander.Header>
                                        <Grid>
                                            <TextBlock loca:Uids.Uid="TextBlock_Special"
                                                       Style="{ThemeResource SubtitleTextBlockStyle}" />
                                        </Grid>
                                    </Expander.Header>
                                    <RelativePanel>
                                        <TextBox x:Name="MemoSpecialFiSpecies"
                                                 MinWidth="1120"
                                                 MinHeight="75"
                                                 MaxWidth="1300"
                                                 MaxHeight="150"
                                                 Margin="{StaticResource XSmallRightMargin}"
                                                 loca:Uids.Uid="TextBox_MemoSpecial"
                                                 AcceptsReturn="True"
                                                 IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditSpecies), Mode=OneWay}"
                                                 RelativePanel.AlignLeftWithPanel="True"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 Text="{x:Bind ViewModel.SpeciesSelected.MemoSpecial, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 TextWrapping="Wrap" />
                                    </RelativePanel>
                                </Expander>
                                <Expander x:Name="CultureExpanderPlSpecies">
                                    <Expander.Header>
                                        <Grid>
                                            <TextBlock loca:Uids.Uid="TextBlock_Culture"
                                                       Style="{ThemeResource SubtitleTextBlockStyle}" />
                                        </Grid>
                                    </Expander.Header>
                                    <RelativePanel>
                                        <TextBox x:Name="MemoCulturePlSpecies"
                                                 MinWidth="1120"
                                                 MaxWidth="1300"
                                                 MaxHeight="150"
                                                 Margin="{StaticResource XSmallRightMargin}"
                                                 loca:Uids.Uid="TextBox_MemoCulture"
                                                 AcceptsReturn="True"
                                                 IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditSpecies), Mode=OneWay}"
                                                 RelativePanel.AlignLeftWithPanel="True"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 Text="{x:Bind ViewModel.SpeciesSelected.MemoCulture, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </RelativePanel>
                                </Expander>
                                <Expander x:Name="ReproductionExpanderPlSpecies">
                                    <Expander.Header>
                                        <Grid>
                                            <TextBlock loca:Uids.Uid="TextBlock_Reproduction"
                                                       Style="{ThemeResource SubtitleTextBlockStyle}" />
                                        </Grid>
                                    </Expander.Header>
                                    <RelativePanel>
                                        <TextBox x:Name="MemoReproductionPlSpecies"
                                                 MinWidth="1120"
                                                 MaxWidth="1300"
                                                 MaxHeight="150"
                                                 Margin="{StaticResource XSmallRightMargin}"
                                                 loca:Uids.Uid="TextBox_MemoReproduction"
                                                 AcceptsReturn="True"
                                                 IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditSpecies), Mode=OneWay}"
                                                 RelativePanel.AlignLeftWithPanel="True"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 Text="{x:Bind ViewModel.SpeciesSelected.MemoReproduction, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 TextWrapping="Wrap" />
                                    </RelativePanel>
                                </Expander>
                                <Expander x:Name="GlobalExpanderPlSpecies">
                                    <Expander.Header>
                                        <Grid>
                                            <TextBlock loca:Uids.Uid="TextBlock_Global"
                                                       Style="{ThemeResource SubtitleTextBlockStyle}" />
                                        </Grid>
                                    </Expander.Header>
                                    <RelativePanel>
                                        <TextBox x:Name="MemoGlobalPlSpecies"
                                                 MinWidth="1120"
                                                 MaxWidth="1300"
                                                 MaxHeight="150"
                                                 Margin="{StaticResource XSmallRightMargin}"
                                                 loca:Uids.Uid="TextBox_MemoGlobal"
                                                 AcceptsReturn="True"
                                                 IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditSpecies), Mode=OneWay}"
                                                 RelativePanel.AlignLeftWithPanel="True"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 Text="{x:Bind ViewModel.SpeciesSelected.MemoGlobal, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 TextWrapping="Wrap" />
                                    </RelativePanel>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                    </RelativePanel>
                </Expander>

                <!--  SpeciessesExpander  -->
                <Expander x:Name="SpeciessesExpander"
                          Margin="{StaticResource XSmallTopBottomMargin}"
                          IsExpanded="True"
                          Visibility="Collapsed">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="SpeciessesTitle"
                                       loca:Uids.Uid="TextBlock_Speciesses"
                                       Style="{ThemeResource PageTitleTextBlockStyle}" />
                            <TextBlock x:Name="SpeciessesDatasetText"
                                       Margin="5,0,0,2"
                                       loca:Uids.Uid="TextBlock_DataSetCount"
                                       Style="{StaticResource DatasetTitleStyle}" />
                            <TextBlock x:Name="SpeciessesDatasetCountText"
                                       Margin="5,0,0,2"
                                       Style="{StaticResource DatasetTitleStyle}"
                                       Text="{x:Bind ViewModel.SpeciesDataSetCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Expander.Header>
                    <Grid Margin="0,4,0,0">
                        <toolkit:DataGrid x:Name="SpeciesDataGrid"
                                          MaxHeight="230"
                                          Margin="0,0,20,0"
                                          VerticalAlignment="Top"
                                          x:FieldModifier="public"
                                          AlternatingRowBackground="LightGray"
                                          AutoGenerateColumns="False"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          CanUserReorderColumns="False"
                                          CanUserResizeColumns="False"
                                          GridLinesVisibility="Horizontal"
                                          ItemsSource="{x:Bind ViewModel.SpeciesItems, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.SpeciesSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          SelectionMode="Single"
                                          Sorting="DataGrid_Species_Sorting">
                            <toolkit:DataGrid.Columns>
                                <toolkit:DataGridTemplateColumn loca:Uids.Uid="DataGridTemplateColumn_SpeciesId"
                                                                Tag="SpeciesId">
                                    <toolkit:DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="models:Tbl75Species">
                                            <HyperlinkButton Margin="12,0"
                                                             BorderThickness="0"
                                                             Click="ViewSpeciesHyperlinkButton_Click"
                                                             Content="{Binding SpeciesId}" />
                                        </DataTemplate>
                                    </toolkit:DataGridTemplateColumn.CellTemplate>
                                </toolkit:DataGridTemplateColumn>
                                <toolkit:DataGridComboBoxColumn loca:Uids.Uid="DataGridComboBoxColumn_GenusName"
                                                                Binding="{Binding GenusId}"
                                                                DisplayMemberPath="GenusName"
                                                                ItemsSource="{x:Bind ViewModel.Tbl66GenussesAllList, Mode=OneWay}" />
                                <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_SpeciesName"
                                                            Binding="{Binding SpeciesName}"
                                                            CanUserSort="True"
                                                            Tag="SpeciesName" />
                                <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_Subspecies"
                                                            Binding="{Binding Subspecies}"
                                                            CanUserSort="True"
                                                            Tag="Subspecies" />
                                <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_Divers"
                                                            Binding="{Binding Divers}"
                                                            CanUserSort="True"
                                                            Tag="Divers" />
                                <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_Creature"
                                                            Binding="{Binding Creature}"
                                                            Tag="Creature" />
                                <toolkit:DataGridComboBoxColumn loca:Uids.Uid="DataGridComboBoxColumn_SpeciesgroupName"
                                                                Binding="{Binding SpeciesgroupId}"
                                                                DisplayMemberPath="SpeciesgroupFullName"
                                                                ItemsSource="{x:Bind ViewModel.Tbl68SpeciesgroupsAllList, Mode=OneWay}" />
                                <toolkit:DataGridCheckBoxColumn loca:Uids.Uid="DataGridCheckBoxColumn_Valid"
                                                                Binding="{Binding Valid}"
                                                                Tag="Valid" />
                                <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_Author"
                                                            Binding="{Binding Author}"
                                                            Tag="Author" />
                                <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_AuthorYear"
                                                            Binding="{Binding AuthorYear}"
                                                            Tag="AuthorYear" />
                            </toolkit:DataGrid.Columns>
                        </toolkit:DataGrid>
                    </Grid>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <ProgressRing x:Name="LoadingProgressRing"
                      Width="40"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                      RelativePanel.AlignHorizontalCenterWithPanel="True"
                      RelativePanel.AlignVerticalCenterWithPanel="True"
                      Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
    </RelativePanel>
</Page>
