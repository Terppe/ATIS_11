<?xml version="1.0" encoding="utf-8" ?>

<Page x:Class="ATIS.Views.Database.Tbl90ReferenceListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:conv="using:ATIS.Helpers.Converters"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:loca="using:WinUI3Localizer"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:models="using:ATIS.Models"
      xmlns:toolkit="using:CommunityToolkit.WinUI.UI.Controls"
      xmlns:winUiCommunity="using:WinUICommunity"
      NavigationCacheMode="Disabled"
      mc:Ignorable="d">

    <!--  ReferenceListPage.xaml  Skriptdatum: 06.01.2025  10:32  -->

    <Page.Resources>

        <MenuFlyout x:Key="ReferenceDataContextMenu">
            <MenuFlyoutItem loca:Uids.Uid="MenuFlyout_Save_Reference"
                            Click="SaveReference_Click">
                <MenuFlyoutItem.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/save.png" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem loca:Uids.Uid="MenuFlyout_Delete_Reference"
                            Click="DeleteReference_Click">
                <MenuFlyoutItem.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/delete.png" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem loca:Uids.Uid="MenuFlyout_Add_Reference"
                            Click="AddReference_Click">
                <MenuFlyoutItem.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/add.png" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem loca:Uids.Uid="MenuFlyout_Refresh"
                            Click="Refresh_Click">
                <MenuFlyoutItem.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/refresh.png" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>
    </Page.Resources>

    <RelativePanel x:Name="ReferenceRoot"
                   Margin="{StaticResource SmallLeftTopRightBottomMargin}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource LargeWindowSnapPoint}" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource MediumWindowSnapPoint}" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource MinWindowSnapPoint}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ReferenceCommandBar.DefaultLabelPosition" Value="Bottom" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <TextBlock x:Name="PageTitle"
                   loca:Uids.Uid="TextBlock_References"
                   RelativePanel.AlignLeftWithPanel="True"
                   Style="{StaticResource PageTitleTextBlockStyle}" />
        <TextBlock x:Name="ReferenceDatasetText"
                   Margin="5,17,0,0"
                   loca:Uids.Uid="TextBlock_DataSetCount"
                   RelativePanel.RightOf="PageTitle"
                   Style="{StaticResource DatasetTitleStyle}" />
        <TextBlock x:Name="ReferenceDatasetCountText"
                   Margin="5,17,0,0"
                   RelativePanel.RightOf="ReferenceDatasetText"
                   Style="{StaticResource DatasetTitleStyle}"
                   Text="{x:Bind ViewModel.ReferenceDataSetCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <CommandBar x:Name="ReferenceCommandBar"
                    HorizontalAlignment="Stretch"
                    Background="Transparent"
                    DefaultLabelPosition="Right"
                    RelativePanel.LeftOf="ReferenceSearchBox"
                    RelativePanel.RightOf="ReferenceDatasetCountText">
            <AppBarButton x:Name="AppBarButtonDeleteReference"
                          loca:Uids.Uid="AppBarButtonDeleteReference"
                          Click="DeleteReference_Click"
                          IsEnabled="{x:Bind conv:NotConverter.IsNotNull(ViewModel.ReferenceSelected), Mode=OneWay}">
                <AppBarButton.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/delete.png" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton loca:Uids.Uid="AppBarButtonAddReference"
                          Background="{ThemeResource SystemAccentColor}"
                          Click="AddReference_Click"
                          Foreground="White">
                <AppBarButton.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/add.png" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="AppBarButtonSync"
                          loca:Uids.Uid="AppBarButtonSync"
                          Click="Refresh_Click"
                          IsEnabled="{x:Bind conv:NotConverter.IsNotNull(ViewModel.ReferenceSelected), Mode=OneWay}">
                <AppBarButton.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/refresh.png" />
                </AppBarButton.Icon>
            </AppBarButton>
        </CommandBar>

        <AutoSuggestBox Name="ReferenceSearchBox"
                        Width="200"
                        Margin="4,8,4,0"
                        loca:Uids.Uid="AutoSuggestBox_Search"
                        Loaded="ReferenceSearchBox_OnLoaded"
                        QuerySubmitted="GetReferencesByInfoOrId"
                        RelativePanel.AlignRightWithPanel="True">
            <AutoSuggestBox.QueryIcon>
                <BitmapIcon ShowAsMonochrome="False"
                            UriSource="/Assets/Fluent/search.png" />
            </AutoSuggestBox.QueryIcon>
        </AutoSuggestBox>

        <ScrollViewer x:Name="PanelReference"
                      RelativePanel.AlignLeftWithPanel="True"
                      RelativePanel.AlignRightWithPanel="True"
                      RelativePanel.Below="PageTitle"
                      VerticalScrollBarVisibility="Auto"
                      VerticalScrollMode="Auto">
            <StackPanel Margin="-10,8,4,0">
                <StackPanel.Resources>
                    <Style TargetType="Expander">
                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                    </Style>
                </StackPanel.Resources>
                <toolkit:DataGrid x:Name="ReferenceDataGrid"
                                  MaxHeight="230"
                                  Margin="0,0,20,0"
                                  VerticalAlignment="Top"
                                  x:FieldModifier="public"
                                  AlternatingRowBackground="LightGray"
                                  AutoGenerateColumns="False"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  CanUserReorderColumns="False"
                                  CanUserResizeColumns="False"
                                  ContextFlyout="{StaticResource ReferenceDataContextMenu}"
                                  CurrentCellChanged="ReferenceDataGrid_OnCurrentCellChanged"
                                  GridLinesVisibility="Horizontal"
                                  ItemsSource="{x:Bind ViewModel.ReferenceItems}"
                                  SelectedItem="{x:Bind ViewModel.ReferenceSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  SelectionMode="Single"
                                  Sorting="ReferenceDataGrid_Sorting">
                    <toolkit:DataGrid.Columns>
                        <toolkit:DataGridTemplateColumn loca:Uids.Uid="DataGridTemplateColumn_ReferenceId"
                                                        Tag="ReferenceId">
                            <toolkit:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:Tbl90Reference">
                                    <HyperlinkButton Margin="12,0"
                                                     BorderThickness="0"
                                                     Click="ViewReferenceHyperlinkButton_Click"
                                                     Content="{Binding ReferenceId}" />
                                </DataTemplate>
                            </toolkit:DataGridTemplateColumn.CellTemplate>
                        </toolkit:DataGridTemplateColumn>
                        <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_RefExpertId"
                                                    Binding="{Binding RefExpertId}"
                                                    CanUserSort="False"
                                                    Tag="RefExpertId" />
                        <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_RefSourceId"
                                                    Binding="{Binding RefSourceId}"
                                                    CanUserSort="False"
                                                    Tag="RefSourceId" />
                        <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_RefAuthorId"
                                                    Binding="{Binding RefAuthorId}"
                                                    CanUserSort="False"
                                                    Tag="RefAuthorId" />
                        <toolkit:DataGridCheckBoxColumn loca:Uids.Uid="DataGridCheckBoxColumn_Valid"
                                                        Binding="{Binding Valid}"
                                                        Tag="Valid" />
                        <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_ValidYear"
                                                    Binding="{Binding ValidYear}"
                                                    Tag="ValidYear" />
                        <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_Info"
                                                    Binding="{Binding Info}"
                                                    CanUserSort="False"
                                                    Tag="Info" />
                    </toolkit:DataGrid.Columns>
                </toolkit:DataGrid>

                <!--  ReferenceDetailExpander  -->
                <Expander x:Name="ReferenceDetailExpander"
                          Margin="{StaticResource XSmallTopBottomMargin}"
                          Visibility="Collapsed">
                    <Expander.Header>
                        <Grid>
                            <TextBlock loca:Uids.Uid="TextBlock_Reference"
                                       Style="{ThemeResource SubtitleTextBlockStyle}" />
                            <TextBlock HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Text="{x:Bind ViewModel.ReferenceSelected.ReferenceId, Mode=OneWay}" />
                        </Grid>
                    </Expander.Header>

                    <RelativePanel x:Name="ReferenceDetailRoot"
                                   Margin="{StaticResource SmallLeftRightMargin}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup>
                                <VisualState>
                                    <VisualState.StateTriggers>
                                        <AdaptiveTrigger MinWindowWidth="{StaticResource LargeWindowSnapPoint}" />
                                    </VisualState.StateTriggers>
                                </VisualState>
                                <VisualState>
                                    <VisualState.StateTriggers>
                                        <AdaptiveTrigger MinWindowWidth="{StaticResource MediumWindowSnapPoint}" />
                                    </VisualState.StateTriggers>
                                </VisualState>
                                <VisualState>
                                    <VisualState.StateTriggers>
                                        <AdaptiveTrigger MinWindowWidth="{StaticResource MinWindowSnapPoint}" />
                                    </VisualState.StateTriggers>
                                    <VisualState.Setters>
                                        <Setter Target="ReferenceCommandBar.DefaultLabelPosition" Value="Bottom" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <CommandBar x:Name="ReferenceDetailCommandBar"
                                    Margin="{StaticResource SmallLeftRightCommandBarMargin}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Top"
                                    Background="Transparent"
                                    DefaultLabelPosition="Right"
                                    RelativePanel.AlignRightWithPanel="True">
                            <AppBarButton loca:Uids.Uid="AppBarButtonSave"
                                          Background="{ThemeResource SystemBaseLowColor}"
                                          Click="SaveReference_Click"
                                          Foreground="White"
                                          Visibility="{x:Bind ViewModel.IsInEditReference, Mode=OneWay}">
                                <AppBarButton.Icon>
                                    <BitmapIcon ShowAsMonochrome="False"
                                                UriSource="/Assets/Fluent/save.png" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton loca:Uids.Uid="AppBarButtonCancel"
                                          Click="CancelEditsReferenceAsync"
                                          Visibility="{x:Bind ViewModel.IsInEditReference, Mode=OneWay}">
                                <AppBarButton.Icon>
                                    <BitmapIcon ShowAsMonochrome="False"
                                                UriSource="/Assets/Fluent/cancel.png" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarSeparator Visibility="{x:Bind ViewModel.IsInEditReference, Mode=OneWay}" />
                            <AppBarButton loca:Uids.Uid="AppBarButtonBack"
                                          Background="{ThemeResource SystemAccentColor}"
                                          Click="BackReference_Click"
                                          Foreground="White">
                                <AppBarButton.Icon>
                                    <BitmapIcon ShowAsMonochrome="False"
                                                UriSource="/Assets/Fluent/arrowleft.png" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton loca:Uids.Uid="AppBarButtonEdit"
                                          Click="{x:Bind ViewModel.StartEditReference}"
                                          IsEnabled="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditReference), Mode=OneWay}"
                                          Visibility="{x:Bind conv:NotConverter.CollapsedIf(ViewModel.IsNewReference), Mode=OneWay}">
                                <AppBarButton.Icon>
                                    <BitmapIcon ShowAsMonochrome="False"
                                                UriSource="/Assets/Fluent/edit.png" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                        </CommandBar>
                        <ScrollViewer x:Name="DetailPanelReference"
                                      Margin="0,36,0,0"
                                      RelativePanel.AlignLeftWithPanel="True"
                                      RelativePanel.AlignRightWithPanel="True"
                                      VerticalScrollBarVisibility="Auto"
                                      VerticalScrollMode="Auto">
                            <StackPanel>
                                <StackPanel.Resources>
                                    <Style TargetType="Expander">
                                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                                    </Style>
                                </StackPanel.Resources>
                                <RelativePanel Margin="4,0,0,0">
                                    <TextBox x:Name="ReferenceId"
                                             MinWidth="110"
                                             Margin="{StaticResource XSmallRightMargin}"
                                             loca:Uids.Uid="TextBox_ReferenceId"
                                             IsReadOnly="True"
                                             RelativePanel.AlignLeftWithPanel="True"
                                             Style="{StaticResource BodyTextBoxStyle}"
                                             Text="{x:Bind ViewModel.ReferenceSelected.ReferenceId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox x:Name="ValidCheckReference"
                                              Width="80"
                                              Margin="{StaticResource SmallRightCheckBoxMargin}"
                                              VerticalAlignment="Bottom"
                                              loca:Uids.Uid="CheckBox_Valid"
                                              IsChecked="{x:Bind ViewModel.ReferenceSelected.Valid, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              IsEnabled="{x:Bind conv:NotConverter.NotCombo(ViewModel.IsInEditReference), Mode=OneWay}"
                                              RelativePanel.AlignLeftWithPanel="True"
                                              RelativePanel.Below="ReferenceId" />
                                    <TextBox x:Name="ValidYearTextReference"
                                             Width="70"
                                             Margin="{StaticResource XSmallRightMargin}"
                                             loca:Uids.Uid="TextBox_ValidYear"
                                             winUiCommunity:TextBoxExtensions.Mask="9999"
                                             winUiCommunity:TextBoxExtensions.MaskPlaceholder=" "
                                             CornerRadius="3"
                                             IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditReference), Mode=OneWay}"
                                             RelativePanel.Below="ReferenceId"
                                             RelativePanel.RightOf="ValidCheckReference"
                                             Style="{StaticResource BodyTextBoxStyle}"
                                             Text="{x:Bind ViewModel.ReferenceSelected.ValidYear, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <ComboBox x:Name="FiSpeciesCombo"
                                              MinWidth="300"
                                              Margin="{StaticResource XSmallRightComboBoxMargin}"
                                              loca:Uids.Uid="ComboBox_FiSpeciesName"
                                              DisplayMemberPath="FiSpeciesFullName"
                                              IsEnabled="{x:Bind conv:NotConverter.NotCombo(ViewModel.IsInEditReference), Mode=OneWay}"
                                              ItemsSource="{x:Bind ViewModel.Tbl69FiSpeciessesAllList}"
                                              RelativePanel.RightOf="ValidYearTextReference"
                                              SelectedValue="{x:Bind ViewModel.ReferenceSelected.FiSpeciesId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="FiSpeciesId" />
                                    <ComboBox x:Name="GenusCombo"
                                              MinWidth="300"
                                              Margin="{StaticResource XSmallRightComboBoxMargin}"
                                              loca:Uids.Uid="ComboBox_GenusName"
                                              DisplayMemberPath="GenusName"
                                              IsEnabled="{x:Bind conv:NotConverter.NotCombo(ViewModel.IsInEditReference), Mode=OneWay}"
                                              ItemsSource="{x:Bind ViewModel.Tbl66GenussesAllList}"
                                              RelativePanel.RightOf="FiSpeciesCombo"
                                              SelectedValue="{x:Bind ViewModel.ReferenceSelected.GenusId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="GenusId" />
                                    <ComboBox x:Name="RefExpertCombo"
                                              MinWidth="1120"
                                              Margin="{StaticResource XSmallRightComboBoxMargin}"
                                              loca:Uids.Uid="ComboBox_RefExpertName"
                                              DisplayMemberPath="RefExpertName"
                                              IsEnabled="{x:Bind conv:NotConverter.NotCombo(ViewModel.IsInEditReference), Mode=OneWay}"
                                              ItemsSource="{x:Bind ViewModel.Tbl90ExpertsAllList}"
                                              RelativePanel.AlignLeftWithPanel="True"
                                              RelativePanel.Below="ValidCheckReference"
                                              SelectedValue="{x:Bind ViewModel.ReferenceSelected.RefExpertId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="RefExpertId" />
                                    <ComboBox x:Name="RefSourceCombo"
                                              MinWidth="1120"
                                              Margin="{StaticResource XSmallRightComboBoxMargin}"
                                              loca:Uids.Uid="ComboBox_RefSourceName"
                                              DisplayMemberPath="RefSourceName"
                                              IsEnabled="{x:Bind conv:NotConverter.NotCombo(ViewModel.IsInEditReference), Mode=OneWay}"
                                              ItemsSource="{x:Bind ViewModel.Tbl90SourcesAllList}"
                                              RelativePanel.AlignLeftWithPanel="True"
                                              RelativePanel.Below="RefExpertCombo"
                                              SelectedValue="{x:Bind ViewModel.ReferenceSelected.RefSourceId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="RefSourceId" />
                                    <ComboBox x:Name="RefAuthorCombo"
                                              MinWidth="1120"
                                              Margin="{StaticResource XSmallRightComboBoxMargin}"
                                              loca:Uids.Uid="ComboBox_RefAuthorName"
                                              DisplayMemberPath="RefAuthorName"
                                              IsEnabled="{x:Bind conv:NotConverter.NotCombo(ViewModel.IsInEditReference), Mode=OneWay}"
                                              ItemsSource="{x:Bind ViewModel.Tbl90AuthorsAllList}"
                                              RelativePanel.AlignLeftWithPanel="True"
                                              RelativePanel.Below="RefSourceCombo"
                                              SelectedValue="{x:Bind ViewModel.ReferenceSelected.RefAuthorId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="RefAuthorId" />
                                    <TextBox x:Name="InfoReference"
                                             MinWidth="1120"
                                             Margin="{StaticResource XSmallRightMargin}"
                                             HorizontalAlignment="Stretch"
                                             loca:Uids.Uid="TextBox_Info"
                                             IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditReference), Mode=OneWay}"
                                             RelativePanel.AlignLeftWithPanel="True"
                                             RelativePanel.Below="RefAuthorCombo"
                                             Text="{x:Bind ViewModel.ReferenceSelected.Info, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </RelativePanel>
                                <Expander x:Name="ComboboxExpanderFamily">
                                    <Expander.Header>
                                        <Grid>
                                            <TextBlock loca:Uids.Uid="TextBlock_Comboboxes"
                                                       Style="{ThemeResource SubtitleTextBlockStyle}" />
                                        </Grid>
                                    </Expander.Header>
                                    <RelativePanel>
                                        <ComboBox x:Name="InfratribusCombo"
                                                  MinWidth="250"
                                                  Margin="{StaticResource XSmallRightComboBoxMargin}"
                                                  loca:Uids.Uid="ComboBox_InfratribusName"
                                                  DisplayMemberPath="InfratribusName"
                                                  IsEnabled="{x:Bind conv:NotConverter.NotCombo(ViewModel.IsInEditReference), Mode=OneWay}"
                                                  ItemsSource="{x:Bind ViewModel.Tbl63InfratribussesAllList}"
                                                  RelativePanel.AlignLeftWithPanel="True"
                                                  SelectedValue="{x:Bind ViewModel.ReferenceSelected.InfratribusId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  SelectedValuePath="InfratribusId" />
                                        <ComboBox x:Name="SubtribusCombo"
                                                  MinWidth="250"
                                                  Margin="{StaticResource XSmallRightComboBoxMargin}"
                                                  loca:Uids.Uid="ComboBox_SubtribusName"
                                                  DisplayMemberPath="SubtribusName"
                                                  IsEnabled="{x:Bind conv:NotConverter.NotCombo(ViewModel.IsInEditReference), Mode=OneWay}"
                                                  ItemsSource="{x:Bind ViewModel.Tbl60SubtribussesAllList}"
                                                  RelativePanel.RightOf="InfratribusCombo"
                                                  SelectedValue="{x:Bind ViewModel.ReferenceSelected.SubtribusId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  SelectedValuePath="SubtribusId" />
                                        <ComboBox x:Name="TribusCombo"
                                                  MinWidth="250"
                                                  Margin="{StaticResource XSmallRightComboBoxMargin}"
                                                  loca:Uids.Uid="ComboBox_TribusName"
                                                  DisplayMemberPath="TribusName"
                                                  IsEnabled="{x:Bind conv:NotConverter.NotCombo(ViewModel.IsInEditReference), Mode=OneWay}"
                                                  ItemsSource="{x:Bind ViewModel.Tbl57TribussesAllList}"
                                                  RelativePanel.RightOf="SubtribusCombo"
                                                  SelectedValue="{x:Bind ViewModel.ReferenceSelected.TribusId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  SelectedValuePath="TribusId" />
                                        <ComboBox x:Name="SupertribusCombo"
                                                  MinWidth="250"
                                                  Margin="{StaticResource XSmallRightComboBoxMargin}"
                                                  loca:Uids.Uid="ComboBox_SupertribusName"
                                                  DisplayMemberPath="SupertribusName"
                                                  IsEnabled="{x:Bind conv:NotConverter.NotCombo(ViewModel.IsInEditReference), Mode=OneWay}"
                                                  ItemsSource="{x:Bind ViewModel.Tbl54SupertribussesAllList}"
                                                  RelativePanel.RightOf="TribusCombo"
                                                  SelectedValue="{x:Bind ViewModel.ReferenceSelected.SupertribusId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  SelectedValuePath="SupertribusId" />
                                        <ComboBox x:Name="InfrafamilyCombo"
                                                  MinWidth="250"
                                                  Margin="{StaticResource XSmallRightComboBoxMargin}"
                                                  loca:Uids.Uid="ComboBox_InfrafamilyName"
                                                  DisplayMemberPath="InfrafamilyName"
                                                  IsEnabled="{x:Bind conv:NotConverter.NotCombo(ViewModel.IsInEditReference), Mode=OneWay}"
                                                  ItemsSource="{x:Bind ViewModel.Tbl51InfrafamiliesAllList}"
                                                  RelativePanel.AlignLeftWithPanel="True"
                                                  RelativePanel.Below="InfratribusCombo"
                                                  SelectedValue="{x:Bind ViewModel.ReferenceSelected.InfrafamilyId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  SelectedValuePath="InfrafamilyId" />
                                        <ComboBox x:Name="SubfamilyCombo"
                                                  MinWidth="250"
                                                  Margin="{StaticResource XSmallRightComboBoxMargin}"
                                                  loca:Uids.Uid="ComboBox_SubfamilyName"
                                                  DisplayMemberPath="SubfamilyName"
                                                  IsEnabled="{x:Bind conv:NotConverter.NotCombo(ViewModel.IsInEditReference), Mode=OneWay}"
                                                  ItemsSource="{x:Bind ViewModel.Tbl48SubfamiliesAllList}"
                                                  RelativePanel.Below="InfratribusCombo"
                                                  RelativePanel.RightOf="InfrafamilyCombo"
                                                  SelectedValue="{x:Bind ViewModel.ReferenceSelected.SubfamilyId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  SelectedValuePath="SubfamilyId" />
                                        <ComboBox x:Name="FamilyCombo"
                                                  MinWidth="250"
                                                  Margin="{StaticResource XSmallRightComboBoxMargin}"
                                                  loca:Uids.Uid="ComboBox_FamilyName"
                                                  DisplayMemberPath="FamilyName"
                                                  IsEnabled="{x:Bind conv:NotConverter.NotCombo(ViewModel.IsInEditReference), Mode=OneWay}"
                                                  ItemsSource="{x:Bind ViewModel.Tbl45FamiliesAllList}"
                                                  RelativePanel.Below="InfratribusCombo"
                                                  RelativePanel.RightOf="SubfamilyCombo"
                                                  SelectedValue="{x:Bind ViewModel.ReferenceSelected.FamilyId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  SelectedValuePath="FamilyId" />
                                        <ComboBox x:Name="SuperfamilyCombo"
                                                  MinWidth="250"
                                                  Margin="{StaticResource XSmallRightComboBoxMargin}"
                                                  loca:Uids.Uid="ComboBox_SuperfamilyName"
                                                  DisplayMemberPath="SuperfamilyName"
                                                  IsEnabled="{x:Bind conv:NotConverter.NotCombo(ViewModel.IsInEditReference), Mode=OneWay}"
                                                  ItemsSource="{x:Bind ViewModel.Tbl42SuperfamiliesAllList}"
                                                  RelativePanel.Below="InfratribusCombo"
                                                  RelativePanel.RightOf="FamilyCombo"
                                                  SelectedValue="{x:Bind ViewModel.ReferenceSelected.SuperfamilyId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  SelectedValuePath="SuperfamilyId" />
                                        <ComboBox x:Name="InfraordoCombo"
                                                  MinWidth="250"
                                                  Margin="{StaticResource XSmallRightComboBoxMargin}"
                                                  loca:Uids.Uid="ComboBox_InfraordoName"
                                                  DisplayMemberPath="InfraordoName"
                                                  IsEnabled="{x:Bind conv:NotConverter.NotCombo(ViewModel.IsInEditReference), Mode=OneWay}"
                                                  ItemsSource="{x:Bind ViewModel.Tbl39InfraordosAllList}"
                                                  RelativePanel.AlignLeftWithPanel="True"
                                                  RelativePanel.Below="InfrafamilyCombo"
                                                  SelectedValue="{x:Bind ViewModel.ReferenceSelected.InfraordoId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  SelectedValuePath="InfraordoId" />
                                        <ComboBox x:Name="SubordoCombo"
                                                  MinWidth="250"
                                                  Margin="{StaticResource XSmallRightComboBoxMargin}"
                                                  loca:Uids.Uid="ComboBox_SubordoName"
                                                  DisplayMemberPath="SubordoName"
                                                  IsEnabled="{x:Bind conv:NotConverter.NotCombo(ViewModel.IsInEditReference), Mode=OneWay}"
                                                  ItemsSource="{x:Bind ViewModel.Tbl36SubordosAllList}"
                                                  RelativePanel.Below="InfrafamilyCombo"
                                                  RelativePanel.RightOf="InfraordoCombo"
                                                  SelectedValue="{x:Bind ViewModel.ReferenceSelected.SubordoId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  SelectedValuePath="SubordoId" />
                                        <ComboBox x:Name="OrdoCombo"
                                                  MinWidth="250"
                                                  Margin="{StaticResource XSmallRightComboBoxMargin}"
                                                  loca:Uids.Uid="ComboBox_OrdoName"
                                                  DisplayMemberPath="OrdoName"
                                                  IsEnabled="{x:Bind conv:NotConverter.NotCombo(ViewModel.IsInEditReference), Mode=OneWay}"
                                                  ItemsSource="{x:Bind ViewModel.Tbl33OrdosAllList}"
                                                  RelativePanel.Below="InfrafamilyCombo"
                                                  RelativePanel.RightOf="SubordoCombo"
                                                  SelectedValue="{x:Bind ViewModel.ReferenceSelected.OrdoId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  SelectedValuePath="OrdoId" />
                                        <ComboBox x:Name="LegioCombo"
                                                  MinWidth="250"
                                                  Margin="{StaticResource XSmallRightComboBoxMargin}"
