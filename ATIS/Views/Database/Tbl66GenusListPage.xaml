<?xml version="1.0" encoding="utf-8" ?>

<Page x:Class="ATIS.Views.Database.Tbl66GenusListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:conv="using:ATIS.Helpers.Converters"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:helpers="using:ATIS.Helpers"
      xmlns:loca="using:WinUI3Localizer"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:models="using:ATIS.Models"
      xmlns:toolkit="using:CommunityToolkit.WinUI.UI.Controls"
      xmlns:winUiCommunity="using:WinUICommunity"
      NavigationCacheMode="Disabled"
      mc:Ignorable="d">

    <!--  GenusListPage.xaml  Skriptdatum: 13.06.2024  10:32  -->

    <Page.Resources>
        <conv:DoubleToStringConverter x:Key="DoubleConverter" />
        <MenuFlyout x:Key="GenusDataContextMenu">
            <MenuFlyoutItem loca:Uids.Uid="MenuFlyout_Save_Genus"
                            Click="SaveGenus_Click">
                <MenuFlyoutItem.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/save.png" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem loca:Uids.Uid="MenuFlyout_Delete_Genus"
                            Click="DeleteGenus_Click">
                <MenuFlyoutItem.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/delete.png" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem loca:Uids.Uid="MenuFlyout_Add_Genus"
                            Click="AddGenus_Click">
                <MenuFlyoutItem.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/add.png" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem loca:Uids.Uid="MenuFlyout_Add_Reference_Expert"
                            Click="AddReferenceExpertButton_Click">
                <MenuFlyoutItem.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/add.png" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem loca:Uids.Uid="MenuFlyout_Add_Reference_Source"
                            Click="AddReferenceSourceButton_Click">
                <MenuFlyoutItem.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/add.png" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem loca:Uids.Uid="MenuFlyout_Add_Reference_Author"
                            Click="AddReferenceAuthorButton_Click">
                <MenuFlyoutItem.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/add.png" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem loca:Uids.Uid="MenuFlyout_Add_Comment"
                            Click="AddComment_Click">
                <MenuFlyoutItem.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/add.png" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem loca:Uids.Uid="MenuFlyout_Refresh"
                            Click="Refresh_Click">
                <MenuFlyoutItem.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/refresh.png" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>
        <MenuFlyout x:Key="ReferenceDataContextMenu">
            <MenuFlyoutItem loca:Uids.Uid="MenuFlyout_Delete_Reference"
                            Click="DeleteReference_Click">
                <MenuFlyoutItem.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/delete.png" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem loca:Uids.Uid="MenuFlyout_Add_Reference_Expert"
                            Click="AddReferenceExpertButton_Click">
                <MenuFlyoutItem.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/add.png" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem loca:Uids.Uid="MenuFlyout_Add_Reference_Source"
                            Click="AddReferenceSourceButton_Click">
                <MenuFlyoutItem.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/add.png" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem loca:Uids.Uid="MenuFlyout_Add_Reference_Author"
                            Click="AddReferenceAuthorButton_Click">
                <MenuFlyoutItem.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/add.png" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>
        <MenuFlyout x:Key="CommentDataContextMenu">
            <MenuFlyoutItem loca:Uids.Uid="MenuFlyout_Delete_Comment"
                            Click="DeleteComment_Click">
                <MenuFlyoutItem.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/delete.png" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem loca:Uids.Uid="MenuFlyout_Add_Comment"
                            Click="AddComment_Click">
                <MenuFlyoutItem.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/add.png" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>
    </Page.Resources>

    <RelativePanel x:Name="GenusRoot"
                   Margin="{StaticResource SmallLeftTopRightBottomMargin}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource LargeWindowSnapPoint}" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource MediumWindowSnapPoint}" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource MinWindowSnapPoint}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="GenusCommandBar.DefaultLabelPosition" Value="Bottom" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <TextBlock x:Name="PageTitle"
                   loca:Uids.Uid="TextBlock_Genusses"
                   RelativePanel.AlignLeftWithPanel="True"
                   Style="{StaticResource PageTitleTextBlockStyle}" />
        <TextBlock x:Name="GenusDatasetText"
                   Margin="5,17,0,0"
                   loca:Uids.Uid="TextBlock_DataSetCount"
                   RelativePanel.RightOf="PageTitle"
                   Style="{StaticResource DatasetTitleStyle}" />
        <TextBlock x:Name="GenusDatasetCountText"
                   Margin="5,17,0,0"
                   RelativePanel.RightOf="GenusDatasetText"
                   Style="{StaticResource DatasetTitleStyle}"
                   Text="{x:Bind ViewModel.GenusDataSetCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <CommandBar x:Name="GenusCommandBar"
                    HorizontalAlignment="Stretch"
                    Background="Transparent"
                    DefaultLabelPosition="Right"
                    RelativePanel.LeftOf="GenusSearchBox"
                    RelativePanel.RightOf="GenusDatasetCountText">
            <AppBarButton x:Name="AppBarButtonDeleteGenus"
                          loca:Uids.Uid="AppBarButtonDeleteGenus"
                          Click="DeleteGenus_Click"
                          IsEnabled="{x:Bind conv:NotConverter.IsNotNull(ViewModel.GenusSelected), Mode=OneWay}">
                <AppBarButton.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/delete.png" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton loca:Uids.Uid="AppBarButtonAddGenus"
                          Background="{ThemeResource SystemAccentColor}"
                          Click="AddGenus_Click"
                          Foreground="White">
                <AppBarButton.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/add.png" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="AppBarButtonAddReference"
                          loca:Uids.Uid="AppBarButtonAddReference"
                          IsCompact="True"
                          IsEnabled="{x:Bind conv:NotConverter.IsNotNull(ViewModel.GenusSelected), Mode=OneWay}">
                <AppBarButton.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/add.png" />
                </AppBarButton.Icon>
                <AppBarButton.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem loca:Uids.Uid="MenuFlyout_Add_Reference_Expert"
                                        Click="AddReferenceExpertButton_Click"
                                        Tag="rating">
                            <MenuFlyoutItem.Icon>
                                <BitmapIcon ShowAsMonochrome="False"
                                            UriSource="/Assets/Fluent/add.png" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem loca:Uids.Uid="MenuFlyout_Add_Reference_Source"
                                        Click="AddReferenceSourceButton_Click"
                                        Tag="match">
                            <MenuFlyoutItem.Icon>
                                <BitmapIcon ShowAsMonochrome="False"
                                            UriSource="/Assets/Fluent/add.png" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem loca:Uids.Uid="MenuFlyout_Add_Reference_Author"
                                        Click="AddReferenceAuthorButton_Click"
                                        Tag="distance">
                            <MenuFlyoutItem.Icon>
                                <BitmapIcon ShowAsMonochrome="False"
                                            UriSource="/Assets/Fluent/add.png" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarButton x:Name="AppBarButtonAddComment"
                          loca:Uids.Uid="AppBarButtonAddComment"
                          Click="AddComment_Click"
                          IsEnabled="{x:Bind conv:NotConverter.IsNotNull(ViewModel.GenusSelected), Mode=OneWay}">
                <AppBarButton.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/add.png" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="AppBarButtonSync"
                          loca:Uids.Uid="AppBarButtonSync"
                          Click="Refresh_Click"
                          IsEnabled="{x:Bind conv:NotConverter.IsNotNull(ViewModel.GenusSelected), Mode=OneWay}">
                <AppBarButton.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/refresh.png" />
                </AppBarButton.Icon>
            </AppBarButton>
        </CommandBar>

        <AutoSuggestBox Name="GenusSearchBox"
                        Width="200"
                        Margin="4,8,4,0"
                        loca:Uids.Uid="AutoSuggestBox_Search"
                        Loaded="GenusSearchBox_OnLoaded"
                        QuerySubmitted="GetGenussesByNameOrId"
                        RelativePanel.AlignRightWithPanel="True">
            <AutoSuggestBox.QueryIcon>
                <BitmapIcon ShowAsMonochrome="False"
                            UriSource="/Assets/Fluent/search.png" />
            </AutoSuggestBox.QueryIcon>
        </AutoSuggestBox>

        <ScrollViewer x:Name="PanelGenus"
                      RelativePanel.AlignLeftWithPanel="True"
                      RelativePanel.AlignRightWithPanel="True"
                      RelativePanel.Below="PageTitle"
                      VerticalScrollBarVisibility="Auto"
                      VerticalScrollMode="Auto">
            <StackPanel Margin="-10,8,4,0">
                <StackPanel.Resources>
                    <Style TargetType="Expander">
                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                    </Style>
                </StackPanel.Resources>
                <toolkit:DataGrid x:Name="GenusDataGrid"
                                  MaxHeight="230"
                                  Margin="0,0,20,0"
                                  VerticalAlignment="Top"
                                  x:FieldModifier="public"
                                  AlternatingRowBackground="LightGray"
                                  AutoGenerateColumns="False"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  CanUserReorderColumns="False"
                                  CanUserResizeColumns="False"
                                  ContextFlyout="{StaticResource GenusDataContextMenu}"
                                  CurrentCellChanged="GenusDataGrid_OnCurrentCellChanged"
                                  GridLinesVisibility="Horizontal"
                                  ItemsSource="{x:Bind ViewModel.GenusItems}"
                                  SelectedItem="{x:Bind ViewModel.GenusSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  SelectionMode="Single"
                                  Sorting="GenusDataGrid_Sorting">
                    <toolkit:DataGrid.Columns>
                        <toolkit:DataGridTemplateColumn loca:Uids.Uid="DataGridTemplateColumn_GenusId"
                                                        Tag="GenusId">
                            <toolkit:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:Tbl66Genus">
                                    <HyperlinkButton Margin="12,0"
                                                     BorderThickness="0"
                                                     Click="ViewGenusHyperlinkButton_Click"
                                                     Content="{Binding GenusId}" />
                                </DataTemplate>
                            </toolkit:DataGridTemplateColumn.CellTemplate>
                        </toolkit:DataGridTemplateColumn>
                        <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_GenusName"
                                                    Binding="{Binding GenusName}"
                                                    CanUserSort="True"
                                                    Tag="GenusName" />
                        <toolkit:DataGridComboBoxColumn loca:Uids.Uid="DataGridComboBoxColumn_InfratribusName"
                                                        Binding="{Binding InfratribusId}"
                                                        DisplayMemberPath="InfratribusName"
                                                        ItemsSource="{x:Bind ViewModel.Tbl63InfratribussesAllList, Mode=OneWay}" />
                        <toolkit:DataGridCheckBoxColumn loca:Uids.Uid="DataGridCheckBoxColumn_Valid"
                                                        Binding="{Binding Valid}"
                                                        Tag="Valid" />
                        <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_ValidYear"
                                                    Binding="{Binding ValidYear}"
                                                    Tag="ValidYear" />
                        <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_Author"
                                                    Binding="{Binding Author}"
                                                    Tag="Author" />
                        <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_AuthorYear"
                                                    Binding="{Binding AuthorYear}"
                                                    Tag="AuthorYear" />
                        <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_Info"
                                                    Binding="{Binding Info}"
                                                    Tag="Info" />
                    </toolkit:DataGrid.Columns>
                </toolkit:DataGrid>

                <!--  GenusDetailExpander  -->
                <Expander x:Name="GenusDetailExpander"
                          Margin="{StaticResource XSmallTopBottomMargin}"
                          Visibility="Collapsed">
                    <Expander.Header>
                        <Grid>
                            <TextBlock loca:Uids.Uid="TextBlock_Genus"
                                       Style="{ThemeResource SubtitleTextBlockStyle}" />
                            <TextBlock HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Text="{x:Bind ViewModel.GenusSelected.GenusName, Mode=OneWay}" />
                        </Grid>
                    </Expander.Header>

                    <RelativePanel x:Name="GenusDetailRoot"
                                   Margin="{StaticResource SmallLeftRightMargin}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup>
                                <VisualState>
                                    <VisualState.StateTriggers>
                                        <AdaptiveTrigger MinWindowWidth="{StaticResource LargeWindowSnapPoint}" />
                                    </VisualState.StateTriggers>
                                </VisualState>
                                <VisualState>
                                    <VisualState.StateTriggers>
                                        <AdaptiveTrigger MinWindowWidth="{StaticResource MediumWindowSnapPoint}" />
                                    </VisualState.StateTriggers>
                                </VisualState>
                                <VisualState>
                                    <VisualState.StateTriggers>
                                        <AdaptiveTrigger MinWindowWidth="{StaticResource MinWindowSnapPoint}" />
                                    </VisualState.StateTriggers>
                                    <VisualState.Setters>
                                        <Setter Target="GenusCommandBar.DefaultLabelPosition" Value="Bottom" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <CommandBar x:Name="GenusDetailCommandBar"
                                    Margin="{StaticResource SmallLeftRightCommandBarMargin}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Top"
                                    Background="Transparent"
                                    DefaultLabelPosition="Right"
                                    RelativePanel.AlignRightWithPanel="True">
                            <AppBarButton loca:Uids.Uid="AppBarButtonSave"
                                          Background="{ThemeResource SystemBaseLowColor}"
                                          Click="SaveGenus_Click"
                                          Foreground="White"
                                          Visibility="{x:Bind ViewModel.IsInEditGenus, Mode=OneWay}">
                                <AppBarButton.Icon>
                                    <BitmapIcon ShowAsMonochrome="False"
                                                UriSource="/Assets/Fluent/save.png" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton loca:Uids.Uid="AppBarButtonCancel"
                                          Click="CancelEditsGenusAsync"
                                          Visibility="{x:Bind ViewModel.IsInEditGenus, Mode=OneWay}">
                                <AppBarButton.Icon>
                                    <BitmapIcon ShowAsMonochrome="False"
                                                UriSource="/Assets/Fluent/cancel.png" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarSeparator Visibility="{x:Bind ViewModel.IsInEditGenus, Mode=OneWay}" />
                            <AppBarButton loca:Uids.Uid="AppBarButtonBack"
                                          Background="{ThemeResource SystemAccentColor}"
                                          Click="BackGenus_Click"
                                          Foreground="White">
                                <AppBarButton.Icon>
                                    <BitmapIcon ShowAsMonochrome="False"
                                                UriSource="/Assets/Fluent/arrowleft.png" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton loca:Uids.Uid="AppBarButtonEdit"
                                          Click="{x:Bind ViewModel.StartEditGenus}"
                                          IsEnabled="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditGenus), Mode=OneWay}"
                                          Visibility="{x:Bind conv:NotConverter.CollapsedIf(ViewModel.IsNewGenus), Mode=OneWay}">
                                <AppBarButton.Icon>
                                    <BitmapIcon ShowAsMonochrome="False"
                                                UriSource="/Assets/Fluent/edit.png" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                        </CommandBar>
                        <ScrollViewer x:Name="DetailPanelGenus"
                                      Margin="0,36,0,0"
                                      RelativePanel.AlignLeftWithPanel="True"
                                      RelativePanel.AlignRightWithPanel="True"
                                      VerticalScrollBarVisibility="Auto"
                                      VerticalScrollMode="Auto">
                            <RelativePanel Margin="4,0,0,0">
                                <TextBox x:Name="GenusId"
                                         MinWidth="110"
                                         Margin="{StaticResource XSmallRightMargin}"
                                         loca:Uids.Uid="TextBox_GenusId"
                                         IsReadOnly="True"
                                         RelativePanel.AlignLeftWithPanel="True"
                                         Text="{x:Bind ViewModel.GenusSelected.GenusId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox x:Name="GenusName"
                                         MinWidth="150"
                                         Margin="{StaticResource XSmallRightMargin}"
                                         loca:Uids.Uid="TextBox_GenusName"
                                         IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditGenus), Mode=OneWay}"
                                         LostFocus="GenusName_OnLostFocus"
                                         MaxLength="100"
                                         RelativePanel.RightOf="GenusId"
                                         Text="{x:Bind ViewModel.GenusSelected.GenusName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <CheckBox x:Name="ValidCheckGenus"
                                          Width="80"
                                          Margin="{StaticResource SmallRightCheckBoxMargin}"
                                          VerticalAlignment="Bottom"
                                          loca:Uids.Uid="CheckBox_Valid"
                                          IsChecked="{x:Bind ViewModel.GenusSelected.Valid, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{x:Bind conv:NotConverter.NotCombo(ViewModel.IsInEditGenus), Mode=OneWay}"
                                          RelativePanel.RightOf="GenusName" />
                                <TextBox x:Name="ValidYearTextGenus"
                                         Width="70"
                                         Margin="{StaticResource XSmallRightMargin}"
                                         loca:Uids.Uid="TextBox_ValidYear"
                                         winUiCommunity:TextBoxExtensions.Mask="9999"
                                         winUiCommunity:TextBoxExtensions.MaskPlaceholder=" "
                                         CornerRadius="3"
                                         IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditGenus), Mode=OneWay}"
                                         RelativePanel.RightOf="ValidCheckGenus"
                                         Style="{StaticResource BodyTextBoxStyle}"
                                         Text="{x:Bind ViewModel.GenusSelected.ValidYear, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <ComboBox x:Name="InfratribusCombo"
                                          MinWidth="200"
                                          Margin="{StaticResource XSmallRightComboBoxMargin}"
                                          loca:Uids.Uid="ComboBox_InfratribusName"
                                          DisplayMemberPath="InfratribusName"
                                          IsEnabled="{x:Bind conv:NotConverter.NotCombo(ViewModel.IsInEditGenus), Mode=OneWay}"
                                          ItemsSource="{x:Bind ViewModel.Tbl63InfratribussesAllList}"
                                          RelativePanel.RightOf="ValidYearTextGenus"
                                          SelectedValue="{x:Bind ViewModel.GenusSelected.InfratribusId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          SelectedValuePath="InfratribusId" />
                                <TextBox x:Name="AuthorTextGenus"
                                         MinWidth="150"
                                         Margin="{StaticResource XSmallRightMargin}"
                                         HorizontalAlignment="Stretch"
                                         loca:Uids.Uid="TextBox_Author"
                                         CharacterCasing="Upper"
                                         IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditGenus), Mode=OneWay}"
                                         MaxLength="60"
                                         RelativePanel.AlignLeftWithPanel="True"
                                         RelativePanel.Below="GenusId"
                                         Text="{x:Bind ViewModel.GenusSelected.Author, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox x:Name="AuthorYearTextGenus"
                                         Width="70"
                                         Margin="{StaticResource XSmallRightMargin}"
                                         loca:Uids.Uid="TextBox_AuthorYear"
                                         winUiCommunity:TextBoxExtensions.Mask="9999"
                                         winUiCommunity:TextBoxExtensions.MaskPlaceholder=" "
                                         CornerRadius="3"
                                         IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditGenus), Mode=OneWay}"
                                         RelativePanel.Below="ValidCheckGenus"
                                         RelativePanel.RightOf="AuthorTextGenus"
                                         Text="{x:Bind ViewModel.GenusSelected.AuthorYear, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox x:Name="InfoGenus"
                                         MinWidth="1120"
                                         Margin="{StaticResource XSmallRightMargin}"
                                         HorizontalAlignment="Stretch"
                                         loca:Uids.Uid="TextBox_Info"
                                         IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditGenus), Mode=OneWay}"
                                         RelativePanel.AlignLeftWithPanel="True"
                                         RelativePanel.Below="AuthorTextGenus"
                                         Text="{x:Bind ViewModel.GenusSelected.Info, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox x:Name="SynonymGenus"
                                         MinWidth="1120"
                                         MinHeight="75"
                                         MaxWidth="1300"
                                         MaxHeight="150"
                                         Margin="{StaticResource XSmallRightMargin}"
                                         loca:Uids.Uid="TextBox_Synonym"
                                         AcceptsReturn="True"
                                         IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditGenus), Mode=OneWay}"
                                         RelativePanel.AlignLeftWithPanel="True"
                                         RelativePanel.Below="InfoGenus"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         Text="{x:Bind ViewModel.GenusSelected.Synonym, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         TextWrapping="Wrap" />
                                <TabView x:Name="TabViewLanguageGenus"
                                         MinWidth="1120"
                                         MaxWidth="1300"
                                         Margin="{StaticResource XSmallRightMargin}"
                                         Background="LightBlue"
                                         CornerRadius="3"
                                         IsAddTabButtonVisible="False"
                                         RelativePanel.AlignLeftWithPanel="True"
                                         RelativePanel.Below="SynonymGenus">
                                    <TabView.TabItems>
                                        <TabViewItem loca:Uids.Uid="TabViewItem_EngName"
                                                     IsClosable="False">
                                            <TextBox Margin="{StaticResource XSmallRightMargin}"
                                                     IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditGenus), Mode=OneWay}"
                                                     MaxLength="200"
                                                     Text="{x:Bind ViewModel.GenusSelected.EngName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </TabViewItem>
                                        <TabViewItem loca:Uids.Uid="TabViewItem_GerName"
                                                     IsClosable="False">
                                            <TextBox Margin="{StaticResource XSmallRightMargin}"
                                                     IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditGenus), Mode=OneWay}"
                                                     MaxLength="200"
                                                     Text="{x:Bind ViewModel.GenusSelected.GerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </TabViewItem>
                                        <TabViewItem loca:Uids.Uid="TabViewItem_FraName"
                                                     IsClosable="False">
                                            <TextBox Margin="{StaticResource XSmallRightMargin}"
                                                     IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditGenus), Mode=OneWay}"
                                                     MaxLength="200"
                                                     Text="{x:Bind ViewModel.GenusSelected.FraName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </TabViewItem>
                                        <TabViewItem loca:Uids.Uid="TabViewItem_SpaName"
                                                     IsClosable="False">
                                            <TextBox Margin="{StaticResource XSmallRightMargin}"
                                                     IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditGenus), Mode=OneWay}"
                                                     MaxLength="200"
                                                     Text="{x:Bind ViewModel.GenusSelected.PorName, Mode=TwoWay}" />
                                        </TabViewItem>
                                    </TabView.TabItems>
                                </TabView>
                                <TextBox x:Name="MemoGenus"
                                         MinWidth="1120"
                                         MinHeight="75"
                                         MaxWidth="1300"
                                         MaxHeight="150"
                                         Margin="{StaticResource XSmallRightMargin}"
