                <!--  ReferencesExpander  -->
                <Expander x:Name="ReferencesExpander"
                          Margin="{StaticResource XSmallTopBottomMargin}"
                          IsExpanded="True"
                          Visibility="Collapsed">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ReferencesTitle"
                                       loca:Uids.Uid="TextBlock_References"
                                       Style="{ThemeResource PageTitleTextBlockStyle}" />
                            <TextBlock x:Name="ReferencesDatasetText"
                                       Margin="5,0,0,2"
                                       loca:Uids.Uid="TextBlock_DataSetCount"
                                       Style="{StaticResource DatasetTitleStyle}" />
                            <TextBlock x:Name="ReferencesDatasetCountText"
                                       Margin="5,0,0,2"
                                       Style="{StaticResource DatasetTitleStyle}"
                                       Text="{x:Bind ViewModel.ReferenceDataSetCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Expander.Header>
                    <Grid Margin="0,4,0,0">
                        <toolkit:DataGrid x:Name="ReferenceDataGrid"
                                          MaxHeight="230"
                                          Margin="0,0,20,0"
                                          VerticalAlignment="Top"
                                          x:FieldModifier="public"
                                          AlternatingRowBackground="LightGray"
                                          AutoGenerateColumns="False"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          CanUserReorderColumns="False"
                                          CanUserResizeColumns="False"
                                          ContextFlyout="{StaticResource ReferenceDataContextMenu}"
                                          GridLinesVisibility="Horizontal"
                                          ItemsSource="{x:Bind ViewModel.ReferenceItems}"
                                          SelectedItem="{x:Bind ViewModel.ReferenceSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          SelectionMode="Single"
                                          Sorting="DataGrid_Reference_Sorting">
                            <toolkit:DataGrid.Columns>
                                <toolkit:DataGridTemplateColumn loca:Uids.Uid="DataGridTemplateColumn_ReferenceId"
                                                                Tag="ReferenceId">
                                    <toolkit:DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="models:Tbl90Reference">
                                            <HyperlinkButton Margin="12,0"
                                                             BorderThickness="0"
                                                             Click="ViewReferenceHyperlinkButton_Click"
                                                             Content="{Binding ReferenceId}" />
                                        </DataTemplate>
                                    </toolkit:DataGridTemplateColumn.CellTemplate>
                                </toolkit:DataGridTemplateColumn>
                                <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_RefExpertId"
                                                            Binding="{Binding RefExpertId}"
                                                            CanUserSort="False"
                                                            Tag="RefExpertId" />
                                <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_RefSourceId"
                                                            Binding="{Binding RefSourceId}"
                                                            CanUserSort="False"
                                                            Tag="RefSourceId" />
                                <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_RefAuthorId"
                                                            Binding="{Binding RefAuthorId}"
                                                            CanUserSort="False"
                                                            Tag="RefAuthorId" />
                                <toolkit:DataGridCheckBoxColumn loca:Uids.Uid="DataGridCheckBoxColumn_Valid"
                                                                Binding="{Binding Valid}"
                                                                Tag="Valid" />
                                <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_ValidYear"
                                                            Binding="{Binding ValidYear}"
                                                            Tag="ValidYear" />
                                <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_Info"
                                                            Binding="{Binding Info}"
                                                            Tag="Info" />
                            </toolkit:DataGrid.Columns>
                        </toolkit:DataGrid>
                    </Grid>
