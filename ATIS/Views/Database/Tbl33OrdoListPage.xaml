                                                             Content="{Binding ReferenceId}" />
                                        </DataTemplate>
                                    </toolkit:DataGridTemplateColumn.CellTemplate>
                                </toolkit:DataGridTemplateColumn>
                                <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_RefExpertId"
                                                            Binding="{Binding RefExpertId}"
                                                            CanUserSort="False"
                                                            Tag="RefExpertId" />
                                <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_RefSourceId"
                                                            Binding="{Binding RefSourceId}"
                                                            CanUserSort="False"
                                                            Tag="RefSourceId" />
                                <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_RefAuthorId"
                                                            Binding="{Binding RefAuthorId}"
                                                            CanUserSort="False"
                                                            Tag="RefAuthorId" />
                                <toolkit:DataGridCheckBoxColumn loca:Uids.Uid="DataGridCheckBoxColumn_Valid"
                                                                Binding="{Binding Valid}"
                                                                Tag="Valid" />
                                <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_ValidYear"
                                                            Binding="{Binding ValidYear}"
                                                            Tag="ValidYear" />
                                <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_Info"
                                                            Binding="{Binding Info}"
                                                            Tag="Info" />
                            </toolkit:DataGrid.Columns>
                        </toolkit:DataGrid>
                    </Grid>
                </Expander>

                <!--  CommentsExpander  -->
                <Expander x:Name="CommentsExpander"
                          Margin="{StaticResource XSmallTopBottomMargin}"
                          IsExpanded="True"
                          Visibility="Collapsed">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="CommentsTitle"
                                       loca:Uids.Uid="TextBlock_Comments"
                                       Style="{ThemeResource PageTitleTextBlockStyle}" />
                            <TextBlock x:Name="CommentsDatasetText"
                                       Margin="5,0,0,2"
                                       loca:Uids.Uid="TextBlock_DataSetCount"
                                       Style="{StaticResource DatasetTitleStyle}" />
                            <TextBlock x:Name="CommentsDatasetCountText"
                                       Margin="5,0,0,2"
                                       Style="{StaticResource DatasetTitleStyle}"
                                       Text="{x:Bind ViewModel.CommentDataSetCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Expander.Header>
                    <RelativePanel x:Name="CommentsRoot"
                                   Margin="{StaticResource SmallLeftRightMargin}">
                        <Grid Margin="0,4,0,0">
                            <toolkit:DataGrid x:Name="CommentDataGrid"
                                              MaxHeight="230"
                                              Margin="0,0,20,0"
                                              VerticalAlignment="Top"
                                              x:FieldModifier="public"
                                              AlternatingRowBackground="LightGray"
                                              AutoGenerateColumns="False"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              CanUserReorderColumns="False"
                                              CanUserResizeColumns="False"
                                              ContextFlyout="{StaticResource CommentDataContextMenu}"
                                              GridLinesVisibility="Horizontal"
                                              ItemsSource="{x:Bind ViewModel.CommentItems, Mode=OneWay}"
                                              SelectedItem="{x:Bind ViewModel.CommentSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              SelectionMode="Single"
                                              Sorting="DataGrid_Comment_Sorting">
                                <toolkit:DataGrid.Columns>
                                    <toolkit:DataGridTemplateColumn loca:Uids.Uid="DataGridTemplateColumn_CommentId"
                                                                    Tag="CommentId">
                                        <toolkit:DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate x:DataType="models:Tbl93Comment">
                                                <HyperlinkButton Margin="12,0"
                                                                 BorderThickness="0"
                                                                 Click="ViewCommentHyperlinkButton_Click"
                                                                 Content="{Binding CommentId}" />
                                            </DataTemplate>
                                        </toolkit:DataGridTemplateColumn.CellTemplate>
                                    </toolkit:DataGridTemplateColumn>
                                    <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_Info"
                                                                Binding="{Binding Info}"
                                                                Tag="Info" />
                                </toolkit:DataGrid.Columns>
                            </toolkit:DataGrid>
                        </Grid>
                    </RelativePanel>
                </Expander>

                <!--  SubordosExpander  -->
                <Expander x:Name="SubordosExpander"
                          Margin="{StaticResource XSmallTopBottomMargin}"
                          IsExpanded="True"
                          Visibility="Collapsed">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="SubordosTitle"
                                       loca:Uids.Uid="TextBlock_Subordos"
                                       Style="{ThemeResource PageTitleTextBlockStyle}" />
                            <TextBlock x:Name="SubordosDatasetText"
                                       Margin="5,0,0,2"
                                       loca:Uids.Uid="TextBlock_DataSetCount"
                                       Style="{StaticResource DatasetTitleStyle}" />
                            <TextBlock x:Name="SubordosDatasetCountText"
                                       Margin="5,0,0,2"
                                       Style="{StaticResource DatasetTitleStyle}"
                                       Text="{x:Bind ViewModel.SubordoDataSetCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Expander.Header>
                    <Grid Margin="0,4,0,0">
                        <toolkit:DataGrid x:Name="SubordoDataGrid"
                                          MaxHeight="230"
                                          Margin="0,0,20,0"
                                          VerticalAlignment="Top"
                                          x:FieldModifier="public"
                                          AlternatingRowBackground="LightGray"
                                          AutoGenerateColumns="False"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          CanUserReorderColumns="False"
                                          CanUserResizeColumns="False"
                                          ContextFlyout="{StaticResource SubordoDataContextMenu}"
                                          GridLinesVisibility="Horizontal"
                                          ItemsSource="{x:Bind ViewModel.SubordoItems, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.SubordoSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          SelectionMode="Single"
                                          Sorting="DataGrid_Subordo_Sorting">
                            <toolkit:DataGrid.Columns>
                                <toolkit:DataGridTemplateColumn loca:Uids.Uid="DataGridTemplateColumn_SubordoId"
                                                                Tag="SubordoId">
                                    <toolkit:DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="models:Tbl36Subordo">
                                            <HyperlinkButton Margin="12,0"
                                                             BorderThickness="0"
                                                             Click="ViewSubordoHyperlinkButton_Click"
                                                             Content="{Binding SubordoId}" />
                                        </DataTemplate>
                                    </toolkit:DataGridTemplateColumn.CellTemplate>
                                </toolkit:DataGridTemplateColumn>
                                <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_SubordoName"
                                                            Binding="{Binding SubordoName}"
                                                            CanUserSort="True"
                                                            Tag="SubordoName" />
                                <toolkit:DataGridComboBoxColumn loca:Uids.Uid="DataGridComboBoxColumn_OrdoName"
                                                                Binding="{Binding OrdoId}"
                                                                DisplayMemberPath="OrdoName"
                                                                ItemsSource="{x:Bind ViewModel.Tbl33OrdosAllList, Mode=OneWay}" />
                                <toolkit:DataGridCheckBoxColumn loca:Uids.Uid="DataGridCheckBoxColumn_Valid"
                                                                Binding="{Binding Valid}"
                                                                Tag="Valid" />
                                <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_ValidYear"
                                                            Binding="{Binding ValidYear}"
                                                            Tag="ValidYear" />
                                <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_Author"
                                                            Binding="{Binding Author}"
                                                            Tag="Author" />
                                <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_AuthorYear"
                                                            Binding="{Binding AuthorYear}"
                                                            Tag="AuthorYear" />
                                <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_Info"
                                                            Binding="{Binding Info}"
                                                            Tag="Info" />
                            </toolkit:DataGrid.Columns>
                        </toolkit:DataGrid>
                    </Grid>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <ProgressRing x:Name="LoadingProgressRing"
                      Width="40"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                      RelativePanel.AlignHorizontalCenterWithPanel="True"
                      RelativePanel.AlignVerticalCenterWithPanel="True"
                      Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
    </RelativePanel>
</Page>
