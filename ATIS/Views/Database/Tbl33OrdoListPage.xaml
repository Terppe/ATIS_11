<?xml version="1.0" encoding="utf-8" ?>

<Page x:Class="ATIS.Views.Database.Tbl33OrdoListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:conv="using:ATIS.Helpers.Converters"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:helpers="using:ATIS.Helpers"
      xmlns:loca="using:WinUI3Localizer"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:models="using:ATIS.Models"
      xmlns:toolkit="using:CommunityToolkit.WinUI.UI.Controls"
      xmlns:winUiCommunity="using:WinUICommunity"
      NavigationCacheMode="Disabled"
      mc:Ignorable="d">

    <!--  OrdoListPage.xaml  Skriptdatum: 15.06.2024  10:32  -->

    <Page.Resources>

        <MenuFlyout x:Key="OrdoDataContextMenu">
            <MenuFlyoutItem loca:Uids.Uid="MenuFlyout_Save_Ordo"
                            Click="SaveOrdo_Click">
                <MenuFlyoutItem.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/save.png" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem loca:Uids.Uid="MenuFlyout_Delete_Ordo"
                            Click="DeleteOrdo_Click">
                <MenuFlyoutItem.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/delete.png" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem loca:Uids.Uid="MenuFlyout_Add_Ordo"
                            Click="AddOrdo_Click">
                <MenuFlyoutItem.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/add.png" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem loca:Uids.Uid="MenuFlyout_Add_Reference_Expert"
                            Click="AddReferenceExpertButton_Click">
                <MenuFlyoutItem.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/add.png" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem loca:Uids.Uid="MenuFlyout_Add_Reference_Source"
                            Click="AddReferenceSourceButton_Click">
                <MenuFlyoutItem.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/add.png" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem loca:Uids.Uid="MenuFlyout_Add_Reference_Author"
                            Click="AddReferenceAuthorButton_Click">
                <MenuFlyoutItem.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/add.png" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem loca:Uids.Uid="MenuFlyout_Add_Comment"
                            Click="AddComment_Click">
                <MenuFlyoutItem.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/add.png" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem loca:Uids.Uid="MenuFlyout_Refresh"
                            Click="Refresh_Click">
                <MenuFlyoutItem.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/refresh.png" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>
        <MenuFlyout x:Key="ReferenceDataContextMenu">
            <MenuFlyoutItem loca:Uids.Uid="MenuFlyout_Delete_Reference"
                            Click="DeleteReference_Click">
                <MenuFlyoutItem.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/delete.png" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem loca:Uids.Uid="MenuFlyout_Add_Reference_Expert"
                            Click="AddReferenceExpertButton_Click">
                <MenuFlyoutItem.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/add.png" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem loca:Uids.Uid="MenuFlyout_Add_Reference_Source"
                            Click="AddReferenceSourceButton_Click">
                <MenuFlyoutItem.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/add.png" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem loca:Uids.Uid="MenuFlyout_Add_Reference_Author"
                            Click="AddReferenceAuthorButton_Click">
                <MenuFlyoutItem.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/add.png" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>
        <MenuFlyout x:Key="CommentDataContextMenu">
            <MenuFlyoutItem loca:Uids.Uid="MenuFlyout_Delete_Comment"
                            Click="DeleteComment_Click">
                <MenuFlyoutItem.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/delete.png" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem loca:Uids.Uid="MenuFlyout_Add_Comment"
                            Click="AddComment_Click">
                <MenuFlyoutItem.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/add.png" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>
        <MenuFlyout x:Key="SubordoDataContextMenu">
            <MenuFlyoutItem loca:Uids.Uid="MenuFlyout_Add_Subordo"
                            Click="AddSubordo_Click">
                <MenuFlyoutItem.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/add.png" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>
    </Page.Resources>

    <RelativePanel x:Name="OrdoRoot"
                   Margin="{StaticResource SmallLeftTopRightBottomMargin}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource LargeWindowSnapPoint}" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource MediumWindowSnapPoint}" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource MinWindowSnapPoint}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="OrdoCommandBar.DefaultLabelPosition" Value="Bottom" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <TextBlock x:Name="PageTitle"
                   loca:Uids.Uid="TextBlock_Ordos"
                   RelativePanel.AlignLeftWithPanel="True"
                   Style="{StaticResource PageTitleTextBlockStyle}" />
        <TextBlock x:Name="OrdoDatasetText"
                   Margin="5,17,0,0"
                   loca:Uids.Uid="TextBlock_DataSetCount"
                   RelativePanel.RightOf="PageTitle"
                   Style="{StaticResource DatasetTitleStyle}" />
        <TextBlock x:Name="OrdoDatasetCountText"
                   Margin="5,17,0,0"
                   RelativePanel.RightOf="OrdoDatasetText"
                   Style="{StaticResource DatasetTitleStyle}"
                   Text="{x:Bind ViewModel.OrdoDataSetCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <CommandBar x:Name="OrdoCommandBar"
                    HorizontalAlignment="Stretch"
                    Background="Transparent"
                    DefaultLabelPosition="Right"
                    RelativePanel.LeftOf="OrdoSearchBox"
                    RelativePanel.RightOf="OrdoDatasetCountText">
            <AppBarButton x:Name="AppBarButtonDeleteOrdo"
                          loca:Uids.Uid="AppBarButtonDeleteOrdo"
                          Click="DeleteOrdo_Click"
                          IsEnabled="{x:Bind conv:NotConverter.IsNotNull(ViewModel.OrdoSelected), Mode=OneWay}">
                <AppBarButton.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/delete.png" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton loca:Uids.Uid="AppBarButtonAddOrdo"
                          Background="{ThemeResource SystemAccentColor}"
                          Click="AddOrdo_Click"
                          Foreground="White">
                <AppBarButton.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/add.png" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="AppBarButtonAddReference"
                          loca:Uids.Uid="AppBarButtonAddReference"
                          IsCompact="True"
                          IsEnabled="{x:Bind conv:NotConverter.IsNotNull(ViewModel.OrdoSelected), Mode=OneWay}">
                <AppBarButton.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/add.png" />
                </AppBarButton.Icon>
                <AppBarButton.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem loca:Uids.Uid="MenuFlyout_Add_Reference_Expert"
                                        Click="AddReferenceExpertButton_Click"
                                        Tag="rating">
                            <MenuFlyoutItem.Icon>
                                <BitmapIcon ShowAsMonochrome="False"
                                            UriSource="/Assets/Fluent/add.png" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem loca:Uids.Uid="MenuFlyout_Add_Reference_Source"
                                        Click="AddReferenceSourceButton_Click"
                                        Tag="match">
                            <MenuFlyoutItem.Icon>
                                <BitmapIcon ShowAsMonochrome="False"
                                            UriSource="/Assets/Fluent/add.png" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem loca:Uids.Uid="MenuFlyout_Add_Reference_Author"
                                        Click="AddReferenceAuthorButton_Click"
                                        Tag="distance">
                            <MenuFlyoutItem.Icon>
                                <BitmapIcon ShowAsMonochrome="False"
                                            UriSource="/Assets/Fluent/add.png" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarButton x:Name="AppBarButtonAddComment"
                          loca:Uids.Uid="AppBarButtonAddComment"
                          Click="AddComment_Click"
                          IsEnabled="{x:Bind conv:NotConverter.IsNotNull(ViewModel.OrdoSelected), Mode=OneWay}">
                <AppBarButton.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/add.png" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="AppBarButtonAddSubordo"
                          loca:Uids.Uid="AppBarButtonAddSubordo"
                          Click="AddSubordo_Click"
                          IsEnabled="{x:Bind conv:NotConverter.IsNotNull(ViewModel.OrdoSelected), Mode=OneWay}">
                <AppBarButton.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/add.png" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="AppBarButtonSync"
                          loca:Uids.Uid="AppBarButtonSync"
                          Click="Refresh_Click"
                          IsEnabled="{x:Bind conv:NotConverter.IsNotNull(ViewModel.OrdoSelected), Mode=OneWay}">
                <AppBarButton.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/refresh.png" />
                </AppBarButton.Icon>
            </AppBarButton>
        </CommandBar>

        <AutoSuggestBox Name="OrdoSearchBox"
                        Width="200"
                        Margin="4,8,4,0"
                        loca:Uids.Uid="AutoSuggestBox_Search"
                        Loaded="OrdoSearchBox_OnLoaded"
                        QuerySubmitted="GetOrdosByNameOrId"
                        RelativePanel.AlignRightWithPanel="True">
            <AutoSuggestBox.QueryIcon>
                <BitmapIcon ShowAsMonochrome="False"
                            UriSource="/Assets/Fluent/search.png" />
            </AutoSuggestBox.QueryIcon>
        </AutoSuggestBox>

        <ScrollViewer x:Name="PanelOrdo"
                      RelativePanel.AlignLeftWithPanel="True"
                      RelativePanel.AlignRightWithPanel="True"
                      RelativePanel.Below="PageTitle"
                      VerticalScrollBarVisibility="Auto"
                      VerticalScrollMode="Auto">
            <StackPanel Margin="-10,8,4,0">
                <StackPanel.Resources>
                    <Style TargetType="Expander">
                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                    </Style>
                </StackPanel.Resources>
                <toolkit:DataGrid x:Name="OrdoDataGrid"
                                  MaxHeight="230"
                                  Margin="0,0,20,0"
                                  VerticalAlignment="Top"
                                  x:FieldModifier="public"
                                  AlternatingRowBackground="LightGray"
                                  AutoGenerateColumns="False"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  CanUserReorderColumns="False"
                                  CanUserResizeColumns="False"
                                  ContextFlyout="{StaticResource OrdoDataContextMenu}"
                                  CurrentCellChanged="OrdoDataGrid_OnCurrentCellChanged"
                                  GridLinesVisibility="Horizontal"
                                  ItemsSource="{x:Bind ViewModel.OrdoItems}"
                                  SelectedItem="{x:Bind ViewModel.OrdoSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  SelectionMode="Single"
                                  Sorting="OrdoDataGrid_Sorting">
                    <toolkit:DataGrid.Columns>
                        <toolkit:DataGridTemplateColumn loca:Uids.Uid="DataGridTemplateColumn_OrdoId"
                                                        Tag="OrdoId">
                            <toolkit:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:Tbl33Ordo">
                                    <HyperlinkButton Margin="12,0"
                                                     BorderThickness="0"
                                                     Click="ViewOrdoHyperlinkButton_Click"
                                                     Content="{Binding OrdoId}" />
                                </DataTemplate>
                            </toolkit:DataGridTemplateColumn.CellTemplate>
                        </toolkit:DataGridTemplateColumn>
                        <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_OrdoName"
                                                    Binding="{Binding OrdoName}"
                                                    CanUserSort="True"
                                                    Tag="OrdoName" />
                        <toolkit:DataGridComboBoxColumn loca:Uids.Uid="DataGridComboBoxColumn_LegioName"
                                                        Binding="{Binding LegioId}"
                                                        DisplayMemberPath="LegioName"
                                                        ItemsSource="{x:Bind ViewModel.Tbl30LegiosAllList, Mode=OneWay}" />
                        <toolkit:DataGridCheckBoxColumn loca:Uids.Uid="DataGridCheckBoxColumn_Valid"
                                                        Binding="{Binding Valid}"
                                                        Tag="Valid" />
                        <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_ValidYear"
                                                    Binding="{Binding ValidYear}"
                                                    Tag="ValidYear" />
                        <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_Author"
                                                    Binding="{Binding Author}"
                                                    Tag="Author" />
                        <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_AuthorYear"
                                                    Binding="{Binding AuthorYear}"
                                                    Tag="AuthorYear" />
                        <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_Info"
                                                    Binding="{Binding Info}"
                                                    Tag="Info" />
                    </toolkit:DataGrid.Columns>
                </toolkit:DataGrid>

                <!--  OrdoDetailExpander  -->
                <Expander x:Name="OrdoDetailExpander"
                          Margin="{StaticResource XSmallTopBottomMargin}"
                          Visibility="Collapsed">
                    <Expander.Header>
                        <Grid>
                            <TextBlock loca:Uids.Uid="TextBlock_Ordo1"
                                       Style="{ThemeResource SubtitleTextBlockStyle}" />
                            <TextBlock HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Text="{x:Bind ViewModel.OrdoSelected.OrdoName, Mode=OneWay}" />
                        </Grid>
                    </Expander.Header>

                    <RelativePanel x:Name="OrdoDetailRoot"
                                   Margin="{StaticResource SmallLeftRightMargin}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup>
                                <VisualState>
                                    <VisualState.StateTriggers>
                                        <AdaptiveTrigger MinWindowWidth="{StaticResource LargeWindowSnapPoint}" />
                                    </VisualState.StateTriggers>
                                </VisualState>
                                <VisualState>
                                    <VisualState.StateTriggers>
                                        <AdaptiveTrigger MinWindowWidth="{StaticResource MediumWindowSnapPoint}" />
                                    </VisualState.StateTriggers>
                                </VisualState>
                                <VisualState>
                                    <VisualState.StateTriggers>
                                        <AdaptiveTrigger MinWindowWidth="{StaticResource MinWindowSnapPoint}" />
                                    </VisualState.StateTriggers>
                                    <VisualState.Setters>
                                        <Setter Target="OrdoCommandBar.DefaultLabelPosition" Value="Bottom" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <CommandBar x:Name="OrdoDetailCommandBar"
                                    Margin="{StaticResource SmallLeftRightCommandBarMargin}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Top"
                                    Background="Transparent"
                                    DefaultLabelPosition="Right"
                                    RelativePanel.AlignRightWithPanel="True">
                            <AppBarButton loca:Uids.Uid="AppBarButtonSave"
                                          Background="{ThemeResource SystemBaseLowColor}"
                                          Click="SaveOrdo_Click"
                                          Foreground="White"
                                          Visibility="{x:Bind ViewModel.IsInEditOrdo, Mode=OneWay}">
                                <AppBarButton.Icon>
                                    <BitmapIcon ShowAsMonochrome="False"
                                                UriSource="/Assets/Fluent/save.png" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton loca:Uids.Uid="AppBarButtonCancel"
                                          Click="CancelEditsOrdoAsync"
                                          Visibility="{x:Bind ViewModel.IsInEditOrdo, Mode=OneWay}">
                                <AppBarButton.Icon>
                                    <BitmapIcon ShowAsMonochrome="False"
                                                UriSource="/Assets/Fluent/cancel.png" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarSeparator Visibility="{x:Bind ViewModel.IsInEditOrdo, Mode=OneWay}" />
                            <AppBarButton loca:Uids.Uid="AppBarButtonBack"
                                          Background="{ThemeResource SystemAccentColor}"
                                          Click="BackOrdo_Click"
                                          Foreground="White">
                                <AppBarButton.Icon>
                                    <BitmapIcon ShowAsMonochrome="False"
                                                UriSource="/Assets/Fluent/arrowleft.png" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton loca:Uids.Uid="AppBarButtonEdit"
                                          Click="{x:Bind ViewModel.StartEditOrdo}"
                                          IsEnabled="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditOrdo), Mode=OneWay}"
                                          Visibility="{x:Bind conv:NotConverter.CollapsedIf(ViewModel.IsNewOrdo), Mode=OneWay}">
                                <AppBarButton.Icon>
                                    <BitmapIcon ShowAsMonochrome="False"
                                                UriSource="/Assets/Fluent/edit.png" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                        </CommandBar>
                        <ScrollViewer x:Name="DetailPanelOrdo"
                                      Margin="0,36,0,0"
                                      RelativePanel.AlignLeftWithPanel="True"
                                      RelativePanel.AlignRightWithPanel="True"
                                      VerticalScrollBarVisibility="Auto"
                                      VerticalScrollMode="Auto">
                            <RelativePanel Margin="4,0,0,0">
                                <TextBox x:Name="OrdoId"
                                         MinWidth="110"
                                         Margin="{StaticResource XSmallRightMargin}"
                                         loca:Uids.Uid="TextBox_OrdoId"
                                         IsReadOnly="True"
                                         RelativePanel.AlignLeftWithPanel="True"
                                         Text="{x:Bind ViewModel.OrdoSelected.OrdoId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox x:Name="OrdoName"
                                         MinWidth="150"
                                         Margin="{StaticResource XSmallRightMargin}"
                                         loca:Uids.Uid="TextBox_OrdoName"
                                         Background="SlateGray"
                                         Foreground="White"
                                         IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditOrdo), Mode=OneWay}"
                                         LostFocus="OrdoName_OnLostFocus"
                                         MaxLength="100"
                                         RelativePanel.RightOf="OrdoId"
                                         Text="{x:Bind ViewModel.OrdoSelected.OrdoName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <CheckBox x:Name="ValidCheckOrdo"
                                          Width="80"
                                          Margin="{StaticResource SmallRightCheckBoxMargin}"
                                          VerticalAlignment="Bottom"
                                          loca:Uids.Uid="CheckBox_Valid"
                                          IsChecked="{x:Bind ViewModel.OrdoSelected.Valid, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{x:Bind conv:NotConverter.NotCombo(ViewModel.IsInEditOrdo), Mode=OneWay}"
                                          RelativePanel.RightOf="OrdoName" />
                                <TextBox x:Name="ValidYearTextOrdo"
                                         Width="70"
                                         Margin="{StaticResource XSmallRightMargin}"
                                         loca:Uids.Uid="TextBox_ValidYear"
                                         winUiCommunity:TextBoxExtensions.Mask="9999"
                                         winUiCommunity:TextBoxExtensions.MaskPlaceholder=" "
                                         CornerRadius="3"
                                         IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditOrdo), Mode=OneWay}"
                                         RelativePanel.RightOf="ValidCheckOrdo"
                                         Style="{StaticResource BodyTextBoxStyle}"
                                         Text="{x:Bind ViewModel.OrdoSelected.ValidYear, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <ComboBox x:Name="LegioCombo"
                                          MinWidth="200"
                                          Margin="{StaticResource XSmallRightComboBoxMargin}"
                                          loca:Uids.Uid="ComboBox_LegioName"
                                          DisplayMemberPath="LegioName"
                                          IsEnabled="{x:Bind conv:NotConverter.NotCombo(ViewModel.IsInEditOrdo), Mode=OneWay}"
                                          ItemsSource="{x:Bind ViewModel.Tbl30LegiosAllList}"
                                          RelativePanel.RightOf="ValidYearTextOrdo"
                                          SelectedValue="{x:Bind ViewModel.OrdoSelected.LegioId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          SelectedValuePath="LegioId" />
                                <TextBox x:Name="AuthorTextOrdo"
                                         MinWidth="150"
                                         Margin="{StaticResource XSmallRightMargin}"
                                         HorizontalAlignment="Stretch"
                                         loca:Uids.Uid="TextBox_Author"
                                         CharacterCasing="Upper"
                                         IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditOrdo), Mode=OneWay}"
                                         MaxLength="60"
                                         RelativePanel.AlignLeftWithPanel="True"
                                         RelativePanel.Below="OrdoId"
                                         Text="{x:Bind ViewModel.OrdoSelected.Author, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox x:Name="AuthorYearTextOrdo"
                                         Width="70"
                                         Margin="{StaticResource XSmallRightMargin}"
                                         loca:Uids.Uid="TextBox_AuthorYear"
                                         winUiCommunity:TextBoxExtensions.Mask="9999"
                                         winUiCommunity:TextBoxExtensions.MaskPlaceholder=" "
                                         CornerRadius="3"
                                         IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditOrdo), Mode=OneWay}"
                                         RelativePanel.Below="ValidCheckOrdo"
                                         RelativePanel.RightOf="AuthorTextOrdo"
                                         Text="{x:Bind ViewModel.OrdoSelected.AuthorYear, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox x:Name="InfoOrdo"
                                         MinWidth="1120"
                                         Margin="{StaticResource XSmallRightMargin}"
                                         HorizontalAlignment="Stretch"
                                         loca:Uids.Uid="TextBox_Info"
                                         IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditOrdo), Mode=OneWay}"
                                         RelativePanel.AlignLeftWithPanel="True"
                                         RelativePanel.Below="AuthorTextOrdo"
                                         Text="{x:Bind ViewModel.OrdoSelected.Info, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox x:Name="SynonymOrdo"
                                         MinWidth="1120"
                                         MinHeight="75"
                                         MaxWidth="1300"
                                         MaxHeight="150"
                                         Margin="{StaticResource XSmallRightMargin}"
                                         loca:Uids.Uid="TextBox_Synonym"
                                         AcceptsReturn="True"
                                         IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditOrdo), Mode=OneWay}"
                                         RelativePanel.AlignLeftWithPanel="True"
                                         RelativePanel.Below="InfoOrdo"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         Text="{x:Bind ViewModel.OrdoSelected.Synonym, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         TextWrapping="Wrap" />
                                <TabView x:Name="TabViewLanguageOrdo"
                                         MinWidth="1120"
                                         MaxWidth="1300"
                                         Margin="{StaticResource XSmallRightMargin}"
                                         Background="LightBlue"
                                         CornerRadius="3"
                                         IsAddTabButtonVisible="False"
                                         RelativePanel.AlignLeftWithPanel="True"
                                         RelativePanel.Below="SynonymOrdo">
                                    <TabView.TabItems>
                                        <TabViewItem loca:Uids.Uid="TabViewItem_EngName"
                                                     IsClosable="False">
                                            <TextBox Margin="{StaticResource XSmallRightMargin}"
                                                     IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditOrdo), Mode=OneWay}"
                                                     MaxLength="200"
                                                     Text="{x:Bind ViewModel.OrdoSelected.EngName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </TabViewItem>
                                        <TabViewItem loca:Uids.Uid="TabViewItem_GerName"
                                                     IsClosable="False">
                                            <TextBox Margin="{StaticResource XSmallRightMargin}"
                                                     IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditOrdo), Mode=OneWay}"
                                                     MaxLength="200"
                                                     Text="{x:Bind ViewModel.OrdoSelected.GerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </TabViewItem>
                                        <TabViewItem loca:Uids.Uid="TabViewItem_FraName"
                                                     IsClosable="False">
                                            <TextBox Margin="{StaticResource XSmallRightMargin}"
                                                     IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditOrdo), Mode=OneWay}"
                                                     MaxLength="200"
                                                     Text="{x:Bind ViewModel.OrdoSelected.FraName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
