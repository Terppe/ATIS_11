<?xml version="1.0" encoding="utf-8" ?>

<Page x:Class="ATIS.Views.Database.Tbl93CommentListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:conv="using:ATIS.Helpers.Converters"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:loca="using:WinUI3Localizer"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:models="using:ATIS.Models"
      xmlns:toolkit="using:CommunityToolkit.WinUI.UI.Controls"
      xmlns:winUiCommunity="using:WinUICommunity"
      NavigationCacheMode="Disabled"
      mc:Ignorable="d">

    <!--  CommentListPage.xaml  Skriptdatum: 06.01.2025  10:32  -->

    <Page.Resources>

        <MenuFlyout x:Key="CommentDataContextMenu">
            <MenuFlyoutItem loca:Uids.Uid="MenuFlyout_Delete_Comment"
                            Click="DeleteComment_Click">
                <MenuFlyoutItem.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/delete.png" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem loca:Uids.Uid="MenuFlyout_Add_Comment"
                            Click="AddComment_Click">
                <MenuFlyoutItem.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/add.png" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem loca:Uids.Uid="MenuFlyout_Refresh"
                            Click="Refresh_Click">
                <MenuFlyoutItem.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/refresh.png" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>
    </Page.Resources>

    <RelativePanel x:Name="CommentRoot"
                   Margin="{StaticResource SmallLeftTopRightBottomMargin}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource LargeWindowSnapPoint}" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource MediumWindowSnapPoint}" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource MinWindowSnapPoint}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="CommentCommandBar.DefaultLabelPosition" Value="Bottom" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <TextBlock x:Name="PageTitle"
                   loca:Uids.Uid="TextBlock_Comments"
                   RelativePanel.AlignLeftWithPanel="True"
                   Style="{StaticResource PageTitleTextBlockStyle}" />
        <TextBlock x:Name="CommentDatasetText"
                   Margin="5,17,0,0"
                   loca:Uids.Uid="TextBlock_DataSetCount"
                   RelativePanel.RightOf="PageTitle"
                   Style="{StaticResource DatasetTitleStyle}" />
        <TextBlock x:Name="CommentDatasetCountText"
                   Margin="5,17,0,0"
                   RelativePanel.RightOf="CommentDatasetText"
                   Style="{StaticResource DatasetTitleStyle}"
                   Text="{x:Bind ViewModel.CommentDataSetCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <CommandBar x:Name="CommentCommandBar"
                    HorizontalAlignment="Stretch"
                    Background="Transparent"
                    DefaultLabelPosition="Right"
                    RelativePanel.LeftOf="CommentSearchBox"
                    RelativePanel.RightOf="CommentDatasetCountText">
            <AppBarButton x:Name="AppBarButtonDeleteComment"
                          loca:Uids.Uid="AppBarButtonDeleteComment"
                          Click="DeleteComment_Click"
                          IsEnabled="{x:Bind conv:NotConverter.IsNotNull(ViewModel.CommentSelected), Mode=OneWay}">
                <AppBarButton.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/delete.png" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton loca:Uids.Uid="AppBarButtonAddComment"
                          Background="{ThemeResource SystemAccentColor}"
                          Click="AddComment_Click"
                          Foreground="White">
                <AppBarButton.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/add.png" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="AppBarButtonSync"
                          loca:Uids.Uid="AppBarButtonSync"
                          Click="Refresh_Click"
                          IsEnabled="{x:Bind conv:NotConverter.IsNotNull(ViewModel.CommentSelected), Mode=OneWay}">
                <AppBarButton.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/refresh.png" />
                </AppBarButton.Icon>
            </AppBarButton>
        </CommandBar>

        <AutoSuggestBox Name="CommentSearchBox"
                        Width="200"
                        Margin="4,8,4,0"
                        loca:Uids.Uid="AutoSuggestBox_Search"
                        Loaded="CommentSearchBox_OnLoaded"
                        QuerySubmitted="GetCommentsByInfoOrId"
                        RelativePanel.AlignRightWithPanel="True">
            <AutoSuggestBox.QueryIcon>
                <BitmapIcon ShowAsMonochrome="False"
                            UriSource="/Assets/Fluent/search.png" />
            </AutoSuggestBox.QueryIcon>
        </AutoSuggestBox>

        <ScrollViewer x:Name="PanelComment"
                      RelativePanel.AlignLeftWithPanel="True"
                      RelativePanel.AlignRightWithPanel="True"
                      RelativePanel.Below="PageTitle"
                      VerticalScrollBarVisibility="Auto"
                      VerticalScrollMode="Auto">
            <StackPanel Margin="-10,8,4,0">
                <StackPanel.Resources>
                    <Style TargetType="Expander">
                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                    </Style>
                </StackPanel.Resources>
                <toolkit:DataGrid x:Name="CommentDataGrid"
                                  MaxHeight="330"
                                  Margin="0,0,20,0"
                                  VerticalAlignment="Top"
                                  x:FieldModifier="public"
                                  AlternatingRowBackground="LightGray"
                                  AutoGenerateColumns="False"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  CanUserReorderColumns="False"
                                  CanUserResizeColumns="False"
                                  ContextFlyout="{StaticResource CommentDataContextMenu}"
                                  CurrentCellChanged="CommentDataGrid_OnCurrentCellChanged"
                                  GridLinesVisibility="Horizontal"
                                  ItemsSource="{x:Bind ViewModel.CommentItems}"
                                  SelectedItem="{x:Bind ViewModel.CommentSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  SelectionMode="Single"
                                  Sorting="CommentDataGrid_Sorting">
                    <toolkit:DataGrid.Columns>
                        <toolkit:DataGridTemplateColumn loca:Uids.Uid="DataGridTemplateColumn_CommentId"
                                                        Tag="CommentId">
                            <toolkit:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:Tbl93Comment">
                                    <HyperlinkButton Margin="12,0"
                                                     BorderThickness="0"
                                                     Click="ViewCommentHyperlinkButton_Click"
                                                     Content="{Binding CommentId}" />
                                </DataTemplate>
                            </toolkit:DataGridTemplateColumn.CellTemplate>
                        </toolkit:DataGridTemplateColumn>
                        <toolkit:DataGridCheckBoxColumn loca:Uids.Uid="DataGridCheckBoxColumn_Valid"
                                                        Binding="{Binding Valid}"
                                                        Tag="Valid" />
                        <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_ValidYear"
                                                    Binding="{Binding ValidYear}"
                                                    Tag="ValidYear" />
                        <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_Info"
                                                    Binding="{Binding Info}"
                                                    CanUserSort="False"
                                                    Tag="Info" />
                    </toolkit:DataGrid.Columns>
                </toolkit:DataGrid>

                <!--  CommentDetailExpander  -->
                <Expander x:Name="CommentDetailExpander"
                          Margin="{StaticResource XSmallTopBottomMargin}"
                          Visibility="Collapsed">
                    <Expander.Header>
                        <Grid>
                            <TextBlock loca:Uids.Uid="TextBlock_Comment"
                                       Style="{ThemeResource SubtitleTextBlockStyle}" />
                            <TextBlock HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Text="{x:Bind ViewModel.CommentSelected.CommentId, Mode=OneWay}" />
                        </Grid>
                    </Expander.Header>

                    <RelativePanel x:Name="CommentDetailRoot"
                                   Margin="{StaticResource SmallLeftRightMargin}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup>
                                <VisualState>
                                    <VisualState.StateTriggers>
                                        <AdaptiveTrigger MinWindowWidth="{StaticResource LargeWindowSnapPoint}" />
                                    </VisualState.StateTriggers>
                                </VisualState>
                                <VisualState>
                                    <VisualState.StateTriggers>
                                        <AdaptiveTrigger MinWindowWidth="{StaticResource MediumWindowSnapPoint}" />
                                    </VisualState.StateTriggers>
                                </VisualState>
                                <VisualState>
                                    <VisualState.StateTriggers>
                                        <AdaptiveTrigger MinWindowWidth="{StaticResource MinWindowSnapPoint}" />
                                    </VisualState.StateTriggers>
                                    <VisualState.Setters>
                                        <Setter Target="CommentCommandBar.DefaultLabelPosition" Value="Bottom" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <CommandBar x:Name="CommentDetailCommandBar"
                                    Margin="{StaticResource SmallLeftRightCommandBarMargin}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Top"
                                    Background="Transparent"
                                    DefaultLabelPosition="Right"
                                    RelativePanel.AlignRightWithPanel="True">
                            <AppBarButton loca:Uids.Uid="AppBarButtonSave"
                                          Background="{ThemeResource SystemBaseLowColor}"
                                          Click="SaveComment_Click"
                                          Foreground="White"
                                          Visibility="{x:Bind ViewModel.IsInEditComment, Mode=OneWay}">
                                <AppBarButton.Icon>
                                    <BitmapIcon ShowAsMonochrome="False"
                                                UriSource="/Assets/Fluent/save.png" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton loca:Uids.Uid="AppBarButtonCancel"
                                          Click="CancelEditsCommentAsync"
                                          Visibility="{x:Bind ViewModel.IsInEditComment, Mode=OneWay}">
                                <AppBarButton.Icon>
                                    <BitmapIcon ShowAsMonochrome="False"
                                                UriSource="/Assets/Fluent/cancel.png" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarSeparator Visibility="{x:Bind ViewModel.IsInEditComment, Mode=OneWay}" />
                            <AppBarButton loca:Uids.Uid="AppBarButtonBack"
                                          Background="{ThemeResource SystemAccentColor}"
                                          Click="BackComment_Click"
                                          Foreground="White">
                                <AppBarButton.Icon>
                                    <BitmapIcon ShowAsMonochrome="False"
                                                UriSource="/Assets/Fluent/arrowleft.png" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton loca:Uids.Uid="AppBarButtonEdit"
                                          Click="{x:Bind ViewModel.StartEditComment}"
                                          IsEnabled="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditComment), Mode=OneWay}"
                                          Visibility="{x:Bind conv:NotConverter.CollapsedIf(ViewModel.IsNewComment), Mode=OneWay}">
                                <AppBarButton.Icon>
                                    <BitmapIcon ShowAsMonochrome="False"
                                                UriSource="/Assets/Fluent/edit.png" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                        </CommandBar>
                        <ScrollViewer x:Name="DetailPanelComment"
                                      Margin="0,36,0,0"
                                      RelativePanel.AlignLeftWithPanel="True"
                                      RelativePanel.AlignRightWithPanel="True"
                                      VerticalScrollBarVisibility="Auto"
                                      VerticalScrollMode="Auto">
                            <StackPanel>
                                <StackPanel.Resources>
                                    <Style TargetType="Expander">
                                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                                    </Style>
                                </StackPanel.Resources>
                                <RelativePanel Margin="4,0,0,0">
                                    <TextBox x:Name="CommentId"
                                             MinWidth="110"
                                             Margin="{StaticResource XSmallRightMargin}"
                                             loca:Uids.Uid="TextBox_CommentId"
                                             IsReadOnly="True"
                                             RelativePanel.AlignLeftWithPanel="True"
                                             Style="{StaticResource BodyTextBoxStyle}"
                                             Text="{x:Bind ViewModel.CommentSelected.CommentId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox x:Name="ValidCheckComment"
                                              Width="80"
                                              Margin="{StaticResource SmallRightCheckBoxMargin}"
                                              VerticalAlignment="Bottom"
                                              loca:Uids.Uid="CheckBox_Valid"
                                              IsChecked="{x:Bind ViewModel.CommentSelected.Valid, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              RelativePanel.AlignLeftWithPanel="True"
                                              RelativePanel.Below="CommentId" />
                                    <TextBox x:Name="ValidYearTextComment"
                                             Width="70"
                                             Margin="{StaticResource XSmallRightMargin}"
                                             loca:Uids.Uid="TextBox_ValidYear"
                                             winUiCommunity:TextBoxExtensions.Mask="9999"
                                             winUiCommunity:TextBoxExtensions.MaskPlaceholder=" "
                                             CornerRadius="3"
                                             IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditComment), Mode=OneWay}"
                                             RelativePanel.Below="CommentId"
                                             RelativePanel.RightOf="ValidCheckComment"
                                             Style="{StaticResource BodyTextBoxStyle}"
                                             Text="{x:Bind ViewModel.CommentSelected.ValidYear, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <ComboBox x:Name="SpeciesCombo"
                                              MinWidth="300"
                                              Margin="{StaticResource XSmallRightComboBoxMargin}"
                                              loca:Uids.Uid="ComboBox_SpeciesName"
                                              DisplayMemberPath="SpeciesFullName"
                                              IsEnabled="{x:Bind conv:NotConverter.NotCombo(ViewModel.IsInEditComment), Mode=OneWay}"
                                              ItemsSource="{x:Bind ViewModel.Tbl75SpeciessesAllList}"
                                              RelativePanel.RightOf="ValidYearTextComment"
                                              SelectedValue="{x:Bind ViewModel.CommentSelected.SpeciesId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="SpeciesId" />
                                    <ComboBox x:Name="GenusCombo"
                                              MinWidth="300"
                                              Margin="{StaticResource XSmallRightComboBoxMargin}"
                                              loca:Uids.Uid="ComboBox_GenusName"
                                              DisplayMemberPath="GenusName"
                                              IsEnabled="{x:Bind conv:NotConverter.NotCombo(ViewModel.IsInEditComment), Mode=OneWay}"
                                              ItemsSource="{x:Bind ViewModel.Tbl66GenussesAllList}"
                                              RelativePanel.RightOf="SpeciesCombo"
                                              SelectedValue="{x:Bind ViewModel.CommentSelected.GenusId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="GenusId" />
                                    <TextBox x:Name="InfoComment"
                                             MinWidth="1120"
                                             Margin="{StaticResource XSmallRightMargin}"
                                             HorizontalAlignment="Stretch"
                                             loca:Uids.Uid="TextBox_Info"
                                             Foreground="IndianRed"
                                             IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditComment), Mode=OneWay}"
                                             MaxLength="100"
                                             RelativePanel.AlignLeftWithPanel="True"
                                             RelativePanel.Below="ValidCheckComment"
                                             Text="{x:Bind ViewModel.CommentSelected.Info, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <ComboBox x:Name="InfratribusCombo"
                                              MinWidth="250"
                                              Margin="{StaticResource XSmallRightComboBoxMargin}"
                                              loca:Uids.Uid="ComboBox_InfratribusName"
                                              DisplayMemberPath="InfratribusName"
                                              IsEnabled="{x:Bind conv:NotConverter.NotCombo(ViewModel.IsInEditComment), Mode=OneWay}"
                                              ItemsSource="{x:Bind ViewModel.Tbl63InfratribussesAllList}"
                                              RelativePanel.AlignLeftWithPanel="True"
                                              RelativePanel.Below="InfoComment"
                                              SelectedValue="{x:Bind ViewModel.CommentSelected.InfratribusId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="InfratribusId" />
                                    <ComboBox x:Name="SubtribusCombo"
                                              MinWidth="250"
                                              Margin="{StaticResource XSmallRightComboBoxMargin}"
                                              loca:Uids.Uid="ComboBox_SubtribusName"
                                              DisplayMemberPath="SubtribusName"
                                              IsEnabled="{x:Bind conv:NotConverter.NotCombo(ViewModel.IsInEditComment), Mode=OneWay}"
                                              ItemsSource="{x:Bind ViewModel.Tbl60SubtribussesAllList}"
                                              RelativePanel.Below="InfoComment"
                                              RelativePanel.RightOf="InfratribusCombo"
                                              SelectedValue="{x:Bind ViewModel.CommentSelected.SubtribusId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="SubtribusId" />
                                    <ComboBox x:Name="TribusCombo"
                                              MinWidth="250"
                                              Margin="{StaticResource XSmallRightComboBoxMargin}"
                                              loca:Uids.Uid="ComboBox_TribusName"
                                              DisplayMemberPath="TribusName"
                                              IsEnabled="{x:Bind conv:NotConverter.NotCombo(ViewModel.IsInEditComment), Mode=OneWay}"
                                              ItemsSource="{x:Bind ViewModel.Tbl57TribussesAllList}"
                                              RelativePanel.Below="InfoComment"
                                              RelativePanel.RightOf="SubtribusCombo"
                                              SelectedValue="{x:Bind ViewModel.CommentSelected.TribusId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="TribusId" />
                                    <ComboBox x:Name="SupertribusCombo"
                                              MinWidth="250"
                                              Margin="{StaticResource XSmallRightComboBoxMargin}"
                                              loca:Uids.Uid="ComboBox_SupertribusName"
                                              DisplayMemberPath="SupertribusName"
                                              IsEnabled="{x:Bind conv:NotConverter.NotCombo(ViewModel.IsInEditComment), Mode=OneWay}"
                                              ItemsSource="{x:Bind ViewModel.Tbl54SupertribussesAllList}"
                                              RelativePanel.Below="InfoComment"
                                              RelativePanel.RightOf="TribusCombo"
                                              SelectedValue="{x:Bind ViewModel.CommentSelected.SupertribusId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="SupertribusId" />
                                    <ComboBox x:Name="InfrafamilyCombo"
                                              MinWidth="250"
                                              Margin="{StaticResource XSmallRightComboBoxMargin}"
                                              loca:Uids.Uid="ComboBox_InfrafamilyName"
                                              DisplayMemberPath="InfrafamilyName"
                                              IsEnabled="{x:Bind conv:NotConverter.NotCombo(ViewModel.IsInEditComment), Mode=OneWay}"
                                              ItemsSource="{x:Bind ViewModel.Tbl51InfrafamiliesAllList}"
                                              RelativePanel.AlignLeftWithPanel="True"
                                              RelativePanel.Below="InfratribusCombo"
                                              SelectedValue="{x:Bind ViewModel.CommentSelected.InfrafamilyId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="InfrafamilyId" />
                                    <ComboBox x:Name="SubfamilyCombo"
                                              MinWidth="250"
                                              Margin="{StaticResource XSmallRightComboBoxMargin}"
                                              loca:Uids.Uid="ComboBox_SubfamilyName"
                                              DisplayMemberPath="SubfamilyName"
                                              IsEnabled="{x:Bind conv:NotConverter.NotCombo(ViewModel.IsInEditComment), Mode=OneWay}"
                                              ItemsSource="{x:Bind ViewModel.Tbl48SubfamiliesAllList}"
                                              RelativePanel.Below="InfratribusCombo"
                                              RelativePanel.RightOf="InfrafamilyCombo"
                                              SelectedValue="{x:Bind ViewModel.CommentSelected.SubfamilyId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="SubfamilyId" />
                                    <ComboBox x:Name="FamilyCombo"
                                              MinWidth="250"
                                              Margin="{StaticResource XSmallRightComboBoxMargin}"
                                              loca:Uids.Uid="ComboBox_FamilyName"
                                              DisplayMemberPath="FamilyName"
                                              IsEnabled="{x:Bind conv:NotConverter.NotCombo(ViewModel.IsInEditComment), Mode=OneWay}"
                                              ItemsSource="{x:Bind ViewModel.Tbl45FamiliesAllList}"
                                              RelativePanel.Below="InfratribusCombo"
                                              RelativePanel.RightOf="SubfamilyCombo"
                                              SelectedValue="{x:Bind ViewModel.CommentSelected.FamilyId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="FamilyId" />
                                    <ComboBox x:Name="SuperfamilyCombo"
                                              MinWidth="250"
                                              Margin="{StaticResource XSmallRightComboBoxMargin}"
                                              loca:Uids.Uid="ComboBox_SuperfamilyName"
                                              DisplayMemberPath="SuperfamilyName"
                                              IsEnabled="{x:Bind conv:NotConverter.NotCombo(ViewModel.IsInEditComment), Mode=OneWay}"
                                              ItemsSource="{x:Bind ViewModel.Tbl42SuperfamiliesAllList}"
                                              RelativePanel.Below="InfratribusCombo"
                                              RelativePanel.RightOf="FamilyCombo"
                                              SelectedValue="{x:Bind ViewModel.CommentSelected.SuperfamilyId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="SuperfamilyId" />
                                    <ComboBox x:Name="InfraordoCombo"
                                              MinWidth="250"
                                              Margin="{StaticResource XSmallRightComboBoxMargin}"
                                              loca:Uids.Uid="ComboBox_InfraordoName"
                                              DisplayMemberPath="InfraordoName"
                                              IsEnabled="{x:Bind conv:NotConverter.NotCombo(ViewModel.IsInEditComment), Mode=OneWay}"
                                              ItemsSource="{x:Bind ViewModel.Tbl39InfraordosAllList}"
                                              RelativePanel.AlignLeftWithPanel="True"
                                              RelativePanel.Below="InfrafamilyCombo"
                                              SelectedValue="{x:Bind ViewModel.CommentSelected.InfraordoId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="InfraordoId" />
                                    <ComboBox x:Name="SubordoCombo"
                                              MinWidth="250"
                                              Margin="{StaticResource XSmallRightComboBoxMargin}"
                                              loca:Uids.Uid="ComboBox_SubordoName"
                                              DisplayMemberPath="SubordoName"
                                              IsEnabled="{x:Bind conv:NotConverter.NotCombo(ViewModel.IsInEditComment), Mode=OneWay}"
                                              ItemsSource="{x:Bind ViewModel.Tbl36SubordosAllList}"
                                              RelativePanel.Below="InfrafamilyCombo"
                                              RelativePanel.RightOf="InfraordoCombo"
                                              SelectedValue="{x:Bind ViewModel.CommentSelected.SubordoId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="SubordoId" />
                                    <ComboBox x:Name="OrdoCombo"
                                              MinWidth="250"
                                              Margin="{StaticResource XSmallRightComboBoxMargin}"
                                              loca:Uids.Uid="ComboBox_OrdoName"
                                              DisplayMemberPath="OrdoName"
                                              IsEnabled="{x:Bind conv:NotConverter.NotCombo(ViewModel.IsInEditComment), Mode=OneWay}"
                                              ItemsSource="{x:Bind ViewModel.Tbl33OrdosAllList}"
                                              RelativePanel.Below="InfrafamilyCombo"
                                              RelativePanel.RightOf="SubordoCombo"
                                              SelectedValue="{x:Bind ViewModel.CommentSelected.OrdoId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="OrdoId" />
                                    <ComboBox x:Name="LegioCombo"
                                              MinWidth="250"
                                              Margin="{StaticResource XSmallRightComboBoxMargin}"
                                              loca:Uids.Uid="ComboBox_LegioName"
                                              DisplayMemberPath="LegioName"
                                              IsEnabled="{x:Bind conv:NotConverter.NotCombo(ViewModel.IsInEditComment), Mode=OneWay}"
                                              ItemsSource="{x:Bind ViewModel.Tbl30LegiosAllList}"
                                              RelativePanel.Below="InfrafamilyCombo"
                                              RelativePanel.RightOf="OrdoCombo"
                                              SelectedValue="{x:Bind ViewModel.CommentSelected.LegioId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="LegioId" />
                                    <ComboBox x:Name="InfraclassCombo"
                                              MinWidth="250"
                                              Margin="{StaticResource XSmallRightComboBoxMargin}"
                                              loca:Uids.Uid="ComboBox_InfraclassName"
                                              DisplayMemberPath="InfraclassName"
                                              IsEnabled="{x:Bind conv:NotConverter.NotCombo(ViewModel.IsInEditComment), Mode=OneWay}"
                                              ItemsSource="{x:Bind ViewModel.Tbl27InfraclassesAllList}"
                                              RelativePanel.AlignLeftWithPanel="True"
                                              RelativePanel.Below="InfraordoCombo"
                                              SelectedValue="{x:Bind ViewModel.CommentSelected.InfraclassId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="InfraclassId" />
                                    <ComboBox x:Name="SubclassCombo"
                                              MinWidth="250"
                                              Margin="{StaticResource XSmallRightComboBoxMargin}"
                                              loca:Uids.Uid="ComboBox_SubclassName"
                                              DisplayMemberPath="SubclassName"
                                              IsEnabled="{x:Bind conv:NotConverter.NotCombo(ViewModel.IsInEditComment), Mode=OneWay}"
                                              ItemsSource="{x:Bind ViewModel.Tbl24SubclassesAllList}"
                                              RelativePanel.Below="InfraordoCombo"
                                              RelativePanel.RightOf="InfraclassCombo"
                                              SelectedValue="{x:Bind ViewModel.CommentSelected.SubclassId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="SubclassId" />
                                    <ComboBox x:Name="ClassCombo"
                                              MinWidth="250"
                                              Margin="{StaticResource XSmallRightComboBoxMargin}"
                                              loca:Uids.Uid="ComboBox_ClassName"
                                              DisplayMemberPath="ClassName"
                                              IsEnabled="{x:Bind conv:NotConverter.NotCombo(ViewModel.IsInEditComment), Mode=OneWay}"
                                              ItemsSource="{x:Bind ViewModel.Tbl21ClassesAllList}"
                                              RelativePanel.Below="InfraordoCombo"
                                              RelativePanel.RightOf="SubclassCombo"
                                              SelectedValue="{x:Bind ViewModel.CommentSelected.ClassId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="ClassId" />
                                    <ComboBox x:Name="SuperclassCombo"
                                              MinWidth="250"
                                              Margin="{StaticResource XSmallRightComboBoxMargin}"
                                              loca:Uids.Uid="ComboBox_SuperclassName"
                                              DisplayMemberPath="SuperclassName"
                                              IsEnabled="{x:Bind conv:NotConverter.NotCombo(ViewModel.IsInEditComment), Mode=OneWay}"
                                              ItemsSource="{x:Bind ViewModel.Tbl18SuperclassesAllList}"
                                              RelativePanel.Below="InfraordoCombo"
                                              RelativePanel.RightOf="ClassCombo"
                                              SelectedValue="{x:Bind ViewModel.CommentSelected.SuperclassId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="SuperclassId" />
                                    <ComboBox x:Name="SubdivisionCombo"
                                              MinWidth="200"
                                              Margin="{StaticResource XSmallRightComboBoxMargin}"
                                              loca:Uids.Uid="ComboBox_SubdivisionName"
                                              DisplayMemberPath="SubdivisionName"
                                              IsEnabled="{x:Bind conv:NotConverter.NotCombo(ViewModel.IsInEditComment), Mode=OneWay}"
                                              ItemsSource="{x:Bind ViewModel.Tbl15SubdivisionsAllList}"
                                              RelativePanel.AlignLeftWithPanel="True"
                                              RelativePanel.Below="InfraclassCombo"
                                              SelectedValue="{x:Bind ViewModel.CommentSelected.SubdivisionId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="SubdivisionId" />
                                    <ComboBox x:Name="DivisionCombo"
                                              MinWidth="200"
                                              Margin="{StaticResource XSmallRightComboBoxMargin}"
                                              loca:Uids.Uid="ComboBox_DivisionName"
                                              DisplayMemberPath="DivisionName"
                                              IsEnabled="{x:Bind conv:NotConverter.NotCombo(ViewModel.IsInEditComment), Mode=OneWay}"
                                              ItemsSource="{x:Bind ViewModel.Tbl09DivisionsAllList}"
                                              RelativePanel.Below="InfraclassCombo"
                                              RelativePanel.RightOf="SubdivisionCombo"
                                              SelectedValue="{x:Bind ViewModel.CommentSelected.DivisionId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="DivisionId" />
                                    <ComboBox x:Name="SubphylumCombo"
                                              MinWidth="200"
                                              Margin="{StaticResource XSmallRightComboBoxMargin}"
                                              loca:Uids.Uid="ComboBox_SubphylumName"
                                              DisplayMemberPath="SubphylumName"
                                              IsEnabled="{x:Bind conv:NotConverter.NotCombo(ViewModel.IsInEditComment), Mode=OneWay}"
                                              ItemsSource="{x:Bind ViewModel.Tbl12SubphylumsAllList}"
                                              RelativePanel.Below="InfraclassCombo"
                                              RelativePanel.RightOf="DivisionCombo"
                                              SelectedValue="{x:Bind ViewModel.CommentSelected.SubphylumId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="SubphylumId" />
                                    <ComboBox x:Name="PhylumCombo"
                                              MinWidth="200"
                                              Margin="{StaticResource XSmallRightComboBoxMargin}"
                                              loca:Uids.Uid="ComboBox_PhylumName"
                                              DisplayMemberPath="PhylumName"
                                              IsEnabled="{x:Bind conv:NotConverter.NotCombo(ViewModel.IsInEditComment), Mode=OneWay}"
                                              ItemsSource="{x:Bind ViewModel.Tbl06PhylumsAllList}"
                                              RelativePanel.Below="InfraclassCombo"
                                              RelativePanel.RightOf="SubphylumCombo"
                                              SelectedValue="{x:Bind ViewModel.CommentSelected.PhylumId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="PhylumId" />
                                    <ComboBox x:Name="RegnumCombo"
                                              MinWidth="200"
                                              Margin="{StaticResource XSmallRightComboBoxMargin}"
                                              loca:Uids.Uid="ComboBox_RegnumName"
                                              DisplayMemberPath="RegnumFullName"
                                              IsEnabled="{x:Bind conv:NotConverter.NotCombo(ViewModel.IsInEditComment), Mode=OneWay}"
                                              ItemsSource="{x:Bind ViewModel.Tbl03RegnumsAllList}"
                                              RelativePanel.Below="InfraclassCombo"
                                              RelativePanel.RightOf="PhylumCombo"
                                              SelectedValue="{x:Bind ViewModel.CommentSelected.RegnumId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="RegnumId" />
                                </RelativePanel>
                                <Expander x:Name="MemoExpanderComment">
                                    <Expander.Header>
                                        <Grid>
                                            <TextBlock loca:Uids.Uid="TextBlock_Memo"
                                                       Style="{ThemeResource SubtitleTextBlockStyle}" />
                                        </Grid>
                                    </Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox x:Name="MemoComment"
                                                 MinWidth="1120"
                                                 MaxWidth="1300"
                                                 MaxHeight="75"
                                                 Margin="{StaticResource XSmallRightMargin}"
                                                 loca:Uids.Uid="TextBox_Memo"
                                                 AcceptsReturn="True"
                                                 IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditComment), Mode=OneWay}"
                                                 RelativePanel.AlignLeftWithPanel="True"
                                                 RelativePanel.Below="InfoComment"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 Text="{x:Bind ViewModel.CommentSelected.Memo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                    </RelativePanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <ProgressRing x:Name="LoadingProgressRing"
                      Width="40"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                      RelativePanel.AlignHorizontalCenterWithPanel="True"
                      RelativePanel.AlignVerticalCenterWithPanel="True"
                      Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
    </RelativePanel>
</Page>
