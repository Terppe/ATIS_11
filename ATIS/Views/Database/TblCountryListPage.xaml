                            </Grid>

                        </StackPanel>
                    </Border>

                </atis:AtisPageLayout.DetailContent>

            </atis:AtisPageLayout>
        </ScrollViewer>

        <!--  2. 🔥 Modernes Lade Overlay  -->
        <atis:LoadingOverlayControl Grid.RowSpan="1"
                                    IsLoading="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
    </Grid>
</Page>
