<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="ATIS.Views.Database.TblCountryListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:atis="using:ATIS.DesignSystem.Components"
      xmlns:behaviors="using:ATIS.DesignSystem.Behaviors"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:toolkit="using:CommunityToolkit.WinUI.UI.Controls"
      x:Name="RootPage"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
      SizeChanged="Page_SizeChanged"
      mc:Ignorable="d">

    <interactivity:Interaction.Behaviors>
        <behaviors:AtisBindingCommitBehavior Command="{Binding SaveCountryCommand}" />
    </interactivity:Interaction.Behaviors>

    <Grid x:Name="RootGrid">

        <ScrollViewer VerticalScrollBarVisibility="Visible">
        <atis:AtisPageLayout>

            <!--  HEADER LINKS  -->

            <atis:AtisPageLayout.Header>

                <StackPanel Margin="8,0,0,8"
                            Orientation="Horizontal"
                            Spacing="10">
                    <TextBlock Margin="0,4,0,0"
                               Style="{StaticResource AtisPageTitleTextStyle}"
                               Text="{x:Bind ViewModel.CountryPageTitle}" />
                    <TextBlock Margin="0,16,0,0"
                               Style="{StaticResource AtisBodyTextStyle}"
                               Text="{x:Bind ViewModel.DataSetCountLabel}" />
                    <TextBlock Margin="0,16,0,0"
                               Style="{StaticResource AtisBodyTextStyle}"
                               Text="{Binding CountryDataSetCount, Mode=OneWay}" />
                </StackPanel>
            </atis:AtisPageLayout.Header>

            <!--  APPBAR RECHTS  -->
            <atis:AtisPageLayout.AppBar>
                <Grid ColumnSpacing="8">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--  LEFT: Buttons  -->
                    <StackPanel Grid.Column="0"
                                Margin="8"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">

                        <Button Margin="5,0,5,0"
                                Command="{x:Bind ViewModel.AddCountryCommand}"
                                Style="{StaticResource AtisPrimaryButton}">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="6">
                                <FontIcon Glyph="&#xE710;" />
                                <TextBlock Text="{x:Bind ViewModel.ButtonAddLabel}" />
                            </StackPanel>
                        </Button>

                        <Button Margin="5,0,5,0"
                                Command="{x:Bind ViewModel.SaveCountryCommand}"
                                Style="{StaticResource AtisSecondaryButton}">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="6">
                                <FontIcon Glyph="&#xE74E;" />
                                <TextBlock Text="{x:Bind ViewModel.ButtonSaveLabel}" />
                            </StackPanel>
                        </Button>

                        <Button Margin="5,0,5,0"
                                Command="{x:Bind ViewModel.DeleteCountryCommand}"
                                Style="{StaticResource AtisSecondaryButton}">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="6">
                                <FontIcon Glyph="&#xE74D;" />
                                <TextBlock Text="{x:Bind ViewModel.ButtonDeleteLabel}" />
                            </StackPanel>
                        </Button>

                        <Button Margin="5,0,5,0"
                                Command="{x:Bind ViewModel.RefreshCommand}"
                                Style="{StaticResource AtisSecondaryButton}">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="6">
                                <FontIcon Glyph="&#xE72C;" />
                                <TextBlock Text="{x:Bind ViewModel.ButtonRefreshLabel}" />
                            </StackPanel>
                        </Button>

                    </StackPanel>

                    <!--  RIGHT: SearchBox  -->
                    <AutoSuggestBox x:Name="SearchBox"
                                    Grid.Column="1"
                                    Width="260"
                                    Height="32"
                                    Margin="10,0,18,0"
                                    VerticalAlignment="Center"
                                    Loaded="SearchBox_OnLoaded"
                                    PlaceholderText="{x:Bind ViewModel.SearchPlaceholder}"
                                    QueryIcon="Find"
                                    QuerySubmitted="AutoSuggestBox_QuerySubmitted"
                                    Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}"
                                    TextChanged="SearchBox_TextChanged" />
                </Grid>
            </atis:AtisPageLayout.AppBar>

            <!--  ⭐ LIST CONTENT  -->
            <atis:AtisPageLayout.ListContent>

                    <Border Style="{StaticResource AtisCard}">
                        <Grid>
                            <toolkit:DataGrid x:Name="CountryDataGrid"
                                              Height="Auto"
                                              MinHeight="250"
                                              MaxHeight="300"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Top"
                                              AlternatingRowBackground="{ThemeResource AtisGridRowAlternateBackground}"
                                              AreRowDetailsFrozen="True"
                                              CanUserSortColumns="True"
                                              GridLinesVisibility="Vertical"
                                              ItemsSource="{Binding Countries}"
                                              RowBackground="{ThemeResource AtisGridRowBackground}"
                                              SelectedItem="{Binding CountrySelected, Mode=TwoWay}"
                                              SelectionMode="Single"
                                              Sorting="CountryDataGrid_Sorting"
                                              Style="{StaticResource AtisDataGridStyle}">

                                <!--  ContextFlyout  -->
                                <toolkit:DataGrid.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Command="{x:Bind ViewModel.AddCountryCommand}"
                                                        Icon="Add"
                                                        Style="{StaticResource AtisPrimaryMenuFlyoutItem}"
                                                        Text="{x:Bind ViewModel.CtxAddLabel}" />

                                        <MenuFlyoutItem Command="{x:Bind ViewModel.StartEditCountryCommand}"
                                                        Icon="Edit"
                                                        Text="{x:Bind ViewModel.CtxEditLabel}" />

                                        <MenuFlyoutItem Command="{x:Bind ViewModel.SaveCountryCommand}"
                                                        Icon="Save"
                                                        IsEnabled="{x:Bind ViewModel.CountrySelected, Converter={StaticResource NullToBoolConverter}}"
                                                        Text="{x:Bind ViewModel.CtxSaveLabel}" />

                                        <MenuFlyoutItem Command="{x:Bind ViewModel.DeleteCountryCommand}"
                                                        Icon="Delete"
                                                        Text="{x:Bind ViewModel.CtxDeleteLabel}" />

                                        <MenuFlyoutItem Command="{x:Bind ViewModel.RefreshCommand}"
                                                        Icon="Refresh"
                                                        Text="{x:Bind ViewModel.CtxRefreshLabel}" />
                                    </MenuFlyout>
                                </toolkit:DataGrid.ContextFlyout>

                                <!--  RowStyle  -->
                                <toolkit:DataGrid.RowStyle>
                                    <Style TargetType="toolkit:DataGridRow">
                                        <Setter Property="Background" Value="{Binding IsAlternate, Converter={StaticResource BoolToRowBackgroundConverter}}" />
                                    </Style>
                                </toolkit:DataGrid.RowStyle>

                                <!--  Columns  -->
                                <toolkit:DataGrid.Columns>

                                    <toolkit:DataGridTextColumn Binding="{Binding CountryId}"
                                                                CanUserSort="True"
                                                                Header="{Binding ColCountryId}"
                                                                IsReadOnly="True"
                                                                Tag="CountryId" />

                                    <toolkit:DataGridTextColumn Binding="{Binding Name}"
                                                                CanUserSort="True"
                                                                Header="{Binding ColCountryName}"
                                                                Tag="Name" />

                                    <toolkit:DataGridTextColumn Binding="{Binding Regex}"
                                                                CanUserSort="True"
                                                                Header="{Binding ColCountryRegex}"
                                                                Tag="Regex" />

                                    <toolkit:DataGridTextColumn Binding="{Binding ZoomLevel}"
                                                                CanUserSort="True"
                                                                Header="{Binding ColCountryZoomLevel}"
                                                                Tag="ZoomLevel" />

                                    <toolkit:DataGridTextColumn Binding="{Binding Latitude}"
                                                                CanUserSort="True"
                                                                Header="{Binding ColCountryLatitude}"
                                                                Tag="Latitude" />

                                    <toolkit:DataGridTextColumn Binding="{Binding Longitude}"
                                                                CanUserSort="True"
                                                                Header="{Binding ColCountryLongitude}"
                                                                Tag="Longitude" />

                                </toolkit:DataGrid.Columns>

                            </toolkit:DataGrid>
                        </Grid>
                    </Border>

            </atis:AtisPageLayout.ListContent>

            <!--  ⭐ DETAIL CONTENT  -->
            <atis:AtisPageLayout.DetailContent>
                <Border Style="{StaticResource AtisCard}"
                        Visibility="{Binding CountrySelected, Converter={StaticResource NullToVisibilityConverter}}">
                    <StackPanel Spacing="8">

                        <!--  Detail CommandBar  -->
                        <atis:AtisDetailHeader IsEnabled="True">
                            <atis:AtisDetailHeader.LeftContent>

                                <TextBlock Style="{StaticResource AtisSectionTitleTextStyle}"
                                           Text="{x:Bind ViewModel.CountryDetailTitle}" />
                            </atis:AtisDetailHeader.LeftContent>

                            <atis:AtisDetailHeader.RightContent>
                                <StackPanel Orientation="Horizontal"
                                            Spacing="8">
                                    <Button Margin="5,0,5,0"
                                            Command="{Binding SaveCountryCommand}"
                                            Style="{StaticResource AtisSecondaryButton}"
                                            Visibility="{Binding IsInEditCountry, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="6">
                                            <FontIcon Glyph="&#xE74E;" />
                                            <TextBlock Text="{x:Bind ViewModel.ButtonSaveLabel}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Margin="5,0,5,0"
                                            Command="{Binding CancelEditCountryCommand}"
                                            Style="{StaticResource AtisSecondaryButton}"
                                            Visibility="{Binding IsInEditCountry, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="6">
                                            <FontIcon Glyph="&#xE8BB;" />
                                            <TextBlock Text="{x:Bind ViewModel.ButtonCancelLabel}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding StartEditCountryCommand}"
                                            IsEnabled="{Binding CanEditCountry}"
                                            Style="{StaticResource AtisSecondaryButton}">
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="6">
                                            <FontIcon Glyph="&#xE70F;" />
                                            <TextBlock Text="{x:Bind ViewModel.ButtonEditLabel}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </atis:AtisDetailHeader.RightContent>
                        </atis:AtisDetailHeader>

                        <!--  Detail Fields  -->
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--  Row 0  -->
                            <Grid Grid.Row="0"
                                  ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <!--  Header  -->
                                    <!--<TextBlock Style="{StaticResource AtisFormLabelTextStyle}"
                                    Text="{Binding CountryNameLabel}" />-->
                                    <!--  Input  -->
                                    <TextBox x:Name="CountryName"
                                             MinWidth="{Binding NameUi.MinWidth}"
                                             MaxWidth="{Binding NameUi.MaxWidth}"
                                             BorderBrush="{Binding NameErrors, FallbackValue=Gray, TargetNullValue=Gray, Converter={StaticResource ErrorsToBrushConverter}}"
                                             GotFocus="{x:Bind ViewModel.BeginUserEdit}"
                                             Header="{Binding ColCountryName}"
                                             IsReadOnly="{Binding IsInEditCountry, Converter={StaticResource InvertBoolConverter}}"
                                             LostFocus="{x:Bind ViewModel.ValidateName}"
                                             MaxLength="{Binding NameUi.MaxLength}"
                                             PlaceholderText="{Binding CountryNamePlaceholder}"
                                             Style="{StaticResource AtisTextBox}"
                                             Text="{Binding CountryEdit.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             TextChanged="{x:Bind ViewModel.OnFieldChanged}" />
                                    <!--  Errors  -->
                                    <TextBlock FontSize="12"
                                               Foreground="Red"
                                               Text="{Binding NameErrors, Converter={StaticResource ErrorListToStringConverter}}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>

                            <!--  Row 1  -->
                            <Grid Grid.Row="1"
                                  ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <!--  Header  -->
                                    <!--<TextBlock Style="{StaticResource AtisFormLabelTextStyle}"
                                    Text="{Binding CountryRegexLabel}" />-->
                                    <!--  Input  -->
                                    <TextBox MinWidth="{Binding NameUi.MinWidth}"
                                             MaxWidth="{Binding NameUi.MaxWidth}"
                                             BorderBrush="{Binding RegexErrors, FallbackValue=Gray, TargetNullValue=Gray, Converter={StaticResource ErrorsToBrushConverter}}"
                                             GotFocus="{x:Bind ViewModel.BeginUserEdit}"
                                             Header="{Binding ColCountryRegex}"
                                             IsReadOnly="{Binding IsInEditCountry, Converter={StaticResource InvertBoolConverter}}"
                                             LostFocus="{x:Bind ViewModel.ValidateRegex}"
                                             MaxLength="{Binding NameUi.MaxLength}"
                                             PlaceholderText="{Binding CountryRegexPlaceholder}"
                                             Style="{StaticResource AtisTextBox}"
                                             Text="{Binding CountryEdit.Regex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             TextChanged="{x:Bind ViewModel.OnFieldChanged}" />
                                    <!--  Errors  -->
                                    <TextBlock FontSize="12"
                                               Foreground="Red"
                                               Text="{Binding RegexErrors, Converter={StaticResource ErrorListToStringConverter}}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>

                            <!--  Row 2  -->
                            <Grid Grid.Row="2"
                                  ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <!--  Header  -->
                                    <!--<TextBlock Style="{StaticResource AtisFormLabelTextStyle}"
                                    Text="{Binding CountryZoomLevelLabel}" />-->
                                    <!--  Input  -->
                                    <TextBox BorderBrush="{Binding ZoomLevelErrors, FallbackValue=Gray, TargetNullValue=Gray, Converter={StaticResource ErrorsToBrushConverter}}"
                                             GotFocus="{x:Bind ViewModel.BeginUserEdit}"
                                             Header="{Binding ColCountryZoomLevel}"
                                             InputScope="Number"
                                             IsReadOnly="{Binding IsInEditCountry, Converter={StaticResource InvertBoolConverter}}"
                                             LostFocus="{x:Bind ViewModel.ValidateZoomLevel}"
                                             PlaceholderText="{Binding CountryZoomLevelPlaceholder}"
                                             Style="{StaticResource AtisTextBox}"
                                             Text="{Binding CountryEdit.ZoomLevel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             TextChanged="{x:Bind ViewModel.OnFieldChanged}" />
                                    <!--  Errors  -->
                                    <TextBlock FontSize="12"
                                               Foreground="Red"
                                               Text="{Binding ZoomLevelErrors, Converter={StaticResource ErrorListToStringConverter}}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <!--  Header  -->
                                    <!--<TextBlock Style="{StaticResource AtisFormLabelTextStyle}"
                                    Text="{Binding CountryLatitudeLabel}" />-->
                                    <!--  Input  -->
                                    <TextBox BorderBrush="{Binding LatitudeErrors, FallbackValue=Gray, TargetNullValue=Gray, Converter={StaticResource ErrorsToBrushConverter}}"
                                             GotFocus="{x:Bind ViewModel.BeginUserEdit}"
                                             Header="{Binding ColCountryLatitude}"
                                             InputScope="Number"
                                             IsReadOnly="{Binding IsInEditCountry, Converter={StaticResource InvertBoolConverter}}"
                                             LostFocus="{x:Bind ViewModel.ValidateLatitude}"
                                             PlaceholderText="{Binding CountryLatitudePlaceholder}"
                                             Style="{StaticResource AtisTextBox}"
                                             Text="{Binding CountryEdit.Latitude, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             TextChanged="{x:Bind ViewModel.OnFieldChanged}" />
                                    <!--  Errors  -->
                                    <TextBlock FontSize="12"
                                               Foreground="Red"
                                               Text="{Binding LatitudeErrors, Converter={StaticResource ErrorListToStringConverter}}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <!--  Header  -->
                                    <!--<TextBlock Style="{StaticResource AtisFormLabelTextStyle}"
                                    Text="{Binding CountryLongitudeLabel}" />-->
                                    <!--  Input  -->
                                    <TextBox BorderBrush="{Binding LongitudeErrors, FallbackValue=Gray, TargetNullValue=Gray, Converter={StaticResource ErrorsToBrushConverter}}"
                                             GotFocus="{x:Bind ViewModel.BeginUserEdit}"
                                             Header="{Binding ColCountryLongitude}"
                                             InputScope="Number"
                                             IsReadOnly="{Binding IsInEditCountry, Converter={StaticResource InvertBoolConverter}}"
                                             LostFocus="{x:Bind ViewModel.ValidateLongitude}"
                                             PlaceholderText="{Binding CountryLongitudePlaceholder}"
                                             Style="{StaticResource AtisTextBox}"
                                             Text="{Binding CountryEdit.Longitude, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             TextChanged="{x:Bind ViewModel.OnFieldChanged}" />
                                    <!--  Errors  -->
                                    <TextBlock FontSize="12"
                                               Foreground="Red"
                                               Text="{Binding LongitudeErrors, Converter={StaticResource ErrorListToStringConverter}}"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding CountrySelected, Converter={StaticResource NullToCollapsedConverter}}" />
                                </StackPanel>
                            </Grid>

                        </Grid>

                    </StackPanel>
                </Border>

            </atis:AtisPageLayout.DetailContent>

        </atis:AtisPageLayout>
        </ScrollViewer>

        <!--  2. 🔥 Modernes Lade Overlay  -->
        <atis:LoadingOverlayControl Grid.RowSpan="1"
                                    IsLoading="{Binding IsLoading}" />
        <!--<atis:LoadingOverlayControl Grid.RowSpan="1"
        IsLoading="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />-->
    </Grid>
</Page>
