<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="ATIS.Views.Database.TblCountryListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:atis="using:ATIS.DesignSystem.Components"
      xmlns:behaviors="using:ATIS.DesignSystem.Behaviors"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
      xmlns:loca="using:WinUI3Localizer"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:toolkit="using:CommunityToolkit.WinUI.UI.Controls"
      x:Name="RootPage"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
      SizeChanged="Page_SizeChanged"
      mc:Ignorable="d">

    <interactivity:Interaction.Behaviors>
        <behaviors:AtisBindingCommitBehavior Command="{Binding SaveCountryCommand}" />
    </interactivity:Interaction.Behaviors>

    <Grid x:Name="RootGrid">

        <ScrollViewer VerticalScrollBarVisibility="Visible">
            <atis:AtisPageLayout>

                <!--  HEADER LINKS  -->
                <atis:AtisPageLayout.Header>

                    <StackPanel Margin="8,0,0,8"
                                Orientation="Horizontal"
                                Spacing="10">
                        <TextBlock Margin="0,4,0,0"
                                   loca:Uids.Uid="TextBlock_Countries"
                                   Style="{StaticResource AtisPageTitleTextStyle}" />

                        <TextBlock Margin="0,16,0,0"
                                   loca:Uids.Uid="TextBlock_DataSetCount"
                                   Style="{StaticResource AtisBodyTextStyle}" />

                        <TextBlock Margin="0,16,0,0"
                                   Style="{StaticResource AtisBodyTextStyle}"
                                   Text="{Binding CountryDataSetCount, Mode=OneWay}" />
                    </StackPanel>
                </atis:AtisPageLayout.Header>

                <!--  APPBAR RECHTS  -->
                <atis:AtisPageLayout.AppBar>
                    <Grid ColumnSpacing="8">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!--  LEFT: Buttons  -->
                        <StackPanel Grid.Column="0"
                                    Margin="8"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">

                            <Button Margin="5,0,5,0"
                                    Command="{Binding AddCountryCommand}"
                                    Style="{StaticResource AtisPrimaryButton}">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="6">
                                    <FontIcon Glyph="&#xE710;" />
                                    <TextBlock loca:Uids.Uid="TextBlock_Add" />
                                </StackPanel>
                            </Button>
                            <Button Margin="5,0,5,0"
                                    Command="{Binding SaveCountryCommand}"
                                    Style="{StaticResource AtisSecondaryButton}">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="6">
                                    <FontIcon Glyph="&#xE74E;" />
                                    <TextBlock loca:Uids.Uid="TextBlock_Save" />
                                </StackPanel>
                            </Button>

                            <Button Margin="5,0,5,0"
                                    Command="{Binding DeleteCountryCommand}"
                                    Style="{StaticResource AtisSecondaryButton}">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="6">
                                    <FontIcon Glyph="&#xE74D;" />
                                    <TextBlock loca:Uids.Uid="TextBlock_Delete" />
                                </StackPanel>
                            </Button>

                            <Button Margin="5,0,5,0"
                                    Command="{Binding RefreshCommand}"
                                    Style="{StaticResource AtisSecondaryButton}">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="6">
                                    <FontIcon Glyph="&#xE72C;" />
                                    <TextBlock loca:Uids.Uid="TextBlock_Sync" />
                                </StackPanel>
                            </Button>

                        </StackPanel>

                        <!--  RIGHT: SearchBox  -->
                        <AutoSuggestBox x:Name="SearchBox"
                                        Grid.Column="1"
                                        Width="260"
                                        Height="32"
                                        Margin="10,0,18,0"
                                        VerticalAlignment="Center"
                                        loca:Uids.Uid="AutoSuggestBox_Search"
                                        Loaded="SearchBox_OnLoaded"
                                        QueryIcon="Find"
                                        QuerySubmitted="AutoSuggestBox_QuerySubmitted"
                                        Text="{Binding SearchText, Mode=TwoWay}" />
                    </Grid>
                </atis:AtisPageLayout.AppBar>

                <!--  ⭐ LIST CONTENT  -->
                <atis:AtisPageLayout.ListContent>
                    <Border Style="{StaticResource AtisCard}">
                        <Grid>
                            <toolkit:DataGrid x:Name="CountryDataGrid"
                                              Height="Auto"
                                              MinHeight="250"
                                              MaxHeight="300"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Top"
                                              AlternatingRowBackground="{ThemeResource AtisGridRowAlternateBackground}"
                                              AreRowDetailsFrozen="True"
                                              CanUserSortColumns="True"
                                              GridLinesVisibility="Vertical"
                                              ItemsSource="{Binding Countries}"
                                              RowBackground="{ThemeResource AtisGridRowBackground}"
                                              SelectedItem="{Binding CountrySelected, Mode=TwoWay}"
                                              SelectionMode="Single"
                                              Sorting="CountryDataGrid_Sorting"
                                              Style="{StaticResource AtisDataGridStyle}">


                                <!--  ContextFlyout  -->
                                <toolkit:DataGrid.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem loca:Uids.Uid="MenuFlyout_Add"
                                                        Command="{Binding AddCountryCommand}"
                                                        Icon="Add"
                                                        Style="{StaticResource AtisPrimaryMenuFlyoutItem}" />

                                        <MenuFlyoutItem loca:Uids.Uid="MenuFlyout_Edit"
                                                        Command="{Binding StartEditCountryCommand}"
                                                        Icon="Edit" />

                                        <MenuFlyoutItem loca:Uids.Uid="MenuFlyout_Save"
                                                        Command="{Binding SaveCountryCommand}"
                                                        Icon="Save"
                                                        IsEnabled="{Binding CountrySelected, Converter={StaticResource NullToBoolConverter}}" />

                                        <MenuFlyoutItem loca:Uids.Uid="MenuFlyout_Delete"
                                                        Command="{Binding DeleteCountryCommand}"
                                                        Icon="Delete" />

                                        <MenuFlyoutItem loca:Uids.Uid="MenuFlyout_Refresh"
                                                        Command="{Binding RefreshCommand}"
                                                        Icon="Refresh" />

                                    </MenuFlyout>
                                </toolkit:DataGrid.ContextFlyout>

                                <!--  Columns  -->
                                <toolkit:DataGrid.RowStyle>
                                    <Style TargetType="toolkit:DataGridRow">
                                        <Setter Property="Background" Value="{Binding IsAlternate, Converter={StaticResource BoolToRowBackgroundConverter}}" />
                                    </Style>
                                </toolkit:DataGrid.RowStyle>

                                <!--  Columns  -->
                                <toolkit:DataGrid.Columns>
                                    <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTemplateColumn_CountryId"
                                                                Binding="{Binding CountryId}"
                                                                CanUserSort="True"
                                                                IsReadOnly="True"
                                                                Tag="CountryId" />
                                    <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_CountryName"
                                                                Binding="{Binding Name}"
                                                                CanUserSort="True"
                                                                Tag="Name" />
                                    <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_Regex"
                                                                Binding="{Binding Regex}"
                                                                CanUserSort="True"
                                                                Tag="Regex" />
                                    <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_ZoomLevel"
                                                                Binding="{Binding ZoomLevel}"
                                                                CanUserSort="True"
                                                                Tag="ZoomLevel" />
                                    <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_Latitude"
                                                                Binding="{Binding Latitude}"
                                                                CanUserSort="True"
                                                                Tag="Latitude" />
                                    <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_Longitude"
                                                                Binding="{Binding Longitude}"
                                                                CanUserSort="True"
                                                                Tag="Longitude" />
                                </toolkit:DataGrid.Columns>

                            </toolkit:DataGrid>
                        </Grid>
                    </Border>
                </atis:AtisPageLayout.ListContent>

                <!--  ⭐ DETAIL CONTENT  -->
                <atis:AtisPageLayout.DetailContent>
                    <Border Style="{StaticResource AtisCard}"
                            Visibility="{Binding CountrySelected, Converter={StaticResource NullToVisibilityConverter}}">
                        <StackPanel Spacing="8">

                            <!--  Detail CommandBar  -->
                            <atis:AtisDetailHeader IsEnabled="True">
                                <atis:AtisDetailHeader.LeftContent>

                                    <TextBlock loca:Uids.Uid="TextBlock_Country"
                                               Style="{StaticResource AtisSectionTitleTextStyle}" />

                                </atis:AtisDetailHeader.LeftContent>

                                <atis:AtisDetailHeader.RightContent>
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="8">
                                        <Button Margin="5,0,5,0"
                                                Command="{Binding SaveCountryCommand}"
                                                Style="{StaticResource AtisSecondaryButton}"
                                                Visibility="{Binding IsInEditCountry, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="6">
                                                <FontIcon Glyph="&#xE74E;" />
                                                <TextBlock loca:Uids.Uid="TextBlock_Save" />
                                            </StackPanel>
                                        </Button>
                                        <Button Margin="5,0,5,0"
                                                Command="{Binding CancelEditCountryCommand}"
                                                Style="{StaticResource AtisSecondaryButton}"
                                                Visibility="{Binding IsInEditCountry, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="6">
                                                <FontIcon Glyph="&#xE8BB;" />
                                                <TextBlock loca:Uids.Uid="TextBlock_Cancel" />
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding StartEditCountryCommand}"
                                                IsEnabled="{Binding CanEditCountry}"
                                                Style="{StaticResource AtisSecondaryButton}">
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="6">
                                                <FontIcon Glyph="&#xE70F;" />
                                                <TextBlock loca:Uids.Uid="TextBlock_Edit" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </atis:AtisDetailHeader.RightContent>
                            </atis:AtisDetailHeader>

                            <!--  Detail Fields  -->
                            <Grid RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!--  Row 0  -->
                                <Grid Grid.Row="0"
                                      ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBox x:Name="CountryName"
                                                 MinWidth="{Binding NameUi.MinWidth}"
                                                 MaxWidth="{Binding NameUi.MaxWidth}"
                                                 loca:Uids.Uid="TextBox_CountryName"
                                                 BorderBrush="{Binding NameErrors, FallbackValue=Gray, TargetNullValue=Gray, Converter={StaticResource ErrorsToBrushConverter}}"
                                                 DataContext="{Binding}"
                                                 GotFocus="{x:Bind ViewModel.BeginUserEdit}"
                                                 IsReadOnly="{Binding IsInEditCountry, Converter={StaticResource InvertBoolConverter}}"
                                                 LostFocus="{x:Bind ViewModel.ValidateName}"
                                                 MaxLength="{Binding NameUi.MaxLength}"
                                                 Style="{StaticResource AtisTextBox}"
                                                 Text="{Binding CountryEdit.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 TextChanged="{x:Bind ViewModel.OnFieldChanged}" />
                                        <TextBlock FontSize="12"
                                                   Foreground="Red"
                                                   Text="{Binding NameErrors, Converter={StaticResource ErrorListToStringConverter}}"
                                                   TextWrapping="Wrap" />

                                    </StackPanel>
                                </Grid>

                                <!--  Row 1  -->
                                <Grid Grid.Row="1"
                                      ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBox MinWidth="{Binding NameUi.MinWidth}"
                                                 MaxWidth="{Binding NameUi.MaxWidth}"
                                                 loca:Uids.Uid="TextBox_Regex"
                                                 BorderBrush="{Binding RegexErrors, FallbackValue=Gray, TargetNullValue=Gray, Converter={StaticResource ErrorsToBrushConverter}}"
                                                 DataContext="{Binding}"
                                                 IsReadOnly="{Binding IsInEditCountry, Converter={StaticResource InvertBoolConverter}}"
                                                 LostFocus="{x:Bind ViewModel.ValidateRegex}"
                                                 MaxLength="{Binding NameUi.MaxLength}"
                                                 Style="{StaticResource AtisTextBox}"
                                                 Text="{Binding CountryEdit.Regex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 TextChanged="{x:Bind ViewModel.OnFieldChanged}" />
                                        <TextBlock FontSize="12"
                                                   Foreground="Red"
                                                   Text="{Binding RegexErrors, Converter={StaticResource ErrorListToStringConverter}}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>

                                <!--  Row 2  -->
                                <Grid Grid.Row="2"
                                      ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBox loca:Uids.Uid="TextBox_ZoomLevel"
                                                 BorderBrush="{Binding ZoomLevelErrors, FallbackValue=Gray, TargetNullValue=Gray, Converter={StaticResource ErrorsToBrushConverter}}"
                                                 DataContext="{Binding}"
                                                 GotFocus="{x:Bind ViewModel.BeginUserEdit}"
                                                 InputScope="Number"
                                                 IsReadOnly="{Binding IsInEditCountry, Converter={StaticResource InvertBoolConverter}}"
                                                 LostFocus="{x:Bind ViewModel.ValidateZoomLevel}"
                                                 Style="{StaticResource AtisTextBox}"
                                                 Text="{Binding CountryEdit.ZoomLevel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 TextChanged="{x:Bind ViewModel.OnFieldChanged}" />
                                        <TextBlock FontSize="12"
                                                   Foreground="Red"
                                                   Text="{Binding ZoomLevelErrors, Converter={StaticResource ErrorListToStringConverter}}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBox loca:Uids.Uid="TextBox_Latitude"
                                                 BorderBrush="{Binding LatitudeErrors, FallbackValue=Gray, TargetNullValue=Gray, Converter={StaticResource ErrorsToBrushConverter}}"
                                                 DataContext="{Binding}"
                                                 GotFocus="{x:Bind ViewModel.BeginUserEdit}"
                                                 InputScope="Number"
                                                 IsReadOnly="{Binding IsInEditCountry, Converter={StaticResource InvertBoolConverter}}"
                                                 LostFocus="{x:Bind ViewModel.ValidateLatitude}"
                                                 Style="{StaticResource AtisTextBox}"
                                                 Text="{Binding CountryEdit.Latitude, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 TextChanged="{x:Bind ViewModel.OnFieldChanged}" />
                                        <TextBlock FontSize="12"
                                                   Foreground="Red"
                                                   Text="{Binding LatitudeErrors, Converter={StaticResource ErrorListToStringConverter}}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBox loca:Uids.Uid="TextBox_Longitude"
                                                 BorderBrush="{Binding LongitudeErrors, FallbackValue=Gray, TargetNullValue=Gray, Converter={StaticResource ErrorsToBrushConverter}}"
                                                 DataContext="{Binding}"
                                                 GotFocus="{x:Bind ViewModel.BeginUserEdit}"
                                                 InputScope="Number"
                                                 IsReadOnly="{Binding IsInEditCountry, Converter={StaticResource InvertBoolConverter}}"
                                                 LostFocus="{x:Bind ViewModel.ValidateLongitude}"
                                                 Style="{StaticResource AtisTextBox}"
                                                 Text="{Binding CountryEdit.Longitude, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 TextChanged="{x:Bind ViewModel.OnFieldChanged}" />
                                        <TextBlock FontSize="12"
                                                   Foreground="Red"
                                                   Text="{Binding LongitudeErrors, Converter={StaticResource ErrorListToStringConverter}}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>






