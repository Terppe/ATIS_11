<?xml version="1.0" encoding="utf-8" ?>

<Page x:Class="ATIS.Views.Database.TblCountryListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:conv="using:ATIS.Helpers.Converters"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:loca="using:WinUI3Localizer"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:models="using:ATIS.Models"
      xmlns:toolkit="using:CommunityToolkit.WinUI.UI.Controls"
      NavigationCacheMode="Disabled"
      mc:Ignorable="d">

    <!--  CountryListPage.xaml  Skriptdatum:  06.01.2025 12:32  -->

    <Page.Resources>

        <MenuFlyout x:Key="CountryDataContextMenu">
            <MenuFlyoutItem loca:Uids.Uid="MenuFlyout_Save_Country"
                            Click="SaveCountry_Click">
                <MenuFlyoutItem.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/save.png" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem loca:Uids.Uid="MenuFlyout_Delete_Country"
                            Click="DeleteCountry_Click">
                <MenuFlyoutItem.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/delete.png" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem loca:Uids.Uid="MenuFlyout_Add_Country"
                            Click="AddCountry_Click">
                <MenuFlyoutItem.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/add.png" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem loca:Uids.Uid="MenuFlyout_Refresh"
                            Click="Refresh_Click">
                <MenuFlyoutItem.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/refresh.png" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>
    </Page.Resources>

    <RelativePanel x:Name="CountryRoot"
                   Margin="{StaticResource SmallLeftTopRightBottomMargin}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource LargeWindowSnapPoint}" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource MediumWindowSnapPoint}" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource MinWindowSnapPoint}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="CountryCommandBar.DefaultLabelPosition" Value="Bottom" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <TextBlock x:Name="PageTitle"
                   loca:Uids.Uid="TextBlock_Countries"
                   RelativePanel.AlignLeftWithPanel="True"
                   Style="{StaticResource PageTitleTextBlockStyle}" />
        <TextBlock x:Name="CountryDatasetText"
                   Margin="5,17,0,0"
                   loca:Uids.Uid="TextBlock_DataSetCount"
                   RelativePanel.RightOf="PageTitle"
                   Style="{StaticResource DatasetTitleStyle}" />
        <TextBlock x:Name="CountryDatasetCountText"
                   Margin="5,17,0,0"
                   RelativePanel.RightOf="CountryDatasetText"
                   Style="{StaticResource DatasetTitleStyle}"
                   Text="{x:Bind ViewModel.CountryDataSetCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <CommandBar x:Name="CountryCommandBar"
                    HorizontalAlignment="Stretch"
                    Background="Transparent"
                    DefaultLabelPosition="Right"
                    RelativePanel.LeftOf="CountrySearchBox"
                    RelativePanel.RightOf="CountryDatasetCountText">
            <AppBarButton x:Name="AppBarButtonDeleteCountry"
                          loca:Uids.Uid="AppBarButtonDeleteCountry"
                          Click="DeleteCountry_Click"
                          IsEnabled="{x:Bind conv:NotConverter.IsNotNull(ViewModel.CountrySelected), Mode=OneWay}">
                <AppBarButton.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/delete.png" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton x:Name="AppBarButtonAddCountry"
                          loca:Uids.Uid="AppBarButtonAddCountry"
                          Background="{ThemeResource SystemAccentColor}"
                          Click="AddCountry_Click"
                          Foreground="White">
                <AppBarButton.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/add.png" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="AppBarButtonSync"
                          loca:Uids.Uid="AppBarButtonSync"
                          Click="Refresh_Click"
                          IsEnabled="{x:Bind conv:NotConverter.IsNotNull(ViewModel.CountrySelected), Mode=OneWay}">
                <AppBarButton.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/refresh.png" />
                </AppBarButton.Icon>
            </AppBarButton>
        </CommandBar>

        <AutoSuggestBox Name="CountrySearchBox"
                        Width="200"
                        Margin="4,8,4,0"
                        loca:Uids.Uid="AutoSuggestBox_Search"
                        Loaded="CountrySearchBox_OnLoaded"
                        QuerySubmitted="GetCountriesByNameOrId"
                        RelativePanel.AlignRightWithPanel="True">
            <AutoSuggestBox.QueryIcon>
                <BitmapIcon ShowAsMonochrome="False"
                            UriSource="/Assets/Fluent/search.png" />
            </AutoSuggestBox.QueryIcon>
        </AutoSuggestBox>

        <ScrollViewer x:Name="PanelCountry"
                      RelativePanel.AlignLeftWithPanel="True"
                      RelativePanel.AlignRightWithPanel="True"
                      RelativePanel.Below="PageTitle"
                      VerticalScrollBarVisibility="Auto"
                      VerticalScrollMode="Auto">
            <StackPanel Margin="-10,8,4,0">
                <StackPanel.Resources>
                    <Style TargetType="Expander">
                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                    </Style>
                </StackPanel.Resources>
                <toolkit:DataGrid x:Name="CountryDataGrid"
                                  MaxHeight="530"
                                  Margin="0,0,20,0"
                                  VerticalAlignment="Top"
                                  x:FieldModifier="public"
                                  AlternatingRowBackground="LightGray"
                                  AutoGenerateColumns="False"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  CanUserReorderColumns="False"
                                  CanUserResizeColumns="False"
                                  ContextFlyout="{StaticResource CountryDataContextMenu}"
                                  CurrentCellChanged="CountryDataGrid_OnCurrentCellChanged"
                                  GridLinesVisibility="Horizontal"
                                  ItemsSource="{x:Bind ViewModel.CountryItems}"
                                  SelectedItem="{x:Bind ViewModel.CountrySelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  SelectionMode="Single"
                                  Sorting="CountryDataGrid_Sorting">
                    <toolkit:DataGrid.Columns>
                        <toolkit:DataGridTemplateColumn loca:Uids.Uid="DataGridTemplateColumn_CountryId"
                                                        Tag="CountryId">
                            <toolkit:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:TblCountry">
                                    <HyperlinkButton Margin="12,0"
                                                     BorderThickness="0"
                                                     Click="ViewCountryHyperlinkButton_Click"
                                                     Content="{Binding CountryId}" />
                                </DataTemplate>
                            </toolkit:DataGridTemplateColumn.CellTemplate>
                        </toolkit:DataGridTemplateColumn>
                        <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_CountryName"
                                                    Binding="{Binding Name}"
                                                    CanUserSort="True"
                                                    Tag="CountryName" />
                        <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_Regex"
                                                    Binding="{Binding Regex}"
                                                    Tag="Regex" />
                    </toolkit:DataGrid.Columns>
                </toolkit:DataGrid>

                <!--  CountryDetailExpander  -->
                <Expander x:Name="CountryDetailExpander"
                          Margin="{StaticResource XSmallTopBottomMargin}"
                          Visibility="Collapsed">
                    <Expander.Header>
                        <Grid>
                            <TextBlock loca:Uids.Uid="TextBlock_Country"
                                       Style="{ThemeResource SubtitleTextBlockStyle}" />
                            <TextBlock HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Text="{x:Bind ViewModel.CountrySelected.Name, Mode=OneWay}" />
                        </Grid>
                    </Expander.Header>

                    <RelativePanel x:Name="CountryDetailRoot"
                                   Margin="{StaticResource SmallLeftRightMargin}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup>
                                <VisualState>
                                    <VisualState.StateTriggers>
                                        <AdaptiveTrigger MinWindowWidth="{StaticResource LargeWindowSnapPoint}" />
                                    </VisualState.StateTriggers>
                                </VisualState>
                                <VisualState>
                                    <VisualState.StateTriggers>
                                        <AdaptiveTrigger MinWindowWidth="{StaticResource MediumWindowSnapPoint}" />
                                    </VisualState.StateTriggers>
                                </VisualState>
                                <VisualState>
                                    <VisualState.StateTriggers>
                                        <AdaptiveTrigger MinWindowWidth="{StaticResource MinWindowSnapPoint}" />
                                    </VisualState.StateTriggers>
                                    <VisualState.Setters>
                                        <Setter Target="CountryCommandBar.DefaultLabelPosition" Value="Bottom" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <CommandBar x:Name="CountryDetailCommandBar"
                                    Margin="{StaticResource SmallLeftRightCommandBarMargin}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Top"
                                    Background="Transparent"
                                    DefaultLabelPosition="Right"
                                    RelativePanel.AlignRightWithPanel="True">
                            <AppBarButton loca:Uids.Uid="AppBarButtonSave"
                                          Background="{ThemeResource SystemBaseLowColor}"
                                          Click="SaveCountry_Click"
                                          Foreground="White"
                                          Visibility="{x:Bind ViewModel.IsInEditCountry, Mode=OneWay}">
                                <AppBarButton.Icon>
                                    <BitmapIcon ShowAsMonochrome="False"
                                                UriSource="/Assets/Fluent/save.png" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton loca:Uids.Uid="AppBarButtonCancel"
                                          Click="CancelEditsCountryAsync"
                                          Visibility="{x:Bind ViewModel.IsInEditCountry, Mode=OneWay}">
                                <AppBarButton.Icon>
                                    <BitmapIcon ShowAsMonochrome="False"
                                                UriSource="/Assets/Fluent/cancel.png" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarSeparator Visibility="{x:Bind ViewModel.IsInEditCountry, Mode=OneWay}" />
                            <AppBarButton loca:Uids.Uid="AppBarButtonBack"
                                          Background="{ThemeResource SystemAccentColor}"
                                          Click="BackCountry_Click"
                                          Foreground="White">
                                <AppBarButton.Icon>
                                    <BitmapIcon ShowAsMonochrome="False"
                                                UriSource="/Assets/Fluent/arrowleft.png" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton loca:Uids.Uid="AppBarButtonEdit"
                                          Click="{x:Bind ViewModel.StartEditCountry}"
                                          IsEnabled="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditCountry), Mode=OneWay}"
                                          Visibility="{x:Bind conv:NotConverter.CollapsedIf(ViewModel.IsNewCountry), Mode=OneWay}">
                                <AppBarButton.Icon>
                                    <BitmapIcon ShowAsMonochrome="False"
                                                UriSource="/Assets/Fluent/edit.png" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                        </CommandBar>
                        <ScrollViewer x:Name="DetailPanelCountry"
                                      Margin="0,36,0,0"
                                      RelativePanel.AlignLeftWithPanel="True"
                                      RelativePanel.AlignRightWithPanel="True"
                                      VerticalScrollBarVisibility="Auto"
                                      VerticalScrollMode="Auto">
                            <RelativePanel Margin="4,0,0,0">
                                <TextBox x:Name="CountryId"
                                         MinWidth="110"
                                         Margin="{StaticResource XSmallRightMargin}"
                                         loca:Uids.Uid="TextBox_CountryId"
                                         IsReadOnly="True"
                                         RelativePanel.AlignLeftWithPanel="True"
                                         Text="{x:Bind ViewModel.CountrySelected.CountryId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox x:Name="CountryName"
                                         MinWidth="500"
                                         Margin="{StaticResource XSmallRightMargin}"
                                         loca:Uids.Uid="TextBox_CountryName"
                                         Background="SlateGray"
                                         Foreground="White"
                                         IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditCountry), Mode=OneWay}"
                                         LostFocus="CountryName_OnLostFocus"
                                         MaxLength="100"
                                         RelativePanel.RightOf="CountryId"
                                         Text="{x:Bind ViewModel.CountrySelected.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox x:Name="AuthorTextRegex"
                                         MinWidth="500"
                                         Margin="{StaticResource XSmallRightMargin}"
                                         HorizontalAlignment="Stretch"
                                         loca:Uids.Uid="TextBox_Regex"
                                         CharacterCasing="Upper"
                                         IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditCountry), Mode=OneWay}"
                                         MaxLength="200"
                                         RelativePanel.AlignLeftWithPanel="True"
                                         RelativePanel.Below="CountryId"
                                         Text="{x:Bind ViewModel.CountrySelected.Regex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </RelativePanel>
                        </ScrollViewer>
                    </RelativePanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <ProgressRing x:Name="LoadingProgressRing"
                      Width="40"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                      RelativePanel.AlignHorizontalCenterWithPanel="True"
                      RelativePanel.AlignVerticalCenterWithPanel="True"
                      Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
    </RelativePanel>
</Page>
