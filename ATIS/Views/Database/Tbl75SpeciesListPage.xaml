    <RelativePanel x:Name="SpeciesRoot"
                   Margin="{StaticResource SmallLeftTopRightBottomMargin}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource LargeWindowSnapPoint}" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource MediumWindowSnapPoint}" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource MinWindowSnapPoint}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SpeciesCommandBar.DefaultLabelPosition" Value="Bottom" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <TextBlock x:Name="PageTitle"
                   loca:Uids.Uid="TextBlock_Speciesses"
                   RelativePanel.AlignLeftWithPanel="True"
                   Style="{StaticResource PageTitleTextBlockStyle}" />
        <TextBlock x:Name="SpeciesDatasetText"
                   Margin="5,17,0,0"
                   loca:Uids.Uid="TextBlock_DataSetCount"
                   RelativePanel.RightOf="PageTitle"
                   Style="{StaticResource DatasetTitleStyle}" />
        <TextBlock x:Name="SpeciesDatasetCountText"
                   Margin="5,17,0,0"
                   RelativePanel.RightOf="SpeciesDatasetText"
                   Style="{StaticResource DatasetTitleStyle}"
                   Text="{x:Bind ViewModel.SpeciesDataSetCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <CommandBar x:Name="SpeciesCommandBar"
                    HorizontalAlignment="Stretch"
                    Background="Transparent"
                    DefaultLabelPosition="Right"
                    RelativePanel.LeftOf="SpeciesSearchBox"
                    RelativePanel.RightOf="SpeciesDatasetCountText">
            <AppBarButton x:Name="AppBarButtonDeleteSpecies"
                          loca:Uids.Uid="AppBarButtonDeleteSpecies"
                          Click="DeleteSpecies_Click"
                          IsEnabled="{x:Bind conv:NotConverter.IsNotNull(ViewModel.SpeciesSelected), Mode=OneWay}">
                <AppBarButton.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/delete.png" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton loca:Uids.Uid="AppBarButtonAddSpecies"
                          Background="{ThemeResource SystemAccentColor}"
                          Click="AddSpecies_Click"
                          Foreground="White">
                <AppBarButton.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/add.png" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="AppBarButtonAddReference"
                          loca:Uids.Uid="AppBarButtonAddReference"
                          IsCompact="True"
                          IsEnabled="{x:Bind conv:NotConverter.IsNotNull(ViewModel.SpeciesSelected), Mode=OneWay}">
                <AppBarButton.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/add.png" />
                </AppBarButton.Icon>
                <AppBarButton.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem loca:Uids.Uid="MenuFlyout_Add_Reference_Expert"
                                        Click="AddReferenceExpertButton_Click"
                                        Tag="rating">
                            <MenuFlyoutItem.Icon>
                                <BitmapIcon ShowAsMonochrome="False"
                                            UriSource="/Assets/Fluent/add.png" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem loca:Uids.Uid="MenuFlyout_Add_Reference_Source"
                                        Click="AddReferenceSourceButton_Click"
                                        Tag="match">
                            <MenuFlyoutItem.Icon>
                                <BitmapIcon ShowAsMonochrome="False"
                                            UriSource="/Assets/Fluent/add.png" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem loca:Uids.Uid="MenuFlyout_Add_Reference_Author"
                                        Click="AddReferenceAuthorButton_Click"
                                        Tag="distance">
                            <MenuFlyoutItem.Icon>
                                <BitmapIcon ShowAsMonochrome="False"
                                            UriSource="/Assets/Fluent/add.png" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarButton x:Name="AppBarButtonAddComment"
                          loca:Uids.Uid="AppBarButtonAddComment"
                          Click="AddComment_Click"
                          IsEnabled="{x:Bind conv:NotConverter.IsNotNull(ViewModel.SpeciesSelected), Mode=OneWay}">
                <AppBarButton.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/add.png" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="AppBarButtonAddName"
                          loca:Uids.Uid="AppBarButtonAddName"
                          Click="AddName_Click"
                          IsEnabled="{x:Bind conv:NotConverter.IsNotNull(ViewModel.SpeciesSelected), Mode=OneWay}">
                <AppBarButton.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/add.png" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="AppBarButtonAddImage"
                          loca:Uids.Uid="AppBarButtonAddImage"
                          Click="AddImage_Click"
                          IsEnabled="{x:Bind conv:NotConverter.IsNotNull(ViewModel.SpeciesSelected), Mode=OneWay}">
                <AppBarButton.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/add.png" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="AppBarButtonAddSynonym"
                          loca:Uids.Uid="AppBarButtonAddSynonym"
                          Click="AddSynonym_Click"
                          IsEnabled="{x:Bind conv:NotConverter.IsNotNull(ViewModel.SpeciesSelected), Mode=OneWay}">
                <AppBarButton.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/add.png" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="AppBarButtonAddGeographic"
                          loca:Uids.Uid="AppBarButtonAddGeographic"
                          Click="AddGeographic_Click"
                          IsEnabled="{x:Bind conv:NotConverter.IsNotNull(ViewModel.SpeciesSelected), Mode=OneWay}">
                <AppBarButton.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/add.png" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="AppBarButtonSync"
                          loca:Uids.Uid="AppBarButtonSync"
                          Click="Refresh_Click"
                          IsEnabled="{x:Bind conv:NotConverter.IsNotNull(ViewModel.SpeciesSelected), Mode=OneWay}">
                <AppBarButton.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/refresh.png" />
                </AppBarButton.Icon>
            </AppBarButton>
        </CommandBar>

        <AutoSuggestBox Name="SpeciesSearchBox"
                        Width="280"
                        Margin="4,8,4,0"
                        loca:Uids.Uid="AutoSuggestBox_Search"
                        Loaded="SpeciesSearchBox_OnLoaded"
                        QuerySubmitted="GetSpeciessesByNameOrId"
                        RelativePanel.AlignRightWithPanel="True">
            <AutoSuggestBox.QueryIcon>
                <BitmapIcon ShowAsMonochrome="False"
                            UriSource="/Assets/Fluent/search.png" />
            </AutoSuggestBox.QueryIcon>
        </AutoSuggestBox>

        <ScrollViewer x:Name="PanelSpecies"
                      RelativePanel.AlignLeftWithPanel="True"
                      RelativePanel.AlignRightWithPanel="True"
                      RelativePanel.Below="PageTitle"
                      VerticalScrollBarVisibility="Auto"
                      VerticalScrollMode="Auto">

            <StackPanel Margin="-10,8,4,0">
                <StackPanel.Resources>
                    <Style TargetType="Expander">
                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                    </Style>
                </StackPanel.Resources>
                <toolkit:DataGrid x:Name="SpeciesDataGrid"
                                  MaxHeight="230"
                                  Margin="0,0,20,0"
                                  VerticalAlignment="Top"
                                  x:FieldModifier="public"
                                  AlternatingRowBackground="LightGray"
                                  AutoGenerateColumns="False"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  CanUserReorderColumns="False"
                                  CanUserResizeColumns="False"
                                  ContextFlyout="{StaticResource SpeciesDataContextMenu}"
                                  CurrentCellChanged="SpeciesDataGrid_OnCurrentCellChanged"
                                  GridLinesVisibility="Horizontal"
                                  ItemsSource="{x:Bind ViewModel.SpeciesItems}"
                                  SelectedItem="{x:Bind ViewModel.SpeciesSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  SelectionMode="Single"
                                  Sorting="SpeciesDataGrid_Sorting">
                    <toolkit:DataGrid.Columns>
                        <toolkit:DataGridTemplateColumn loca:Uids.Uid="DataGridTemplateColumn_SpeciesId"
                                                        Tag="SpeciesId">
                            <toolkit:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:Tbl75Species">
                                    <HyperlinkButton Margin="12,0"
                                                     BorderThickness="0"
                                                     Click="ViewSpeciesHyperlinkButton_Click"
                                                     Content="{Binding SpeciesId}" />
                                </DataTemplate>
                            </toolkit:DataGridTemplateColumn.CellTemplate>
                        </toolkit:DataGridTemplateColumn>
                        <toolkit:DataGridComboBoxColumn loca:Uids.Uid="DataGridComboBoxColumn_GenusName"
                                                        Binding="{Binding GenusId}"
                                                        DisplayMemberPath="GenusName"
                                                        ItemsSource="{x:Bind ViewModel.Tbl66GenussesAllList, Mode=OneWay}" />
                        <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_SpeciesName"
                                                    Binding="{Binding SpeciesName}"
                                                    CanUserSort="True"
                                                    Tag="SpeciesName" />
                        <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_Subspecies"
                                                    Binding="{Binding Subspecies}"
                                                    CanUserSort="True"
                                                    Tag="Subspecies" />
                        <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_Divers"
                                                    Binding="{Binding Divers}"
                                                    CanUserSort="True"
                                                    Tag="Divers" />
                        <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_Creature"
                                                    Binding="{Binding Creature}"
                                                    Tag="Creative" />
                        <toolkit:DataGridComboBoxColumn loca:Uids.Uid="DataGridComboBoxColumn_SpeciesgroupName"
                                                        Binding="{Binding SpeciesgroupId}"
                                                        DisplayMemberPath="SpeciesgroupFullName"
                                                        ItemsSource="{x:Bind ViewModel.Tbl68SpeciesgroupsAllList, Mode=OneWay}" />
                        <toolkit:DataGridCheckBoxColumn loca:Uids.Uid="DataGridCheckBoxColumn_Valid"
                                                        Binding="{Binding Valid}"
                                                        Tag="Valid" />
                        <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_Author"
                                                    Binding="{Binding Author}"
                                                    Tag="Author" />
                        <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_AuthorYear"
                                                    Binding="{Binding AuthorYear}"
                                                    Tag="AuthorYear" />
                        <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_Info"
                                                    Binding="{Binding Info}"
                                                    Tag="Info" />
                    </toolkit:DataGrid.Columns>
                </toolkit:DataGrid>

                <!--  SpeciesDetailExpander  -->
                <Expander x:Name="SpeciesDetailExpander"
                          MinWidth="1200"
                          Margin="{StaticResource XSmallTopBottomMargin}"
                          Visibility="Collapsed">
                    <Expander.Header>
                        <Grid>
                            <TextBlock loca:Uids.Uid="TextBlock_Species"
                                       Style="{ThemeResource SubtitleTextBlockStyle}" />
                            <StackPanel HorizontalAlignment="Right"
                                        Orientation="Horizontal">
                                <ComboBox Width="Auto"
                                          Margin="{StaticResource XSmallRightComboBoxMargin}"
                                          DisplayMemberPath="GenusName"
                                          IsDropDownOpen="False"
                                          IsEditable="False"
                                          IsEnabled="False"
                                          ItemsSource="{x:Bind ViewModel.Tbl66GenussesAllList}"
                                          SelectedValue="{x:Bind ViewModel.SpeciesSelected.GenusId, Mode=OneWay}"
                                          SelectedValuePath="GenusId" />
                                <TextBlock Margin="2,0,0,0"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Text="{x:Bind ViewModel.SpeciesSelected.SpeciesName, Mode=OneWay}" />
                                <TextBlock Margin="2,0,0,0"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Text="{x:Bind ViewModel.SpeciesSelected.Subspecies, Mode=OneWay}" />
                                <TextBlock Margin="2,0,0,0"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Text="{x:Bind ViewModel.SpeciesSelected.Divers, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                    </Expander.Header>
                    <RelativePanel x:Name="SpeciesDetailRoot"
                                   Margin="{StaticResource SmallLeftRightMargin}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup>
                                <VisualState>
                                    <VisualState.StateTriggers>
                                        <AdaptiveTrigger MinWindowWidth="{StaticResource LargeWindowSnapPoint}" />
                                    </VisualState.StateTriggers>
                                </VisualState>
                                <VisualState>
                                    <VisualState.StateTriggers>
                                        <AdaptiveTrigger MinWindowWidth="{StaticResource MediumWindowSnapPoint}" />
                                    </VisualState.StateTriggers>
                                </VisualState>
                                <VisualState>
                                    <VisualState.StateTriggers>
                                        <AdaptiveTrigger MinWindowWidth="{StaticResource MinWindowSnapPoint}" />
                                    </VisualState.StateTriggers>
                                    <VisualState.Setters>
                                        <Setter Target="SpeciesCommandBar.DefaultLabelPosition" Value="Bottom" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <CommandBar x:Name="SpeciesDetailCommandBar"
                                    Margin="{StaticResource SmallLeftRightCommandBarMargin}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Top"
                                    Background="Transparent"
                                    DefaultLabelPosition="Right"
                                    RelativePanel.AlignRightWithPanel="True">
                            <AppBarButton loca:Uids.Uid="AppBarButtonSave"
                                          Background="{ThemeResource SystemBaseLowColor}"
                                          Click="SaveSpecies_Click"
                                          Foreground="White"
                                          Visibility="{x:Bind ViewModel.IsInEditSpecies, Mode=OneWay}">
                                <AppBarButton.Icon>
                                    <BitmapIcon ShowAsMonochrome="False"
                                                UriSource="/Assets/Fluent/save.png" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton loca:Uids.Uid="AppBarButtonCancel"
                                          Click="CancelEditsSpeciesAsync"
                                          Visibility="{x:Bind ViewModel.IsInEditSpecies, Mode=OneWay}">
                                <AppBarButton.Icon>
                                    <BitmapIcon ShowAsMonochrome="False"
                                                UriSource="/Assets/Fluent/cancel.png" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarSeparator Visibility="{x:Bind ViewModel.IsInEditSpecies, Mode=OneWay}" />
                            <AppBarButton loca:Uids.Uid="AppBarButtonBack"
                                          Background="{ThemeResource SystemAccentColor}"
                                          Click="BackSpecies_Click"
                                          Foreground="White">
                                <AppBarButton.Icon>
                                    <BitmapIcon ShowAsMonochrome="False"
                                                UriSource="/Assets/Fluent/arrowleft.png" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton loca:Uids.Uid="AppBarButtonEdit"
                                          Click="{x:Bind ViewModel.StartEditSpecies}"
                                          IsEnabled="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditSpecies), Mode=OneWay}"
                                          Visibility="{x:Bind conv:NotConverter.CollapsedIf(ViewModel.IsNewSpecies), Mode=OneWay}">
                                <AppBarButton.Icon>
                                    <BitmapIcon ShowAsMonochrome="False"
                                                UriSource="/Assets/Fluent/edit.png" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                        </CommandBar>
                        <ScrollViewer x:Name="DetailPanelSpecies"
                                      Margin="0,36,0,0"
                                      RelativePanel.AlignLeftWithPanel="True"
                                      RelativePanel.AlignRightWithPanel="True"
                                      VerticalScrollBarVisibility="Auto"
                                      VerticalScrollMode="Auto">
