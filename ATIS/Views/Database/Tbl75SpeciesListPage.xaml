                                                             BorderThickness="0"
                                                             Click="ViewImageHyperlinkButton_Click"
                                                             Content="{Binding ImageId}" />
                                        </DataTemplate>
                                    </toolkit:DataGridTemplateColumn.CellTemplate>
                                </toolkit:DataGridTemplateColumn>
                                <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_ImageMimeType"
                                                            Binding="{Binding ImageMimeType}"
                                                            Tag="ImageMimeType" />
                                <toolkit:DataGridTemplateColumn loca:Uids.Uid="DataGridTemplateColumn_Image">
                                    <toolkit:DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center"
                                                        Orientation="Horizontal">
                                                <Image Width="22"
                                                       Height="22"
                                                       Margin="{StaticResource SmallLeftMargin}"
                                                       Source="{Binding Filestream, Converter={StaticResource ResourceKey=ImageSourceConverter}}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </toolkit:DataGridTemplateColumn.CellTemplate>
                                </toolkit:DataGridTemplateColumn>
                                <toolkit:DataGridComboBoxColumn loca:Uids.Uid="DataGridComboBoxColumn_SpeciesName"
                                                                Binding="{Binding SpeciesId}"
                                                                DisplayMemberPath="SpeciesName"
                                                                ItemsSource="{x:Bind ViewModel.Tbl75SpeciessesAllList, Mode=OneWay}" />
                                <toolkit:DataGridCheckBoxColumn loca:Uids.Uid="DataGridCheckBoxColumn_Valid"
                                                                Binding="{Binding Valid}"
                                                                Tag="Valid" />
                                <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_Info"
                                                            Binding="{Binding Info}"
                                                            Tag="Info" />
                            </toolkit:DataGrid.Columns>
                        </toolkit:DataGrid>
                    </Grid>
                </Expander>

                <!--  SynonymsExpander  -->
                <Expander x:Name="SynonymsExpander"
                          Margin="{StaticResource XSmallTopBottomMargin}"
                          IsExpanded="True"
                          Visibility="Collapsed">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="SynonymsTitle"
                                       loca:Uids.Uid="TextBlock_Synonyms"
                                       Style="{ThemeResource PageTitleTextBlockStyle}" />
                            <TextBlock x:Name="SynonymsDatasetText"
                                       Margin="5,0,0,2"
                                       loca:Uids.Uid="TextBlock_DataSetCount"
                                       Style="{StaticResource DatasetTitleStyle}" />
                            <TextBlock x:Name="SynonymsDatasetCountText"
                                       Margin="5,0,0,2"
                                       Style="{StaticResource DatasetTitleStyle}"
                                       Text="{x:Bind ViewModel.SynonymDataSetCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Expander.Header>
                    <Grid Margin="0,4,0,0">
                        <toolkit:DataGrid x:Name="SynonymDataGrid"
                                          MaxHeight="230"
                                          Margin="0,0,20,0"
                                          VerticalAlignment="Top"
                                          x:FieldModifier="public"
                                          AlternatingRowBackground="LightGray"
                                          AutoGenerateColumns="False"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          CanUserReorderColumns="False"
                                          CanUserResizeColumns="False"
                                          ContextFlyout="{StaticResource SynonymDataContextMenu}"
                                          GridLinesVisibility="Horizontal"
                                          ItemsSource="{x:Bind ViewModel.SynonymItems, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.SynonymSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          SelectionMode="Single"
                                          Sorting="DataGrid_Synonym_Sorting">
                            <toolkit:DataGrid.Columns>
                                <toolkit:DataGridTemplateColumn loca:Uids.Uid="DataGridTemplateColumn_SynonymId"
                                                                Tag="SynonymId">
                                    <toolkit:DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="models:Tbl84Synonym">
                                            <HyperlinkButton Margin="12,0"
                                                             BorderThickness="0"
                                                             Click="ViewSynonymHyperlinkButton_Click"
                                                             Content="{Binding SynonymId}" />
                                        </DataTemplate>
                                    </toolkit:DataGridTemplateColumn.CellTemplate>
                                </toolkit:DataGridTemplateColumn>
                                <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_SynonymName"
                                                            Binding="{Binding SynonymName}"
                                                            CanUserSort="True"
                                                            Tag="SynonymName" />
                                <toolkit:DataGridComboBoxColumn loca:Uids.Uid="DataGridComboBoxColumn_SpeciesName"
                                                                Binding="{Binding SpeciesId}"
                                                                DisplayMemberPath="SpeciesName"
                                                                ItemsSource="{x:Bind ViewModel.Tbl75SpeciessesAllList, Mode=OneWay}" />
                                <toolkit:DataGridCheckBoxColumn loca:Uids.Uid="DataGridCheckBoxColumn_Valid"
                                                                Binding="{Binding Valid}"
                                                                Tag="Valid" />
                                <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_Author"
                                                            Binding="{Binding Author}"
                                                            Tag="Author" />
                                <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_AuthorYear"
                                                            Binding="{Binding AuthorYear}"
                                                            Tag="AuthorYear" />
                                <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_Info"
                                                            Binding="{Binding Info}"
                                                            Tag="Info" />
                            </toolkit:DataGrid.Columns>
                        </toolkit:DataGrid>
                    </Grid>
                </Expander>

                <!--  GeographicsExpander  -->
                <Expander x:Name="GeographicsExpander"
                          Margin="{StaticResource XSmallTopBottomMargin}"
                          IsExpanded="True"
                          Visibility="Collapsed">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="GeographicsTitle"
                                       loca:Uids.Uid="TextBlock_Geographics"
                                       Style="{ThemeResource PageTitleTextBlockStyle}" />
                            <TextBlock x:Name="GeographicsDatasetText"
                                       Margin="5,0,0,2"
                                       loca:Uids.Uid="TextBlock_DataSetCount"
                                       Style="{StaticResource DatasetTitleStyle}" />
                            <TextBlock x:Name="GeographicsDatasetCountText"
                                       Margin="5,0,0,2"
                                       Style="{StaticResource DatasetTitleStyle}"
                                       Text="{x:Bind ViewModel.GeographicDataSetCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Expander.Header>
                    <Grid Margin="0,4,0,0">
                        <toolkit:DataGrid x:Name="GeographicDataGrid"
                                          MaxHeight="230"
                                          Margin="0,0,20,0"
                                          VerticalAlignment="Top"
                                          x:FieldModifier="public"
                                          AlternatingRowBackground="LightGray"
                                          AutoGenerateColumns="False"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          CanUserReorderColumns="False"
                                          CanUserResizeColumns="False"
                                          ContextFlyout="{StaticResource GeographicDataContextMenu}"
                                          GridLinesVisibility="Horizontal"
                                          ItemsSource="{x:Bind ViewModel.GeographicItems, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.GeographicSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          SelectionMode="Single"
                                          Sorting="DataGrid_Geographic_Sorting">
                            <toolkit:DataGrid.Columns>
                                <toolkit:DataGridTemplateColumn loca:Uids.Uid="DataGridTemplateColumn_GeographicId"
                                                                Tag="ImageId">
                                    <toolkit:DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="models:Tbl87Geographic">
                                            <HyperlinkButton Margin="12,0"
                                                             BorderThickness="0"
                                                             Click="ViewGeographicHyperlinkButton_Click"
                                                             Content="{Binding GeographicId}" />
                                        </DataTemplate>
                                    </toolkit:DataGridTemplateColumn.CellTemplate>
                                </toolkit:DataGridTemplateColumn>
                                <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_Continent"
                                                            Binding="{Binding Continent}"
                                                            Tag="Continent" />
                                <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_Country"
                                                            Binding="{Binding Country}"
                                                            Tag="Country" />
                                <toolkit:DataGridComboBoxColumn loca:Uids.Uid="DataGridComboBoxColumn_SpeciesName"
                                                                Binding="{Binding SpeciesId}"
                                                                DisplayMemberPath="SpeciesName"
                                                                ItemsSource="{x:Bind ViewModel.Tbl75SpeciessesAllList, Mode=OneWay}" />
                                <toolkit:DataGridCheckBoxColumn loca:Uids.Uid="DataGridCheckBoxColumn_Valid"
                                                                Binding="{Binding Valid}"
                                                                Tag="Valid" />
                                <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_Jurisdiction"
                                                            Binding="{Binding Jurisdiction}"
                                                            Tag="Jurisdiction" />
                                <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_Info"
                                                            Binding="{Binding Info}"
                                                            Tag="Info" />
                            </toolkit:DataGrid.Columns>
                        </toolkit:DataGrid>
                    </Grid>
                </Expander>

            </StackPanel>
        </ScrollViewer>
        <ProgressRing x:Name="LoadingProgressRing"
                      Width="40"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                      RelativePanel.AlignHorizontalCenterWithPanel="True"
                      RelativePanel.AlignVerticalCenterWithPanel="True"
                      Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
    </RelativePanel>
</Page>
