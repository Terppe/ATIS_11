<?xml version="1.0" encoding="utf-8" ?>

<Page x:Class="ATIS.Views.Database.Tbl90RefAuthorListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:conv="using:ATIS.Helpers.Converters"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:loca="using:WinUI3Localizer"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:models="using:ATIS.Models"
      xmlns:toolkit="using:CommunityToolkit.WinUI.UI.Controls"
      xmlns:winUiCommunity="using:WinUICommunity"
      NavigationCacheMode="Disabled"
      mc:Ignorable="d">

    <!--  RefAuthorListPage.xaml  Skriptdatum: 06.01.2025  10:32  -->

    <Page.Resources>
        <MenuFlyout x:Key="RefAuthorDataContextMenu">
            <MenuFlyoutItem loca:Uids.Uid="MenuFlyout_Delete_RefAuthor"
                            Click="DeleteRefAuthor_Click">
                <MenuFlyoutItem.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/delete.png" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem loca:Uids.Uid="MenuFlyout_Add_RefAuthor"
                            Click="AddRefAuthor_Click">
                <MenuFlyoutItem.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/add.png" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem loca:Uids.Uid="MenuFlyout_Refresh"
                            Click="Refresh_Click">
                <MenuFlyoutItem.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/refresh.png" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>
    </Page.Resources>

    <RelativePanel x:Name="RefAuthorRoot"
                   Margin="{StaticResource SmallLeftTopRightBottomMargin}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource LargeWindowSnapPoint}" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource MediumWindowSnapPoint}" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource MinWindowSnapPoint}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RefAuthorCommandBar.DefaultLabelPosition" Value="Bottom" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <TextBlock x:Name="PageTitle"
                   loca:Uids.Uid="TextBlock_RefAuthors"
                   RelativePanel.AlignLeftWithPanel="True"
                   Style="{StaticResource PageTitleTextBlockStyle}" />
        <TextBlock x:Name="RefAuthorDatasetText"
                   Margin="5,17,0,0"
                   loca:Uids.Uid="TextBlock_DataSetCount"
                   RelativePanel.RightOf="PageTitle"
                   Style="{StaticResource DatasetTitleStyle}" />
        <TextBlock x:Name="RefAuthorDatasetCountText"
                   Margin="5,17,0,0"
                   RelativePanel.RightOf="RefAuthorDatasetText"
                   Style="{StaticResource DatasetTitleStyle}"
                   Text="{x:Bind ViewModel.RefAuthorDataSetCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <CommandBar x:Name="RefAuthorCommandBar"
                    HorizontalAlignment="Stretch"
                    Background="Transparent"
                    DefaultLabelPosition="Right"
                    RelativePanel.LeftOf="RefAuthorSearchBox"
                    RelativePanel.RightOf="RefAuthorDatasetCountText">
            <AppBarButton x:Name="AppBarButtonDeleteRefAuthor"
                          loca:Uids.Uid="AppBarButtonDeleteRefAuthor"
                          Click="DeleteRefAuthor_Click"
                          IsEnabled="{x:Bind conv:NotConverter.IsNotNull(ViewModel.RefAuthorSelected), Mode=OneWay}">
                <AppBarButton.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/delete.png" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton loca:Uids.Uid="AppBarButtonAddRefAuthor"
                          Background="{ThemeResource SystemAccentColor}"
                          Click="AddRefAuthor_Click"
                          Foreground="White">
                <AppBarButton.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/add.png" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="AppBarButtonSync"
                          loca:Uids.Uid="AppBarButtonSync"
                          Click="Refresh_Click"
                          IsEnabled="{x:Bind conv:NotConverter.IsNotNull(ViewModel.RefAuthorSelected), Mode=OneWay}">
                <AppBarButton.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/refresh.png" />
                </AppBarButton.Icon>
            </AppBarButton>
        </CommandBar>

        <AutoSuggestBox Name="RefAuthorSearchBox"
                        Width="200"
                        Margin="4,8,4,0"
                        loca:Uids.Uid="AutoSuggestBox_Search"
                        Loaded="RefAuthorSearchBox_OnLoaded"
                        QuerySubmitted="GetRefAuthorsByNameOrId"
                        RelativePanel.AlignRightWithPanel="True">
            <AutoSuggestBox.QueryIcon>
                <BitmapIcon ShowAsMonochrome="False"
                            UriSource="/Assets/Fluent/search.png" />
            </AutoSuggestBox.QueryIcon>
        </AutoSuggestBox>

        <ScrollViewer x:Name="PanelRefAuthor"
                      RelativePanel.AlignLeftWithPanel="True"
                      RelativePanel.AlignRightWithPanel="True"
                      RelativePanel.Below="PageTitle"
                      VerticalScrollBarVisibility="Auto"
                      VerticalScrollMode="Auto">
            <StackPanel Margin="-10,8,4,0">
                <StackPanel.Resources>
                    <Style TargetType="Expander">
                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                    </Style>
                </StackPanel.Resources>
                <toolkit:DataGrid x:Name="RefAuthorDataGrid"
                                  MaxHeight="330"
                                  Margin="0,0,20,0"
                                  VerticalAlignment="Top"
                                  x:FieldModifier="public"
                                  AlternatingRowBackground="LightGray"
                                  AutoGenerateColumns="False"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  CanUserReorderColumns="False"
                                  CanUserResizeColumns="False"
                                  ContextFlyout="{StaticResource RefAuthorDataContextMenu}"
                                  CurrentCellChanged="RefAuthorDataGrid_OnCurrentCellChanged"
                                  GridLinesVisibility="Horizontal"
                                  ItemsSource="{x:Bind ViewModel.RefAuthorItems}"
                                  SelectedItem="{x:Bind ViewModel.RefAuthorSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  SelectionMode="Single"
                                  Sorting="RefAuthorDataGrid_Sorting">
                    <toolkit:DataGrid.Columns>
                        <toolkit:DataGridTemplateColumn loca:Uids.Uid="DataGridTemplateColumn_RefAuthorId"
                                                        Tag="RefAuthorId">
                            <toolkit:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:Tbl90RefAuthor">
                                    <HyperlinkButton Margin="12,0"
                                                     BorderThickness="0"
                                                     Click="ViewRefAuthorHyperlinkButton_Click"
                                                     Content="{Binding RefAuthorId}" />
                                </DataTemplate>
                            </toolkit:DataGridTemplateColumn.CellTemplate>
                        </toolkit:DataGridTemplateColumn>
                        <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_RefAuthorName"
                                                    Binding="{Binding RefAuthorName}"
                                                    CanUserSort="True"
                                                    Tag="RefAuthorName" />
                        <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_ArticelTitle"
                                                    Binding="{Binding ArticelTitle}"
                                                    Tag="ArticelTitle" />
                        <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_BookName"
                                                    Binding="{Binding BookName}"
                                                    Tag="BookName" />
                        <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_Info"
                                                    Binding="{Binding Info}"
                                                    Tag="Info" />
                    </toolkit:DataGrid.Columns>
                </toolkit:DataGrid>

                <!--  RefAuthorDetailExpander  -->
                <Expander x:Name="RefAuthorDetailExpander"
                          Margin="{StaticResource XSmallTopBottomMargin}"
                          Visibility="Collapsed">
                    <Expander.Header>
                        <Grid>
                            <TextBlock loca:Uids.Uid="TextBlock_RefAuthor"
                                       Style="{ThemeResource SubtitleTextBlockStyle}" />
                            <TextBlock HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Text="{x:Bind ViewModel.RefAuthorSelected.RefAuthorName, Mode=OneWay}" />
                        </Grid>
                    </Expander.Header>

                    <RelativePanel x:Name="RefAuthorDetailRoot"
                                   Margin="{StaticResource SmallLeftRightMargin}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup>
                                <VisualState>
                                    <VisualState.StateTriggers>
                                        <AdaptiveTrigger MinWindowWidth="{StaticResource LargeWindowSnapPoint}" />
                                    </VisualState.StateTriggers>
                                </VisualState>
                                <VisualState>
                                    <VisualState.StateTriggers>
                                        <AdaptiveTrigger MinWindowWidth="{StaticResource MediumWindowSnapPoint}" />
                                    </VisualState.StateTriggers>
                                </VisualState>
                                <VisualState>
                                    <VisualState.StateTriggers>
                                        <AdaptiveTrigger MinWindowWidth="{StaticResource MinWindowSnapPoint}" />
                                    </VisualState.StateTriggers>
                                    <VisualState.Setters>
                                        <Setter Target="RefAuthorCommandBar.DefaultLabelPosition" Value="Bottom" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <CommandBar x:Name="RefAuthorDetailCommandBar"
                                    Margin="{StaticResource SmallLeftRightCommandBarMargin}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Top"
                                    Background="Transparent"
                                    DefaultLabelPosition="Right"
                                    RelativePanel.AlignRightWithPanel="True">
                            <AppBarButton loca:Uids.Uid="AppBarButtonSave"
                                          Background="{ThemeResource SystemBaseLowColor}"
                                          Click="SaveRefAuthor_Click"
                                          Foreground="White"
                                          Visibility="{x:Bind ViewModel.IsInEditRefAuthor, Mode=OneWay}">
                                <AppBarButton.Icon>
                                    <BitmapIcon ShowAsMonochrome="False"
                                                UriSource="/Assets/Fluent/save.png" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton loca:Uids.Uid="AppBarButtonCancel"
                                          Click="CancelEditsRefAuthorAsync"
                                          Visibility="{x:Bind ViewModel.IsInEditRefAuthor, Mode=OneWay}">
                                <AppBarButton.Icon>
                                    <BitmapIcon ShowAsMonochrome="False"
                                                UriSource="/Assets/Fluent/cancel.png" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarSeparator Visibility="{x:Bind ViewModel.IsInEditRefAuthor, Mode=OneWay}" />
                            <AppBarButton loca:Uids.Uid="AppBarButtonBack"
                                          Background="{ThemeResource SystemAccentColor}"
                                          Click="BackRefAuthor_Click"
                                          Foreground="White">
                                <AppBarButton.Icon>
                                    <BitmapIcon ShowAsMonochrome="False"
                                                UriSource="/Assets/Fluent/arrowleft.png" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton loca:Uids.Uid="AppBarButtonEdit"
                                          Click="{x:Bind ViewModel.StartEditRefAuthor}"
                                          IsEnabled="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditRefAuthor), Mode=OneWay}"
                                          Visibility="{x:Bind conv:NotConverter.CollapsedIf(ViewModel.IsNewRefAuthor), Mode=OneWay}">
                                <AppBarButton.Icon>
                                    <BitmapIcon ShowAsMonochrome="False"
                                                UriSource="/Assets/Fluent/edit.png" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                        </CommandBar>
                        <ScrollViewer x:Name="DetailPanelRefAuthor"
                                      Margin="0,36,0,0"
                                      RelativePanel.AlignLeftWithPanel="True"
                                      RelativePanel.AlignRightWithPanel="True"
                                      VerticalScrollBarVisibility="Auto"
                                      VerticalScrollMode="Auto">
                            <StackPanel>
                                <StackPanel.Resources>
                                    <Style TargetType="Expander">
                                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                                    </Style>
                                </StackPanel.Resources>
                                <RelativePanel Margin="4,0,0,0">
                                    <TextBox x:Name="RefAuthorId"
                                             MinWidth="110"
                                             Margin="{StaticResource XSmallRightMargin}"
                                             loca:Uids.Uid="TextBox_RefAuthorId"
                                             IsReadOnly="True"
                                             RelativePanel.AlignLeftWithPanel="True"
                                             Text="{x:Bind ViewModel.RefAuthorSelected.RefAuthorId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox x:Name="RefAuthorName"
                                             MinWidth="300"
                                             Margin="{StaticResource XSmallRightMargin}"
                                             loca:Uids.Uid="TextBox_RefAuthorName"
                                             CharacterCasing="Upper"
                                             IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditRefAuthor), Mode=OneWay}"
                                             MaxLength="200"
                                             RelativePanel.RightOf="RefAuthorId"
                                             Text="{x:Bind ViewModel.RefAuthorSelected.RefAuthorName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox x:Name="ValidCheckRefAuthor"
                                              Width="80"
                                              Margin="{StaticResource SmallRightCheckBoxMargin}"
                                              VerticalAlignment="Bottom"
                                              loca:Uids.Uid="CheckBox_Valid"
                                              IsChecked="{x:Bind ViewModel.RefAuthorSelected.Valid, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              IsEnabled="{x:Bind conv:NotConverter.NotCombo(ViewModel.IsInEditRefAuthor), Mode=OneWay}"
                                              RelativePanel.AlignLeftWithPanel="True"
                                              RelativePanel.Below="RefAuthorId" />
                                    <TextBox x:Name="ValidYearTextRefAuthor"
                                             Width="70"
                                             Margin="{StaticResource XSmallRightMargin}"
                                             loca:Uids.Uid="TextBox_ValidYear"
                                             winUiCommunity:TextBoxExtensions.Mask="9999"
                                             winUiCommunity:TextBoxExtensions.MaskPlaceholder=" "
                                             CornerRadius="3"
                                             IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditRefAuthor), Mode=OneWay}"
                                             RelativePanel.Below="RefAuthorId"
                                             RelativePanel.RightOf="ValidCheckRefAuthor"
                                             Style="{StaticResource BodyTextBoxStyle}"
                                             Text="{x:Bind ViewModel.RefAuthorSelected.ValidYear, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox x:Name="IsbnTextRefAuthor"
                                             Width="200"
                                             Margin="{StaticResource XSmallRightMargin}"
                                             loca:Uids.Uid="TextBox_ISBN"
                                             IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditRefAuthor), Mode=OneWay}"
                                             MaxLength="60"
                                             RelativePanel.Below="RefAuthorId"
                                             RelativePanel.RightOf="ValidYearTextRefAuthor"
                                             Style="{StaticResource BodyTextBoxStyle}"
                                             Text="{x:Bind ViewModel.RefAuthorSelected.ISBN, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox x:Name="ArticelTitleTextRefAuthor"
                                             MinWidth="800"
                                             Margin="{StaticResource XSmallRightMargin}"
                                             HorizontalAlignment="Stretch"
                                             loca:Uids.Uid="TextBox_ArticelTitle"
                                             IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditRefAuthor), Mode=OneWay}"
                                             MaxLength="300"
                                             RelativePanel.AlignLeftWithPanel="True"
                                             RelativePanel.Below="ValidCheckRefAuthor"
                                             Text="{x:Bind ViewModel.RefAuthorSelected.ArticelTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox x:Name="BookNameTextRefAuthor"
                                             Width="950"
                                             Margin="{StaticResource XSmallRightMargin}"
                                             loca:Uids.Uid="TextBox_BookName"
                                             IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditRefAuthor), Mode=OneWay}"
                                             MaxLength="200"
                                             RelativePanel.AlignLeftWithPanel="True"
                                             RelativePanel.Below="ArticelTitleTextRefAuthor"
                                             Text="{x:Bind ViewModel.RefAuthorSelected.BookName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox x:Name="PageTextRefAuthor"
                                             Width="160"
                                             Margin="{StaticResource XSmallRightMargin}"
                                             loca:Uids.Uid="TextBox_Page"
                                             IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditRefAuthor), Mode=OneWay}"
                                             MaxLength="60"
                                             RelativePanel.Below="ArticelTitleTextRefAuthor"
                                             RelativePanel.RightOf="BookNameTextRefAuthor"
                                             Text="{x:Bind ViewModel.RefAuthorSelected.Page1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox x:Name="PublisherRefAuthor"
                                             MinWidth="800"
                                             Margin="{StaticResource XSmallRightMargin}"
                                             HorizontalAlignment="Stretch"
                                             loca:Uids.Uid="TextBox_Publisher"
                                             IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditRefAuthor), Mode=OneWay}"
                                             MaxLength="200"
                                             RelativePanel.AlignLeftWithPanel="True"
                                             RelativePanel.Below="BookNameTextRefAuthor"
                                             Text="{x:Bind ViewModel.RefAuthorSelected.Publisher, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox x:Name="PublicationPlaceRefAuthor"
                                             MinWidth="310"
                                             Margin="{StaticResource XSmallRightMargin}"
                                             HorizontalAlignment="Stretch"
                                             loca:Uids.Uid="TextBox_PublicationPlace"
                                             IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditRefAuthor), Mode=OneWay}"
                                             MaxLength="100"
                                             RelativePanel.Below="BookNameTextRefAuthor"
                                             RelativePanel.RightOf="PublisherRefAuthor"
                                             Text="{x:Bind ViewModel.RefAuthorSelected.PublicationPlace, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox x:Name="NotesRefAuthor"
                                             MinWidth="1120"
                                             MinHeight="50"
                                             MaxWidth="1300"
                                             MaxHeight="200"
                                             Margin="{StaticResource XSmallRightMargin}"
                                             loca:Uids.Uid="TextBox_Notes"
                                             AcceptsReturn="True"
                                             IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditRefAuthor), Mode=OneWay}"
                                             RelativePanel.AlignLeftWithPanel="True"
                                             RelativePanel.Below="PublisherRefAuthor"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             Text="{x:Bind ViewModel.RefAuthorSelected.Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             TextWrapping="Wrap" />
                                    <TextBox x:Name="InfoRefAuthor"
                                             MinWidth="1120"
                                             Margin="{StaticResource XSmallRightMargin}"
                                             HorizontalAlignment="Stretch"
                                             loca:Uids.Uid="TextBox_Info"
                                             IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditRefAuthor), Mode=OneWay}"
                                             MaxLength="100"
                                             RelativePanel.AlignLeftWithPanel="True"
                                             RelativePanel.Below="NotesRefAuthor"
                                             Text="{x:Bind ViewModel.RefAuthorSelected.Info, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </RelativePanel>
                                <Expander x:Name="MemoExpanderRefAuthor">
                                    <Expander.Header>
                                        <Grid>
                                            <TextBlock loca:Uids.Uid="TextBlock_Memo"
                                                       Style="{ThemeResource SubtitleTextBlockStyle}" />
                                        </Grid>
                                    </Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox x:Name="MemoRefAuthor"
                                                 MinWidth="1120"
                                                 MinHeight="50"
                                                 MaxWidth="1300"
                                                 MaxHeight="200"
                                                 Margin="{StaticResource XSmallRightMargin}"
                                                 loca:Uids.Uid="TextBox_Memo"
                                                 AcceptsReturn="True"
                                                 IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditRefAuthor), Mode=OneWay}"
                                                 RelativePanel.AlignLeftWithPanel="True"
                                                 RelativePanel.Below="InfoRefAuthor"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 Text="{x:Bind ViewModel.RefAuthorSelected.Memo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 TextWrapping="Wrap" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                    </RelativePanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <ProgressRing x:Name="LoadingProgressRing"
                      Width="40"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                      RelativePanel.AlignHorizontalCenterWithPanel="True"
                      RelativePanel.AlignVerticalCenterWithPanel="True"
                      Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
    </RelativePanel>
</Page>
