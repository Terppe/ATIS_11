<?xml version="1.0" encoding="utf-8" ?>

<Page x:Class="ATIS.Views.Database.Tbl87GeographicListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:conv="using:ATIS.Helpers.Converters"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:loca="using:WinUI3Localizer"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:models="using:ATIS.Models"
      xmlns:toolkit="using:CommunityToolkit.WinUI.UI.Controls"
      xmlns:winUi="using:Mapsui.UI.WinUI"
      xmlns:winUiCommunity="using:WinUICommunity"
      NavigationCacheMode="Disabled"
      mc:Ignorable="d">

    <!--  GeographicListPage.xaml  Skriptdatum: 08.07.2025  10:32  -->

    <Page.Resources>
        <conv:DoubleToStringConverter x:Key="DoubleConverter" />
        <MenuFlyout x:Key="GeographicDataContextMenu">
            <MenuFlyoutItem loca:Uids.Uid="MenuFlyout_Delete_Geographic"
                            Click="DeleteGeographic_Click">
                <MenuFlyoutItem.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/delete.png" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem loca:Uids.Uid="MenuFlyout_Add_Geographic"
                            Click="AddGeographic_Click">
                <MenuFlyoutItem.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/add.png" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem loca:Uids.Uid="MenuFlyout_Refresh"
                            Click="Refresh_Click">
                <MenuFlyoutItem.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/refresh.png" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>
    </Page.Resources>

    <RelativePanel x:Name="GeographicRoot"
                   Margin="{StaticResource SmallLeftTopRightBottomMargin}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource LargeWindowSnapPoint}" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource MediumWindowSnapPoint}" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource MinWindowSnapPoint}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="GeographicCommandBar.DefaultLabelPosition" Value="Bottom" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <TextBlock x:Name="PageTitle"
                   loca:Uids.Uid="TextBlock_Geographics"
                   RelativePanel.AlignLeftWithPanel="True"
                   Style="{StaticResource PageTitleTextBlockStyle}" />
        <TextBlock x:Name="GeographicDatasetText"
                   Margin="5,17,0,0"
                   loca:Uids.Uid="TextBlock_DataSetCount"
                   RelativePanel.RightOf="PageTitle"
                   Style="{StaticResource DatasetTitleStyle}" />
        <TextBlock x:Name="GeographicDatasetCountText"
                   Margin="5,17,0,0"
                   RelativePanel.RightOf="GeographicDatasetText"
                   Style="{StaticResource DatasetTitleStyle}"
                   Text="{x:Bind ViewModel.GeographicDataSetCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <CommandBar x:Name="GeographicCommandBar"
                    HorizontalAlignment="Stretch"
                    Background="Transparent"
                    DefaultLabelPosition="Right"
                    RelativePanel.LeftOf="GeographicSearchBox"
                    RelativePanel.RightOf="GeographicDatasetCountText">
            <AppBarButton x:Name="AppBarButtonDeleteGeographic"
                          loca:Uids.Uid="AppBarButtonDeleteGeographic"
                          Click="DeleteGeographic_Click"
                          IsEnabled="{x:Bind conv:NotConverter.IsNotNull(ViewModel.GeographicSelected), Mode=OneWay}">
                <AppBarButton.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/delete.png" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton x:Name="AppBarButtonAddGeographic"
                          loca:Uids.Uid="AppBarButtonAddGeographic"
                          Background="{ThemeResource SystemAccentColor}"
                          Click="AddGeographic_Click"
                          Foreground="White">
                <AppBarButton.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/add.png" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="AppBarButtonSync"
                          loca:Uids.Uid="AppBarButtonSync"
                          Click="Refresh_Click"
                          IsEnabled="{x:Bind conv:NotConverter.IsNotNull(ViewModel.GeographicSelected), Mode=OneWay}">
                <AppBarButton.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/refresh.png" />
                </AppBarButton.Icon>
            </AppBarButton>
        </CommandBar>

        <AutoSuggestBox Name="GeographicSearchBox"
                        Width="200"
                        Margin="4,8,4,0"
                        loca:Uids.Uid="AutoSuggestBox_Search_info_Id"
                        Loaded="GeographicSearchBox_OnLoaded"
                        QuerySubmitted="GetGeographicsByInfoOrId"
                        RelativePanel.AlignRightWithPanel="True">
            <AutoSuggestBox.QueryIcon>
                <BitmapIcon ShowAsMonochrome="False"
                            UriSource="/Assets/Fluent/search.png" />
            </AutoSuggestBox.QueryIcon>
        </AutoSuggestBox>

        <ScrollViewer x:Name="PanelGeographic"
                      RelativePanel.AlignLeftWithPanel="True"
                      RelativePanel.AlignRightWithPanel="True"
                      RelativePanel.Below="PageTitle"
                      VerticalScrollBarVisibility="Auto"
                      VerticalScrollMode="Auto">
            <StackPanel Margin="-10,8,4,0">
                <StackPanel.Resources>
                    <Style TargetType="Expander">
                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                    </Style>
                </StackPanel.Resources>
                <toolkit:DataGrid x:Name="GeographicDataGrid"
                                  MaxHeight="330"
                                  Margin="0,0,20,0"
                                  VerticalAlignment="Top"
                                  x:FieldModifier="public"
                                  AlternatingRowBackground="LightGray"
                                  AutoGenerateColumns="False"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  CanUserReorderColumns="False"
                                  CanUserResizeColumns="False"
                                  ContextFlyout="{StaticResource GeographicDataContextMenu}"
                                  CurrentCellChanged="GeographicDataGrid_OnCurrentCellChanged"
                                  GridLinesVisibility="Horizontal"
                                  ItemsSource="{x:Bind ViewModel.GeographicItems}"
                                  SelectedItem="{x:Bind ViewModel.GeographicSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  SelectionMode="Single"
                                  Sorting="GeographicDataGrid_Sorting">
                    <toolkit:DataGrid.Columns>
                        <toolkit:DataGridTemplateColumn loca:Uids.Uid="DataGridTemplateColumn_GeographicId"
                                                        Tag="GeographicId">
                            <toolkit:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:Tbl87Geographic">
                                    <HyperlinkButton Margin="12,0"
                                                     BorderThickness="0"
                                                     Click="ViewGeographicHyperlinkButton_Click"
                                                     Content="{Binding GeographicId}" />
                                </DataTemplate>
                            </toolkit:DataGridTemplateColumn.CellTemplate>
                        </toolkit:DataGridTemplateColumn>
                        <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_Continent"
                                                    Binding="{Binding Continent}"
                                                    Tag="Continent" />
                        <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_Country"
                                                    Binding="{Binding Country}"
                                                    Tag="Country" />
                        <toolkit:DataGridCheckBoxColumn loca:Uids.Uid="DataGridCheckBoxColumn_Valid"
                                                        Binding="{Binding Valid}"
                                                        Tag="Valid" />
                        <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_Jurisdiction"
                                                    Binding="{Binding Jurisdiction}"
                                                    Tag="Jurisdiction" />
                        <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_Info"
                                                    Binding="{Binding Info}"
                                                    Tag="Info" />
                    </toolkit:DataGrid.Columns>
                </toolkit:DataGrid>

                <!--  GeographicDetailExpander  -->
                <Expander x:Name="GeographicDetailExpander"
                          Margin="{StaticResource XSmallTopBottomMargin}"
                          Visibility="Collapsed">
                    <Expander.Header>
                        <Grid>
                            <TextBlock loca:Uids.Uid="TextBlock_Geographic"
                                       Style="{ThemeResource SubtitleTextBlockStyle}" />
                            <TextBlock HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Text="{x:Bind ViewModel.GeographicSelected.GeographicId, Mode=OneWay}" />
                        </Grid>
                    </Expander.Header>

                    <RelativePanel x:Name="GeographicDetailRoot"
                                   Margin="{StaticResource SmallLeftRightMargin}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup>
                                <VisualState>
                                    <VisualState.StateTriggers>
                                        <AdaptiveTrigger MinWindowWidth="{StaticResource LargeWindowSnapPoint}" />
                                    </VisualState.StateTriggers>
                                </VisualState>
                                <VisualState>
                                    <VisualState.StateTriggers>
                                        <AdaptiveTrigger MinWindowWidth="{StaticResource MediumWindowSnapPoint}" />
                                    </VisualState.StateTriggers>
                                </VisualState>
                                <VisualState>
                                    <VisualState.StateTriggers>
                                        <AdaptiveTrigger MinWindowWidth="{StaticResource MinWindowSnapPoint}" />
                                    </VisualState.StateTriggers>
                                    <VisualState.Setters>
                                        <Setter Target="GeographicCommandBar.DefaultLabelPosition" Value="Bottom" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <CommandBar x:Name="GeographicDetailCommandBar"
                                    Margin="{StaticResource SmallLeftRightCommandBarMargin}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Top"
                                    Background="Transparent"
                                    DefaultLabelPosition="Right"
                                    RelativePanel.AlignRightWithPanel="True">
                            <AppBarButton loca:Uids.Uid="AppBarButtonSave"
                                          Background="{ThemeResource SystemBaseLowColor}"
                                          Click="SaveGeographic_Click"
                                          Foreground="White"
                                          Visibility="{x:Bind ViewModel.IsInEditGeographic, Mode=OneWay}">
                                <AppBarButton.Icon>
                                    <BitmapIcon ShowAsMonochrome="False"
                                                UriSource="/Assets/Fluent/save.png" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton loca:Uids.Uid="AppBarButtonCancel"
                                          Click="CancelEditsGeographicAsync"
                                          Visibility="{x:Bind ViewModel.IsInEditGeographic, Mode=OneWay}">
                                <AppBarButton.Icon>
                                    <BitmapIcon ShowAsMonochrome="False"
                                                UriSource="/Assets/Fluent/cancel.png" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarSeparator Visibility="{x:Bind ViewModel.IsInEditGeographic, Mode=OneWay}" />
                            <AppBarButton loca:Uids.Uid="AppBarButtonBack"
                                          Background="{ThemeResource SystemAccentColor}"
                                          Click="BackGeographic_Click"
                                          Foreground="White">
                                <AppBarButton.Icon>
                                    <BitmapIcon ShowAsMonochrome="False"
                                                UriSource="/Assets/Fluent/arrowleft.png" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton loca:Uids.Uid="AppBarButtonEdit"
                                          Click="{x:Bind ViewModel.StartEditGeographic}"
                                          IsEnabled="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditGeographic), Mode=OneWay}"
                                          Visibility="{x:Bind conv:NotConverter.CollapsedIf(ViewModel.IsNewGeographic), Mode=OneWay}">
                                <AppBarButton.Icon>
                                    <BitmapIcon ShowAsMonochrome="False"
                                                UriSource="/Assets/Fluent/edit.png" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                        </CommandBar>
                        <ScrollViewer x:Name="DetailPanelGeographic"
                                      Margin="0,36,0,0"
                                      RelativePanel.AlignLeftWithPanel="True"
                                      RelativePanel.AlignRightWithPanel="True"
                                      VerticalScrollBarVisibility="Auto"
                                      VerticalScrollMode="Auto">
                            <StackPanel>
                                <StackPanel.Resources>
                                    <Style TargetType="Expander">
                                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                                    </Style>
                                </StackPanel.Resources>
                                <RelativePanel Margin="4,0,0,0">
                                    <TextBox x:Name="GeographicId"
                                             MinWidth="110"
                                             Margin="{StaticResource XSmallRightMargin}"
                                             loca:Uids.Uid="TextBox_GeographicId"
                                             IsReadOnly="True"
                                             RelativePanel.AlignLeftWithPanel="True"
                                             Text="{x:Bind ViewModel.GeographicSelected.GeographicId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <ComboBox x:Name="ComboContinent"
                                              Width="250"
                                              Margin="{StaticResource XSmallRightComboBoxMargin}"
                                              loca:Uids.Uid="ComboBox_Continent"
                                              IsEnabled="{x:Bind conv:NotConverter.NotCombo(ViewModel.IsInEditGeographic), Mode=OneWay}"
                                              PlaceholderText="Pick a Continent"
                                              RelativePanel.RightOf="GeographicId"
                                              SelectedValue="{x:Bind ViewModel.GeographicSelected.Continent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                        <x:String>Africa</x:String>
                                        <x:String>Antarctica</x:String>
                                        <x:String>Asia</x:String>
                                        <x:String>Australia</x:String>
                                        <x:String>Central/South America</x:String>
                                        <x:String>Europe</x:String>
                                        <x:String>North America/Caribbean</x:String>
                                    </ComboBox>
                                    <ComboBox x:Name="ComboCountry"
                                              MinWidth="250"
                                              Margin="{StaticResource XSmallRightComboBoxMargin}"
                                              loca:Uids.Uid="ComboBox_Country"
                                              DisplayMemberPath="Name"
                                              IsEnabled="{x:Bind conv:NotConverter.NotCombo(ViewModel.IsInEditGeographic), Mode=OneWay}"
                                              ItemsSource="{x:Bind ViewModel.TblCountriesAllList}"
                                              PlaceholderText="Pick a Country"
                                              RelativePanel.RightOf="ComboContinent"
                                              SelectedValue="{x:Bind ViewModel.GeographicSelected.Country, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="Name" />
                                    <CheckBox x:Name="ValidCheckGeographic"
                                              Width="80"
                                              Margin="{StaticResource SmallRightCheckBoxMargin}"
                                              VerticalAlignment="Bottom"
                                              loca:Uids.Uid="CheckBox_Valid"
                                              IsChecked="{x:Bind ViewModel.GeographicSelected.Valid, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              RelativePanel.RightOf="ComboCountry" />
                                    <TextBox x:Name="AddressGeographic"
                                             MinWidth="1120"
                                             Margin="{StaticResource XSmallRightMargin}"
                                             loca:Uids.Uid="TextBox_Address"
                                             IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditGeographic), Mode=OneWay}"
                                             MaxLength="100"
                                             RelativePanel.AlignLeftWithPanel="True"
                                             RelativePanel.Below="GeographicId"
                                             Text="{x:Bind ViewModel.GeographicSelected.Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox x:Name="JurisdictionGeographic"
                                             MinWidth="1120"
                                             Margin="{StaticResource XSmallRightMargin}"
                                             HorizontalAlignment="Stretch"
                                             loca:Uids.Uid="TextBox_Jurisdiction"
                                             IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditGeographic), Mode=OneWay}"
                                             MaxLength="100"
                                             RelativePanel.AlignLeftWithPanel="True"
                                             RelativePanel.Below="AddressGeographic"
                                             Text="{x:Bind ViewModel.GeographicSelected.Jurisdiction, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox x:Name="InfoGeographic"
                                             MinWidth="1120"
                                             Margin="{StaticResource XSmallRightMargin}"
                                             HorizontalAlignment="Stretch"
                                             loca:Uids.Uid="TextBox_Info"
                                             IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditGeographic), Mode=OneWay}"
                                             MaxLength="100"
                                             RelativePanel.AlignLeftWithPanel="True"
                                             RelativePanel.Below="JurisdictionGeographic"
                                             Text="{x:Bind ViewModel.GeographicSelected.Info, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </RelativePanel>
                                <Expander x:Name="MapExpanderGeographic">
                                    <Expander.Header>
                                        <Grid>
                                            <TextBlock loca:Uids.Uid="TextBlock_Map"
                                                       Style="{ThemeResource SubtitleTextBlockStyle}" />
                                        </Grid>
                                    </Expander.Header>
                                    <RelativePanel>
                                        <Border Width="1100"
                                                Height="400">
                                            <Grid>
                                                <winUi:MapControl x:Name="MyMap"
                                                                  HorizontalAlignment="Stretch"
                                                                  VerticalAlignment="Stretch" />
                                            </Grid>
                                        </Border>
                                    </RelativePanel>
                                </Expander>
                                <Expander x:Name="DataExpanderGeographic">
                                    <Expander.Header>
                                        <Grid>
                                            <TextBlock loca:Uids.Uid="TextBlock_Data"
                                                       Style="{ThemeResource SubtitleTextBlockStyle}" />
                                        </Grid>
                                    </Expander.Header>
                                    <RelativePanel>
                                        <TextBox x:Name="AuthorTextGeographic"
                                                 MinWidth="860"
                                                 Margin="{StaticResource XSmallRightMargin}"
                                                 HorizontalAlignment="Stretch"
                                                 loca:Uids.Uid="TextBox_Author"
                                                 CharacterCasing="Upper"
                                                 IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditGeographic), Mode=OneWay}"
                                                 MaxLength="60"
                                                 RelativePanel.AlignLeftWithPanel="True"
                                                 Text="{x:Bind ViewModel.GeographicSelected.Author, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox x:Name="AuthorYearTextGeographic"
                                                 Width="70"
                                                 Margin="{StaticResource XSmallRightMargin}"
                                                 loca:Uids.Uid="TextBox_AuthorYear"
                                                 winUiCommunity:TextBoxExtensions.Mask="9999"
                                                 winUiCommunity:TextBoxExtensions.MaskPlaceholder=" "
                                                 CornerRadius="3"
                                                 IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditGeographic), Mode=OneWay}"
                                                 RelativePanel.RightOf="AuthorTextGeographic"
                                                 Text="{x:Bind ViewModel.GeographicSelected.AuthorYear, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox x:Name="HttpGeographic"
                                                 MinWidth="1120"
                                                 Margin="{StaticResource XSmallRightMargin}"
                                                 loca:Uids.Uid="TextBox_Http"
                                                 IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditGeographic), Mode=OneWay}"
                                                 MaxLength="100"
                                                 RelativePanel.AlignLeftWithPanel="True"
                                                 RelativePanel.Below="AuthorTextGeographic"
                                                 Text="{x:Bind ViewModel.GeographicSelected.Http, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox x:Name="MemoGeographic"
                                                 MinWidth="1120"
                                                 MinHeight="75"
                                                 MaxWidth="1300"
                                                 MaxHeight="300"
                                                 Margin="{StaticResource XSmallRightMargin}"
                                                 loca:Uids.Uid="TextBox_Memo"
                                                 AcceptsReturn="True"
                                                 IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditGeographic), Mode=OneWay}"
                                                 RelativePanel.AlignLeftWithPanel="True"
                                                 RelativePanel.Below="HttpGeographic"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 Text="{x:Bind ViewModel.GeographicSelected.Memo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 TextWrapping="Wrap" />
                                    </RelativePanel>
                                </Expander>
                                <Expander x:Name="LatitudeExpanderGeographic">
                                    <Expander.Header>
                                        <Grid>
                                            <TextBlock loca:Uids.Uid="TextBlock_Latitude"
                                                       Style="{ThemeResource SubtitleTextBlockStyle}" />
                                        </Grid>
                                    </Expander.Header>
                                    <RelativePanel>
                                        <TextBox x:Name="ZoomLevelGeographic"
                                                 MinWidth="250"
                                                 Margin="{StaticResource XSmallRightMargin}"
                                                 loca:Uids.Uid="TextBox_ZoomLevel"
                                                 IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditGeographic), Mode=OneWay}"
                                                 Text="{x:Bind ViewModel.GeographicSelected.ZoomLevel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox x:Name="Latitude1Geographic"
                                                 MinWidth="200"
                                                 Margin="{StaticResource XSmallRightMargin}"
                                                 loca:Uids.Uid="TextBox_Latitude1"
                                                 IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditGeographic), Mode=OneWay}"
                                                 RelativePanel.AlignLeftWithPanel="True"
                                                 RelativePanel.Below="ZoomLevelGeographic"
                                                 Text="{x:Bind ViewModel.GeographicSelected.Latitude, Converter={StaticResource ResourceKey=DoubleConverter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox x:Name="Longitude1Geographic"
                                                 MinWidth="200"
                                                 Margin="{StaticResource XSmallRightMargin}"
                                                 loca:Uids.Uid="TextBox_Longitude1"
                                                 IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditGeographic), Mode=OneWay}"
                                                 RelativePanel.Below="ZoomLevelGeographic"
                                                 RelativePanel.RightOf="Latitude1Geographic"
                                                 Text="{x:Bind ViewModel.GeographicSelected.Longitude, Converter={StaticResource ResourceKey=DoubleConverter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox x:Name="Latitude2Geographic"
                                                 MinWidth="200"
                                                 Margin="{StaticResource XSmallRightMargin}"
                                                 loca:Uids.Uid="TextBox_Latitude2"
                                                 IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditGeographic), Mode=OneWay}"
                                                 RelativePanel.Below="ZoomLevelGeographic"
                                                 RelativePanel.RightOf="Longitude1Geographic"
                                                 Text="{x:Bind ViewModel.GeographicSelected.Latitude1, Converter={StaticResource ResourceKey=DoubleConverter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox x:Name="Longitude2Geographic"
                                                 MinWidth="200"
                                                 Margin="{StaticResource XSmallRightMargin}"
                                                 loca:Uids.Uid="TextBox_Longitude2"
                                                 IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditGeographic), Mode=OneWay}"
                                                 RelativePanel.Below="ZoomLevelGeographic"
                                                 RelativePanel.RightOf="Latitude2Geographic"
                                                 Text="{x:Bind ViewModel.GeographicSelected.Longitude1, Converter={StaticResource ResourceKey=DoubleConverter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox x:Name="Latitude3Geographic"
                                                 MinWidth="200"
                                                 Margin="{StaticResource XSmallRightMargin}"
                                                 loca:Uids.Uid="TextBox_Latitude3"
                                                 IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditGeographic), Mode=OneWay}"
                                                 RelativePanel.AlignLeftWithPanel="True"
                                                 RelativePanel.Below="Latitude1Geographic"
                                                 Text="{x:Bind ViewModel.GeographicSelected.Latitude2, Converter={StaticResource ResourceKey=DoubleConverter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox x:Name="Longitude3Geographic"
                                                 MinWidth="200"
                                                 Margin="{StaticResource XSmallRightMargin}"
                                                 loca:Uids.Uid="TextBox_Longitude3"
                                                 IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditGeographic), Mode=OneWay}"
                                                 RelativePanel.Below="Latitude1Geographic"
                                                 RelativePanel.RightOf="Latitude3Geographic"
                                                 Text="{x:Bind ViewModel.GeographicSelected.Longitude2, Converter={StaticResource ResourceKey=DoubleConverter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox x:Name="Latitude4Geographic"
                                                 MinWidth="200"
                                                 Margin="{StaticResource XSmallRightMargin}"
                                                 loca:Uids.Uid="TextBox_Latitude4"
                                                 IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditGeographic), Mode=OneWay}"
                                                 RelativePanel.Below="Latitude1Geographic"
                                                 RelativePanel.RightOf="Longitude3Geographic"
                                                 Text="{x:Bind ViewModel.GeographicSelected.Latitude3, Converter={StaticResource ResourceKey=DoubleConverter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox x:Name="Longitude4Geographic"
                                                 MinWidth="200"
                                                 Margin="{StaticResource XSmallRightMargin}"
                                                 loca:Uids.Uid="TextBox_Longitude4"
                                                 IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditGeographic), Mode=OneWay}"
                                                 RelativePanel.Below="Latitude1Geographic"
                                                 RelativePanel.RightOf="Latitude4Geographic"
                                                 Text="{x:Bind ViewModel.GeographicSelected.Longitude3, Converter={StaticResource ResourceKey=DoubleConverter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </RelativePanel>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                    </RelativePanel>
                </Expander>

                <!--  SpeciesDetailExpander  -->
                <Expander x:Name="SpeciesDetailExpander"
                          MinWidth="1200"
                          Margin="{StaticResource XSmallTopBottomMargin}"
                          Visibility="Collapsed">
                    <Expander.Header>
                        <Grid>
                            <TextBlock loca:Uids.Uid="TextBlock_Species"
                                       Style="{ThemeResource SubtitleTextBlockStyle}" />
                            <StackPanel HorizontalAlignment="Right"
                                        Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Text="{x:Bind ViewModel.SpeciesSelected.Genus.GenusName, Mode=OneWay}" />
                                <TextBlock Margin="2,0,0,0"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Text="{x:Bind ViewModel.SpeciesSelected.SpeciesName, Mode=OneWay}" />
                                <TextBlock Margin="2,0,0,0"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Text="{x:Bind ViewModel.SpeciesSelected.Subspecies, Mode=OneWay}" />
                                <TextBlock Margin="2,0,0,0"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Text="{x:Bind ViewModel.SpeciesSelected.Divers, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                    </Expander.Header>
                    <RelativePanel x:Name="SpeciesDetailRoot"
