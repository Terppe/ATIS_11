<?xml version="1.0" encoding="utf-8" ?>

<Page x:Class="ATIS.Views.Database.Tbl06PhylumListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:conv="using:ATIS.Helpers.Converters"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:helpers="using:ATIS.Helpers"
      xmlns:loca="using:WinUI3Localizer"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:models="using:ATIS.Models"
      xmlns:toolkit="using:CommunityToolkit.WinUI.UI.Controls"
      xmlns:winUiCommunity="using:WinUICommunity"
      NavigationCacheMode="Disabled"
      mc:Ignorable="d">

    <!--  PhylumListPage.xaml  Skriptdatum: 15.06.2024  12:32  -->

    <Page.Resources>

        <MenuFlyout x:Key="PhylumDataContextMenu">
            <MenuFlyoutItem loca:Uids.Uid="MenuFlyout_Save_Phylum"
                            Click="SavePhylum_Click">
                <MenuFlyoutItem.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/save.png" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem loca:Uids.Uid="MenuFlyout_Delete_Phylum"
                            Click="DeletePhylum_Click">
                <MenuFlyoutItem.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/delete.png" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem loca:Uids.Uid="MenuFlyout_Add_Phylum"
                            Click="AddPhylum_Click">
                <MenuFlyoutItem.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/add.png" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem loca:Uids.Uid="MenuFlyout_Add_Reference_Expert"
                            Click="AddReferenceExpertButton_Click">
                <MenuFlyoutItem.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/add.png" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem loca:Uids.Uid="MenuFlyout_Add_Reference_Source"
                            Click="AddReferenceSourceButton_Click">
                <MenuFlyoutItem.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/add.png" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem loca:Uids.Uid="MenuFlyout_Add_Reference_Author"
                            Click="AddReferenceAuthorButton_Click">
                <MenuFlyoutItem.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/add.png" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem loca:Uids.Uid="MenuFlyout_Add_Comment"
                            Click="AddComment_Click">
                <MenuFlyoutItem.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/add.png" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem loca:Uids.Uid="MenuFlyout_Refresh"
                            Click="Refresh_Click">
                <MenuFlyoutItem.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/refresh.png" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>
        <MenuFlyout x:Key="ReferenceDataContextMenu">
            <MenuFlyoutItem loca:Uids.Uid="MenuFlyout_Delete_Reference"
                            Click="DeleteReference_Click">
                <MenuFlyoutItem.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/delete.png" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem loca:Uids.Uid="MenuFlyout_Add_Reference_Expert"
                            Click="AddReferenceExpertButton_Click">
                <MenuFlyoutItem.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/add.png" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem loca:Uids.Uid="MenuFlyout_Add_Reference_Source"
                            Click="AddReferenceSourceButton_Click">
                <MenuFlyoutItem.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/add.png" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem loca:Uids.Uid="MenuFlyout_Add_Reference_Author"
                            Click="AddReferenceAuthorButton_Click">
                <MenuFlyoutItem.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/add.png" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>
        <MenuFlyout x:Key="CommentDataContextMenu">
            <MenuFlyoutItem loca:Uids.Uid="MenuFlyout_Delete_Comment"
                            Click="DeleteComment_Click">
                <MenuFlyoutItem.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/delete.png" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem loca:Uids.Uid="MenuFlyout_Add_Comment"
                            Click="AddComment_Click">
                <MenuFlyoutItem.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/add.png" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>
    </Page.Resources>

    <RelativePanel x:Name="PhylumRoot"
                   Margin="{StaticResource SmallLeftTopRightBottomMargin}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource LargeWindowSnapPoint}" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource MediumWindowSnapPoint}" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource MinWindowSnapPoint}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PhylumCommandBar.DefaultLabelPosition" Value="Bottom" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <TextBlock x:Name="PageTitle"
                   loca:Uids.Uid="TextBlock_Phylums"
                   RelativePanel.AlignLeftWithPanel="True"
                   Style="{StaticResource PageTitleTextBlockStyle}" />
        <TextBlock x:Name="PhylumDatasetText"
                   Margin="5,17,0,0"
                   loca:Uids.Uid="TextBlock_DataSetCount"
                   RelativePanel.RightOf="PageTitle"
                   Style="{StaticResource DatasetTitleStyle}" />
        <TextBlock x:Name="PhylumDatasetCountText"
                   Margin="5,17,0,0"
                   RelativePanel.RightOf="PhylumDatasetText"
                   Style="{StaticResource DatasetTitleStyle}"
                   Text="{x:Bind ViewModel.PhylumDataSetCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <CommandBar x:Name="PhylumCommandBar"
                    HorizontalAlignment="Stretch"
                    Background="Transparent"
                    DefaultLabelPosition="Right"
                    RelativePanel.LeftOf="PhylumSearchBox"
                    RelativePanel.RightOf="PhylumDatasetCountText">
            <AppBarButton x:Name="AppBarButtonDeletePhylum"
                          loca:Uids.Uid="AppBarButtonDeletePhylum"
                          Click="DeletePhylum_Click"
                          IsEnabled="{x:Bind conv:NotConverter.IsNotNull(ViewModel.PhylumSelected), Mode=OneWay}">
                <AppBarButton.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/delete.png" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton loca:Uids.Uid="AppBarButtonAddPhylum"
                          Background="{ThemeResource SystemAccentColor}"
                          Click="AddPhylum_Click"
                          Foreground="White">
                <AppBarButton.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/add.png" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="AppBarButtonAddReference"
                          loca:Uids.Uid="AppBarButtonAddReference"
                          IsCompact="True"
                          IsEnabled="{x:Bind conv:NotConverter.IsNotNull(ViewModel.PhylumSelected), Mode=OneWay}">
                <AppBarButton.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/add.png" />
                </AppBarButton.Icon>
                <AppBarButton.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem loca:Uids.Uid="MenuFlyout_Add_Reference_Expert"
                                        Click="AddReferenceExpertButton_Click"
                                        Tag="rating">
                            <MenuFlyoutItem.Icon>
                                <BitmapIcon ShowAsMonochrome="False"
                                            UriSource="/Assets/Fluent/add.png" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem loca:Uids.Uid="MenuFlyout_Add_Reference_Source"
                                        Click="AddReferenceSourceButton_Click"
                                        Tag="match">
                            <MenuFlyoutItem.Icon>
                                <BitmapIcon ShowAsMonochrome="False"
                                            UriSource="/Assets/Fluent/add.png" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem loca:Uids.Uid="MenuFlyout_Add_Reference_Author"
                                        Click="AddReferenceAuthorButton_Click"
                                        Tag="distance">
                            <MenuFlyoutItem.Icon>
                                <BitmapIcon ShowAsMonochrome="False"
                                            UriSource="/Assets/Fluent/add.png" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarButton x:Name="AppBarButtonAddComment"
                          loca:Uids.Uid="AppBarButtonAddComment"
                          Click="AddComment_Click"
                          IsEnabled="{x:Bind conv:NotConverter.IsNotNull(ViewModel.PhylumSelected), Mode=OneWay}">
                <AppBarButton.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/add.png" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="AppBarButtonSync"
                          loca:Uids.Uid="AppBarButtonSync"
                          Click="Refresh_Click"
                          IsEnabled="{x:Bind conv:NotConverter.IsNotNull(ViewModel.PhylumSelected), Mode=OneWay}">
                <AppBarButton.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/refresh.png" />
                </AppBarButton.Icon>
            </AppBarButton>
        </CommandBar>

        <AutoSuggestBox Name="PhylumSearchBox"
                        Width="200"
                        Margin="4,8,4,0"
                        loca:Uids.Uid="AutoSuggestBox_Search"
                        Loaded="PhylumSearchBox_OnLoaded"
                        QuerySubmitted="GetPhylumsByNameOrId"
                        RelativePanel.AlignRightWithPanel="True">
            <AutoSuggestBox.QueryIcon>
                <BitmapIcon ShowAsMonochrome="False"
                            UriSource="/Assets/Fluent/search.png" />
            </AutoSuggestBox.QueryIcon>
        </AutoSuggestBox>

        <ScrollViewer x:Name="PanelPhylum"
                      RelativePanel.AlignLeftWithPanel="True"
                      RelativePanel.AlignRightWithPanel="True"
                      RelativePanel.Below="PageTitle"
                      VerticalScrollBarVisibility="Auto"
                      VerticalScrollMode="Auto">
            <StackPanel Margin="-10,8,4,0">
                <StackPanel.Resources>
                    <Style TargetType="Expander">
                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                    </Style>
                </StackPanel.Resources>
                <toolkit:DataGrid x:Name="PhylumDataGrid"
                                  MaxHeight="230"
                                  Margin="0,0,20,0"
                                  VerticalAlignment="Top"
                                  x:FieldModifier="public"
                                  AlternatingRowBackground="LightGray"
                                  AutoGenerateColumns="False"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  CanUserReorderColumns="False"
                                  CanUserResizeColumns="False"
                                  ContextFlyout="{StaticResource PhylumDataContextMenu}"
                                  CurrentCellChanged="PhylumDataGrid_OnCurrentCellChanged"
                                  GridLinesVisibility="Horizontal"
                                  ItemsSource="{x:Bind ViewModel.PhylumItems}"
                                  SelectedItem="{x:Bind ViewModel.PhylumSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  SelectionMode="Single"
                                  Sorting="PhylumDataGrid_Sorting">
                    <toolkit:DataGrid.Columns>
                        <toolkit:DataGridTemplateColumn loca:Uids.Uid="DataGridTemplateColumn_PhylumId"
                                                        Tag="PhylumId">
                            <toolkit:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:Tbl06Phylum">
                                    <HyperlinkButton Margin="12,0"
                                                     BorderThickness="0"
                                                     Click="ViewPhylumHyperlinkButton_Click"
                                                     Content="{Binding PhylumId}" />
                                </DataTemplate>
                            </toolkit:DataGridTemplateColumn.CellTemplate>
                        </toolkit:DataGridTemplateColumn>
                        <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_PhylumName"
                                                    Binding="{Binding PhylumName}"
                                                    CanUserSort="True"
                                                    Tag="PhylumName" />
                        <toolkit:DataGridComboBoxColumn loca:Uids.Uid="DataGridComboBoxColumn_RegnumName"
                                                        Binding="{Binding RegnumId}"
                                                        DisplayMemberPath="RegnumName"
                                                        ItemsSource="{x:Bind ViewModel.Tbl03RegnumsAllList, Mode=OneWay}" />
                        <toolkit:DataGridCheckBoxColumn loca:Uids.Uid="DataGridCheckBoxColumn_Valid"
                                                        Binding="{Binding Valid}"
                                                        Tag="Valid" />
                        <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_ValidYear"
                                                    Binding="{Binding ValidYear}"
                                                    Tag="ValidYear" />
                        <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_Author"
                                                    Binding="{Binding Author}"
                                                    Tag="Author" />
                        <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_AuthorYear"
                                                    Binding="{Binding AuthorYear}"
                                                    Tag="AuthorYear" />
                        <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_Info"
                                                    Binding="{Binding Info}"
                                                    Tag="Info" />
                    </toolkit:DataGrid.Columns>
                </toolkit:DataGrid>

                <!--  PhylumDetailExpander  -->
                <Expander x:Name="PhylumDetailExpander"
                          Margin="{StaticResource XSmallTopBottomMargin}"
                          Visibility="Collapsed">
                    <Expander.Header>
                        <Grid>
                            <TextBlock loca:Uids.Uid="TextBlock_Phylum"
                                       Style="{ThemeResource SubtitleTextBlockStyle}" />
                            <TextBlock HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Text="{x:Bind ViewModel.PhylumSelected.PhylumName, Mode=OneWay}" />
                        </Grid>
                    </Expander.Header>

                    <RelativePanel x:Name="PhylumDetailRoot"
                                   Margin="{StaticResource SmallLeftRightMargin}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup>
                                <VisualState>
                                    <VisualState.StateTriggers>
                                        <AdaptiveTrigger MinWindowWidth="{StaticResource LargeWindowSnapPoint}" />
                                    </VisualState.StateTriggers>
                                </VisualState>
                                <VisualState>
                                    <VisualState.StateTriggers>
                                        <AdaptiveTrigger MinWindowWidth="{StaticResource MediumWindowSnapPoint}" />
                                    </VisualState.StateTriggers>
                                </VisualState>
                                <VisualState>
                                    <VisualState.StateTriggers>
                                        <AdaptiveTrigger MinWindowWidth="{StaticResource MinWindowSnapPoint}" />
                                    </VisualState.StateTriggers>
                                    <VisualState.Setters>
                                        <Setter Target="PhylumCommandBar.DefaultLabelPosition" Value="Bottom" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <CommandBar x:Name="PhylumDetailCommandBar"
                                    Margin="{StaticResource SmallLeftRightCommandBarMargin}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Top"
                                    Background="Transparent"
                                    DefaultLabelPosition="Right"
                                    RelativePanel.AlignRightWithPanel="True">
                            <AppBarButton loca:Uids.Uid="AppBarButtonSave"
                                          Background="{ThemeResource SystemBaseLowColor}"
                                          Click="SavePhylum_Click"
                                          Foreground="White"
                                          Visibility="{x:Bind ViewModel.IsInEditPhylum, Mode=OneWay}">
                                <AppBarButton.Icon>
                                    <BitmapIcon ShowAsMonochrome="False"
                                                UriSource="/Assets/Fluent/save.png" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton loca:Uids.Uid="AppBarButtonCancel"
                                          Click="CancelEditsPhylumAsync"
                                          Visibility="{x:Bind ViewModel.IsInEditPhylum, Mode=OneWay}">
                                <AppBarButton.Icon>
                                    <BitmapIcon ShowAsMonochrome="False"
                                                UriSource="/Assets/Fluent/cancel.png" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarSeparator Visibility="{x:Bind ViewModel.IsInEditPhylum, Mode=OneWay}" />
                            <AppBarButton loca:Uids.Uid="AppBarButtonBack"
                                          Background="{ThemeResource SystemAccentColor}"
                                          Click="BackPhylum_Click"
                                          Foreground="White">
                                <AppBarButton.Icon>
                                    <BitmapIcon ShowAsMonochrome="False"
                                                UriSource="/Assets/Fluent/arrowleft.png" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton loca:Uids.Uid="AppBarButtonEdit"
                                          Click="{x:Bind ViewModel.StartEditPhylum}"
                                          IsEnabled="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditPhylum), Mode=OneWay}"
                                          Visibility="{x:Bind conv:NotConverter.CollapsedIf(ViewModel.IsNewPhylum), Mode=OneWay}">
                                <AppBarButton.Icon>
                                    <BitmapIcon ShowAsMonochrome="False"
                                                UriSource="/Assets/Fluent/edit.png" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                        </CommandBar>
                        <ScrollViewer x:Name="DetailPanelPhylum"
                                      Margin="0,36,0,0"
                                      RelativePanel.AlignLeftWithPanel="True"
                                      RelativePanel.AlignRightWithPanel="True"
                                      VerticalScrollBarVisibility="Auto"
                                      VerticalScrollMode="Auto">
                            <RelativePanel Margin="4,0,0,0">
                                <TextBox x:Name="PhylumId"
                                         MinWidth="110"
                                         Margin="{StaticResource XSmallRightMargin}"
                                         loca:Uids.Uid="TextBox_PhylumId"
                                         IsReadOnly="True"
                                         RelativePanel.AlignLeftWithPanel="True"
                                         Text="{x:Bind ViewModel.PhylumSelected.PhylumId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox x:Name="PhylumName"
                                         MinWidth="150"
                                         Margin="{StaticResource XSmallRightMargin}"
                                         loca:Uids.Uid="TextBox_PhylumName"
                                         IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditPhylum), Mode=OneWay}"
                                         LostFocus="PhylumName_OnLostFocus"
                                         MaxLength="100"
                                         RelativePanel.RightOf="PhylumId"
                                         Text="{x:Bind ViewModel.PhylumSelected.PhylumName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <CheckBox x:Name="ValidCheckPhylum"
                                          Width="80"
                                          Margin="{StaticResource SmallRightCheckBoxMargin}"
                                          VerticalAlignment="Bottom"
                                          loca:Uids.Uid="CheckBox_Valid"
                                          IsChecked="{x:Bind ViewModel.PhylumSelected.Valid, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{x:Bind conv:NotConverter.NotCombo(ViewModel.IsInEditPhylum), Mode=OneWay}"
                                          RelativePanel.RightOf="PhylumName" />
                                <TextBox x:Name="ValidYearTextPhylum"
                                         Width="70"
                                         Margin="{StaticResource XSmallRightMargin}"
                                         loca:Uids.Uid="TextBox_ValidYear"
                                         winUiCommunity:TextBoxExtensions.Mask="9999"
                                         winUiCommunity:TextBoxExtensions.MaskPlaceholder=" "
                                         CornerRadius="3"
                                         IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditPhylum), Mode=OneWay}"
                                         RelativePanel.RightOf="ValidCheckPhylum"
                                         Style="{StaticResource BodyTextBoxStyle}"
                                         Text="{x:Bind ViewModel.PhylumSelected.ValidYear, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <ComboBox x:Name="RegnumCombo"
                                          MinWidth="200"
                                          Margin="{StaticResource XSmallRightComboBoxMargin}"
                                          loca:Uids.Uid="ComboBox_RegnumName"
                                          DisplayMemberPath="RegnumName"
                                          IsEnabled="{x:Bind conv:NotConverter.NotCombo(ViewModel.IsInEditPhylum), Mode=OneWay}"
                                          ItemsSource="{x:Bind ViewModel.Tbl03RegnumsAllList}"
                                          RelativePanel.RightOf="ValidYearTextPhylum"
                                          SelectedValue="{x:Bind ViewModel.PhylumSelected.RegnumId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          SelectedValuePath="RegnumId" />
                                <TextBox x:Name="AuthorTextPhylum"
                                         MinWidth="150"
                                         Margin="{StaticResource XSmallRightMargin}"
                                         HorizontalAlignment="Stretch"
                                         loca:Uids.Uid="TextBox_Author"
                                         CharacterCasing="Upper"
                                         IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditPhylum), Mode=OneWay}"
                                         MaxLength="60"
                                         RelativePanel.AlignLeftWithPanel="True"
                                         RelativePanel.Below="PhylumId"
                                         Text="{x:Bind ViewModel.PhylumSelected.Author, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox x:Name="AuthorYearTextPhylum"
                                         Width="70"
                                         Margin="{StaticResource XSmallRightMargin}"
                                         loca:Uids.Uid="TextBox_AuthorYear"
                                         winUiCommunity:TextBoxExtensions.Mask="9999"
                                         winUiCommunity:TextBoxExtensions.MaskPlaceholder=" "
                                         CornerRadius="3"
                                         IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditPhylum), Mode=OneWay}"
                                         RelativePanel.Below="ValidCheckPhylum"
                                         RelativePanel.RightOf="AuthorTextPhylum"
                                         Text="{x:Bind ViewModel.PhylumSelected.AuthorYear, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox x:Name="InfoPhylum"
                                         MinWidth="1120"
                                         Margin="{StaticResource XSmallRightMargin}"
                                         HorizontalAlignment="Stretch"
                                         loca:Uids.Uid="TextBox_Info"
                                         IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditPhylum), Mode=OneWay}"
                                         RelativePanel.AlignLeftWithPanel="True"
                                         RelativePanel.Below="AuthorTextPhylum"
                                         Text="{x:Bind ViewModel.PhylumSelected.Info, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox x:Name="SynonymPhylum"
                                         MinWidth="1120"
                                         MinHeight="75"
                                         MaxWidth="1300"
                                         MaxHeight="150"
                                         Margin="{StaticResource XSmallRightMargin}"
                                         loca:Uids.Uid="TextBox_Synonym"
                                         AcceptsReturn="True"
                                         IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditPhylum), Mode=OneWay}"
                                         RelativePanel.AlignLeftWithPanel="True"
                                         RelativePanel.Below="InfoPhylum"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         Text="{x:Bind ViewModel.PhylumSelected.Synonym, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         TextWrapping="Wrap" />
                                <TabView x:Name="TabViewLanguagePhylum"
                                         MinWidth="1120"
                                         MaxWidth="1300"
                                         Margin="{StaticResource XSmallRightMargin}"
                                         Background="LightBlue"
                                         CornerRadius="3"
                                         IsAddTabButtonVisible="False"
                                         RelativePanel.AlignLeftWithPanel="True"
                                         RelativePanel.Below="SynonymPhylum">
                                    <TabView.TabItems>
                                        <TabViewItem loca:Uids.Uid="TabViewItem_EngName"
                                                     IsClosable="False">
                                            <TextBox Margin="{StaticResource XSmallRightMargin}"
                                                     IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditPhylum), Mode=OneWay}"
                                                     MaxLength="200"
                                                     Text="{x:Bind ViewModel.PhylumSelected.EngName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </TabViewItem>
                                        <TabViewItem loca:Uids.Uid="TabViewItem_GerName"
                                                     IsClosable="False">
                                            <TextBox Margin="{StaticResource XSmallRightMargin}"
                                                     IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditPhylum), Mode=OneWay}"
                                                     MaxLength="200"
                                                     Text="{x:Bind ViewModel.PhylumSelected.GerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </TabViewItem>
                                        <TabViewItem loca:Uids.Uid="TabViewItem_FraName"
                                                     IsClosable="False">
                                            <TextBox Margin="{StaticResource XSmallRightMargin}"
                                                     IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditPhylum), Mode=OneWay}"
                                                     MaxLength="200"
                                                     Text="{x:Bind ViewModel.PhylumSelected.FraName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </TabViewItem>
                                        <TabViewItem loca:Uids.Uid="TabViewItem_SpaName"
                                                     IsClosable="False">
                                            <TextBox Margin="{StaticResource XSmallRightMargin}"
                                                     IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditPhylum), Mode=OneWay}"
                                                     MaxLength="200"
                                                     Text="{x:Bind ViewModel.PhylumSelected.PorName, Mode=TwoWay}" />
                                        </TabViewItem>
                                    </TabView.TabItems>
                                </TabView>
                                <TextBox x:Name="MemoPhylum"
                                         MinWidth="1120"
                                         MinHeight="75"
                                         MaxWidth="1300"
                                         MaxHeight="150"
                                         Margin="{StaticResource XSmallRightMargin}"
                                         loca:Uids.Uid="TextBox_Memo"
                                         AcceptsReturn="True"
                                         IsReadOnly="{x:Bind conv:NotConverter.Not(ViewModel.IsInEditPhylum), Mode=OneWay}"
