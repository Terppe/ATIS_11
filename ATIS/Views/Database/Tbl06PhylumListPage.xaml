                          IsExpanded="True"
                          Visibility="Collapsed">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="CommentsTitle"
                                       loca:Uids.Uid="TextBlock_Comments"
                                       Style="{ThemeResource PageTitleTextBlockStyle}" />
                            <TextBlock x:Name="CommentsDatasetText"
                                       Margin="5,0,0,2"
                                       loca:Uids.Uid="TextBlock_DataSetCount"
                                       Style="{StaticResource DatasetTitleStyle}" />
                            <TextBlock x:Name="CommentsDatasetCountText"
                                       Margin="5,0,0,2"
                                       Style="{StaticResource DatasetTitleStyle}"
                                       Text="{x:Bind ViewModel.CommentDataSetCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Expander.Header>
                    <RelativePanel x:Name="CommentsRoot"
                                   Margin="{StaticResource SmallLeftRightMargin}">
                        <Grid Margin="0,4,0,0">
                            <toolkit:DataGrid x:Name="CommentDataGrid"
                                              MaxHeight="230"
                                              Margin="0,0,20,0"
                                              VerticalAlignment="Top"
                                              x:FieldModifier="public"
                                              AlternatingRowBackground="LightGray"
                                              AutoGenerateColumns="False"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              CanUserReorderColumns="False"
                                              CanUserResizeColumns="False"
                                              ContextFlyout="{StaticResource CommentDataContextMenu}"
                                              GridLinesVisibility="Horizontal"
                                              ItemsSource="{x:Bind ViewModel.CommentItems, Mode=OneWay}"
                                              SelectedItem="{x:Bind ViewModel.CommentSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              SelectionMode="Single"
                                              Sorting="DataGrid_Comment_Sorting">
                                <toolkit:DataGrid.Columns>
                                    <toolkit:DataGridTemplateColumn loca:Uids.Uid="DataGridTemplateColumn_CommentId"
                                                                    Tag="CommentId">
                                        <toolkit:DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate x:DataType="models:Tbl93Comment">
                                                <HyperlinkButton Margin="12,0"
                                                                 BorderThickness="0"
                                                                 Click="ViewCommentHyperlinkButton_Click"
                                                                 Content="{Binding CommentId}" />
                                            </DataTemplate>
                                        </toolkit:DataGridTemplateColumn.CellTemplate>
                                    </toolkit:DataGridTemplateColumn>
                                    <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_Info"
                                                                Binding="{Binding Info}"
                                                                Tag="Info" />
                                </toolkit:DataGrid.Columns>
                            </toolkit:DataGrid>
                        </Grid>
                    </RelativePanel>
                </Expander>

                <!--  SubphylumsExpander  -->
                <Expander x:Name="SubphylumsExpander"
                          Margin="{StaticResource XSmallTopBottomMargin}"
                          IsExpanded="True"
                          Visibility="Collapsed">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="SubphylumsTitle"
                                       loca:Uids.Uid="TextBlock_Subphylums"
                                       Style="{ThemeResource PageTitleTextBlockStyle}" />
                            <TextBlock x:Name="SubphylumsDatasetText"
                                       Margin="5,0,0,2"
                                       loca:Uids.Uid="TextBlock_DataSetCount"
                                       Style="{StaticResource DatasetTitleStyle}" />
                            <TextBlock x:Name="SubphylumsDatasetCountText"
                                       Margin="5,0,0,2"
                                       Style="{StaticResource DatasetTitleStyle}"
                                       Text="{x:Bind ViewModel.SubphylumDataSetCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Expander.Header>
                    <Grid Margin="0,4,0,0">
                        <toolkit:DataGrid x:Name="SubphylumDataGrid"
                                          MaxHeight="230"
                                          Margin="0,0,20,0"
                                          VerticalAlignment="Top"
                                          x:FieldModifier="public"
                                          AlternatingRowBackground="LightGray"
                                          AutoGenerateColumns="False"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          CanUserReorderColumns="False"
                                          CanUserResizeColumns="False"
                                          GridLinesVisibility="Horizontal"
                                          ItemsSource="{x:Bind ViewModel.SubphylumItems, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.SubphylumSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          SelectionMode="Single"
                                          Sorting="DataGrid_Subphylum_Sorting">
                            <toolkit:DataGrid.Columns>
                                <toolkit:DataGridTemplateColumn loca:Uids.Uid="DataGridTemplateColumn_SubphylumId"
                                                                Tag="SubphylumId">
                                    <toolkit:DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="models:Tbl12Subphylum">
                                            <HyperlinkButton Margin="12,0"
                                                             BorderThickness="0"
                                                             Click="ViewSubphylumHyperlinkButton_Click"
                                                             Content="{Binding SubphylumId}" />
                                        </DataTemplate>
                                    </toolkit:DataGridTemplateColumn.CellTemplate>
                                </toolkit:DataGridTemplateColumn>
                                <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_SubphylumName"
                                                            Binding="{Binding SubphylumName}"
                                                            CanUserSort="True"
                                                            Tag="SubphylumName" />
                                <toolkit:DataGridComboBoxColumn loca:Uids.Uid="DataGridComboBoxColumn_PhylumName"
                                                                Binding="{Binding PhylumId}"
                                                                DisplayMemberPath="PhylumName"
                                                                ItemsSource="{x:Bind ViewModel.Tbl06PhylumsAllList, Mode=OneWay}" />
                                <toolkit:DataGridCheckBoxColumn loca:Uids.Uid="DataGridCheckBoxColumn_Valid"
                                                                Binding="{Binding Valid}"
                                                                Tag="Valid" />
                                <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_ValidYear"
                                                            Binding="{Binding ValidYear}"
                                                            Tag="ValidYear" />
                                <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_Author"
                                                            Binding="{Binding Author}"
                                                            Tag="Author" />
                                <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_AuthorYear"
                                                            Binding="{Binding AuthorYear}"
                                                            Tag="AuthorYear" />
                                <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_Info"
                                                            Binding="{Binding Info}"
                                                            Tag="Info" />
                            </toolkit:DataGrid.Columns>
                        </toolkit:DataGrid>
                    </Grid>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <ProgressRing x:Name="LoadingProgressRing"
                      Width="40"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                      RelativePanel.AlignHorizontalCenterWithPanel="True"
                      RelativePanel.AlignVerticalCenterWithPanel="True"
                      Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
    </RelativePanel>
</Page>
