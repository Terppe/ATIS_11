                                    Margin="{StaticResource MediumBottomMargin}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Top"
                                    Background="Transparent"
                                    DefaultLabelPosition="Right"
                                    RelativePanel.AlignRightWithPanel="True">
                            <AppBarButton x:Uid="AppBarButtonSave"
                                          Click="SavePlSpecies_Click"
                                          Visibility="{x:Bind ViewModel.IsInEdit, Mode=OneWay}">
                                <AppBarButton.Icon>
                                    <BitmapIcon ShowAsMonochrome="False"
                                                UriSource="/Assets/Fluent/save.png" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton x:Uid="AppBarButtonCancel"
                                          Click="{x:Bind ViewModel.CancelEditsAsync}"
                                          Visibility="{x:Bind ViewModel.IsInEdit, Mode=OneWay}">
                                <AppBarButton.Icon>
                                    <BitmapIcon ShowAsMonochrome="False"
                                                UriSource="/Assets/Fluent/cancel.png" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarSeparator Visibility="{x:Bind ViewModel.IsInEdit, Mode=OneWay}" />
                            <AppBarButton x:Uid="AppBarButtonBack"
                                          Click="BackPlSpecies_Click"
                                          Visibility="{x:Bind conv:NotConverter.CollapsedIf(ViewModel.IsNewPlSpecies), Mode=OneWay}">
                                <AppBarButton.Icon>
                                    <BitmapIcon ShowAsMonochrome="False"
                                                UriSource="/Assets/Fluent/arrowleft.png" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton x:Uid="AppBarButtonEdit"
                                          Click="{x:Bind ViewModel.StartEdit}"
                                          IsEnabled="{x:Bind conv:NotConverter.Not(ViewModel.IsInEdit), Mode=OneWay}">
                                <AppBarButton.Icon>
                                    <BitmapIcon ShowAsMonochrome="False"
                                                UriSource="/Assets/Fluent/edit.png" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                        </CommandBar>
