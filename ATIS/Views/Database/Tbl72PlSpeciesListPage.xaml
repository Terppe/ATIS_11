        <AutoSuggestBox Name="PlSpeciesSearchBox"
                        x:Uid="AutoSuggestBox_Search_Species"
                        Width="280"
                        Margin="4,8,4,0"
                        Loaded="PlSpeciesSearchBox_OnLoaded"
                        QuerySubmitted="GetPlSpeciesByNameOrId"
                        RelativePanel.AlignRightWithPanel="True">
            <AutoSuggestBox.QueryIcon>
                <BitmapIcon ShowAsMonochrome="False"
                            UriSource="/Assets/Fluent/search.png" />
            </AutoSuggestBox.QueryIcon>
        </AutoSuggestBox>

        <ScrollViewer x:Name="DetailPanelPlSpecies"
                      RelativePanel.AlignLeftWithPanel="True"
                      RelativePanel.AlignRightWithPanel="True"
                      RelativePanel.Below="PageTitle"
                      VerticalScrollBarVisibility="Auto"
                      VerticalScrollMode="Auto">

            <StackPanel Margin="-10,8,4,0">
                <StackPanel.Resources>
                    <Style TargetType="Expander">
                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                    </Style>
                </StackPanel.Resources>
                <toolkit:DataGrid x:Name="PlSpeciesDataGrid"
                                  MaxHeight="230"
                                  Margin="0,0,20,0"
                                  VerticalAlignment="Top"
                                  x:FieldModifier="public"
                                  AutoGenerateColumns="False"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  CanUserReorderColumns="False"
                                  CanUserResizeColumns="False"
                                  ContextFlyout="{StaticResource PlSpeciesDataContextMenu}"
                                  CurrentCellChanged="PlSpeciesDataGrid_OnCurrentCellChanged"
                                  GridLinesVisibility="Horizontal"
                                  ItemsSource="{x:Bind ViewModel.PlSpeciesItems}"
                                  SelectedItem="{x:Bind ViewModel.PlSpeciesSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  SelectionMode="Single"
                                  Sorting="PlSpeciesDataGrid_Sorting">
                    <toolkit:DataGrid.Columns>
                        <toolkit:DataGridTemplateColumn x:Uid="DataGridTemplateColumn_PlSpeciesId"
                                                        Tag="PlSpeciesId">
                            <toolkit:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:Tbl72PlSpecies">
                                    <HyperlinkButton Margin="12,0"
                                                     BorderThickness="0"
                                                     Click="ViewPlSpeciesHyperlinkButton_Click"
                                                     Content="{Binding PlSpeciesId}" />
                                </DataTemplate>
                            </toolkit:DataGridTemplateColumn.CellTemplate>
                        </toolkit:DataGridTemplateColumn>
                        <toolkit:DataGridComboBoxColumn x:Uid="DataGridComboBoxColumn_GenusName"
                                                        Binding="{Binding GenusId}"
                                                        DisplayMemberPath="GenusName"
                                                        ItemsSource="{x:Bind ViewModel.Tbl66GenussesAllList, Mode=OneWay}" />
                        <toolkit:DataGridTextColumn x:Uid="DataGridTextColumn_PlSpeciesName"
                                                    Binding="{Binding PlSpeciesName}"
                                                    CanUserSort="True"
                                                    Tag="PlSpeciesName" />
                        <toolkit:DataGridTextColumn x:Uid="DataGridTextColumn_Subspecies"
                                                    Binding="{Binding Subspecies}"
                                                    CanUserSort="True"
                                                    Tag="Subspecies" />
                        <toolkit:DataGridTextColumn x:Uid="DataGridTextColumn_Divers"
                                                    Binding="{Binding Divers}"
                                                    CanUserSort="True"
                                                    Tag="Divers" />
                        <toolkit:DataGridComboBoxColumn x:Uid="DataGridComboBoxColumn_SpeciesgroupName"
                                                        Binding="{Binding SpeciesgroupId}"
                                                        DisplayMemberPath="SpeciesgroupName"
                                                        ItemsSource="{x:Bind ViewModel.Tbl68SpeciesgroupsAllList, Mode=OneWay}" />
                        <toolkit:DataGridCheckBoxColumn x:Uid="DataGridCheckBoxColumn_Valid"
                                                        Binding="{Binding Valid}"
                                                        Tag="Valid" />
                        <toolkit:DataGridTextColumn x:Uid="DataGridTextColumn_ValidYear"
                                                    Binding="{Binding ValidYear}"
                                                    Tag="ValidYear" />
                        <toolkit:DataGridTextColumn x:Uid="DataGridTextColumn_Author"
                                                    Binding="{Binding Author}"
                                                    Tag="Author" />
                        <toolkit:DataGridTextColumn x:Uid="DataGridTextColumn_AuthorYear"
                                                    Binding="{Binding AuthorYear}"
                                                    Tag="AuthorYear" />
                        <toolkit:DataGridTextColumn x:Uid="DataGridTextColumn_Info"
                                                    Binding="{Binding Info}"
                                                    Tag="Info" />
                    </toolkit:DataGrid.Columns>
                </toolkit:DataGrid>

                <!--  This progress indicator should be hidden when the data is finished loading.  -->
                <ProgressRing x:Name="LoadingProgressRing"
                              Width="40"
                              VerticalAlignment="Center"
                              IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                              RelativePanel.AlignHorizontalCenterWithPanel="True"
                              RelativePanel.AlignVerticalCenterWithPanel="True"
                              Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

                <!--  PlSpeciesDetailExpander  -->
                <Expander x:Name="PlSpeciesDetailExpander"
                          Margin="{StaticResource SmallTopBottomMargin}"
                          Visibility="Collapsed">
                    <Expander.Header>
                        <Grid>
                            <TextBlock x:Uid="TextBlock_PlSpecies"
                                       Style="{ThemeResource SubtitleTextBlockStyle}" />
                            <StackPanel HorizontalAlignment="Right"
                                        Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Text="{x:Bind ViewModel.PlSpeciesSelected.Tbl66Genusses.GenusName, Mode=OneWay}" />
                                <TextBlock Margin="2,0,0,0"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Text="{x:Bind ViewModel.PlSpeciesSelected.PlSpeciesName, Mode=OneWay}" />
                                <TextBlock Margin="2,0,0,0"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Text="{x:Bind ViewModel.PlSpeciesSelected.Subspecies, Mode=OneWay}" />
                                <TextBlock Margin="2,0,0,0"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Text="{x:Bind ViewModel.PlSpeciesSelected.Divers, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                    </Expander.Header>
                    <RelativePanel x:Name="PlSpeciesDetailRoot"
                                   Margin="{StaticResource SmallLeftRightMargin}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup>
                                <VisualState>
                                    <VisualState.StateTriggers>
                                        <AdaptiveTrigger MinWindowWidth="{StaticResource LargeWindowSnapPoint}" />
                                    </VisualState.StateTriggers>
                                </VisualState>
                                <VisualState>
                                    <VisualState.StateTriggers>
                                        <AdaptiveTrigger MinWindowWidth="{StaticResource MediumWindowSnapPoint}" />
                                    </VisualState.StateTriggers>
                                </VisualState>
                                <VisualState>
                                    <VisualState.StateTriggers>
                                        <AdaptiveTrigger MinWindowWidth="{StaticResource MinWindowSnapPoint}" />
                                    </VisualState.StateTriggers>
                                    <VisualState.Setters>
                                        <Setter Target="PlSpeciesCommandBar.DefaultLabelPosition" Value="Bottom" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
