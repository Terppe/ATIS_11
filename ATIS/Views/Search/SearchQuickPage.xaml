    <RelativePanel x:Name="SearchRoot"
                   Margin="0,-10,0,0">
        <!--<ProgressRing IsActive="True" />-->
        <TabView IsAddTabButtonVisible="False"
                 SelectedIndex="{x:Bind ViewModel.SelectedReportTabIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
            <TabView.TabItems>
                <TabViewItem x:Uid="TabViewItem_Search"
                             IsClosable="False"
                             Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="45" />
                            <RowDefinition Height="2*" />
                        </Grid.RowDefinitions>
                        <StackPanel HorizontalAlignment="Left"
                                    Orientation="Horizontal">
                            <TextBlock x:Uid="TextBlock_DataSetCount"
                                       Margin="{StaticResource XSmallLeftTopRightBottomMargin}"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Bottom"
                                       Style="{ThemeResource DetailSubTitleStyle}" />
                            <TextBlock Width="50"
                                       Margin="{StaticResource XSmallLeftTopRightBottomMargin}"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Bottom"
                                       Style="{StaticResource BodyTextStyle}"
                                       Text="{x:Bind ViewModel.DataSetCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <AutoSuggestBox Name="SearchAutoSuggestBox"
                                            Width="200"
                                            Margin="4,8,4,0"
                                            Loaded="SearchAutoSuggestBox_OnLoaded"
                                            QuerySubmitted="GetNameByName">
                                <AutoSuggestBox.QueryIcon>
                                    <BitmapIcon ShowAsMonochrome="False"
                                                UriSource="/Assets/Fluent/search.png" />
                                </AutoSuggestBox.QueryIcon>
                            </AutoSuggestBox>

                            <AppBarButton x:Uid="AppBarButtonPdf"
                                          Click="PdfPrintListAll"
                                          ToolTipService.ToolTip="PDF">
                                <AppBarButton.Icon>
                                    <BitmapIcon ShowAsMonochrome="False"
                                                UriSource="/Assets/Fluent/pdf.png" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <CheckBox Width="80"
                                      Margin="{StaticResource SmallLeftMargin}"
                                      Content="Auswahl 1"
                                      IsChecked="True" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" />
                        <StackPanel Grid.Row="1">

                            <!--  SelectedIndex="{x:Bind ViewModel.SelectedMainTabIndex, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"  -->
