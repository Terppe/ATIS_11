<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="ATIS.Views.Search.DetailPages.Tbl21ClassDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:loc="using:WinUI3Localizer"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:search="using:ATIS.Views.Search"
      mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Views/Report/ReportResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  BUTTON-LEISTE  -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal">
            <Button Margin="50,5,10,5"
                    Command="{x:Bind ViewModel.ExportPdfCommand}"
                    Content="PDF" />

            <Button Margin="50,5,10,5"
                    HorizontalAlignment="Right"
                    Command="{x:Bind ViewModel.BackCommand}">
                <StackPanel Orientation="Horizontal"
                            Spacing="6">
                    <FontIcon Glyph="&#xE72B;" />
                    <TextBlock loc:Uids.Uid="TextBlock_Back" />
                </StackPanel>
            </Button>

            <TextBlock loc:Uids.Uid="TextBlock_Preview"
                       Style="{ThemeResource TitleTextBlockStyle}" />

            <Button HorizontalAlignment="Right"
                    Click="PrintButton_Click">
                <StackPanel Orientation="Horizontal"
                            Spacing="8">
                    <FontIcon Glyph="&#xE749;" />
                    <TextBlock loc:Uids.Uid="TextBlock_Print" />
                </StackPanel>
            </Button>

        </StackPanel>

        <!--  Breadcrumb  -->
        <ItemsRepeater Grid.Row="1"
                       ItemsSource="{x:Bind ViewModel.Breadcrumb}">
            <ItemsRepeater.Layout>
                <StackLayout Orientation="Horizontal" />
            </ItemsRepeater.Layout>

            <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="search:BreadcrumbItem">
                    <StackPanel Orientation="Horizontal"
                                Spacing="8">
                        <HyperlinkButton Command="{x:Bind NavigateCommand}"
                                         Content="{x:Bind Label}" />
                        <TextBlock Margin="0,10,0,0"
                                   Text="&gt;" />
                    </StackPanel>
                </DataTemplate>
            </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>

        <!--  SCROLLBEREICH  -->
        <ScrollViewer Grid.Row="2"
                      HorizontalAlignment="Stretch"
                      VerticalScrollMode="Enabled">

            <Grid Margin="4,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  ALLE ROWS WIE IM ALTEN WINDOW  -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <!--  0  -->
                    <RowDefinition Height="Auto" />
                    <!--  1  -->
                    <RowDefinition Height="Auto" />
                    <!--  2  -->
                    <RowDefinition Height="Auto" />
                    <!--  3  -->
                    <RowDefinition Height="Auto" />
                    <!--  4  -->
                    <RowDefinition Height="Auto" />
                    <!--  5  -->
                    <RowDefinition Height="Auto" />
                    <!--  6  -->
                    <RowDefinition Height="Auto" />
                    <!--  7  -->
                    <RowDefinition Height="Auto" />
                    <!--  8  -->
                    <RowDefinition Height="Auto" />
                    <!--  9  -->
                    <RowDefinition Height="Auto" />
                    <!--  10  -->
                    <RowDefinition Height="Auto" />
                    <!--  11  -->
                    <RowDefinition Height="Auto" />
                    <!--  12  -->
                    <RowDefinition Height="Auto" />
                    <!--  13  -->
                    <RowDefinition Height="Auto" />
                    <!--  14  -->
                    <RowDefinition Height="Auto" />
                    <!--  15  -->
                    <RowDefinition Height="Auto" />
                    <!--  16  -->
                    <RowDefinition Height="Auto" />
                    <!--  17  -->
                    <RowDefinition Height="Auto" />
                    <!--  18  -->
                    <RowDefinition Height="Auto" />
                    <!--  19  -->
                    <RowDefinition Height="Auto" />
                    <!--  20  -->
                    <RowDefinition Height="Auto" />
                    <!--  21  -->
                    <RowDefinition Height="Auto" />
                    <!--  22  -->
                </Grid.RowDefinitions>

                <!--  HEADER CLASS  -->
                <ListView Grid.Row="0"
                          Grid.Column="0"
                          Grid.ColumnSpan="2"
                          Margin="-12,0,0,0"
                          ItemTemplate="{StaticResource ReportItemTemplateHeaderClass}"
                          ItemsSource="{x:Bind ViewModel.ClassItems}" />

                <!--  HEADER TAXONOMY  -->
                <ListView Grid.Row="1"
                          Grid.Column="0"
                          Grid.ColumnSpan="2"
                          Margin="-12,0,0,0"
                          ItemTemplate="{StaticResource ReportItemTemplateHeaderTaxoNomenHeader}"
                          ItemsSource="{x:Bind ViewModel.RegnumItems}" />

                <ListView Grid.Row="2"
                          Grid.Column="0"
                          Grid.ColumnSpan="2"
                          Margin="-12,0,0,0"
                          ItemTemplate="{StaticResource ReportItemTemplateHeaderTaxoNomenHeaderBodyClass}"
                          ItemsSource="{x:Bind ViewModel.ClassItems}" />

                <!--  TAXONOMIC HIERARCHY  -->
                <TextBlock Grid.Row="3"
                           Grid.Column="0"
                           loc:Uids.Uid="TextBlock_TaxonomicHierarchy"
                           FontSize="18"
                           FontWeight="Bold" />

                <ListView Grid.Row="4"
                          Grid.Column="0"
                          Grid.ColumnSpan="2"
                          Margin="-12,0,0,0"
                          ItemTemplate="{StaticResource ReportItemTemplateHyperlinkRegnum}"
                          ItemsSource="{x:Bind ViewModel.RegnumItems}" />

                <ListView Grid.Row="5"
                          Grid.Column="0"
                          Grid.ColumnSpan="2"
                          Margin="-12,0,0,0"
                          ItemTemplate="{StaticResource ReportItemTemplateHyperlinkPhylum}"
                          ItemsSource="{x:Bind ViewModel.PhylumItems}" />

                <ListView Grid.Row="7"
                          Grid.Column="0"
                          Grid.ColumnSpan="2"
                          Margin="-12,0,0,0"
                          ItemTemplate="{StaticResource ReportItemTemplateHyperlinkSubphylum}"
                          ItemsSource="{x:Bind ViewModel.SubphylumItems}" />

                <ListView Grid.Row="10"
                          Grid.Column="0"
                          Grid.ColumnSpan="2"
                          Margin="-12,0,0,0"
                          ItemTemplate="{StaticResource ReportItemTemplateHyperlinkSuperclass}"
                          ItemsSource="{x:Bind ViewModel.SuperclassItems}" />

                <!--  CLASS DETAILS  -->
                <TextBlock Grid.Row="11"
                           Grid.Column="0"
                           Margin="40,0,0,0"
                           loc:Uids.Uid="TextBlock_Class" />

                <StackPanel Grid.Row="11"
                            Grid.Column="1"
                            Orientation="Horizontal">
                    <TextBlock Text="{x:Bind ViewModel.ClassSelected.ClassName}" />
                    <TextBlock Margin="2,0,0,0"
                               Text="{x:Bind ViewModel.ClassSelected.Author}" />
                    <TextBlock Margin="2,0,0,0"
                               Text="{x:Bind ViewModel.ClassSelected.AuthorYear}" />
                    <TextBlock Margin="2,0,0,0"
                               Text="{x:Bind ViewModel.ClassSelected.EngName}" />
                    <TextBlock Margin="2,0,0,0"
                               Text="{x:Bind ViewModel.ClassSelected.GerName}" />
                    <TextBlock Margin="2,0,0,0"
                               Text="{x:Bind ViewModel.ClassSelected.FraName}" />
                    <TextBlock Margin="2,0,0,0"
                               Text="{x:Bind ViewModel.ClassSelected.PorName}" />
                </StackPanel>

                <!--  DIRECT CHILDREN  -->
                <TextBlock Grid.Row="12"
                           Grid.Column="1"
                           Margin="0,5,0,10"
                           loc:Uids.Uid="TextBlock_DirectChildren"
                           FontWeight="Bold" />

                <ListView Grid.Row="13"
                          Grid.Column="0"
                          Grid.ColumnSpan="2"
                          Margin="-12,0,0,0"
                          ItemsSource="{x:Bind ViewModel.SubclassItems}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="260" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Margin="48,0,0,0"
                                               loc:Uids.Uid="TextBlock_Subclass" />
                                </StackPanel>

                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal">
                                    <TextBlock Text="{Binding SubclassName}" />
                                    <TextBlock Margin="2,0,0,0"
                                               Text="{Binding EngName}" />
                                    <TextBlock Margin="2,0,0,0"
                                               Text="{Binding GerName}" />
                                    <TextBlock Margin="2,0,0,0"
                                               Text="{Binding FraName}" />
                                    <TextBlock Margin="2,0,0,0"
                                               Text="{Binding PorName}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!--  REFERENCES  -->
                <TextBlock Grid.Row="14"
                           Grid.Column="0"
                           loc:Uids.Uid="TextBlock_References"
                           FontSize="18"
                           FontWeight="Bold" />

                <TextBlock Grid.Row="15"
                           Grid.Column="0"
                           Margin="8,0,0,10"
                           loc:Uids.Uid="TextBlock_Experts"
                           FontWeight="Bold" />

                <ListView Grid.Row="16"
                          Grid.Column="0"
                          Grid.ColumnSpan="2"
                          Margin="-12,-12,10,10"
                          ItemTemplate="{StaticResource ReportItemTemplateTbl90RefExpert}"
                          ItemsSource="{x:Bind ViewModel.ReferenceExpertItems}" />

                <TextBlock Grid.Row="17"
                           Grid.Column="0"
                           Margin="8,0,0,10"
                           loc:Uids.Uid="TextBlock_OtherSources"
                           FontWeight="Bold" />

                <ListView Grid.Row="18"
                          Grid.Column="0"
                          Grid.ColumnSpan="2"
                          Margin="-12,-12,10,10"
                          ItemTemplate="{StaticResource ReportItemTemplateTbl90RefSource}"
                          ItemsSource="{x:Bind ViewModel.ReferenceSourceItems}" />

                <TextBlock Grid.Row="19"
                           Grid.Column="0"
                           Margin="8,0,0,10"
                           loc:Uids.Uid="TextBlock_Publications"
                           FontWeight="Bold" />

                <ListView Grid.Row="20"
                          Grid.Column="0"
                          Grid.ColumnSpan="2"
                          Margin="-12,-12,10,10"
                          ItemTemplate="{StaticResource ReportItemTemplateTbl90RefAuthor}"
                          ItemsSource="{x:Bind ViewModel.ReferenceAuthorItems}" />

                <!--  COMMENTS  -->
                <TextBlock Grid.Row="21"
                           Grid.Column="0"
                           Margin="0,0,0,10"
                           loc:Uids.Uid="TextBlock_Comments"
                           FontSize="18"
                           FontWeight="Bold" />

                <ListView Grid.Row="22"
                          Grid.Column="0"
                          Grid.ColumnSpan="2"
                          Margin="-12,-12,10,10"
                          ItemTemplate="{StaticResource ReportItemTemplateTbl93Comment}"
                          ItemsSource="{x:Bind ViewModel.CommentItems}" />

            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
