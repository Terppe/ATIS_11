<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ATIS.Views.Search.DetailPages.Tbl06PhylumDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="16">

        <Button Content="← Zurück" Click="Back_Click"/>

        <StackPanel Spacing="8">
            <TextBlock Text="DetailPage" Style="{ThemeResource TitleTextBlockStyle}" />
            <TextBlock Text="Id:" />
            <TextBlock x:Name="DetailIdTextBlock" />
            <TextBlock Text="Titel:" />
            <TextBlock x:Name="DetailTitleTextBlock" />
            <TextBlock Text="Info:" />
            <TextBlock x:Name="DetailSubtitleTextBlock" />
        </StackPanel>

        <ProgressRing
            IsActive="{Binding IsBusy}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"/>

    </Grid>
</Page>
