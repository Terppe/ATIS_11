<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="ATIS.Views.Search.DetailPages.Tbl12SubphylumDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:components="using:ATIS.DesignSystem.Components"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:loc="using:WinUI3Localizer"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:search="using:ATIS.Views.Search"
      mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Views/Report/ReportResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  BUTTON-LEISTE  -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal">

            <TextBlock Margin="20,0,0,5"
                       loc:Uids.Uid="TextBlock_Preview"
                       Style="{ThemeResource TitleTextBlockStyle}" />

            <Button Margin="20,5,0,5"
                    HorizontalAlignment="Right"
                    Command="{x:Bind ViewModel.BackCommand}">
                <StackPanel Orientation="Horizontal"
                            Spacing="6">
                    <FontIcon Glyph="&#xE72B;" />
                    <TextBlock loc:Uids.Uid="TextBlock_Back" />
                </StackPanel>
            </Button>

            <Button Margin="10,5,0,5"
                    HorizontalAlignment="Right"
                    Command="{x:Bind ViewModel.ExportPdfCommand}">
                <StackPanel Orientation="Horizontal"
                            Spacing="6">
                    <FontIcon Glyph="&#xE749;" />
                    <TextBlock loc:Uids.Uid="TextBlock_Pdf" />
                </StackPanel>
            </Button>

            <Button Margin="10,5,0,5"
                    HorizontalAlignment="Right"
                    Click="PrintButton_Click">
                <StackPanel Orientation="Horizontal"
                            Spacing="6">
                    <FontIcon Glyph="&#xE749;" />
                    <TextBlock loc:Uids.Uid="TextBlock_Print" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!--  Breadcrumb  -->
        <ItemsControl Grid.Row="1"
                      HorizontalAlignment="Stretch"
                      ItemsSource="{x:Bind ViewModel.BreadcrumbReversed}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="search:BreadcrumbItem">
                    <StackPanel Orientation="Horizontal"
                                Spacing="8">
                        <HyperlinkButton Click="Breadcrumb_Click"
                                         Content="{x:Bind Label}" />
                        <TextBlock Margin="0,6,0,0"
                                   Text="&lt;" />
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!--  SCROLLBEREICH  -->
        <ScrollViewer Grid.Row="2"
                      HorizontalAlignment="Stretch"
                      VerticalScrollMode="Enabled">

            <Grid Margin="4,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  ALLE ROWS WIE IM ALTEN WINDOW  -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  HEADER CLASS  -->
                <ListView Grid.Row="0"
                          Grid.Column="0"
                          Grid.ColumnSpan="2"
                          Margin="-15,0,0,0"
                          ItemTemplate="{StaticResource ReportItemTemplateHeaderSubphylum}"
                          ItemsSource="{x:Bind ViewModel.SubphylumItems}" />

                <!--  HEADER TAXONOMY  -->
                <ListView Grid.Row="1"
                          Grid.Column="0"
                          Grid.ColumnSpan="2"
                          Margin="-15,0,0,0"
                          ItemTemplate="{StaticResource ReportItemTemplateHeaderTaxoNomenHeader}"
                          ItemsSource="{x:Bind ViewModel.RegnumItems}" />

                <ListView Grid.Row="2"
                          Grid.Column="0"
                          Grid.ColumnSpan="2"
                          Margin="-15,0,0,0"
                          ItemTemplate="{StaticResource ReportItemTemplateHeaderTaxoNomenHeaderBodySubphylum}"
                          ItemsSource="{x:Bind ViewModel.SubphylumItems}" />

                <!--  TAXONOMIC HIERARCHY  -->
                <TextBlock Grid.Row="3"
                           Grid.Column="0"
                           loc:Uids.Uid="TextBlock_TaxonomicHierarchy"
                           FontSize="18"
                           FontWeight="Bold" />

                <ListView Grid.Row="4"
                          Grid.Column="0"
                          Grid.ColumnSpan="2"
                          Margin="0"
                          ItemTemplate="{StaticResource ReportItemTemplateHyperlinkRegnum}"
                          ItemsSource="{x:Bind ViewModel.RegnumItems}"
                          Style="{StaticResource AtisListViewStyleCompactTaxo}" />

                <ListView Grid.Row="5"
                          Grid.Column="0"
                          Grid.ColumnSpan="2"
                          Margin="0"
                          ItemTemplate="{StaticResource ReportItemTemplateHyperlinkPhylum}"
                          ItemsSource="{x:Bind ViewModel.PhylumItems}"
                          Style="{StaticResource AtisListViewStyleCompactTaxo}" />

                <!--  CLASS DETAILS  -->
                <ListView Grid.Row="7"
                          Grid.Column="0"
                          Grid.ColumnSpan="2"
                          Margin="0"
                          ItemTemplate="{StaticResource ReportItemTemplateHyperlinkSubphylum}"
                          ItemsSource="{x:Bind ViewModel.SubphylumItems}"
                          Style="{StaticResource AtisListViewStyleCompactTaxo}" />


                <!--  DIRECT CHILDREN  -->
                <TextBlock Grid.Row="11"
                           Grid.Column="1"
                           Margin="0,5,0,5"
                           loc:Uids.Uid="TextBlock_DirectChildren"
                           FontWeight="Bold"
                           Visibility="{x:Bind ViewModel.HasDirectChildren, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                <ListView Grid.Row="12"
                          Grid.Column="0"
                          Grid.ColumnSpan="2"
                          Margin="0"
                          ItemTemplate="{StaticResource ReportItemTemplateHyperlinkSuperclass}"
                          ItemsSource="{x:Bind ViewModel.SuperclassItems}"
                          Style="{StaticResource AtisListViewStyleCompactTaxo}" />

                <!--  REFERENCES  -->
                <TextBlock Grid.Row="14"
                           Grid.Column="0"
                           loc:Uids.Uid="TextBlock_References"
                           FontSize="18"
                           FontWeight="Bold" />

                <TextBlock Grid.Row="15"
                           Grid.Column="0"
                           Margin="8,0,0,10"
                           loc:Uids.Uid="TextBlock_Experts"
                           FontWeight="Bold" />

                <ListView Grid.Row="16"
                          Grid.Column="0"
                          Grid.ColumnSpan="2"
                          Margin="-12,-12,10,10"
                          ItemTemplate="{StaticResource ReportItemTemplateTbl90RefExpert}"
                          ItemsSource="{x:Bind ViewModel.ReferenceExpertItems}" />

                <TextBlock Grid.Row="17"
                           Grid.Column="0"
                           Margin="8,0,0,10"
                           loc:Uids.Uid="TextBlock_OtherSources"
                           FontWeight="Bold" />

                <ListView Grid.Row="18"
                          Grid.Column="0"
                          Grid.ColumnSpan="2"
                          Margin="-12,-12,10,10"
                          ItemTemplate="{StaticResource ReportItemTemplateTbl90RefSource}"
                          ItemsSource="{x:Bind ViewModel.ReferenceSourceItems}" />

                <TextBlock Grid.Row="19"
                           Grid.Column="0"
                           Margin="8,0,0,10"
                           loc:Uids.Uid="TextBlock_Publications"
                           FontWeight="Bold" />

                <ListView Grid.Row="20"
                          Grid.Column="0"
                          Grid.ColumnSpan="2"
                          Margin="-12,-12,10,10"
                          ItemTemplate="{StaticResource ReportItemTemplateTbl90RefAuthor}"
                          ItemsSource="{x:Bind ViewModel.ReferenceAuthorItems}" />

                <!--  COMMENTS  -->
                <TextBlock Grid.Row="21"
                           Grid.Column="0"
                           Margin="0,0,0,10"
                           loc:Uids.Uid="TextBlock_Comments"
                           FontSize="18"
                           FontWeight="Bold" />

                <ListView Grid.Row="22"
                          Grid.Column="0"
                          Grid.ColumnSpan="2"
                          Margin="-12,-12,10,10"
                          ItemTemplate="{StaticResource ReportItemTemplateTbl93Comment}"
                          ItemsSource="{x:Bind ViewModel.CommentItems}" />

            </Grid>
        </ScrollViewer>
        <!--  2. 🔥 Modernes Lade Overlay  -->
        <components:LoadingOverlayControl Grid.Row="0"
                                          Grid.RowSpan="3"
                                          IsLoading="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

    </Grid>
</Page>
