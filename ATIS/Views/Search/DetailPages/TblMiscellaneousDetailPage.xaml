<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ATIS.Views.Search.DetailPages.TblMiscellaneousDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:WinUI3Localizer">

    <Grid
        Padding="12"
        RowDefinitions="Auto,Auto,*"
        RowSpacing="8">

        <!--  BUTTON-LEISTE  -->
        <StackPanel
            Grid.Row="0"
            Orientation="Horizontal"
            Spacing="10">

            <TextBlock loc:Uids.Uid="TextBlock_Preview" Style="{ThemeResource TitleTextBlockStyle}" />

            <Button Click="BackButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72B;" />
                    <TextBlock loc:Uids.Uid="TextBlock_Back" />
                </StackPanel>
            </Button>
            <Button
                x:Name="ExportPdfButton"
                Click="ExportPdfButton_Click"
                IsEnabled="False">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE749;" />
                    <TextBlock loc:Uids.Uid="TextBlock_Pdf" />
                </StackPanel>
            </Button>
        </StackPanel>

        <ProgressRing
            x:Name="LoadingRing"
            Grid.Row="1"
            IsActive="False"
            Visibility="Collapsed" />

        <!--  SCROLLBEREICH  -->
        <ScrollViewer
            Grid.Row="2"
            HorizontalAlignment="Stretch"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollMode="Enabled">

            <Grid
                Margin="4,8,0,0"
                ColumnDefinitions="160,*"
                ColumnSpacing="8"
                RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                RowSpacing="8">

                <Grid.Resources>
                    <Style x:Key="DetailValueStyle" TargetType="TextBlock">
                        <Setter Property="TextWrapping" Value="Wrap" />
                    </Style>
                </Grid.Resources>

                <TextBlock
                    loc:Uids.Uid="TextBlock_Miscellaneous"
                    FontSize="18"
                    FontWeight="Bold" />
                <TextBlock
                    Grid.Column="1"
                    Style="{StaticResource DetailValueStyle}"
                    Text="{Binding MiscellaneousName}" />

                <TextBlock Grid.Row="1" loc:Uids.Uid="TextBlock_CountId" />
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="1"
                    Text="{Binding CountId}" />

                <TextBlock Grid.Row="2" loc:Uids.Uid="TextBlock_LastUpdated" />
                <TextBlock
                    Grid.Row="2"
                    Grid.Column="1"
                    Text="{Binding UpdaterDate}" />

                <TextBlock Grid.Row="3" Text="ID" />
                <TextBlock
                    Grid.Row="3"
                    Grid.Column="1"
                    Text="{Binding MiscellaneousId}" />

                <TextBlock
                    Grid.Row="4"
                    VerticalAlignment="Center"
                    loc:Uids.Uid="TextBlock_Valid_Year" />
                <StackPanel
                    Grid.Row="4"
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8">
                    <CheckBox
                        IsChecked="{Binding Valid, Mode=OneWay}"
                        IsEnabled="False"
                        IsThreeState="True" />
                    <TextBlock VerticalAlignment="Center" Text="{Binding ValidYear}" />
                </StackPanel>

                <TextBlock Grid.Row="5" loc:Uids.Uid="TextBlock_ShortInfo" />
                <TextBlock
                    Grid.Row="5"
                    Grid.Column="1"
                    Text="{Binding ShortInfo}" />

                <TextBlock Grid.Row="6" loc:Uids.Uid="TextBlock_Thema1" />
                <TextBlock
                    Grid.Row="6"
                    Grid.Column="1"
                    Style="{StaticResource DetailValueStyle}"
                    Text="{Binding Thema1}" />

                <TextBlock Grid.Row="7" loc:Uids.Uid="TextBlock_Thema2" />
                <TextBlock
                    Grid.Row="7"
                    Grid.Column="1"
                    Style="{StaticResource DetailValueStyle}"
                    Text="{Binding Thema2}" />

                <TextBlock Grid.Row="8" loc:Uids.Uid="TextBlock_Info" />
                <TextBlock
                    Grid.Row="8"
                    Grid.Column="1"
                    Style="{StaticResource DetailValueStyle}"
                    Text="{Binding Info}" />

                <TextBlock Grid.Row="9" loc:Uids.Uid="TextBlock_Memo" />
                <TextBlock
                    Grid.Row="9"
                    Grid.Column="1"
                    Style="{StaticResource DetailValueStyle}"
                    Text="{Binding Memo}" />
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
