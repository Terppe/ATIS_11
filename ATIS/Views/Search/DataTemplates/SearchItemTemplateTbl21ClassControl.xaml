<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="ATIS.Views.Search.DataTemplates.SearchItemTemplateTbl21ClassControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Row="0"
                    Grid.Column="0"
                    Orientation="Horizontal">
            <Ellipse Width="16"
                     Height="16"
                     Margin="3"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Fill="{ThemeResource SystemControlBackgroundBaseMediumBrush}" />
            <TextBlock Width="50"
                       Style="{StaticResource AtisSubtitleTextStyle}"
                       Text="{Binding ClassId}" />
            <CheckBox Width="80"
                      Content="Valid"
                      IsChecked="{Binding Valid}" />
            <TextBlock Style="{StaticResource AtisSubtitleTextStyle}"
                       Text="{Binding ClassName}" />
            <TextBlock Style="{StaticResource AtisSubtitleTextStyle}"
                       Text="{Binding Author}" />
            <TextBlock Style="{StaticResource AtisSubtitleTextStyle}"
                       Text="{Binding AuthorYear}" />
            <TextBlock Style="{StaticResource AtisSubtitleTextStyle}"
                       Text="{Binding EngName}" />
            <TextBlock Style="{StaticResource AtisSubtitleTextStyle}"
                       Text="{Binding GerName}" />
            <TextBlock Style="{StaticResource AtisSubtitleTextStyle}"
                       Text="{Binding FraName}" />
            <TextBlock Style="{StaticResource AtisSubtitleTextStyle}"
                       Text="{Binding PorName}" />
        </StackPanel>
    </Grid>
</UserControl>
