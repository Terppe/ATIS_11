<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="ATIS.Views.Search.DataTemplates.SearchItemTemplateTbl06PhylumControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Row="0"
                    Grid.Column="0"
                    Orientation="Horizontal">
            <Ellipse Width="16"
                     Height="16"
                     Margin="3"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Fill="{ThemeResource SystemControlBackgroundBaseMediumBrush}" />
            <TextBlock Width="50"
                       Style="{StaticResource ListTitleStyle}"
                       Text="{Binding Item.PhylumId}" />
            <CheckBox Width="80"
                      Margin="{StaticResource SmallLeftMargin}"
                      Content="Valid"
                      IsChecked="{Binding Item.Valid}" />
            <TextBlock Style="{StaticResource ListSubTitleStyle}"
                       Text="{Binding Item.PhylumName}" />
            <TextBlock Style="{StaticResource ListSubTitleStyle}"
                       Text="{Binding Item.Author}" />
            <TextBlock Style="{StaticResource ListSubTitleStyle}"
                       Text="{Binding Item.AuthorYear}" />
            <TextBlock Style="{StaticResource ListSubTitleStyle}"
                       Text="{Binding Item.EngName}" />
            <TextBlock Style="{StaticResource ListSubTitleStyle}"
                       Text="{Binding Item.GerName}" />
            <TextBlock Style="{StaticResource ListSubTitleStyle}"
                       Text="{Binding Item.FraName}" />
            <TextBlock Style="{StaticResource ListSubTitleStyle}"
                       Text="{Binding Item.PorName}" />
        </StackPanel>
    </Grid>
</UserControl>
