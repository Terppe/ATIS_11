<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="ATIS.Views.Search.SearchPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:models="using:ATIS.Models"
      xmlns:search="using:ATIS.Views.Search">

    <Page.Resources>

        <DataTemplate x:Key="RegnumTemplate" x:DataType="models:Tbl03Regnum">
            <StackPanel Spacing="8">
                <TextBlock Text="{x:Bind RegnumId}" />
                <TextBlock Text="{x:Bind RegnumName}" />
                <TextBlock Text="{x:Bind Subregnum}" />
                <TextBlock Text="{x:Bind Author}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="PhylumTemplate" x:DataType="models:Tbl06Phylum">
            <StackPanel Spacing="8">
                <TextBlock Text="{x:Bind PhylumId}" />
                <TextBlock Text="{x:Bind PhylumName}" />
                <TextBlock Text="{x:Bind Author}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="SubphylumTemplate" x:DataType="models:Tbl12Subphylum">
            <StackPanel Spacing="8">
                <TextBlock Text="{x:Bind SubphylumId}" />
                <TextBlock Text="{x:Bind SubphylumName}" />
                <TextBlock Text="{x:Bind Author}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="SuperclassTemplate" x:DataType="models:Tbl18Superclass">
            <StackPanel Spacing="8">
                <TextBlock Text="{x:Bind SuperclassId}" />
                <TextBlock Text="{x:Bind SuperclassName}" />
                <TextBlock Text="{x:Bind Author}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ClassTemplate" x:DataType="models:Tbl21Class">
            <StackPanel Spacing="8">
                <TextBlock Text="{x:Bind ClassId}" />
                <TextBlock Text="{x:Bind ClassName}" />
                <TextBlock Text="{x:Bind Author}" />
            </StackPanel>
        </DataTemplate>



        <DataTemplate x:Key="SpeciesTemplate" x:DataType="models:Tbl75Species">
            <StackPanel Spacing="8">
                <TextBlock Text="{x:Bind SpeciesId}" />
                <TextBlock Text="{x:Bind Subspecies}" />
                <TextBlock Text="{x:Bind SpeciesName}" />
                <TextBlock Text="{x:Bind Divers}" />
                <TextBlock Text="{x:Bind Author}" />
            </StackPanel>
        </DataTemplate>

        <search:SearchTemplateSelector x:Key="SearchSelector"
                                       RegnumTemplate="{StaticResource RegnumTemplate}"
                                       PhylumTemplate="{StaticResource PhylumTemplate}"
                                       SubphylumTemplate="{StaticResource SubphylumTemplate}"
                                       SuperclassTemplate="{StaticResource SuperclassTemplate}"
                                       ClassTemplate="{StaticResource ClassTemplate}"

                                       SpeciesTemplate="{StaticResource SpeciesTemplate}" />

    </Page.Resources>

    <Grid Padding="12"
          RowDefinitions="Auto,*">

        <StackPanel Padding="8"
                    Orientation="Horizontal">

            <!--  ComboBox: Tabellenwahl  -->
            <ComboBox x:Name="TableCombo"
                      ItemsSource="{x:Bind ViewModel.Tables}"
                      SelectedItem="{x:Bind ViewModel.SelectedTable, Mode=TwoWay}"
                      SelectionChanged="OnTableSelectionChanged" />

            <!--  AutoSuggestBox: Suche  -->
            <AutoSuggestBox x:Name="SearchBox"
                            Width="200"
                            QuerySubmitted="OnSearchQuerySubmitted"
                            Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}" />
        </StackPanel>

        <!--  Ergebnisliste  -->
        <ListView x:Name="ResultList"
                  Grid.Row="1"
                  ItemsSource="{x:Bind ViewModel.Results}"
                  ItemTemplateSelector="{StaticResource SearchSelector}"
                  SelectionChanged="OnRowSelected" />

    </Grid>
</Page>
