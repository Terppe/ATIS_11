    <Page.Resources>

        <DataTemplate x:Key="RegnumTemplate"
                      x:DataType="models:Tbl03Regnum">
            <StackPanel Padding="8"
                        Spacing="2">

                <!--  Zeile 1  -->
                <StackPanel Orientation="Horizontal"
                            Spacing="6">
                    <TextBlock FontSize="16"
                               FontWeight="SemiBold"
                               Text="{x:Bind RegnumName}" />
                    <TextBlock FontSize="16"
                               FontWeight="SemiBold"
                               Text="{x:Bind Subregnum}" />
                </StackPanel>

                <!--  Zeile 2  -->
                <TextBlock Foreground="Gray"
                           Opacity="0.85">
                    <Run Text="ID: " />
                    <Run Text="{x:Bind RegnumId}" />
                    <Run Text=" - " />
                    <Run Text="{x:Bind Author}" />
                </TextBlock>
            </StackPanel>
        </DataTemplate>

