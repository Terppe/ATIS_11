    <Grid Padding="12"
          RowDefinitions="Auto,*">

        <StackPanel Padding="8"
                    Orientation="Horizontal">

            <!--  ComboBox: Tabellenwahl  -->
            <ComboBox x:Name="TableCombo"
                      Width="150"
                      ItemsSource="{x:Bind ViewModel.Tables}"
                      SelectedItem="{x:Bind ViewModel.SelectedTable, Mode=TwoWay}"
                      SelectionChanged="OnTableSelectionChanged" />

            <!--  AutoSuggestBox: Suche  -->
            <AutoSuggestBox x:Name="SearchBox"
                            Width="150" Margin="25,0,0,0"
                            QuerySubmitted="OnSearchQuerySubmitted"
                            Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}" />
        </StackPanel>

        <!--  Ergebnisliste  -->
        <ListView x:Name="ResultList"
                  Grid.Row="1"
                  ItemTemplateSelector="{StaticResource SearchSelector}"
                  ItemsSource="{x:Bind ViewModel.Results}"
                  SelectionChanged="OnRowSelected" />
    </Grid>
