<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="ATIS.Views.Search.SearchPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:models="using:ATIS.Models"
      xmlns:search="using:ATIS.Views.Search"
      NavigationCacheMode="Required">

    <Page.Resources>

        <DataTemplate x:Key="RegnumTemplate"
                      x:DataType="models:Tbl03Regnum">
            <StackPanel Spacing="8">
                <TextBlock Text="{x:Bind RegnumId}" />
                <TextBlock Text="{x:Bind RegnumName}" />
                <TextBlock Text="{x:Bind Subregnum}" />
                <TextBlock Text="{x:Bind Author}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="PhylumTemplate"
                      x:DataType="models:Tbl06Phylum">
            <StackPanel Spacing="8">
                <TextBlock Text="{x:Bind PhylumId}" />
                <TextBlock Text="{x:Bind PhylumName}" />
                <TextBlock Text="{x:Bind Author}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="SubphylumTemplate"
                      x:DataType="models:Tbl12Subphylum">
            <StackPanel Spacing="8">
                <TextBlock Text="{x:Bind SubphylumId}" />
                <TextBlock Text="{x:Bind SubphylumName}" />
                <TextBlock Text="{x:Bind Author}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="SuperclassTemplate"
                      x:DataType="models:Tbl18Superclass">
            <StackPanel Spacing="8">
                <TextBlock Text="{x:Bind SuperclassId}" />
                <TextBlock Text="{x:Bind SuperclassName}" />
                <TextBlock Text="{x:Bind Author}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ClassTemplate"
                      x:DataType="models:Tbl21Class">
            <StackPanel Spacing="8">
                <TextBlock Text="{x:Bind ClassId}" />
                <TextBlock Text="{x:Bind ClassName}" />
                <TextBlock Text="{x:Bind Author}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="SubclassTemplate"
                      x:DataType="models:Tbl24Subclass">
            <StackPanel Spacing="8">
                <TextBlock Text="{x:Bind SubclassId}" />
                <TextBlock Text="{x:Bind SubclassName}" />
                <TextBlock Text="{x:Bind Author}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="InfraclassTemplate"
                      x:DataType="models:Tbl27Infraclass">
            <StackPanel Spacing="8">
                <TextBlock Text="{x:Bind InfraclassId}" />
                <TextBlock Text="{x:Bind InfraclassName}" />
                <TextBlock Text="{x:Bind Author}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="LegioTemplate"
                      x:DataType="models:Tbl30Legio">
            <StackPanel Spacing="8">
                <TextBlock Text="{x:Bind LegioId}" />
                <TextBlock Text="{x:Bind LegioName}" />
                <TextBlock Text="{x:Bind Author}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="OrdoTemplate"
                      x:DataType="models:Tbl33Ordo">
            <StackPanel Spacing="8">
                <TextBlock Text="{x:Bind OrdoId}" />
                <TextBlock Text="{x:Bind OrdoName}" />
                <TextBlock Text="{x:Bind Author}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="SubordoTemplate"
                      x:DataType="models:Tbl36Subordo">
            <StackPanel Spacing="8">
                <TextBlock Text="{x:Bind SubordoId}" />
                <TextBlock Text="{x:Bind SubordoName}" />
                <TextBlock Text="{x:Bind Author}" />
            </StackPanel>
        </DataTemplate>

        <!--<DataTemplate x:Key="SpeciesTemplate"
        x:DataType="models:Tbl75Species">
        <StackPanel Spacing="8">
        <TextBlock Text="{x:Bind SpeciesId}" />
        <TextBlock Text="{x:Bind Subspecies}" />
        <TextBlock Text="{x:Bind SpeciesName}" />
        <TextBlock Text="{x:Bind Divers}" />
        <TextBlock Text="{x:Bind Author}" />
        </StackPanel>
        </DataTemplate>-->

        <search:SearchTemplateSelector x:Key="SearchSelector"
                                       RegnumTemplate="{StaticResource RegnumTemplate}"
                                       PhylumTemplate="{StaticResource PhylumTemplate}"
                                       SubphylumTemplate="{StaticResource SubphylumTemplate}"
                                       SuperclassTemplate="{StaticResource SuperclassTemplate}" 
                                       ClassTemplate="{StaticResource ClassTemplate}"
                                       SubclassTemplate="{StaticResource SubclassTemplate}"
                                       InfraclassTemplate="{StaticResource InfraclassTemplate}"
                                       LegioTemplate="{StaticResource LegioTemplate}"
                                       OrdoTemplate="{StaticResource OrdoTemplate}"
                                       SubordoTemplate="{StaticResource SubordoTemplate}"
          />
    </Page.Resources>

    <Grid Padding="12"
          RowDefinitions="Auto,*">

        <StackPanel Padding="8"
                    Orientation="Horizontal">

            <!--  ComboBox: Tabellenwahl  -->
            <ComboBox x:Name="TableCombo"
                      Width="150"
                      ItemsSource="{x:Bind ViewModel.Tables}"
                      SelectedItem="{x:Bind ViewModel.SelectedTable, Mode=TwoWay}"
                      SelectionChanged="OnTableSelectionChanged" />

            <!--  AutoSuggestBox: Suche  -->
            <AutoSuggestBox x:Name="SearchBox"
                            Width="150"
                            QuerySubmitted="OnSearchQuerySubmitted"
                            Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}" />
        </StackPanel>

        <!--  Ergebnisliste  -->
        <ListView x:Name="ResultList"
                  Grid.Row="1"
                  ItemTemplateSelector="{StaticResource SearchSelector}"
                  ItemsSource="{x:Bind ViewModel.Results}"
                  SelectionChanged="OnRowSelected" />

    </Grid>
</Page>
