<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="ATIS.Views.Modules.Tbl21Class.Tbl21ClassPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:components="using:ATIS.DesignSystem.Components"
      xmlns:layout="using:ATIS.DesignSystem.Layout"
      xmlns:loc="using:WinUI3Localizer"
      xmlns:tbl21Class="using:ATIS.Views.Modules.Tbl21Class"
      xmlns:tbl24Subclass="using:ATIS.Views.Modules.Tbl24Subclass"
      xmlns:tbl90Reference="using:ATIS.Views.Modules.Tbl90Reference"
      xmlns:tbl93Comment="using:ATIS.Views.Modules.Tbl93Comment"
      x:Name="RootPage">

    <!--  Tbl21ClassPage Skriptdatum:  26.08.2026   18:32  -->

    <Grid x:Name="RootGrid">
        <ScrollViewer VerticalScrollBarVisibility="Visible">

            <layout:BaseBossPageLayout>

                <!--  HEADER LEFT  -->
                <layout:BaseBossPageLayout.Header>
                    <StackPanel Margin="8,0,0,8"
                                Orientation="Horizontal"
                                Spacing="10">

                        <TextBlock Margin="0,4,0,0"
                                   loc:Uids.Uid="TextBlock_Classes"
                                   Style="{StaticResource AtisSectionTitleTextStyle}" />

                        <TextBlock Margin="0,12,0,0"
                                   loc:Uids.Uid="TextBlock_DataSetCount"
                                   Style="{StaticResource AtisBodyTextStyle}" />

                        <TextBlock Margin="0,12,0,0"
                                   Style="{StaticResource AtisBodyTextStyle}"
                                   Text="{Binding DataSetCount}" />
                    </StackPanel>
                </layout:BaseBossPageLayout.Header>

                <!--  APPBAR RIGHT  -->
                <layout:BaseBossPageLayout.AppBar>
                    <Grid ColumnSpacing="8">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Margin="8"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">

                            <Button Margin="5,0,5,0"
                                    Command="{Binding NewCommand}"
                                    IsEnabled="{Binding IsEditMode, Converter={StaticResource InverseBoolConverter}}"
                                    Style="{StaticResource AtisPrimaryButton}">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="6">
                                    <FontIcon Glyph="&#xE710;" />
                                    <TextBlock loc:Uids.Uid="TextBlock_Add" />
                                </StackPanel>
                            </Button>

                            <Button Margin="5,0,5,0"
                                    Command="{Binding RefreshCommand}"
                                    IsEnabled="{Binding HasItems}"
                                    Style="{StaticResource AtisSecondaryButton}">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="6">
                                    <FontIcon Glyph="&#xE72C;" />
                                    <TextBlock loc:Uids.Uid="TextBlock_Refresh" />
                                </StackPanel>
                            </Button>

                        </StackPanel>

                        <!--  SEARCH  -->
                        <AutoSuggestBox x:Name="SearchBox"
                                        Grid.Column="1"
                                        Width="260"
                                        Height="32"
                                        Margin="12,0"
                                        VerticalAlignment="Center"
                                        IsEnabled="{Binding IsInParentMode, Converter={StaticResource InverseBoolConverter}}"
                                        PlaceholderText="Suchen..."
                                        QueryIcon="Find"
                                        QuerySubmitted="SearchBox_OnQuerySubmitted"
                                        Text="{Binding SearchText, Mode=TwoWay}" />
                    </Grid>
                </layout:BaseBossPageLayout.AppBar>

                <!--  LIST CONTENT  -->
                <layout:BaseBossPageLayout.ListContent>
                    <tbl21Class:Tbl21ClassBossControl DataContext="{Binding}" />
                </layout:BaseBossPageLayout.ListContent>

                <!--  DETAIL CONTENT  -->
                <layout:BaseBossPageLayout.DetailContent>
                    <Grid RowDefinitions="Auto,*"
                          Visibility="{Binding IsDetailVisible, Converter={StaticResource BoolToVisibilityConverter}}">

                        <!--  Headerleiste  -->
                        <ScrollViewer Grid.Row="0"
                                      HorizontalScrollBarVisibility="Hidden"
                                      HorizontalScrollMode="Auto"
                                      VerticalScrollBarVisibility="Disabled"
                                      VerticalScrollMode="Disabled"
                                      ZoomMode="Disabled">
                            <StackPanel Margin="0,10,0,10"
                                        Orientation="Horizontal"
                                        Spacing="4">

                                <Button x:Name="EditClassTab"
                                        Click="DetailTabButton_Click"
                                        Style="{StaticResource TabButtonStyle}"
                                        Tag="0">
                                    <StackPanel Spacing="4">
                                        <TextBlock HorizontalAlignment="Center"
                                                   loc:Uids.Uid="TextBlock_Edit_Class" />
                                        <Border x:Name="EditClassTabUnderline"
                                                Height="2"
                                                Background="Transparent" />
                                    </StackPanel>
                                </Button>

                                <Button x:Name="CommentsClassTab"
                                        Click="DetailTabButton_Click"
                                        Style="{StaticResource TabButtonStyle}"
                                        Tag="1">
                                    <StackPanel Spacing="4">
                                        <TextBlock HorizontalAlignment="Center"
                                                   loc:Uids.Uid="TextBlock_Comments" />
                                        <Border x:Name="CommentsClassTabUnderline"
                                                Height="2"
                                                Background="Transparent" />
                                    </StackPanel>
                                </Button>

                                <Button x:Name="ReferencesClassTab"
                                        Click="DetailTabButton_Click"
                                        Style="{StaticResource TabButtonStyle}"
                                        Tag="2">
                                    <StackPanel Spacing="4">
                                        <TextBlock HorizontalAlignment="Center"
                                                   loc:Uids.Uid="TextBlock_References" />
                                        <Border x:Name="ReferencesClassTabUnderline"
                                                Height="2"
                                                Background="Transparent" />
                                    </StackPanel>
                                </Button>

                                <Button x:Name="SubclassTab"
                                        Click="DetailTabButton_Click"
                                        Style="{StaticResource TabButtonStyle}"
                                        Tag="3">
                                    <StackPanel Spacing="4">
                                        <TextBlock HorizontalAlignment="Center"
                                                   loc:Uids.Uid="TextBlock_Subclass" />
                                        <Border x:Name="SubclassTabUnderline"
                                                Height="2"
                                                Background="Transparent" />
                                    </StackPanel>
                                </Button>

                                <Button x:Name="CommentsSubclassTab"
                                        Click="DetailTabButton_Click"
                                        Style="{StaticResource TabButtonStyle}"
                                        Tag="4">
                                    <StackPanel Spacing="4">
                                        <TextBlock HorizontalAlignment="Center"
                                                   loc:Uids.Uid="TextBlock_Comments" />
                                        <Border x:Name="CommentsSubclassTabUnderline"
                                                Height="2"
                                                Background="Transparent" />
                                    </StackPanel>
                                </Button>

                                <Button x:Name="ReferencesSubclassTab"
                                        Click="DetailTabButton_Click"
                                        Style="{StaticResource TabButtonStyle}"
                                        Tag="5">
                                    <StackPanel Spacing="4">
                                        <TextBlock HorizontalAlignment="Center"
                                                   loc:Uids.Uid="TextBlock_References" />
                                        <Border x:Name="ReferencesSubclassTabUnderline"
                                                Height="2"
                                                Background="Transparent" />
                                    </StackPanel>
                                </Button>

                            </StackPanel>
                        </ScrollViewer>

                        <!--  Inhalte  -->
                        <Grid Grid.Row="1">

                            <ScrollViewer x:Name="EditClassContent"
                                          Padding="1">
                                <tbl21Class:Tbl21ClassEditControl Item="{Binding SelectedItem, Mode=TwoWay}" />
                            </ScrollViewer>

                            <Grid x:Name="CommentsClassContent"
                                  DataContext="{Binding ClassCommentViewModel}"
                                  RowDefinitions="Auto,*">
                                <tbl93Comment:Tbl93CommentParentControl Grid.Row="0" />
                                <tbl93Comment:Tbl93CommentEditControl Grid.Row="1"
                                                                      Item="{Binding Item}"
                                                                      Visibility="{Binding HasActiveItem, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </Grid>

                            <Grid x:Name="ReferencesClassContent"
                                  DataContext="{Binding ClassReferenceViewModel}"
                                  RowDefinitions="Auto,*">
                                <tbl90Reference:Tbl90ReferenceParentControl x:Name="ReferenceParentControl"
                                                                            Grid.Row="0" />

                                <tbl90Reference:Tbl90ReferenceEditControl Grid.Row="1"
                                                                          Item="{Binding Item}"
                                                                          Visibility="{Binding HasActiveItem, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </Grid>

                            <Grid x:Name="SubclassContent"
                                  DataContext="{Binding SubclassViewModel}"
                                  RowDefinitions="Auto,*">
                                <tbl24Subclass:Tbl24SubclassParentControl x:Name="SubclassParentControl"
                                                                          Grid.Row="0" />
                                <tbl24Subclass:Tbl24SubclassEditControl Grid.Row="1"
                                                                        Item="{Binding SelectedItem}"
                                                                        Visibility="{Binding IsDetailVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </Grid>

                            <Grid x:Name="CommentsSubclassContent"
                                  DataContext="{Binding SubclassViewModel.SubclassCommentViewModel}"
                                  RowDefinitions="Auto,*">
                                <tbl93Comment:Tbl93CommentParentControl Grid.Row="0" />
                                <tbl93Comment:Tbl93CommentEditControl Grid.Row="1"
                                                                      Item="{Binding Item}"
                                                                      Visibility="{Binding HasActiveItem, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </Grid>

                            <Grid x:Name="ReferencesSubclassContent"
                                  DataContext="{Binding SubclassViewModel.SubclassReferenceViewModel}"
                                  RowDefinitions="Auto,*">
                                <tbl90Reference:Tbl90ReferenceParentControl Grid.Row="0" />

                                <tbl90Reference:Tbl90ReferenceEditControl Grid.Row="1"
                                                                          Item="{Binding Item}"
                                                                          Visibility="{Binding HasActiveItem, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </Grid>
                        </Grid>
                    </Grid>
                </layout:BaseBossPageLayout.DetailContent>

            </layout:BaseBossPageLayout>

        </ScrollViewer>

        <!--  2. 🔥 Modernes Lade Overlay  -->
        <components:LoadingOverlayControl Grid.RowSpan="1"
                                          IsLoading="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

    </Grid>
</Page>
