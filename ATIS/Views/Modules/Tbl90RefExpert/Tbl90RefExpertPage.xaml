<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="ATIS.Views.Modules.Tbl90RefExpert.Tbl90RefExpertPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <Grid Padding="12"
          RowDefinitions="Auto,*,Auto">
        <!--  SEARCH + BUTTONS  -->
        <StackPanel Orientation="Horizontal"
                    Spacing="8">
            <TextBox Width="200"
                     PlaceholderText="Suche…"
                     Text="{Binding SearchText, Mode=TwoWay}" />
            <Button Command="{Binding SearchCommand}"
                    CommandParameter="{Binding SearchText}"
                    Content="Suchen" />
            <Button Command="{Binding NewCommand}"
                    Content="Neu" />
            <Button Command="{Binding EditCommand}"
                    Content="Bearbeiten" />
            <Button Command="{Binding DeleteCommand}"
                    Content="Löschen" />
        </StackPanel>
        <!--  LIST (DATAGRID)  -->
        <controls:DataGrid Grid.Row="1"
                           Margin="0,12,0,12"
                           AutoGenerateColumns="False"
                           IsReadOnly="True"
                           ItemsSource="{Binding Items}"
                           SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                           SelectionMode="Single">
            <controls:DataGrid.Columns>
                <controls:DataGridTextColumn Width="60"
                                             Binding="{Binding RefExpertId}"
                                             Header="ID" />
                <controls:DataGridTextColumn Width="*"
                                             Binding="{Binding RefExpertName}"
                                             Header="Name" />
                <controls:DataGridTextColumn Width="80"
                                             Binding="{Binding ValidYear}"
                                             Header="Jahr" />
                <controls:DataGridTextColumn Width="80"
                                             Binding="{Binding Valid}"
                                             Header="Gültig" />
            </controls:DataGrid.Columns>
        </controls:DataGrid>
        <!--  DETAIL FORM  -->
        <StackPanel Grid.Row="2"
                    Spacing="12">
            <TextBlock Margin="0,0,0,8"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Text="Expert Details" />
            <TextBox Header="Name"
                     IsEnabled="{Binding IsInEdit}"
                     Text="{Binding EditItem.RefExpertName, Mode=TwoWay}" />
            <TextBox Header="Jahr"
                     IsEnabled="{Binding IsInEdit}"
                     Text="{Binding EditItem.ValidYear, Mode=TwoWay}" />
            <CheckBox Content="Gültig"
                      IsChecked="{Binding EditItem.Valid, Mode=TwoWay}" />
            <TextBox Header="Info"
                     IsEnabled="{Binding IsInEdit}"
                     Text="{Binding EditItem.Info, Mode=TwoWay}" />
            <TextBox Height="80"
                     AcceptsReturn="True"
                     Header="Notizen"
                     IsEnabled="{Binding IsInEdit}"
                     Text="{Binding EditItem.Notes, Mode=TwoWay}"
                     TextWrapping="Wrap" />
            <TextBox Height="120"
                     AcceptsReturn="True"
                     Header="Memo"
                     IsEnabled="{Binding IsInEdit}"
                     Text="{Binding EditItem.Memo, Mode=TwoWay}"
                     TextWrapping="Wrap" />
            <StackPanel HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Spacing="8">
                <Button Command="{Binding SaveCommand}"
                        Content="Speichern" />
                <Button Command="{Binding CancelCommand}"
                        Content="Abbrechen" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
