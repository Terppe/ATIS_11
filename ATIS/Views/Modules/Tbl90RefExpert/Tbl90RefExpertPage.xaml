<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="ATIS.Views.Modules.Tbl90RefExpert.Tbl90RefExpertPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:atis="using:ATIS.DesignSystem.Components"
      xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:loc="using:WinUI3Localizer"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <Grid x:Name="RootGrid">
        <ScrollViewer VerticalScrollBarVisibility="Visible">

            <atis:Base1List1DetailPageLayout>

                <!--  HEADER LEFT  -->
                <atis:Base1List1DetailPageLayout.Header>
                    <StackPanel Margin="8,0,0,8"
                                Orientation="Horizontal"
                                Spacing="10">
                        <TextBlock Margin="0,4,0,0"
                                   loc:Uids.Uid="TextBlock_RefExperts"
                                   Style="{StaticResource AtisSectionTitleTextStyle}" />

                        <TextBlock Margin="0,12,0,0"
                                   loc:Uids.Uid="TextBlock_DataSetCount"
                                   Style="{StaticResource AtisBodyTextStyle}" />

                        <TextBlock Margin="0,12,0,0"
                                   Style="{StaticResource AtisBodyTextStyle}"
                                   Text="{Binding DataSetCount, Mode=OneWay}" />
                    </StackPanel>
                </atis:Base1List1DetailPageLayout.Header>

                <!--  HEADER RIGHT BUTTONS + SEARCHBOX  -->
                <atis:Base1List1DetailPageLayout.AppBar>
                    <Grid ColumnSpacing="8">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Margin="8"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">

                            <Button Margin="5,0,5,0"
                                    Command="{Binding NewCommand}"
                                    Style="{StaticResource AtisPrimaryButton}">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="6">
                                    <FontIcon Glyph="&#xE710;" />
                                    <TextBlock loc:Uids.Uid="TextBlock_Add" />
                                </StackPanel>
                            </Button>

                            <Button Margin="5,0,5,0"
                                    Command="{Binding EditCommand}"
                                    Style="{StaticResource AtisSecondaryButton}">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="6">
                                    <FontIcon Glyph="&#xE70F;" />
                                    <TextBlock loc:Uids.Uid="TextBlock_Edit" />
                                </StackPanel>
                            </Button>

                            <Button Margin="5,0,5,0"
                                    Command="{Binding DeleteCommand}"
                                    Style="{StaticResource AtisSecondaryButton}">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="6">
                                    <FontIcon Glyph="&#xE74D;" />
                                    <TextBlock loc:Uids.Uid="TextBlock_Delete" />
                                </StackPanel>
                            </Button>

                        </StackPanel>

                        <!--  RIGHT SEARCH  -->
                        <AutoSuggestBox x:Name="SearchBox"
                                        Grid.Column="1"
                                        Width="260"
                                        Height="32"
                                        Margin="10,0,18,0"
                                        VerticalAlignment="Center"
                                        loc:Uids.Uid="AutoSuggestBox_Search"
                                        KeyUp="SearchBox_OnKeyUp"
                                        QueryIcon="Find"
                                        Text="{Binding SearchText, Mode=TwoWay}" />
                    </Grid>
                </atis:Base1List1DetailPageLayout.AppBar>

                <!--  LIST (DATAGRID)  -->
                <atis:Base1List1DetailPageLayout.ListContent>
                    <Border Style="{StaticResource AtisCard}">
                        <Grid>
                            <controls:DataGrid x:Name="RefExpertDataGrid"
                                               Height="Auto"
                                               MinHeight="150"
                                               MaxHeight="200"
                                               HorizontalAlignment="Stretch"
                                               VerticalAlignment="Top"
                                               AlternatingRowBackground="{ThemeResource AtisGridRowAlternateBackground}"
                                               AreRowDetailsFrozen="True"
                                               CanUserSortColumns="True"
                                               GridLinesVisibility="Vertical"
                                               ItemsSource="{Binding Items}"
                                               RowBackground="{ThemeResource AtisGridRowBackground}"
                                               SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                               SelectionMode="Single"
                                               Sorting="DataGrid_Sorting"
                                               Style="{StaticResource AtisDataGridStyle}">

                                <!--  ContextFlyout  -->
                                <controls:DataGrid.ContextFlyout>
                                    <MenuFlyout>

                                        <MenuFlyoutItem loc:Uids.Uid="MenuFlyout_Add"
                                                        Command="{Binding NewCommand}"
                                                        Icon="Add"
                                                        Style="{StaticResource AtisPrimaryMenuFlyoutItem}" />

                                        <MenuFlyoutItem loc:Uids.Uid="MenuFlyout_Edit"
                                                        Command="{Binding EditCommand}"
                                                        Icon="Edit" />

                                        <MenuFlyoutItem loc:Uids.Uid="MenuFlyout_Save"
                                                        Command="{Binding SaveCommand}"
                                                        Icon="Save"
                                                        IsEnabled="{Binding SelectedItem, Converter={StaticResource NullToBoolConverter}}" />

                                        <MenuFlyoutItem loc:Uids.Uid="MenuFlyout_Delete"
                                                        Command="{Binding DeleteCommand}"
                                                        Icon="Delete" />

                                    </MenuFlyout>
                                </controls:DataGrid.ContextFlyout>

                                <!--  RowStyle  -->
                                <controls:DataGrid.RowStyle>
                                    <Style TargetType="controls:DataGridRow">
                                        <Setter Property="Background" Value="{Binding IsAlternate, Converter={StaticResource BoolToRowBackgroundConverter}}" />
                                    </Style>
                                </controls:DataGrid.RowStyle>

                                <!--  Columns  -->
                                <controls:DataGrid.Columns>

                                    <controls:DataGridTextColumn loc:Uids.Uid="DataGridTextColumn_RefExpertId"
                                                                 Binding="{Binding RefExpertId}"
                                                                 CanUserSort="True"
                                                                 IsReadOnly="True"
                                                                 Tag="RefExpertId" />

                                    <controls:DataGridTextColumn loc:Uids.Uid="DataGridTextColumn_RefExpertName"
                                                                 Binding="{Binding RefExpertName}"
                                                                 CanUserSort="True"
                                                                 Tag="RefExpertName" />

                                    <controls:DataGridTextColumn loc:Uids.Uid="DataGridTextColumn_ValidYear"
                                                                 Binding="{Binding ValidYear}"
                                                                 CanUserSort="True"
                                                                 Tag="ValidYear" />

                                    <controls:DataGridTextColumn loc:Uids.Uid="DataGridTextColumn_Valid"
                                                                 Binding="{Binding Valid}"
                                                                 CanUserSort="True"
                                                                 Tag="Valid" />

                                </controls:DataGrid.Columns>

                            </controls:DataGrid>
                        </Grid>
                    </Border>
                </atis:Base1List1DetailPageLayout.ListContent>


                <!--  DETAIL FORM  -->
                <atis:Base1List1DetailPageLayout.DetailContent>
                    <Border Style="{StaticResource AtisCard}"
                            Visibility="{Binding SelectedItem, Converter={StaticResource NullToVisibilityConverter}}">
                        <StackPanel Spacing="12">

                            <!--  Detail Header  -->
                            <atis:AtisDetailHeader IsEnabled="True">

                                <atis:AtisDetailHeader.LeftContent>
                                    <TextBlock loc:Uids.Uid="TextBlock_RefExpertDetail"
                                               Style="{StaticResource AtisSectionTitleTextStyle}" />
                                </atis:AtisDetailHeader.LeftContent>

                                <atis:AtisDetailHeader.RightContent>
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="8">

                                        <Button Margin="5,0,5,0"
                                                Command="{Binding SaveCommand}"
                                                Style="{StaticResource AtisSecondaryButton}"
                                                Visibility="{Binding IsInEdit, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="6">
                                                <FontIcon Glyph="&#xE74E;" />
                                                <TextBlock loc:Uids.Uid="TextBlock_Save" />
                                            </StackPanel>
                                        </Button>

                                        <Button Margin="5,0,5,0"
                                                Command="{Binding CancelCommand}"
                                                Style="{StaticResource AtisSecondaryButton}"
                                                Visibility="{Binding IsInEdit, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="6">
                                                <FontIcon Glyph="&#xE8BB;" />
                                                <TextBlock loc:Uids.Uid="TextBlock_Cancel" />
                                            </StackPanel>
                                        </Button>

                                        <Button Command="{Binding EditCommand}"
                                                IsEnabled="{Binding SelectedItem, Converter={StaticResource NullToBoolConverter}}"
                                                Style="{StaticResource AtisSecondaryButton}">
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="6">
                                                <FontIcon Glyph="&#xE70F;" />
                                                <TextBlock loc:Uids.Uid="TextBlock_Edit" />
                                            </StackPanel>
                                        </Button>

                                    </StackPanel>
                                </atis:AtisDetailHeader.RightContent>

                            </atis:AtisDetailHeader>

                            <!--  ⭐ Detail Fields  -->
                            <Grid RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!--  Row 0  -->
                                <Grid Grid.Row="0"
                                      ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBox loc:Uids.Uid="TextBox_RefExpertName"
                                             IsEnabled="{Binding IsInEdit}"
                                             Style="{StaticResource AtisTextBox}"
                                             Text="{Binding EditItem.RefExpertName, Mode=TwoWay}" />
                                </Grid>

                                <!--  Row 1  -->
                                <Grid Grid.Row="1"
                                      ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBox loc:Uids.Uid="TextBox_ValidYear"
                                             IsEnabled="{Binding IsInEdit}"
                                             Style="{StaticResource AtisTextBox}"
                                             Text="{Binding EditItem.ValidYear, Mode=TwoWay}" />

                                    <CheckBox Grid.Column="1"
                                              Margin="4,16,4,0"
                                              loc:Uids.Uid="CheckBox_Valid"
                                              IsChecked="{Binding EditItem.Valid, Mode=TwoWay}"
                                              IsEnabled="{Binding IsInEdit}"
                                              Style="{StaticResource AtisCheckBox}" />
                                </Grid>

                                <!--  Row 2 Style="{StaticResource AtisCheckBox}" IsHitTestVisible="{Binding IsInEdit}"  -->
                                <Grid Grid.Row="2"
                                      ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBox loc:Uids.Uid="TextBox_Info"
                                             IsEnabled="{Binding IsInEdit}"
                                             Style="{StaticResource AtisTextBox}"
                                             Text="{Binding EditItem.Info, Mode=TwoWay}" />
                                </Grid>

                                <!--  Row 3  -->
                                <Grid Grid.Row="3"
                                      ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBox Height="80"
                                             loc:Uids.Uid="TextBox_Notes"
                                             AcceptsReturn="True"
                                             IsEnabled="{Binding IsInEdit}"
                                             Style="{StaticResource AtisTextBox}"
                                             Text="{Binding EditItem.Notes, Mode=TwoWay}"
                                             TextWrapping="Wrap" />
                                </Grid>

                                <!--  Row 4  -->
                                <Grid Grid.Row="4"
                                      ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBox Height="80"
                                             loc:Uids.Uid="TextBox_Memo"
                                             AcceptsReturn="True"
                                             IsEnabled="{Binding IsInEdit}"
                                             Style="{StaticResource AtisTextBox}"
                                             Text="{Binding EditItem.Memo, Mode=TwoWay}"
                                             TextWrapping="Wrap" />
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </Border>
                </atis:Base1List1DetailPageLayout.DetailContent>
            </atis:Base1List1DetailPageLayout>

        </ScrollViewer>

        <!--  2. 🔥 Modernes Lade Overlay  -->
        <atis:LoadingOverlayControl Grid.RowSpan="1"
                                    IsLoading="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

    </Grid>

</Page>
