<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="ATIS.Views.Modules.Tbl33Ordo.Tbl33OrdoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:components="using:ATIS.DesignSystem.Components"
      xmlns:layout="using:ATIS.DesignSystem.Layout"
      xmlns:loc="using:WinUI3Localizer"
      xmlns:tbl33Ordo="using:ATIS.Views.Modules.Tbl33Ordo"
      xmlns:tbl36Subordo="using:ATIS.Views.Modules.Tbl36Subordo"
      xmlns:tbl90Reference="using:ATIS.Views.Modules.Tbl90Reference"
      xmlns:tbl93Comment="using:ATIS.Views.Modules.Tbl93Comment"
      x:Name="RootPage"
      DataContext="{Binding OrdoViewModel}">

    <!--  Tbl33OrdoPage Skriptdatum:  15.06.2024  10:32  -->

    <Grid x:Name="RootGrid">
        <ScrollViewer VerticalScrollBarVisibility="Visible">

            <layout:BaseBossPageLayout>

                <!--  HEADER LEFT  -->
                <layout:BaseBossPageLayout.Header>
                    <StackPanel Margin="8,0,0,8"
                                Orientation="Horizontal"
                                Spacing="10">

                        <TextBlock Margin="0,4,0,0"
                                   loc:Uids.Uid="TextBlock_Ordos"
                                   Style="{StaticResource AtisSectionTitleTextStyle}" />

                        <TextBlock Margin="0,12,0,0"
                                   loc:Uids.Uid="TextBlock_DataSetCount"
                                   Style="{StaticResource AtisBodyTextStyle}" />

                        <TextBlock Margin="0,12,0,0"
                                   Style="{StaticResource AtisBodyTextStyle}"
                                   Text="{Binding DataSetCount}" />
                    </StackPanel>
                </layout:BaseBossPageLayout.Header>

                <!--  APPBAR RIGHT  -->
                <layout:BaseBossPageLayout.AppBar>
                    <Grid ColumnSpacing="8">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Margin="8"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">

                            <Button Margin="5,0,5,0"
                                    Command="{Binding NewCommand}"
                                    IsEnabled="{Binding IsEditMode, Converter={StaticResource InverseBoolConverter}}"
                                    Style="{StaticResource AtisPrimaryButton}">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="6">
                                    <FontIcon Glyph="&#xE710;" />
                                    <TextBlock loc:Uids.Uid="TextBlock_Add" />
                                </StackPanel>
                            </Button>

                            <Button Margin="5,0,5,0"
                                    Command="{Binding RefreshCommand}"
                                    IsEnabled="{Binding HasItems}"
                                    Style="{StaticResource AtisSecondaryButton}">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="6">
                                    <FontIcon Glyph="&#xE72C;" />
                                    <TextBlock loc:Uids.Uid="TextBlock_Refresh" />
                                </StackPanel>
                            </Button>

                        </StackPanel>

                        <!--  SEARCH  -->
                        <AutoSuggestBox x:Name="SearchBox"
                                        Grid.Column="1"
                                        Width="260"
                                        Height="32"
                                        Margin="12,0"
                                        VerticalAlignment="Center"
                                        IsEnabled="{Binding IsInParentMode, Converter={StaticResource InverseBoolConverter}}"
                                        PlaceholderText="Suchen..."
                                        QueryIcon="Find"
                                        QuerySubmitted="SearchBox_OnQuerySubmitted"
                                        Text="{Binding SearchText, Mode=TwoWay}" />
                    </Grid>
                </layout:BaseBossPageLayout.AppBar>

                <!--  LIST CONTENT  -->
                <layout:BaseBossPageLayout.ListContent>
                    <tbl33Ordo:Tbl33OrdoBossControl DataContext="{Binding}" />
                </layout:BaseBossPageLayout.ListContent>

                <!--  DETAIL CONTENT  -->
                <layout:BaseBossPageLayout.DetailContent>
                    <Grid>
                        <Pivot x:Name="DetailPivot"
                               SelectedIndex="{Binding SelectedDetailPivotIndex, Mode=TwoWay}"
                               Visibility="{Binding IsDetailVisible, Converter={StaticResource BoolToVisibilityConverter}}">

                            <!--  Edit Ordo  -->
                            <PivotItem loc:Uids.Uid="PivotItem_Edit_Ordo">
                                <ScrollViewer Padding="1">
                                    <tbl33Ordo:Tbl33OrdoEditControl Item="{Binding SelectedItem, Mode=TwoWay}" />
                                </ScrollViewer>
                            </PivotItem>

                            <!--  Comments Ordo  -->
                            <PivotItem x:Name="CommentsOrdoPivot"
                                       loc:Uids.Uid="PivotItem_Comments">
                                <Grid DataContext="{Binding OrdoCommentViewModel}"
                                      RowDefinitions="Auto,*">

                                    <tbl93Comment:Tbl93CommentParentControl Grid.Row="0" />

                                    <tbl93Comment:Tbl93CommentEditControl Grid.Row="1"
                                                                          Item="{Binding SelectedItem}"
                                                                          Visibility="{Binding IsDetailVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </Grid>
                            </PivotItem>

                            <!--  References Ordo  -->
                            <PivotItem x:Name="ReferencesOrdoPivot"
                                       loc:Uids.Uid="PivotItem_References">

                                <Grid DataContext="{Binding OrdoReferenceViewModel}"
                                      RowDefinitions="Auto,*">

                                    <tbl90Reference:Tbl90ReferenceParentControl x:Name="ReferenceParentControl"
                                                                                Grid.Row="0" />

                                    <tbl90Reference:Tbl90ReferenceEditControl Grid.Row="1"
                                                                              Item="{Binding SelectedItem}"
                                                                              Visibility="{Binding IsDetailVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </Grid>
                            </PivotItem>

                            <!--  Subordo  -->
                            <PivotItem x:Name="SubordoPivot"
                                       loc:Uids.Uid="PivotItem_Edit_Subordo">

                                <Grid RowDefinitions="Auto,*">
                                    <tbl36Subordo:Tbl36SubordoParentControl x:Name="SubordoParentControl"
                                                                            Grid.Row="0"
                                                                            DataContext="{Binding SubordoViewModel}" />

                                    <tbl36Subordo:Tbl36SubordoEditControl Grid.Row="1"
                                                                          DataContext="{Binding SubordoViewModel}"
                                                                          Item="{Binding SelectedItem}"
                                                                          Visibility="{Binding IsDetailVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </Grid>
                            </PivotItem>

                            <!--  Comments Subordo  -->
                            <PivotItem x:Name="CommentsSubordoPivot"
                                       loc:Uids.Uid="PivotItem_Comments">

                                <Grid DataContext="{Binding SubordoViewModel.SubordoCommentViewModel}"
                                      RowDefinitions="Auto,*">

                                    <tbl93Comment:Tbl93CommentParentControl Grid.Row="0" />

                                    <tbl93Comment:Tbl93CommentEditControl Grid.Row="1"
                                                                          Item="{Binding SelectedItem}"
                                                                          Visibility="{Binding IsDetailVisible, Converter={StaticResource BoolToVisibilityConverter}}" />

                                </Grid>
                            </PivotItem>

                            <!--  References Subordo  -->
                            <PivotItem x:Name="ReferencesSubordoPivot"
                                       loc:Uids.Uid="PivotItem_References">

                                <Grid DataContext="{Binding SubordoViewModel.SubordoReferenceViewModel}"
                                      RowDefinitions="Auto,*">

                                    <tbl90Reference:Tbl90ReferenceParentControl Grid.Row="0" />

                                    <tbl90Reference:Tbl90ReferenceEditControl Grid.Row="1"
                                                                              Item="{Binding SelectedItem}"
                                                                              Visibility="{Binding IsDetailVisible, Converter={StaticResource BoolToVisibilityConverter}}" />

                                </Grid>
                            </PivotItem>
                        </Pivot>
                    </Grid>

                </layout:BaseBossPageLayout.DetailContent>

            </layout:BaseBossPageLayout>

        </ScrollViewer>

        <!--  2. 🔥 Modernes Lade Overlay  -->
        <components:LoadingOverlayControl Grid.RowSpan="1"
                                          IsLoading="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

    </Grid>
</Page>
