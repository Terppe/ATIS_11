<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="ATIS.Views.Modules.Tbl33Ordo.Tbl33OrdoEditControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:WinUI3Localizer"
             x:Name="Root">

    <!--  Tbl33OrdoEditControl Skriptdatum:  15.06.2024  10:32  -->

    <Border Padding="4"
            Background="{ThemeResource ControlFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="6">

        <StackPanel Spacing="4">

            <!--  HEADER  -->
            <Grid Margin="0,0,0,4"
                  ColumnDefinitions="*,Auto">

                <TextBlock Grid.Column="0"
                           Margin="8,0,0,0"
                           loc:Uids.Uid="TextBlock_Ordo"
                           Style="{StaticResource AtisSectionTitleTextStyle}" />

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">

                    <!--  BACK  -->

                    <Button Command="{Binding BackCommand}">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6">
                            <FontIcon Glyph="&#xE72B;" />
                            <TextBlock Text="Back" />
                        </StackPanel>
                    </Button>

                    <!--  NEW  -->
                    <Button Command="{Binding NewCommand}"
                            Style="{StaticResource AtisPrimaryButton}">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6">
                            <FontIcon Glyph="&#xE710;" />
                            <TextBlock loc:Uids.Uid="TextBlock_Add" />
                        </StackPanel>
                    </Button>

                    <!--  SAVE  -->
                    <Button Command="{Binding SaveCommand}"
                            Style="{StaticResource AtisSecondaryButton}">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6">
                            <FontIcon Glyph="&#xE74E;" />
                            <TextBlock loc:Uids.Uid="TextBlock_Save" />
                        </StackPanel>
                    </Button>

                    <!--  DELETE  -->
                    <Button Command="{Binding DeleteCommand}"
                            Style="{StaticResource AtisSecondaryButton}">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6">
                            <FontIcon Glyph="&#xE74D;" />
                            <TextBlock loc:Uids.Uid="TextBlock_Delete" />
                        </StackPanel>
                    </Button>

                </StackPanel>
            </Grid>

            <!--  ID + Name  -->
            <StackPanel Orientation="Horizontal"
                        Spacing="4">

                <!--  ID  -->
                <TextBox MinWidth="110"
                         VerticalAlignment="Top"
                         loc:Uids.Uid="TextBox_OrdoId"
                         IsReadOnly="True"
                         Style="{StaticResource AtisTextBox}"
                         Text="{Binding Item.OrdoId, ElementName=Root}" />

                <!--  OrdoName  -->
                <StackPanel MinWidth="150"
                            VerticalAlignment="Top"
                            Spacing="2">
                    <TextBox x:Name="OrdoNameBox"
                             loc:Uids.Uid="TextBox_OrdoName"
                             Loaded="OrdoNameBox_OnLoaded"
                             Style="{StaticResource AtisTextBox}"
                             Text="{Binding Item.OrdoName, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             TextChanged="OrdoNameBox_OnTextChanged" />
                    <TextBlock Height="18"
                               FontSize="10"
                               Foreground="Red"
                               Text="{Binding Item.OrdoNameError, ElementName=Root}"
                               Visibility="{Binding Item.HasOrdoNameError, ElementName=Root, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>

                <!--  Legio Combo  -->
                <StackPanel MinWidth="150"
                            VerticalAlignment="Top"
                            Spacing="2">
                    <TextBlock Visibility="Collapsed" />
                    <ComboBox x:Name="LegioCombo"
                              MinWidth="200"
                              VerticalAlignment="Center"
                              loc:Uids.Uid="ComboBox_LegioName"
                              DisplayMemberPath="LegioName"
                              ItemsSource="{Binding ViewModel.LegioList, ElementName=Root}"
                              SelectedValue="{Binding Item.LegioId, ElementName=Root, Mode=TwoWay}"
                              SelectedValuePath="LegioId"
                              Style="{StaticResource AtisComboBox}" />
                </StackPanel>

                <!--  Valid  -->
                <CheckBox MinWidth="60"
                          VerticalAlignment="Bottom"
                          loc:Uids.Uid="CheckBox_Valid"
                          IsChecked="{Binding Item.Valid, ElementName=Root, Mode=TwoWay}"
                          Style="{StaticResource AtisCheckBox}" />

                <!--  ValidYear  -->
                <StackPanel MinWidth="60"
                            VerticalAlignment="Top"
                            Spacing="2">
                    <TextBox x:Name="ValidYearBox"
                             loc:Uids.Uid="TextBox_ValidYear"
                             Loaded="ValidYearBox_OnLoaded"
                             Style="{StaticResource AtisTextBox}"
                             Text="{Binding Item.ValidYear, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             TextChanged="ValidYearBox_OnTextChanged" />
                    <TextBlock Height="16"
                               FontSize="10"
                               Foreground="Red"
                               Text="{Binding Item.ValidYearError, ElementName=Root}"
                               Visibility="{Binding Item.HasValidYearError, ElementName=Root, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
            </StackPanel>

            <!--  Author + AuthorYear  -->
            <StackPanel Orientation="Horizontal"
                        Spacing="4">
                <TextBox MinWidth="150"
                         VerticalAlignment="Top"
                         loc:Uids.Uid="TextBox_Author"
                         CharacterCasing="Upper"
                         Style="{StaticResource AtisTextBox}"
                         Text="{Binding Item.Author, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <StackPanel MinWidth="60"
                            VerticalAlignment="Top"
                            Spacing="4">
                    <TextBox x:Name="AuthorYearBox"
                             loc:Uids.Uid="TextBox_AuthorYear"
                             Loaded="AuthorYearBox_OnLoaded"
                             Style="{StaticResource AtisTextBox}"
                             Text="{Binding Item.AuthorYear, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             TextChanged="AuthorYearBox_OnTextChanged" />
                    <TextBlock Height="16"
                               FontSize="10"
                               Foreground="Red"
                               Text="{Binding Item.AuthorYearError, ElementName=Root}"
                               Visibility="{Binding Item.HasAuthorYearError, ElementName=Root, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
            </StackPanel>

            <!--  Synonym  -->
            <TextBox MinWidth="200"
                     MinHeight="75"
                     MaxHeight="150"
                     loc:Uids.Uid="TextBox_Synonym"
                     AcceptsReturn="True"
                     Style="{StaticResource AtisTextBox}"
                     Text="{Binding Item.Synonym, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     TextWrapping="Wrap" />

            <!--  Language Tab  -->
            <Grid RowDefinitions="Auto, Auto">
                <StackPanel Margin="0,0,0,10"
                            Orientation="Horizontal"
                            Spacing="4">
                    <Button x:Name="EngNameTab"
                            Click="DetailTabButton_Click"
                            Style="{StaticResource TabButtonStyle}"
                            Tag="0">
                        <StackPanel Spacing="4">
                            <TextBlock HorizontalAlignment="Center"
                                       loc:Uids.Uid="TextBlock_EnglishName" />
                            <Border x:Name="EngNameTabUnderline"
                                    Height="2"
                                    Background="Transparent" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="GerNameTab"
                            Click="DetailTabButton_Click"
                            Style="{StaticResource TabButtonStyle}"
                            Tag="1">
                        <StackPanel Spacing="4">
                            <TextBlock HorizontalAlignment="Center"
                                       loc:Uids.Uid="TextBlock_GermanName" />
                            <Border x:Name="GerNameTabUnderline"
                                    Height="2"
                                    Background="Transparent" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="FraNameTab"
                            Click="DetailTabButton_Click"
                            Style="{StaticResource TabButtonStyle}"
                            Tag="2">
                        <StackPanel Spacing="4">
                            <TextBlock HorizontalAlignment="Center"
                                       loc:Uids.Uid="TextBlock_FrenchName" />
                            <Border x:Name="FraNameTabUnderline"
                                    Height="2"
                                    Background="Transparent" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="SpaNameTab"
                            Click="DetailTabButton_Click"
                            Style="{StaticResource TabButtonStyle}"
                            Tag="3">
                        <StackPanel Spacing="4">
                            <TextBlock HorizontalAlignment="Center"
                                       loc:Uids.Uid="TextBlock_SpanishName" />
                            <Border x:Name="SpaNameTabUnderline"
                                    Height="2"
                                    Background="Transparent" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Grid x:Name="TabContentGrid"
                      Grid.Row="1">

                    <Grid x:Name="EngNameGrid">
                        <TextBox Style="{StaticResource AtisTextBoxNoHeader}"
                                 Text="{Binding Item.EngName, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <Grid x:Name="GerNameGrid"
                          Visibility="Collapsed">
                        <TextBox Style="{StaticResource AtisTextBoxNoHeader}"
                                 Text="{Binding Item.GerName, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <Grid x:Name="FraNameGrid"
                          Visibility="Collapsed">
                        <TextBox Style="{StaticResource AtisTextBoxNoHeader}"
                                 Text="{Binding Item.FraName, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <Grid x:Name="SpaNameGrid"
                          Visibility="Collapsed">
                        <TextBox Style="{StaticResource AtisTextBoxNoHeader}"
                                 Text="{Binding Item.PorName, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                </Grid>
            </Grid>

            <!--  Memo  -->
            <TextBox MinWidth="200"
                     MinHeight="75"
                     MaxHeight="150"
                     loc:Uids.Uid="TextBox_Memo"
                     AcceptsReturn="True"
                     Style="{StaticResource AtisTextBox}"
                     Text="{Binding Item.Memo, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     TextWrapping="Wrap" />

        </StackPanel>

    </Border>
</UserControl>
