        </layout:BaseBossPageLayout.AppBar>

        <!--  LISTE  -->
        <layout:BaseBossPageLayout.Content>

            <Grid x:Name="ListRoot"
                  RowDefinitions="Auto,*">

                <!--  Sticky Header (nur horizontal scroll, keine Scrollbar sichtbar)  -->
                <ScrollViewer x:Name="HeaderScroll"
                              Grid.Row="0"
                              Padding="4"
                              Background="#EFEFEF"
                              HorizontalScrollBarVisibility="Hidden"
                              HorizontalScrollMode="Enabled"
                              VerticalScrollBarVisibility="Disabled"
                              VerticalScrollMode="Disabled">

                    <Grid x:Name="HeaderGrid"
                          Padding="4"
                          Background="#EFEFEF">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding IdWidth}" />
                            <ColumnDefinition Width="{Binding Extra1Width}" />
                            <ColumnDefinition Width="{Binding Extra2Width}" />
                            <ColumnDefinition Width="{Binding Extra3Width}" />
                            <ColumnDefinition Width="{Binding Extra4Width}" />
                            <ColumnDefinition Width="{Binding Extra5Width}" />
                            <ColumnDefinition Width="{Binding Extra6Width}" />
                            <ColumnDefinition Width="{Binding Extra7Width}" />
                            <ColumnDefinition Width="{Binding Extra8Width}" />
                        </Grid.ColumnDefinitions>

                        <!--  Header content wie bisher  -->
                        <!--<Button Grid.Column="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{x:Bind ViewModel.SortCommand}"
                                CommandParameter="Id">
                            <TextBlock FontWeight="SemiBold"
                                       Foreground="#333"
                                       Text="ID" />
                        </Button>-->

                        <!--<Button Grid.Column="1"
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{x:Bind ViewModel.SortCommand}"
                                CommandParameter="Extra1">
                            <TextBlock FontWeight="SemiBold"
                                       Foreground="#333"
                                       Text="Name" />
                        </Button>-->

                        <TextBlock Grid.Column="2"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Text="Subtribus" />
                        <TextBlock Grid.Column="3"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Text="Valid" />
                        <TextBlock Grid.Column="4"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Text="Year" />
                        <TextBlock Grid.Column="5"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Text="Author" />
                        <TextBlock Grid.Column="6"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Text="AuthorYear" />
                    </Grid>
                </ScrollViewer>

                <Border x:Name="FocusSink" IsTabStop="True" Opacity="0" />

                <!--  Body scrollt (vertikal + horizontal); treibt Header mit  -->
                <ScrollViewer x:Name="BodyScroll"
                              Grid.Row="1"
                              MaxHeight="200"
                              Padding="4"
                              Background="#F7F7F7"
                              HorizontalScrollBarVisibility="Auto"
                              HorizontalScrollMode="Enabled"
                              VerticalScrollBarVisibility="Auto"
                              VerticalScrollMode="Enabled"
                              ViewChanged="BodyScroll_ViewChanged">

                    <ItemsRepeater x:Name="InfratribusRepeater"
                                   IsTabStop="False"
                                   XYFocusKeyboardNavigation="Disabled"
                                   ItemsSource="{Binding Items}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="2" />
                        </ItemsRepeater.Layout>

                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:Tbl63Infratribus">
                                <local:Tbl63InfratribusRowControl Infratribus="{Binding}"

                                                                  Loaded="Row_Loaded"
                                                                  Tapped="Row_Tapped"
                                                                  Unloaded="Row_Unloaded" />
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                </ScrollViewer>
            </Grid>


