        <layout:BaseBossPageLayout.Header>
            <StackPanel Orientation="Horizontal"
                        Spacing="10">
                <TextBlock FontWeight="Bold"
                           Text="Infratribusses" />

                <TextBlock Style="{StaticResource AtisBodyTextStyle}"
                           Text="Datensätze:" />

                <TextBlock Style="{StaticResource AtisBodyTextStyle}"
                           Text="{Binding DataSetCount}" />
            </StackPanel>
        </layout:BaseBossPageLayout.Header>

        <!--  APPBAR (rechts)  -->
        <layout:BaseBossPageLayout.AppBar>
            <!--<StackPanel Orientation="Horizontal"
            Spacing="8">

