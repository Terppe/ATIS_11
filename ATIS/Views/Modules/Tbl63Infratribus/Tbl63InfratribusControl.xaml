            <TextBlock Grid.Column="5"
            VerticalAlignment="Center"
            FontWeight="SemiBold"
            Text="Author" />
            <TextBlock Grid.Column="6"
            VerticalAlignment="Center"
            FontWeight="SemiBold"
            Text="AuthorYear" />
            </Grid>
            --><!--  LISTE  --><!--
            <ScrollViewer Grid.Row="1"
            MaxHeight="200"
            Padding="4"
            Background="#F7F7F7">

            <ItemsRepeater ItemsSource="{Binding Items}">
            <ItemsRepeater.Layout>
            <StackLayout Spacing="2" />
            </ItemsRepeater.Layout>

            <ItemsRepeater.ItemTemplate>
            <DataTemplate x:DataType="models:Tbl63Infratribus">
            <local:Tbl63InfratribusRowControl Loaded="Row_Loaded"
            Tapped="Row_Tapped"
            Unloaded="Row_Unloaded" />
            </DataTemplate>
            </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            </ScrollViewer>

            --><!--  EDIT  -->
            <!--<local:Tbl63InfratribusEditControl Grid.Row="2"
            Margin="0,8,0,0"
            Visibility="{Binding SelectedComment, Converter={StaticResource NullToVisibilityConverter}}" />-->
            <!--<ScrollViewer Padding="6">
            <local:Tbl63InfratribusEditControl Item="{Binding SelectedItem}" Grid.Row="2" />
            </ScrollViewer>--><!--

            </Grid>-->

        </layout:BaseBossPageLayout.Content>


    </layout:BaseBossPageLayout>

