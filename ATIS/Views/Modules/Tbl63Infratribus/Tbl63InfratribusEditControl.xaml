<UserControl x:Class="ATIS.Views.Modules.Tbl63Infratribus.Tbl63InfratribusEditControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:WinUI3Localizer">

    <Border Padding="12"
            Background="WhiteSmoke"
            CornerRadius="6">

        <!--  COMMENT HEADER + BUTTONS  -->
        <StackPanel Spacing="12">

            <!--  HEADER-ZEILE  -->
            <Grid Margin="0,0,0,8"
                  ColumnDefinitions="*,Auto">

                <!--  Titel links  -->
                <TextBlock Grid.Column="0"
                           loc:Uids.Uid="TextBlock_Infratribus"
                           Style="{StaticResource AtisSectionTitleTextStyle}" />

                <!--  Buttons rechts  -->
                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">

                    <Button Command="{Binding NewCommand}"
                            Style="{StaticResource AtisPrimaryButton}">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6">
                            <FontIcon Glyph="&#xE710;" />
                            <TextBlock loc:Uids.Uid="TextBlock_Add" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding SaveCommand}"
                            Style="{StaticResource AtisSecondaryButton}">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6">
                            <FontIcon Glyph="&#xE74E;" />
                            <TextBlock loc:Uids.Uid="TextBlock_Save" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding DeleteCommand}"
                            Style="{StaticResource AtisSecondaryButton}">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6">
                            <FontIcon Glyph="&#xE74D;" />
                            <TextBlock loc:Uids.Uid="TextBlock_Delete" />
                        </StackPanel>
                    </Button>

                </StackPanel>

            </Grid>


            <!--  ID (read-only)  -->
            <StackPanel Orientation="Horizontal"
                        Spacing="8">
                <TextBox MinWidth="110"
                         loc:Uids.Uid="TextBox_InfratribusId"
                         IsReadOnly="True"
                         Style="{StaticResource AtisTextBox}"
                         Text="{x:Bind Item.InfratribusId, Mode=OneWay}" />

                <!--  InfratribusName  -->
                <TextBox loc:Uids.Uid="TextBox_InfratribusName"
                         Style="{StaticResource AtisTextBox}"
                         Text="{x:Bind Item.InfratribusName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <!--  SubtribusName  -->
                <ComboBox MinWidth="200"
                          MinHeight="32"
                          Margin="0,18,0,0"
                          VerticalAlignment="Center"
                          VerticalContentAlignment="Bottom"
                          loc:Uids.Uid="ComboBox_SubtribusName"
                          DisplayMemberPath="SubtribusName"
                          ItemsSource="{x:Bind ViewModel.SubtribusList}"
                          SelectedValue="{x:Bind Item.SubtribusId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          SelectedValuePath="SubtribusId"
                          Style="{StaticResource AtisComboBox}" />

                <!--  Valid + ValidYear  -->
                <CheckBox VerticalAlignment="Bottom"
                          loc:Uids.Uid="CheckBox_Valid"
                          IsChecked="{x:Bind Item.Valid, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          Style="{StaticResource AtisCheckBox}" />
                <TextBox Width="60"
                         VerticalAlignment="Center"
                         loc:Uids.Uid="TextBox_ValidYear"
                         Style="{StaticResource AtisTextBox}"
                         Text="{x:Bind Item.ValidYear, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <!--  Author  -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox loc:Uids.Uid="TextBox_Author"
                         Style="{StaticResource AtisTextBox}"
                         Text="{x:Bind Item.Author, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <!--  AuthorYear  -->
                <TextBox Width="60"
                         VerticalAlignment="Center"
                         loc:Uids.Uid="TextBox_AuthorYear"
                         Style="{StaticResource AtisTextBox}"
                         Text="{x:Bind Item.AuthorYear, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <!--  Info  -->
            <StackPanel>
                <TextBox loc:Uids.Uid="TextBox_Info"
                         Style="{StaticResource AtisTextBox}"
                         Text="{x:Bind Item.Info, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <!--  Synonym  -->
            <StackPanel>
                <TextBox loc:Uids.Uid="TextBox_Synonym"
                         Style="{StaticResource AtisTextBox}"
                         Text="{x:Bind Item.Synonym, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         TextWrapping="Wrap" />
            </StackPanel>

            <!--  Language  -->
            <TabView Margin="0,4,0,0">
                <TabViewItem loc:Uids.Uid="TabViewItem_EngName">
                    <StackPanel>
                        <TextBox Style="{StaticResource AtisTextBox}"
                                 Text="{x:Bind Item.EngName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </TabViewItem>
                <TabViewItem loc:Uids.Uid="TabViewItem_GerName">
                    <StackPanel>
                        <TextBox Style="{StaticResource AtisTextBox}"
                                 Text="{x:Bind Item.GerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </TabViewItem>
                <TabViewItem loc:Uids.Uid="TabViewItem_FraName">
                    <StackPanel>
                        <TextBox Style="{StaticResource AtisTextBox}"
                                 Text="{x:Bind Item.FraName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </TabViewItem>
                <TabViewItem loc:Uids.Uid="TabViewItem_SpaName">
                    <StackPanel>
                        <TextBox Style="{StaticResource AtisTextBox}"
                                 Text="{x:Bind Item.PorName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </TabViewItem>

            </TabView>

            <!--  Memo  -->
            <StackPanel>
                <TextBox loc:Uids.Uid="TextBox_Memo"
                         Style="{StaticResource AtisTextBox}"
                         Text="{x:Bind Item.Memo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         TextWrapping="Wrap" />
            </StackPanel>

        </StackPanel>

    </Border>
</UserControl>
