<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="ATIS.Views.Modules.Tbl63Infratribus.Tbl63InfratribusEditControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:WinUI3Localizer"
             x:Name="Root">

    <Border Padding="4"
            Background="{ThemeResource ControlFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="6">

        <StackPanel Spacing="4">

            <!--  HEADER  -->
            <Grid Margin="0,0,0,4"
                  ColumnDefinitions="*,Auto">

                <!--  Titel links  -->
                <TextBlock Grid.Column="0"
                           Margin="8,0,0,0"
                           loc:Uids.Uid="TextBlock_Infratribus"
                           Style="{StaticResource AtisSectionTitleTextStyle}" />

                <!--  Buttons rechts  -->
                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">

                    <!--  BACK  -->
                    <Button Command="{Binding CloseEditCommand}">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6">
                            <FontIcon Glyph="&#xE72B;" />
                            <TextBlock Text="Back" />
                        </StackPanel>
                    </Button>

                    <!--  NEW  -->
                    <Button Command="{Binding NewCommand}"
                            Style="{StaticResource AtisPrimaryButton}">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6">
                            <FontIcon Glyph="&#xE710;" />
                            <TextBlock loc:Uids.Uid="TextBlock_Add" />
                        </StackPanel>
                    </Button>

                    <!--  SAVE  -->
                    <Button Command="{Binding SaveCommand}"
                            Style="{StaticResource AtisSecondaryButton}">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6">
                            <FontIcon Glyph="&#xE74E;" />
                            <TextBlock loc:Uids.Uid="TextBlock_Save" />
                        </StackPanel>
                    </Button>

                    <!--  DELETE  -->
                    <Button Command="{Binding DeleteCommand}"
                            Style="{StaticResource AtisSecondaryButton}">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6">
                            <FontIcon Glyph="&#xE74D;" />
                            <TextBlock loc:Uids.Uid="TextBlock_Delete" />
                        </StackPanel>
                    </Button>

                </StackPanel>
            </Grid>

            <!--  ID + Name + Tribus  -->
            <StackPanel Orientation="Horizontal"
                        Spacing="4">

                <!--  ID (keine Validierung - von DB erzeugt)  -->
                <TextBox MinWidth="110"
                         VerticalAlignment="Top"
                         loc:Uids.Uid="TextBox_InfratribusId"
                         IsReadOnly="True"
                         Style="{StaticResource AtisTextBox}"
                         Text="{Binding Item.InfratribusId, ElementName=Root, Mode=OneWay}" />

                <!--  InfratribusName mit Validierung  -->
                <StackPanel MinWidth="150"
                            VerticalAlignment="Top"
                            Spacing="2">
                    <TextBox x:Name="InfratribusNameBox"
                             loc:Uids.Uid="TextBox_InfratribusName"
                             Loaded="InfratribusNameBox_OnLoaded"
                             Style="{StaticResource AtisTextBox}"
                             Text="{Binding Item.InfratribusName, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             TextChanged="InfratribusNameBox_OnTextChanged" />
                    <TextBlock Height="18"
                               FontSize="10"
                               Foreground="Red"
                               Text="{Binding Item.InfratribusNameError, ElementName=Root, Mode=OneWay}"
                               Visibility="{Binding Item.HasInfratribusNameError, ElementName=Root, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>

                <!--  SubribusName Combo  -->
                <StackPanel MinWidth="150"
                            VerticalAlignment="Top"
                            Spacing="2">
                    <TextBlock Visibility="Collapsed" />
                    <ComboBox x:Name="SubtribusCombo"
                              MinWidth="200"
                              VerticalAlignment="Center"
                              loc:Uids.Uid="ComboBox_SubtribusName"
                              DisplayMemberPath="SubtribusName"
                              ItemsSource="{Binding ViewModel.SubtribusList, ElementName=Root}"
                              SelectedValue="{Binding Item.SubtribusId, ElementName=Root, Mode=TwoWay}"
                              SelectedValuePath="SubtribusId"
                              Style="{StaticResource AtisComboBox}" />
                </StackPanel>

                <!--  CheckBox  -->
                <CheckBox MinWidth="60"
                          VerticalAlignment="Bottom"
                          loc:Uids.Uid="CheckBox_Valid"
                          IsChecked="{Binding Item.Valid, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          Style="{StaticResource AtisCheckBox}" />

                <!--  ValidYear mit Validierung  -->
                <StackPanel MinWidth="60"
                            VerticalAlignment="Top"
                            Spacing="2">
                    <TextBox x:Name="ValidYearBox"
                             loc:Uids.Uid="TextBox_ValidYear"
                             Loaded="ValidYearBox_OnLoaded"
                             Style="{StaticResource AtisTextBox}"
                             Text="{Binding Item.ValidYear, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             TextChanged="ValidYearBox_OnTextChanged" />
                    <TextBlock Height="16"
                               FontSize="10"
                               Foreground="Red"
                               Text="{Binding Item.ValidYearError, ElementName=Root, Mode=OneWay}"
                               Visibility="{Binding Item.HasValidYearError, ElementName=Root, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        Spacing="4">
                <TextBox MinWidth="150"
                         VerticalAlignment="Top"
                         loc:Uids.Uid="TextBox_Author"
                         CharacterCasing="Upper"
                         Style="{StaticResource AtisTextBox}"
                         Text="{Binding Item.Author, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <!--  AuthorYear mit Validierung  -->
                <StackPanel MinWidth="60"
                            VerticalAlignment="Top"
                            Spacing="2">
                    <TextBox x:Name="AuthorYearBox"
                             loc:Uids.Uid="TextBox_AuthorYear"
                             Loaded="AuthorYearBox_OnLoaded"
                             Style="{StaticResource AtisTextBox}"
                             Text="{Binding Item.AuthorYear, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             TextChanged="AuthorYearBox_OnTextChanged" />
                    <TextBlock Height="16"
                               FontSize="10"
                               Foreground="Red"
                               Text="{Binding Item.AuthorYearError, ElementName=Root, Mode=OneWay}"
                               Visibility="{Binding Item.HasAuthorYearError, ElementName=Root, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
            </StackPanel>

            <!--  Info  -->
            <TextBox MinWidth="200"
                     MinHeight="75"
                     MaxHeight="150"
                     loc:Uids.Uid="TextBox_Info"
                     AcceptsReturn="True"
                     Style="{StaticResource AtisTextBox}"
                     Text="{Binding Item.Info, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     TextWrapping="Wrap" />

            <!--  Synonym  -->
            <TextBox MinHeight="75"
                     MaxHeight="150"
                     loc:Uids.Uid="TextBox_Synonym"
                     AcceptsReturn="True"
                     Style="{StaticResource AtisTextBox}"
                     Text="{Binding Item.Synonym, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     TextWrapping="Wrap" />

            <!--  Language Pivot  -->
            <Pivot>
                <PivotItem loc:Uids.Uid="TabViewItem_EngName">
                    <TextBox loc:Uids.Uid="TextBox_EngName"
                             Style="{StaticResource AtisTextBox}"
                             Text="{Binding Item.EngName, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </PivotItem>
                <PivotItem loc:Uids.Uid="TabViewItem_GerName">
                    <TextBox loc:Uids.Uid="TextBox_GerName"
                             Style="{StaticResource AtisTextBox}"
                             Text="{Binding Item.GerName, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </PivotItem>
                <PivotItem loc:Uids.Uid="TabViewItem_FraName">
                    <TextBox loc:Uids.Uid="TextBox_FraName"
                             Style="{StaticResource AtisTextBox}"
                             Text="{Binding Item.FraName, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </PivotItem>
                <PivotItem loc:Uids.Uid="TabViewItem_SpaName">
                    <TextBox loc:Uids.Uid="TextBox_SpaName"
                             Style="{StaticResource AtisTextBox}"
                             Text="{Binding Item.PorName, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </PivotItem>

            </Pivot>

            <!--  Memo  -->
            <TextBox MinHeight="75"
                     MaxHeight="150"
                     loc:Uids.Uid="TextBox_Memo"
                     AcceptsReturn="True"
                     Style="{StaticResource AtisTextBox}"
                     Text="{Binding Item.Memo, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</UserControl>


