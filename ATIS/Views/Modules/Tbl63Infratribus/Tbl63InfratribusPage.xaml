<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="ATIS.Views.Modules.Tbl63Infratribus.Tbl63InfratribusPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:components="using:ATIS.DesignSystem.Components"
      xmlns:layout="using:ATIS.DesignSystem.Layout"
      xmlns:loc="using:WinUI3Localizer"
      xmlns:local="using:ATIS.Views.Modules.Tbl63Infratribus"
      xmlns:tbl66Genus="using:ATIS.Views.Modules.Tbl66Genus"
      xmlns:tbl90Reference="using:ATIS.Views.Modules.Tbl90Reference"
      xmlns:tbl93Comment="using:ATIS.Views.Modules.Tbl93Comment"
      x:Name="RootPage">

    <Grid x:Name="RootGrid">
        <ScrollViewer VerticalScrollBarVisibility="Visible">

            <layout:BaseBossPageLayout>

                <!--  HEADER LEFT  -->
                <layout:BaseBossPageLayout.Header>
                    <StackPanel Margin="8,0,0,8"
                                Orientation="Horizontal"
                                Spacing="10">

                        <TextBlock Margin="0,4,0,0"
                                   loc:Uids.Uid="TextBlock_Infratribusses"
                                   Style="{StaticResource AtisSectionTitleTextStyle}" />

                        <TextBlock Margin="0,12,0,0"
                                   loc:Uids.Uid="TextBlock_DataSetCount"
                                   Style="{StaticResource AtisBodyTextStyle}" />

                        <TextBlock Margin="0,12,0,0"
                                   Style="{StaticResource AtisBodyTextStyle}"
                                   Text="{Binding DataSetCount}" />
                    </StackPanel>
                </layout:BaseBossPageLayout.Header>

                <!--  APPBAR RIGHT  -->
                <layout:BaseBossPageLayout.AppBar>
                    <Grid ColumnSpacing="8">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Margin="8"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">

                            <Button Margin="5,0,5,0"
                                    Command="{Binding NewCommand}"
                                    Style="{StaticResource AtisPrimaryButton}">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="6">
                                    <FontIcon Glyph="&#xE710;" />
                                    <TextBlock loc:Uids.Uid="TextBlock_Add" />
                                </StackPanel>
                            </Button>

                            <Button Margin="5,0,5,0"
                                    Command="{Binding RefreshCommand}"
                                    Style="{StaticResource AtisSecondaryButton}">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="6">
                                    <FontIcon Glyph="&#xE72C;" />
                                    <TextBlock loc:Uids.Uid="TextBlock_Refresh" />
                                </StackPanel>
                            </Button>

                        </StackPanel>

                        <!--  SEARCH  -->
                        <AutoSuggestBox x:Name="SearchBox"
                                        Grid.Column="1"
                                        Width="260"
                                        Height="32"
                                        Margin="12,0"
                                        VerticalAlignment="Center"
                                        PlaceholderText="Suchen..."
                                        QueryIcon="Find"
                                        QuerySubmitted="SearchBox_OnQuerySubmitted"
                                        Text="{Binding SearchText, Mode=TwoWay}" />
                    </Grid>
                </layout:BaseBossPageLayout.AppBar>

                <!--  LIST CONTENT  -->
                <layout:BaseBossPageLayout.ListContent>
                    <local:Tbl63InfratribusBossControl DataContext="{Binding}" />
                </layout:BaseBossPageLayout.ListContent>

                <!--  DETAIL CONTENT  -->
                <layout:BaseBossPageLayout.DetailContent>

                    <Pivot x:Name="DetailPivot"
                           Visibility="{Binding IsInfratribusDetailVisible, Converter={StaticResource BoolToVisibilityConverter}}">

                        <!--  EDIT INFRATRIBUS  -->
                        <PivotItem Header="Edit Infratribus">
                            <ScrollViewer Padding="1">
                                <local:Tbl63InfratribusEditControl DataContext="{x:Bind ViewModel}"
                                                                   Item="{Binding SelectedItem, Mode=TwoWay}" />
                            </ScrollViewer>
                        </PivotItem>

                        <!--  COMMENTS  -->
                        <PivotItem x:Name="CommentsInfratribusPivot"
                                   Header="Comments">
                            <Grid RowDefinitions="Auto,*">

                                <!--  ParentControl: x:Bind  -->
                                <tbl93Comment:Tbl93CommentParentControl Grid.Row="0"
                                                                        DataContext="{x:Bind ViewModel.InfratribusCommentViewModel}" />

                                <!--  EditControl: Binding  -->
                                <tbl93Comment:Tbl93CommentEditControl Grid.Row="1"
                                                                      DataContext="{Binding InfratribusCommentViewModel}"
                                                                      Item="{Binding SelectedItem}"
                                                                      Visibility="{Binding IsCommentDetailVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </Grid>
                        </PivotItem>

                        <!--  REFERENCES  -->
                        <PivotItem x:Name="ReferencesInfratribusPivot"
                                   Header="References">
                            <Grid RowDefinitions="Auto,*">

                                <!--  ParentControl: x:Bind  -->
                                <tbl90Reference:Tbl90ReferenceParentControl Grid.Row="0"
                                                                            DataContext="{x:Bind ViewModel.InfratribusReferenceViewModel}" />

                                <!--  EditControl: Binding  -->
                                <tbl90Reference:Tbl90ReferenceEditControl Grid.Row="1"
                                                                          DataContext="{Binding InfratribusReferenceViewModel}"
                                                                          Item="{Binding SelectedItem}"
                                                                          Visibility="{Binding IsReferenceDetailVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </Grid>
                        </PivotItem>

                        <!--  GENUS  -->
                        <PivotItem x:Name="GenusInfratribusPivot"
                                   Header="Genus">
                            <Grid RowDefinitions="Auto,*">

                                <!--  ParentControl: x:Bind  -->
                                <tbl66Genus:Tbl66GenusParentControl Grid.Row="0"
                                                                    DataContext="{x:Bind ViewModel.GenusViewModel}" />

                                <!--  EditControl: Binding  -->
                                <tbl66Genus:Tbl66GenusEditControl Grid.Row="1"
                                                                  DataContext="{Binding GenusViewModel}"
                                                                  Item="{Binding SelectedItem}"
                                                                  Visibility="{Binding IsGenusDetailVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </Grid>
                        </PivotItem>

                    </Pivot>

                </layout:BaseBossPageLayout.DetailContent>

            </layout:BaseBossPageLayout>

        </ScrollViewer>

        <!--  LOADING OVERLAY  -->
        <components:LoadingOverlayControl Grid.RowSpan="1"
                                          IsLoading="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

    </Grid>
</Page>
