<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="ATIS.Views.Modules.TblCountry.TblCountryEditControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="using:WinUI3Localizer"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Name="Root"
             mc:Ignorable="d">

    <!--    TblCountryEditControl Skriptdatum:   01.10.2026 12:32   -->

    <Border Padding="4"
            Background="{ThemeResource ControlFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="6">

        <StackPanel Spacing="4">

            <!--  HEADER  -->
            <Grid Margin="0,0,0,4"
                  ColumnDefinitions="*,Auto">

                <TextBlock Grid.Column="0"
                           Margin="8,0,0,0"
                           loc:Uids.Uid="TextBlock_Country"
                           Style="{StaticResource AtisSectionTitleTextStyle}" />

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">

                    <!--  BACK  -->

                    <Button Command="{Binding BackCommand}">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6">
                            <FontIcon Glyph="&#xE72B;" />
                            <TextBlock Text="Back" />
                        </StackPanel>
                    </Button>

                    <!--  NEW  -->
                    <Button Command="{Binding NewCommand}"
                            Style="{StaticResource AtisPrimaryButton}">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6">
                            <FontIcon Glyph="&#xE710;" />
                            <TextBlock loc:Uids.Uid="TextBlock_Add" />
                        </StackPanel>
                    </Button>

                    <!--  SAVE  -->
                    <Button Command="{Binding SaveCommand}"
                            Style="{StaticResource AtisSecondaryButton}">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6">
                            <FontIcon Glyph="&#xE74E;" />
                            <TextBlock loc:Uids.Uid="TextBlock_Save" />
                        </StackPanel>
                    </Button>

                    <!--  DELETE  -->
                    <Button Command="{Binding DeleteCommand}"
                            Style="{StaticResource AtisSecondaryButton}">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6">
                            <FontIcon Glyph="&#xE74D;" />
                            <TextBlock loc:Uids.Uid="TextBlock_Delete" />
                        </StackPanel>
                    </Button>

                </StackPanel>
            </Grid>

            <!--  ID + Name   -->
            <StackPanel Orientation="Horizontal"
                        Spacing="4">

                <!--  ID  -->
                <TextBox MinWidth="110"
                         VerticalAlignment="Top"
                         loc:Uids.Uid="TextBox_CountryId"
                         IsReadOnly="True"
                         Style="{StaticResource AtisTextBox}"
                         Text="{Binding Item.CountryId, ElementName=Root}" />

                <!--  CountryName  -->
                <StackPanel MinWidth="150"
                            VerticalAlignment="Top"
                            Spacing="2">
                    <TextBox x:Name="CountryNameBox"
                             loc:Uids.Uid="TextBox_CountryName"
                             Loaded="CountryNameBox_OnLoaded"
                             Style="{StaticResource AtisTextBox}"
                             Text="{Binding Item.Name, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             TextChanged="CountryNameBox_OnTextChanged" />
                    <TextBlock Height="18"
                               FontSize="10"
                               Foreground="Red"
                               Text="{Binding Item.NameError, ElementName=Root}"
                               Visibility="{Binding Item.HasNameError, ElementName=Root, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>

                <!--  NULL Combo  -->
                <!--<StackPanel MinWidth="150"
                            VerticalAlignment="Top"
                            Spacing="2">
                    <TextBlock Visibility="Collapsed" />

                    <ComboBox x:Name="NULLCombo"
                              MinWidth="200"
                              VerticalAlignment="Center"
                              loc:Uids.Uid="ComboBox_NULLName"
                              DisplayMemberPath="NULLName"
                              ItemsSource="{Binding NULLList}"
                              SelectedValue="{Binding Item.NULLId, ElementName=Root, Mode=TwoWay}"
                              SelectedValuePath="NULLId"
                              Style="{StaticResource AtisComboBox}" />
                </StackPanel>-->


                <!--  Regex  -->
                <StackPanel MinWidth="60"
                            VerticalAlignment="Top"
                            Spacing="2">
                    <TextBox x:Name="RegexBox"
                             loc:Uids.Uid="TextBox_Regex"
                             Loaded="RegexBox_OnLoaded"
                             Style="{StaticResource AtisTextBox}"
                             Text="{Binding Item.Regex, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             TextChanged="RegexBox_OnTextChanged" />
                    <TextBlock Height="16"
                               FontSize="10"
                               Foreground="Red"
                               Text="{Binding Item.RegexError, ElementName=Root}"
                               Visibility="{Binding Item.HasRegexError, ElementName=Root, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
            </StackPanel>

            <!--  ZoomLevel  -->
            <TextBox loc:Uids.Uid="TextBox_ZoomLevel"
                     Style="{StaticResource AtisTextBox}"
                     Text="{Binding Item.ZoomLevel, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <!--  Latitude  -->
            <TextBox loc:Uids.Uid="TextBox_Latitude"
                     Style="{StaticResource AtisTextBox}"
                     Text="{Binding Item.Latitude, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <!--  Longitude  -->
            <TextBox loc:Uids.Uid="TextBox_Longitude"
                     Style="{StaticResource AtisTextBox}"
                     Text="{Binding Item.Longitude, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />



        </StackPanel>

    </Border>
</UserControl>  
