<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ATIS.Views.Modules.Tbl60Subtribus.Tbl60SubtribusParentControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:ATIS.Models"
    mc:Ignorable="d">

    <Grid
        Padding="2"
        RowDefinitions="Auto,Auto,*">

        <!-- TOP BAR -->
        <Grid
            Grid.Row="0"
            Margin="0,0,0,8"
            ColumnDefinitions="*,Auto">
            <StackPanel
                Orientation="Horizontal"
                Spacing="10"
                Margin="8,0,0,8">
                <TextBlock
                    Text="Subtribus"
                    FontSize="20"
                    FontWeight="Bold" />
                <TextBlock
                    Text="("
                    VerticalAlignment="Center" />
                <TextBlock
                    Text="{Binding DataSetCount}"
                    VerticalAlignment="Center" />
                <TextBlock
                    Text=")"
                    VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                VerticalAlignment="Center"
                Margin="0,0,8,0">
                <Button
                    Command="{Binding NewCommand}">
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="6">
                        <FontIcon
                            Glyph="&#xE710;" />
                        <TextBlock
                            Text="Neu" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- LIST HEADER -->
        <Grid
            Grid.Row="1"
            Padding="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition
                    Width="120" />
                <ColumnDefinition
                    Width="200" />
                <ColumnDefinition
                    Width="200" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                Text="ID"
                FontWeight="Bold" />
            <TextBlock
                Grid.Column="1"
                Text="Subtribus"
                FontWeight="Bold" />
            <TextBlock
                Grid.Column="2"
                Text="Tribus"
                FontWeight="Bold" />
        </Grid>

        <!-- LIST -->
        <ListView
            x:Name="SubtribusListView"
            Grid.Row="2"
            ItemsSource="{Binding Items}"
            SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
            SelectionMode="Single"
            IsItemClickEnabled="True"
            ItemClick="SubtribusListView_ItemClick">

            <ListView.ItemTemplate>
                <DataTemplate
                    x:DataType="models:Tbl60Subtribus">
                    <Grid
                        Padding="4"
                        ColumnDefinitions="120,200,200">

                        <TextBlock
                            Grid.Column="0"
                            Text="{x:Bind SubtribusId}" />
                        <TextBlock
                            Grid.Column="1"
                            Text="{x:Bind SubtribusName}" />
                        <TextBlock
                            Grid.Column="2"
                            Text="{x:Bind Tribus.TribusName}" />

                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>

        </ListView>

    </Grid>
</UserControl>
