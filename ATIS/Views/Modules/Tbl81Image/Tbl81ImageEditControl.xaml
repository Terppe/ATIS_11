<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="ATIS.Views.Modules.Tbl81Image.Tbl81ImageEditControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="using:WinUI3Localizer"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Name="Root"
             mc:Ignorable="d">

    <!--  Tbl81ImageEditControl Skriptdatum:  13.09.2026  10:32  -->

    <Border Padding="4"
            Background="{ThemeResource ControlFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="6">

        <StackPanel Spacing="4">

            <!--  HEADER  -->
            <Grid Margin="0,0,8,4"
                  ColumnDefinitions="*,Auto">

                <TextBlock Grid.Column="0"
                           Margin="8,0,0,0"
                           loc:Uids.Uid="TextBlock_Image"
                           Style="{StaticResource AtisSectionTitleTextStyle}" />

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">

                    <!--  BACK  -->
                    <Button Command="{Binding BackCommand}">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6">
                            <FontIcon Glyph="&#xE72B;" />
                            <TextBlock Text="Back" />
                        </StackPanel>
                    </Button>

                    <!--  NEW  -->
                    <Button Command="{Binding NewCommand}"
                            Style="{StaticResource AtisPrimaryButton}">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6">
                            <FontIcon Glyph="&#xE710;" />
                            <TextBlock loc:Uids.Uid="TextBlock_Add" />
                        </StackPanel>
                    </Button>

                    <!--  SAVE  -->
                    <Button Command="{Binding SaveCommand}"
                            IsEnabled="{Binding CanSave}"
                            Style="{StaticResource AtisSecondaryButton}">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6">
                            <FontIcon Glyph="&#xE74E;" />
                            <TextBlock loc:Uids.Uid="TextBlock_Save" />
                        </StackPanel>
                    </Button>

                    <!--  DELETE  -->
                    <Button Command="{Binding DeleteCommand}"
                            IsEnabled="{Binding CanSave}"
                            Style="{StaticResource AtisSecondaryButton}">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6">
                            <FontIcon Glyph="&#xE74D;" />
                            <TextBlock loc:Uids.Uid="TextBlock_Delete" />
                        </StackPanel>
                    </Button>

                    <Button Click="SelectFileButton_Click"
                            IsEnabled="{Binding Item, ElementName=Root, Converter={StaticResource NullToBoolConverter}}"
                            Style="{StaticResource AtisSecondaryButton}">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6">
                            <FontIcon Glyph="&#xE8B7;" />
                            <TextBlock loc:Uids.Uid="TextBlock_SelectFile" />
                        </StackPanel>
                    </Button>

                    <Button Click="LoadFromClipboardButton_Click"
                            IsEnabled="{Binding Item, ElementName=Root, Converter={StaticResource NullToBoolConverter}}"
                            Style="{StaticResource AtisSecondaryButton}">
                        <ToolTipService.ToolTip>
                            <ToolTip loc:Uids.Uid="Tooltip_LoadFromClipboard" />
                        </ToolTipService.ToolTip>

                        <StackPanel Orientation="Horizontal"
                                    Spacing="6">
                            <FontIcon Glyph="&#xE8A5;" />
                            <TextBlock loc:Uids.Uid="TextBlock_LoadFromClipboard" />
                        </StackPanel>
                    </Button>

                    <Button Click="OpenPreviewButton_Click"
                            IsEnabled="{Binding CanSave}"
                            Style="{StaticResource AtisSecondaryButton}">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6">
                            <FontIcon Glyph="&#xEB9F;" />
                            <TextBlock loc:Uids.Uid="TextBlock_ShowMedia" />
                        </StackPanel>
                    </Button>

                </StackPanel>
            </Grid>

            <!--  ID + Name  -->
            <StackPanel Orientation="Horizontal"
                        Spacing="4">

                <!--  ID  -->
                <TextBox MinWidth="110"
                         VerticalAlignment="Top"
                         loc:Uids.Uid="TextBox_ImageId"
                         IsReadOnly="True"
                         Style="{StaticResource AtisTextBox}"
                         Text="{Binding Item.ImageId, ElementName=Root}" />

                <!--  GenusSpeciesSubspeciesDiversName  -->
                <TextBox loc:Uids.Uid="TextBox_GenusSpeciesName"
                         IsReadOnly="True"
                         Style="{StaticResource AtisTextBox}"
                         Text="{Binding Item.GenusSpeciesFullName, ElementName=Root, Mode=OneWay}"
                         Visibility="{Binding IsSpeciesParent, Converter={StaticResource BoolToVisibilityConverter}}" />
                <!--<TextBox loc:Uids.Uid="TextBox_GenusSpeciesName"
                IsReadOnly="True"
                Style="{StaticResource AtisTextBox}"
                Text="{Binding Item.GenusSpeciesFullName, ElementName=Root, Mode=OneWay}" />-->

                <!--  Valid  -->
                <CheckBox MinWidth="60"
                          VerticalAlignment="Bottom"
                          loc:Uids.Uid="CheckBox_Valid"
                          IsChecked="{Binding Item.Valid, ElementName=Root, Mode=TwoWay}"
                          Style="{StaticResource AtisCheckBox}" />

                <!--  ValidYear  -->
                <StackPanel MinWidth="60"
                            VerticalAlignment="Top"
                            Spacing="2">
                    <TextBox x:Name="ValidYearBox"
                             loc:Uids.Uid="TextBox_ValidYear"
                             Loaded="ValidYearBox_OnLoaded"
                             Style="{StaticResource AtisTextBox}"
                             Text="{Binding Item.ValidYear, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             TextChanged="ValidYearBox_OnTextChanged" />
                    <TextBlock Height="16"
                               FontSize="10"
                               Foreground="Red"
                               Text="{Binding Item.ValidYearError, ElementName=Root}"
                               Visibility="{Binding Item.HasValidYearError, ElementName=Root, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>

                <!--  ImageMimeType  -->
                <ComboBox x:Name="ImageMimeTypeCombo"
                          MinWidth="90"
                          VerticalAlignment="Center"
                          loc:Uids.Uid="ComboBox_ImageMimeType"
                          PlaceholderText="Select"
                          SelectedItem="{Binding Item.ImageMimeType, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          SelectionChanged="ComboImageMimeType_OnSelectionChanged"
                          Style="{StaticResource AtisComboBox}">
                    <x:String>jpg</x:String>
                    <x:String>png</x:String>
                    <x:String>bmp</x:String>
                    <x:String>tif</x:String>
                    <x:String>tiff</x:String>
                    <x:String>gif</x:String>
                    <x:String>ico</x:String>
                    <x:String>jpeg</x:String>
                    <x:String>webp</x:String>
                    <x:String>wmf</x:String>
                    <x:String>wmv</x:String>
                    <x:String>mpg</x:String>
                    <x:String>mp3</x:String>
                    <x:String>wav</x:String>
                    <x:String>m4a</x:String>
                    <x:String>mp4</x:String>
                    <x:String>avi</x:String>
                    <x:String>mov</x:String>
                    <x:String>swf</x:String>
                    <x:String>flv</x:String>
                </ComboBox>

                <!--  ShotDate  -->
                <StackPanel Spacing="4">
                    <TextBlock loc:Uids.Uid="TextBlock_ShotDate" />

                    <Border x:Name="ShotDateBorder"
                            MinHeight="32"
                            Padding="0,0"
                            Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource AtisTextBoxBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">

                        <DatePicker x:Name="DpShotDate"
                                    Width="300"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="{ThemeResource AtisTextBoxForegroundBrush}"
                                    GotFocus="DpShotDate_OnGotFocus"
                                    LostFocus="DpShotDate_OnLostFocus"
                                    SelectedDate="{Binding Item.ShotDateOffset, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Border>
                </StackPanel>
            </StackPanel>

            <!--  Info  -->
            <TextBox loc:Uids.Uid="TextBox_Info"
                     Style="{StaticResource AtisTextBox}"
                     Text="{Binding Item.Info, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <!--  Memo  -->
            <TextBox MinWidth="200"
                     MinHeight="75"
                     MaxHeight="150"
                     loc:Uids.Uid="TextBox_Memo"
                     Style="{StaticResource AtisTextBoxWrap}"
                     Text="{Binding Item.Memo, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

    </Border>
</UserControl>
