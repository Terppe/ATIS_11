<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="ATIS.Views.Modules.Tbl81Image.Tbl81ImagePreviewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="using:WinUI3Localizer"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid Background="Black"
          RowDefinitions="Auto,*">
        <StackPanel x:Name="ImageToolbar"
                    Padding="8"
                    Orientation="Horizontal"
                    Spacing="8">

            <Button Click="Zoom100Button_Click"
                    Style="{StaticResource AtisSecondaryButton}">
                <StackPanel Orientation="Horizontal"
                            Spacing="6">
                    <FontIcon Glyph="&#xE8A3;" />
                    <TextBlock loc:Uids.Uid="TextBlock_HundredPercent" />
                </StackPanel>
            </Button>

            <Button Click="FitButton_Click"
                    Style="{StaticResource AtisSecondaryButton}">
                <StackPanel Orientation="Horizontal"
                            Spacing="6">
                    <FontIcon Glyph="&#xE90F;" />
                    <TextBlock loc:Uids.Uid="TextBlock_Fit" />
                </StackPanel>
            </Button>

            <Button Click="ZoomInButton_Click"
                    Style="{StaticResource AtisSecondaryButton}">
                <StackPanel Orientation="Horizontal"
                            Spacing="6">
                    <FontIcon Glyph="&#xE8A3;" />
                    <TextBlock loc:Uids.Uid="TextBlock_ZoomIn" />
                </StackPanel>
            </Button>

            <Button Click="ZoomOutButton_Click"
                    Style="{StaticResource AtisSecondaryButton}">
                <StackPanel Orientation="Horizontal"
                            Spacing="6">
                    <FontIcon Glyph="&#xE71F;" />
                    <TextBlock loc:Uids.Uid="TextBlock_ZoomOut" />
                </StackPanel>
            </Button>

            <Button Click="CloseWindowButton_Click"
                    Style="{StaticResource AtisSecondaryButton}">
                <StackPanel Orientation="Horizontal"
                            Spacing="6">
                    <FontIcon Glyph="&#xE8BB;" />
                    <TextBlock loc:Uids.Uid="TextBlock_Close" />
                </StackPanel>
            </Button>

        </StackPanel>

        <Grid Grid.Row="1">
            <ScrollViewer x:Name="ImageScrollViewer"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                <Grid x:Name="ImageHost"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top">
                    <Image x:Name="PreviewImage"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           Stretch="None">
                        <Image.RenderTransform>
                            <ScaleTransform x:Name="ImageScaleTransform" ScaleX="1" ScaleY="1" />
                        </Image.RenderTransform>
                    </Image>
                </Grid>
            </ScrollViewer>

            <Grid x:Name="MediaGrid"
                  Visibility="Collapsed">
                <MediaPlayerElement x:Name="VideoPlayer"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    AreTransportControlsEnabled="True"
                                    AutoPlay="False"
                                    IsTabStop="True" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
