<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="ATIS.Views.Modules.TblUserProfile.TblUserProfileBossControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="using:WinUI3Localizer"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="using:ATIS.Models"
             mc:Ignorable="d">

    <!--    TblUserProfileBossControl Skriptdatum:   10.10.2026  10:32 -->

    <UserControl.Resources>
        <GridLength x:Key="IdWidthResource">120</GridLength>
        <GridLength x:Key="Extra1WidthResource">200</GridLength>
        <GridLength x:Key="Extra2WidthResource">200</GridLength>
        <GridLength x:Key="Extra3WidthResource">80</GridLength>
        <GridLength x:Key="Extra4WidthResource">100</GridLength>
        <GridLength x:Key="Extra5WidthResource">250</GridLength>
        <GridLength x:Key="Extra6WidthResource">80</GridLength>
    </UserControl.Resources>

    <Grid Padding="2"
          RowDefinitions="Auto,*">

        <!--  HEADER  -->
        <Grid Padding="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{StaticResource IdWidthResource}" />
                <ColumnDefinition Width="{StaticResource Extra1WidthResource}" />
                <ColumnDefinition Width="{StaticResource Extra2WidthResource}" />
                <ColumnDefinition Width="{StaticResource Extra3WidthResource}" />
                <ColumnDefinition Width="{StaticResource Extra4WidthResource}" />
                <ColumnDefinition Width="{StaticResource Extra5WidthResource}" />
                <ColumnDefinition Width="{StaticResource Extra6WidthResource}" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{x:Bind ViewModel.SortCommand}"
                    CommandParameter="Id"
                    FontWeight="Bold">
                <TextBlock Text="{x:Bind ViewModel.IdHeaderText, Mode=OneWay}" />
            </Button>

            <Button Grid.Column="1"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{x:Bind ViewModel.SortCommand}"
                    CommandParameter="Name"
                    FontWeight="Bold">
                <TextBlock Text="{x:Bind ViewModel.NameHeaderText, Mode=OneWay}" />
            </Button>

            <TextBlock Grid.Column="2"
                       Margin="0,6,0,0"
                       loc:Uids.Uid="TextBlock_FirstName"
                       FontWeight="Bold" />

            <TextBlock Grid.Column="3"
                       Margin="0,6,0,0"
                       loc:Uids.Uid="TextBlock_LastName"
                       FontWeight="Bold" />
            <TextBlock Grid.Column="4"
                       Margin="0,6,0,0"
                       loc:Uids.Uid="TextBlock_FilestreamId"
                       FontWeight="Bold" />
            <!--<TextBlock Grid.Column="5"
            Margin="0,6,0,0"
            loc:Uids.Uid="TextBlock_Author"
            FontWeight="Bold" />
            <TextBlock Grid.Column="6"
            Margin="0,6,0,0"
            loc:Uids.Uid="TextBlock_Year"
            FontWeight="Bold" />-->
        </Grid>

        <ListView x:Name="UserProfileListView"
                  Grid.Row="1"
                  MaxHeight="150"
                  Margin="0,0,10,0"
                  BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                  BorderThickness="1"
                  CornerRadius="4"
                  IsItemClickEnabled="True"
                  ItemContainerStyle="{StaticResource AtisListViewItemStyle}"
                  ItemsSource="{Binding Items}"
                  RightTapped="UserProfileListView_RightTapped"
                  SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                  SelectionMode="Single">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:TblUserProfile">
                    <Grid Style="{StaticResource AtisListRowGridStyle}">

                        <!--  Kontextmenü direkt am Row-Root  -->
                        <Grid.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem loc:Uids.Uid="MenuFlyout_Add_UserProfile"
                                                Command="{Binding DataContext.NewCommand, ElementName=UserProfileListView}">
                                    <MenuFlyoutItem.Icon>
                                        <SymbolIcon Symbol="Add" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem loc:Uids.Uid="MenuFlyout_Save_UserProfile"
                                                Command="{Binding DataContext.SaveCommand, ElementName=UserProfileListView}"
                                                CommandParameter="{Binding}">
                                    <MenuFlyoutItem.Icon>
                                        <SymbolIcon Symbol="Save" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem loc:Uids.Uid="MenuFlyout_Delete_UserProfile"
                                                Command="{Binding DataContext.DeleteCommand, ElementName=UserProfileListView}"
                                                CommandParameter="{Binding}">
                                    <MenuFlyoutItem.Icon>
                                        <SymbolIcon Symbol="Delete" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem loc:Uids.Uid="MenuFlyout_Refresh"
                                                Command="{Binding DataContext.RefreshCommand, ElementName=UserProfileListView}">
                                    <MenuFlyoutItem.Icon>
                                        <SymbolIcon Symbol="Refresh" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Grid.ContextFlyout>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource IdWidthResource}" />
                            <ColumnDefinition Width="{StaticResource Extra1WidthResource}" />
                            <ColumnDefinition Width="{StaticResource Extra2WidthResource}" />
                            <ColumnDefinition Width="{StaticResource Extra3WidthResource}" />
                            <ColumnDefinition Width="{StaticResource Extra4WidthResource}" />
                            <ColumnDefinition Width="{StaticResource Extra5WidthResource}" />
                            <ColumnDefinition Width="{StaticResource Extra6WidthResource}" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Margin="4,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="{x:Bind UserProfileId}" />
                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Text="{x:Bind Email}" />

                        <TextBlock Grid.Column="2"
                                   VerticalAlignment="Center"
                                   Text="{x:Bind FirstName}" />

                        <TextBlock Grid.Column="3"
                                   VerticalAlignment="Center"
                                   Text="{x:Bind LastName}" />
                        <!--<CheckBox Grid.Column="4"
                        IsChecked="{x:Bind Valid}"
                        IsEnabled="False"
                        IsTabStop="False" />-->
                        <!--<TextBlock Grid.Column="6"
                        VerticalAlignment="Center"
                        Text="{x:Bind AuthorYear}" />-->

                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>

            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsStackPanel />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>

        </ListView>
    </Grid>
</UserControl>
