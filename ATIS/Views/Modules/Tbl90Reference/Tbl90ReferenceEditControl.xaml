<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="ATIS.Views.Modules.Tbl90Reference.Tbl90ReferenceEditControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:WinUI3Localizer"
             x:Name="Root">

    <Border Padding="4"
            Background="{ThemeResource ControlFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="6">

        <StackPanel Spacing="4">

            <!--  HEADER  -->
            <Grid Margin="0,0,0,4"
                  ColumnDefinitions="*,Auto">

                <!--  Titel links  -->
                <TextBlock Grid.Column="0"
                           Margin="8,0,0,0"
                           loc:Uids.Uid="TextBlock_Reference"
                           Style="{StaticResource AtisSectionTitleTextStyle}" />

                <!--  Buttons rechts  -->
                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">

                    <Button Command="{Binding CloseEditCommand}">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6">
                            <FontIcon Glyph="&#xE72B;" />
                            <TextBlock Text="Back" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NewCommand}"
                            Style="{StaticResource AtisPrimaryButton}">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6">
                            <FontIcon Glyph="&#xE710;" />
                            <TextBlock loc:Uids.Uid="TextBlock_Add" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding SaveCommand}"
                            Style="{StaticResource AtisSecondaryButton}">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6">
                            <FontIcon Glyph="&#xE74E;" />
                            <TextBlock loc:Uids.Uid="TextBlock_Save" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding DeleteCommand}"
                            Style="{StaticResource AtisSecondaryButton}">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6">
                            <FontIcon Glyph="&#xE74D;" />
                            <TextBlock loc:Uids.Uid="TextBlock_Delete" />
                        </StackPanel>
                    </Button>

                </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal"
                        Spacing="4">

                <!--  ReferenceId  -->
                <TextBox Width="120"
                         loc:Uids.Uid="TextBox_ReferenceId"
                         IsReadOnly="True"
                         Style="{StaticResource AtisTextBox}"
                         Text="{Binding Item.ReferenceId, ElementName=Root, Mode=OneWay}" />

                <!--  Valid  -->
                <CheckBox MinWidth="60"
                          VerticalAlignment="Bottom"
                          loc:Uids.Uid="CheckBox_Valid"
                          IsChecked="{Binding Item.Valid, Mode=TwoWay, ElementName=Root, UpdateSourceTrigger=PropertyChanged}"
                          Style="{StaticResource AtisCheckBox}" />

                <!--  ValidYear  -->
                <StackPanel MinWidth="60"
                            VerticalAlignment="Top"
                            Spacing="2">
                    <TextBox x:Name="ValidYearBox"
                             loc:Uids.Uid="TextBox_ValidYear"
                             Loaded="ValidYearBox_OnLoaded"
                             Style="{StaticResource AtisTextBox}"
                             Text="{Binding Item.ValidYear, Mode=TwoWay, ElementName=Root, UpdateSourceTrigger=PropertyChanged}"
                             TextChanged="ValidYearBox_OnTextChanged" />
                    <TextBlock Height="16"
                               FontSize="10"
                               Foreground="Red"
                               Text="{Binding Item.ValidYearError, Mode=OneWay, ElementName=Root}"
                               Visibility="{Binding Item.HasValidYearError, Mode=OneWay, ElementName=Root, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
            </StackPanel>

            <StackPanel x:Name="ExpertPanel"
                        Orientation="Horizontal"
                        Spacing="4">

                <!--  RefExpertId  -->
                <TextBox Width="120"
                         loc:Uids.Uid="TextBox_ReferenceExpertId"
                         IsReadOnly="True"
                         Style="{StaticResource AtisTextBox}"
                         Text="{Binding Item.RefExpertId, Mode=OneWay, ElementName=Root}" />

                <!--  Combo  -->
                <StackPanel MinWidth="150"
                            VerticalAlignment="Top"
                            Spacing="2">
                    <TextBlock Visibility="Collapsed" />
                    <ComboBox x:Name="RefExpertCombo"
                              MinWidth="200"
                              loc:Uids.Uid="ComboBox_RefExpertName"
                              DisplayMemberPath="RefExpertName"
                              ItemsSource="{Binding RefExpertsList}"
                              SelectedValue="{Binding Item.RefExpertId, Mode=TwoWay, ElementName=Root}"
                              SelectedValuePath="RefExpertId"
                              SelectionChanged="OnRefExpertChanged"
                              Style="{StaticResource AtisComboBox}" />
                </StackPanel>
            </StackPanel>

            <StackPanel x:Name="SourcePanel"
                        Orientation="Horizontal"
                        Spacing="4">
                <!--  RefSourceId  -->
                <TextBox Width="120"
                         loc:Uids.Uid="TextBox_ReferenceSourceId"
                         IsReadOnly="True"
                         Style="{StaticResource AtisTextBox}"
                         Text="{Binding Item.RefSourceId, Mode=OneWay, ElementName=Root}" />

                <!--  RefSource  -->
                <StackPanel MinWidth="150"
                            VerticalAlignment="Top"
                            Spacing="2">
                    <TextBlock Visibility="Collapsed" />
                    <ComboBox x:Name="RefSourceCombo"
                              MinWidth="400"
                              VerticalAlignment="Center"
                              loc:Uids.Uid="ComboBox_RefSourceName"
                              DisplayMemberPath="RefSourceName"
                              ItemsSource="{Binding RefSourcesList}"
                              SelectedValue="{Binding Item.RefSourceId, Mode=TwoWay, ElementName=Root}"
                              SelectedValuePath="RefSourceId"
                              SelectionChanged="OnRefSourceChanged"
                              Style="{StaticResource AtisComboBox}" />
                </StackPanel>
            </StackPanel>

            <StackPanel x:Name="AuthorPanel"
                        Orientation="Horizontal"
                        Spacing="4">
                <!--  RefAuthorId  -->
                <TextBox Width="120"
                         loc:Uids.Uid="TextBox_ReferenceAuthorId"
                         IsReadOnly="True"
                         Style="{StaticResource AtisTextBox}"
                         Text="{Binding Item.RefAuthorId, Mode=OneWay, ElementName=Root}" />

                <!--  RefAuthor  -->
                <StackPanel MinWidth="150"
                            VerticalAlignment="Top"
                            Spacing="2">
                    <TextBlock Visibility="Collapsed" />
                    <ComboBox x:Name="RefAuthorCombo"
                              MinWidth="600"
                              VerticalAlignment="Center"
                              loc:Uids.Uid="ComboBox_RefAuthorName"
                              DisplayMemberPath="RefAuthorName"
                              ItemsSource="{Binding RefAuthorsList}"
                              SelectedValue="{Binding Item.RefAuthorId, Mode=TwoWay, ElementName=Root}"
                              SelectedValuePath="RefAuthorId"
                              SelectionChanged="OnRefAuthorChanged"
                              Style="{StaticResource AtisComboBox}" />
                </StackPanel>
            </StackPanel>

            <!--  Info mit Validierung  -->
            <StackPanel MinWidth="300"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Spacing="2">

                <TextBox x:Name="InfoBox"
                         loc:Uids.Uid="TextBox_Info"
                         Loaded="InfoBox_OnLoaded"
                         Style="{StaticResource AtisTextBox}"
                         Text="{Binding Item.Info, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ElementName=Root}"
                         TextChanged="InfoBox_OnTextChanged" />

                <TextBlock Height="16"
                           FontSize="10"
                           Foreground="Red"
                           Text="{Binding Item.InfoError, Mode=OneWay, ElementName=Root}"
                           Visibility="{Binding Item.HasInfoError, Mode=OneWay, ElementName=Root, Converter={StaticResource BoolToVisibilityConverter}}" />
            </StackPanel>

            <!--  Tabellen Tab  -->
            <Grid RowDefinitions="Auto, Auto">
                <StackPanel Margin="0,0,0,10"
                            Orientation="Horizontal"
                            Spacing="4">

                    <Button x:Name="SpeciesGenusTab"
                            Click="DetailTabButton_Click"
                            Style="{StaticResource TabButtonStyle}"
                            Tag="0">
                        <StackPanel Spacing="4">
                            <TextBlock HorizontalAlignment="Center"
                                       loc:Uids.Uid="TextBlock_SpeciesGenus" />
                            <Border x:Name="SpeciesGenusTabUnderline"
                                    Height="2"
                                    Background="Transparent" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="TribusTab"
                            Click="DetailTabButton_Click"
                            Style="{StaticResource TabButtonStyle}"
                            Tag="1">
                        <StackPanel Spacing="4">
                            <TextBlock HorizontalAlignment="Center"
                                       loc:Uids.Uid="TextBlock_Tribus" />
                            <Border x:Name="TribusTabUnderline"
                                    Height="2"
                                    Background="Transparent" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="FamilyTab"
                            Click="DetailTabButton_Click"
                            Style="{StaticResource TabButtonStyle}"
                            Tag="2">
                        <StackPanel Spacing="4">
                            <TextBlock HorizontalAlignment="Center"
                                       loc:Uids.Uid="TextBlock_Family" />
                            <Border x:Name="FamilyTabUnderline"
                                    Height="2"
                                    Background="Transparent" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="OrdoTab"
                            Click="DetailTabButton_Click"
                            Style="{StaticResource TabButtonStyle}"
                            Tag="3">
                        <StackPanel Spacing="4">
                            <TextBlock HorizontalAlignment="Center"
                                       loc:Uids.Uid="TextBlock_Ordo" />
                            <Border x:Name="OrdoTabUnderline"
                                    Height="2"
                                    Background="Transparent" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="ClassTab"
                            Click="DetailTabButton_Click"
                            Style="{StaticResource TabButtonStyle}"
                            Tag="4">
                        <StackPanel Spacing="4">
                            <TextBlock HorizontalAlignment="Center"
                                       loc:Uids.Uid="TextBlock_Class" />
                            <Border x:Name="ClassTabUnderline"
                                    Height="2"
                                    Background="Transparent" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="PhylumRegnumTab"
                            Click="DetailTabButton_Click"
                            Style="{StaticResource TabButtonStyle}"
                            Tag="5">
                        <StackPanel Spacing="4">
                            <TextBlock HorizontalAlignment="Center"
                                       loc:Uids.Uid="TextBlock_PhylumRegnum" />
                            <Border x:Name="PhylumRegnumTabUnderline"
                                    Height="2"
                                    Background="Transparent" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Grid x:Name="TabContentGrid"
                      Grid.Row="1">

                    <Grid x:Name="SpeciesGenusGrid"
                          Visibility="Collapsed">
                        <StackPanel MinWidth="150"
                                    VerticalAlignment="Top"
                                    Orientation="Horizontal"
                                    Spacing="4">
                            <TextBlock Visibility="Collapsed" />
                            <ComboBox x:Name="SpeciesCombo"
                                      MinWidth="200"
                                      VerticalAlignment="Center"
                                      loc:Uids.Uid="ComboBox_SpeciesName"
                                      DisplayMemberPath="SpeciesName"
                                      ItemsSource="{Binding ViewModel.SpeciesList, ElementName=Root}"
                                      SelectedValue="{Binding Item.SpeciesId, ElementName=Root, Mode=TwoWay}"
                                      SelectedValuePath="SpeciesId"
                                      Style="{StaticResource AtisComboBox}" />
                            <ComboBox x:Name="GenusCombo"
                                      MinWidth="200"
                                      VerticalAlignment="Center"
                                      loc:Uids.Uid="ComboBox_GenusName"
                                      DisplayMemberPath="GenusName"
                                      ItemsSource="{Binding ViewModel.GenusList, ElementName=Root}"
                                      SelectedValue="{Binding Item.GenusId, ElementName=Root, Mode=TwoWay}"
                                      SelectedValuePath="GenusId"
                                      Style="{StaticResource AtisComboBox}" />
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="TribusGrid"
                          Visibility="Collapsed">
                        <StackPanel MinWidth="150"
                                    VerticalAlignment="Top"
                                    Orientation="Horizontal"
                                    Spacing="4">
                            <TextBlock Visibility="Collapsed" />

                            <ComboBox x:Name="InfratribusCombo"
                                      MinWidth="200"
                                      VerticalAlignment="Center"
                                      loc:Uids.Uid="ComboBox_InfratribusName"
                                      DisplayMemberPath="InfratribusName"
                                      ItemsSource="{Binding ViewModel.InfratribusList, ElementName=Root}"
                                      SelectedValue="{Binding Item.InfratribusId, ElementName=Root, Mode=TwoWay}"
                                      SelectedValuePath="InfratribusId"
                                      Style="{StaticResource AtisComboBox}" />

                            <ComboBox x:Name="SubtribusCombo"
                                      MinWidth="200"
                                      VerticalAlignment="Center"
                                      loc:Uids.Uid="ComboBox_SubtribusName"
                                      DisplayMemberPath="SubtribusName"
                                      ItemsSource="{Binding ViewModel.SubtribusList, ElementName=Root}"
                                      SelectedValue="{Binding Item.SubtribusId, ElementName=Root, Mode=TwoWay}"
                                      SelectedValuePath="SubtribusId"
                                      Style="{StaticResource AtisComboBox}" />

                            <ComboBox x:Name="TribusCombo"
                                      MinWidth="200"
                                      VerticalAlignment="Center"
                                      loc:Uids.Uid="ComboBox_TribusName"
                                      DisplayMemberPath="TribusName"
                                      ItemsSource="{Binding ViewModel.TribusList, ElementName=Root}"
                                      SelectedValue="{Binding Item.TribusId, ElementName=Root, Mode=TwoWay}"
                                      SelectedValuePath="TribusId"
                                      Style="{StaticResource AtisComboBox}" />
                            <ComboBox x:Name="SupertribusCombo"
                                      MinWidth="200"
                                      VerticalAlignment="Center"
                                      loc:Uids.Uid="ComboBox_SupertribusName"
                                      DisplayMemberPath="SupertribusName"
                                      ItemsSource="{Binding ViewModel.SupertribusList, ElementName=Root}"
                                      SelectedValue="{Binding Item.SupertribusId, ElementName=Root, Mode=TwoWay}"
                                      SelectedValuePath="SupertribusId"
                                      Style="{StaticResource AtisComboBox}" />
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="FamilyGrid"
                          Visibility="Collapsed">
                        <StackPanel MinWidth="150"
                                    VerticalAlignment="Top"
                                    Orientation="Horizontal"
                                    Spacing="4">
                            <TextBlock Visibility="Collapsed" />
                            <ComboBox x:Name="InfrafamilyCombo"
                                      MinWidth="200"
                                      VerticalAlignment="Center"
                                      loc:Uids.Uid="ComboBox_InfrafamilyName"
                                      DisplayMemberPath="InfrafamilyName"
                                      ItemsSource="{Binding ViewModel.InfrafamilyList, ElementName=Root}"
                                      SelectedValue="{Binding Item.InfrafamilyId, ElementName=Root, Mode=TwoWay}"
                                      SelectedValuePath="InfrafamilyId"
                                      Style="{StaticResource AtisComboBox}" />

                            <ComboBox x:Name="SubfamilyCombo"
                                      MinWidth="200"
                                      VerticalAlignment="Center"
                                      loc:Uids.Uid="ComboBox_SubfamilyName"
                                      DisplayMemberPath="SubfamilyName"
                                      ItemsSource="{Binding ViewModel.SubfamilyList, ElementName=Root}"
                                      SelectedValue="{Binding Item.SubfamilyId, ElementName=Root, Mode=TwoWay}"
                                      SelectedValuePath="SubfamilyId"
                                      Style="{StaticResource AtisComboBox}" />

                            <ComboBox x:Name="FamilyCombo"
                                      MinWidth="200"
                                      VerticalAlignment="Center"
                                      loc:Uids.Uid="ComboBox_FamilyName"
                                      DisplayMemberPath="FamilyName"
                                      ItemsSource="{Binding ViewModel.FamilyList, ElementName=Root}"
                                      SelectedValue="{Binding Item.FamilyId, ElementName=Root, Mode=TwoWay}"
                                      SelectedValuePath="FamilyId"
                                      Style="{StaticResource AtisComboBox}" />

                            <ComboBox x:Name="SuperfamilyCombo"
                                      MinWidth="200"
                                      VerticalAlignment="Center"
                                      loc:Uids.Uid="ComboBox_SuperfamilyName"
                                      DisplayMemberPath="SuperfamilyName"
                                      ItemsSource="{Binding ViewModel.SuperfamilyList, ElementName=Root}"
                                      SelectedValue="{Binding Item.SuperfamilyId, ElementName=Root, Mode=TwoWay}"
                                      SelectedValuePath="SuperfamilyId"
                                      Style="{StaticResource AtisComboBox}" />
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="OrderGrid"
                          Visibility="Collapsed">
                        <StackPanel MinWidth="150"
                                    VerticalAlignment="Top"
                                    Orientation="Horizontal"
                                    Spacing="4">
                            <TextBlock Visibility="Collapsed" />

                            <ComboBox x:Name="InfraordoCombo"
                                      MinWidth="200"
                                      VerticalAlignment="Center"
                                      loc:Uids.Uid="ComboBox_InfraordoName"
                                      DisplayMemberPath="InfraordoName"
                                      ItemsSource="{Binding ViewModel.InfraordoList, ElementName=Root}"
                                      SelectedValue="{Binding Item.InfraordoId, ElementName=Root, Mode=TwoWay}"
                                      SelectedValuePath="InfraordoId"
                                      Style="{StaticResource AtisComboBox}" />

                            <ComboBox x:Name="SubordoCombo"
                                      MinWidth="200"
                                      VerticalAlignment="Center"
                                      loc:Uids.Uid="ComboBox_SubordoName"
                                      DisplayMemberPath="SubordoName"
                                      ItemsSource="{Binding ViewModel.SubordoList, ElementName=Root}"
                                      SelectedValue="{Binding Item.SubordoId, ElementName=Root, Mode=TwoWay}"
                                      SelectedValuePath="SubordoId"
                                      Style="{StaticResource AtisComboBox}" />

                            <ComboBox x:Name="OrdoCombo"
                                      MinWidth="200"
                                      VerticalAlignment="Center"
                                      loc:Uids.Uid="ComboBox_OrdoName"
                                      DisplayMemberPath="OrdoName"
                                      ItemsSource="{Binding ViewModel.OrdoList, ElementName=Root}"
                                      SelectedValue="{Binding Item.OrdoId, ElementName=Root, Mode=TwoWay}"
                                      SelectedValuePath="OrdoId"
                                      Style="{StaticResource AtisComboBox}" />

                            <ComboBox x:Name="LegioCombo"
                                      MinWidth="200"
                                      VerticalAlignment="Center"
                                      loc:Uids.Uid="ComboBox_LegioName"
                                      DisplayMemberPath="LegioName"
                                      ItemsSource="{Binding ViewModel.LegioList, ElementName=Root}"
                                      SelectedValue="{Binding Item.LegioId, ElementName=Root, Mode=TwoWay}"
                                      SelectedValuePath="LegioId"
                                      Style="{StaticResource AtisComboBox}" />
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="ClassGrid"
                          Visibility="Collapsed">
                        <StackPanel MinWidth="150"
                                    VerticalAlignment="Top"
                                    Orientation="Horizontal"
                                    Spacing="4">
                            <TextBlock Visibility="Collapsed" />

                            <ComboBox x:Name="InfraclassCombo"
                                      MinWidth="200"
                                      VerticalAlignment="Center"
                                      loc:Uids.Uid="ComboBox_InfraclassName"
                                      DisplayMemberPath="InfraclassName"
                                      ItemsSource="{Binding ViewModel.InfraclassList, ElementName=Root}"
                                      SelectedValue="{Binding Item.InfraclassId, ElementName=Root, Mode=TwoWay}"
                                      SelectedValuePath="InfraclassId"
                                      Style="{StaticResource AtisComboBox}" />

                            <ComboBox x:Name="SubclassCombo"
                                      MinWidth="200"
                                      VerticalAlignment="Center"
                                      loc:Uids.Uid="ComboBox_SubclassName"
                                      DisplayMemberPath="SubclassName"
                                      ItemsSource="{Binding ViewModel.SubclassList, ElementName=Root}"
                                      SelectedValue="{Binding Item.SubclassId, ElementName=Root, Mode=TwoWay}"
                                      SelectedValuePath="SubclassId"
                                      Style="{StaticResource AtisComboBox}" />

                            <ComboBox x:Name="ClassCombo"
                                      MinWidth="200"
                                      VerticalAlignment="Center"
                                      loc:Uids.Uid="ComboBox_ClassName"
                                      DisplayMemberPath="ClassName"
                                      ItemsSource="{Binding ViewModel.ClassList, ElementName=Root}"
                                      SelectedValue="{Binding Item.ClassId, ElementName=Root, Mode=TwoWay}"
                                      SelectedValuePath="ClassId"
                                      Style="{StaticResource AtisComboBox}" />

                            <ComboBox x:Name="SuperclassCombo"
                                      MinWidth="200"
                                      VerticalAlignment="Center"
                                      loc:Uids.Uid="ComboBox_SuperclassName"
                                      DisplayMemberPath="SuperclassName"
                                      ItemsSource="{Binding ViewModel.SuperclassList, ElementName=Root}"
                                      SelectedValue="{Binding Item.SuperclassId, ElementName=Root, Mode=TwoWay}"
                                      SelectedValuePath="SuperclassId"
                                      Style="{StaticResource AtisComboBox}" />
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="PhylumRegnumGrid"
                          Visibility="Collapsed">
                        <StackPanel MinWidth="150"
                                    VerticalAlignment="Top"
                                    Orientation="Horizontal"
                                    Spacing="4">
                            <TextBlock Visibility="Collapsed" />

                            <ComboBox x:Name="SubphylumCombo"
                                      MinWidth="200"
                                      VerticalAlignment="Center"
                                      loc:Uids.Uid="ComboBox_SubphylumName"
                                      DisplayMemberPath="SubphylumName"
                                      ItemsSource="{Binding ViewModel.SubphylumList, ElementName=Root}"
                                      SelectedValue="{Binding Item.SubphylumId, ElementName=Root, Mode=TwoWay}"
                                      SelectedValuePath="SubphylumId"
                                      Style="{StaticResource AtisComboBox}" />

                            <ComboBox x:Name="PhylumCombo"
                                      MinWidth="200"
                                      VerticalAlignment="Center"
                                      loc:Uids.Uid="ComboBox_PhylumName"
                                      DisplayMemberPath="PhylumName"
                                      ItemsSource="{Binding ViewModel.PhylumList, ElementName=Root}"
                                      SelectedValue="{Binding Item.PhylumId, ElementName=Root, Mode=TwoWay}"
                                      SelectedValuePath="PhylumId"
                                      Style="{StaticResource AtisComboBox}" />

                            <ComboBox x:Name="RegnumCombo"
                                      MinWidth="200"
                                      VerticalAlignment="Center"
                                      loc:Uids.Uid="ComboBox_RegnumName"
                                      DisplayMemberPath="RegnumName"
                                      ItemsSource="{Binding ViewModel.RegnumList, ElementName=Root}"
                                      SelectedValue="{Binding Item.RegnumId, ElementName=Root, Mode=TwoWay}"
                                      SelectedValuePath="RegnumId"
                                      Style="{StaticResource AtisComboBox}" />
                        </StackPanel>
                    </Grid>

                </Grid>
            </Grid>


            <!--  Memo  -->
            <TextBox MinWidth="200"
                     MinHeight="75"
                     MaxHeight="150"
                     loc:Uids.Uid="TextBox_Memo"
                     AcceptsReturn="True"
                     Style="{StaticResource AtisTextBox}"
                     Text="{Binding Item.Memo, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</UserControl>
