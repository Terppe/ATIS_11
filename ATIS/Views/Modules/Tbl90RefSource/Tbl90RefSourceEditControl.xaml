<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="ATIS.Views.Modules.Tbl90RefSource.Tbl90RefSourceEditControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:WinUI3Localizer"
             x:Name="Root">

    <!--  Tbl90RefSourceEditControl Skriptdatum:   06.01.2025  10:32  -->

    <Border Padding="4"
            Background="{ThemeResource ControlFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="6">

        <StackPanel Spacing="4">

            <!--  HEADER  -->
            <Grid Margin="0,0,0,4"
                  ColumnDefinitions="*,Auto">

                <TextBlock Grid.Column="0"
                           Margin="8,0,0,0"
                           loc:Uids.Uid="TextBlock_RefSource"
                           Style="{StaticResource AtisSectionTitleTextStyle}" />

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">

                    <!--  BACK  -->

                    <Button Command="{Binding BackCommand}">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6">
                            <FontIcon Glyph="&#xE72B;" />
                            <TextBlock Text="Back" />
                        </StackPanel>
                    </Button>

                    <!--  NEW  -->
                    <Button Command="{Binding NewCommand}"
                            Style="{StaticResource AtisPrimaryButton}">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6">
                            <FontIcon Glyph="&#xE710;" />
                            <TextBlock loc:Uids.Uid="TextBlock_Add" />
                        </StackPanel>
                    </Button>

                    <!--  SAVE  -->
                    <Button Command="{Binding SaveCommand}"
                            Style="{StaticResource AtisSecondaryButton}">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6">
                            <FontIcon Glyph="&#xE74E;" />
                            <TextBlock loc:Uids.Uid="TextBlock_Save" />
                        </StackPanel>
                    </Button>

                    <!--  DELETE  -->
                    <Button Command="{Binding DeleteCommand}"
                            Style="{StaticResource AtisSecondaryButton}">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6">
                            <FontIcon Glyph="&#xE74D;" />
                            <TextBlock loc:Uids.Uid="TextBlock_Delete" />
                        </StackPanel>
                    </Button>

                </StackPanel>
            </Grid>

            <!--  ID + Name  -->
            <StackPanel Orientation="Horizontal"
                        Spacing="4">

                <!--  ID  -->
                <TextBox MinWidth="110"
                         VerticalAlignment="Top"
                         loc:Uids.Uid="TextBox_RefSourceId"
                         IsReadOnly="True"
                         Style="{StaticResource AtisTextBox}"
                         Text="{Binding Item.RefSourceId, ElementName=Root}" />

                <!--  RefSourceName  -->
                <StackPanel MinWidth="150"
                            VerticalAlignment="Top"
                            Spacing="2">
                    <TextBox x:Name="RefSourceNameBox"
                             loc:Uids.Uid="TextBox_RefSourceName"
                             Loaded="RefSourceNameBox_OnLoaded"
                             Style="{StaticResource AtisTextBox}"
                             Text="{Binding Item.RefSourceName, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             TextChanged="RefSourceNameBox_OnTextChanged" />
                    <TextBlock Height="18"
                               FontSize="10"
                               Foreground="Red"
                               Text="{Binding Item.RefSourceNameError, ElementName=Root}"
                               Visibility="{Binding Item.HasRefSourceNameError, ElementName=Root, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>

                <!--  NULL Combo  -->
                <StackPanel MinWidth="150"
                            VerticalAlignment="Top"
                            Spacing="2">
                    <TextBlock Visibility="Collapsed" />
                    <ComboBox x:Name="NULLCombo"
                              MinWidth="200"
                              VerticalAlignment="Center"
                              loc:Uids.Uid="ComboBox_NULLName"
                              DisplayMemberPath="NULLName"
                              ItemsSource="{Binding ViewModel.NULLList, ElementName=Root}"
                              SelectedValue="{Binding Item.NULLId, ElementName=Root, Mode=TwoWay}"
                              SelectedValuePath="NULLId"
                              Style="{StaticResource AtisComboBox}" />
                </StackPanel>

                <!--  Valid  -->
                <CheckBox MinWidth="60"
                          VerticalAlignment="Bottom"
                          loc:Uids.Uid="CheckBox_Valid"
                          IsChecked="{Binding Item.Valid, ElementName=Root, Mode=TwoWay}"
                          Style="{StaticResource AtisCheckBox}" />

            </StackPanel>

            <!--  Author + AuthorYear  -->
            <StackPanel Orientation="Horizontal"
                        Spacing="4">
                <TextBox MinWidth="150"
                         VerticalAlignment="Top"
                         loc:Uids.Uid="TextBox_Author"
                         CharacterCasing="Upper"
                         Style="{StaticResource AtisTextBox}"
                         Text="{Binding Item.Author, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <!--  Memo  -->
            <TextBox MinWidth="200"
                     MinHeight="75"
                     MaxHeight="150"
                     loc:Uids.Uid="TextBox_Memo"
                     AcceptsReturn="True"
                     Style="{StaticResource AtisTextBox}"
                     Text="{Binding Item.Memo, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     TextWrapping="Wrap" />

        </StackPanel>

    </Border>
</UserControl>
