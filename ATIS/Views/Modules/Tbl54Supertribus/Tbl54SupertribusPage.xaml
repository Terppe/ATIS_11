<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="ATIS.Views.Modules.Tbl54Supertribus.Tbl54SupertribusPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:components="using:ATIS.DesignSystem.Components"
      xmlns:layout="using:ATIS.DesignSystem.Layout"
      xmlns:loc="using:WinUI3Localizer"
      xmlns:tbl54Supertribus="using:ATIS.Views.Modules.Tbl54Supertribus"
      xmlns:tbl57Tribus="using:ATIS.Views.Modules.Tbl57Tribus"
      xmlns:tbl90Reference="using:ATIS.Views.Modules.Tbl90Reference"
      xmlns:tbl93Comment="using:ATIS.Views.Modules.Tbl93Comment"
      x:Name="RootPage"
      DataContext="{Binding SupertribusViewModel}">

    <!--    Tbl54SupertribusPage Skriptdatum:  22.01.2025  10:32 -->

    <Grid x:Name="RootGrid">
        <ScrollViewer VerticalScrollBarVisibility="Visible">

            <layout:BaseBossPageLayout>

                <!--  HEADER LEFT  -->
                <layout:BaseBossPageLayout.Header>
                    <StackPanel Margin="8,0,0,8"
                                Orientation="Horizontal"
                                Spacing="10">

                        <TextBlock Margin="0,4,0,0"
                                   loc:Uids.Uid="TextBlock_Supertribusses"
                                   Style="{StaticResource AtisSectionTitleTextStyle}" />

                        <TextBlock Margin="0,12,0,0"
                                   loc:Uids.Uid="TextBlock_DataSetCount"
                                   Style="{StaticResource AtisBodyTextStyle}" />

                        <TextBlock Margin="0,12,0,0"
                                   Style="{StaticResource AtisBodyTextStyle}"
                                   Text="{Binding DataSetCount}" />
                    </StackPanel>
                </layout:BaseBossPageLayout.Header>

                <!--  APPBAR RIGHT  -->
                <layout:BaseBossPageLayout.AppBar>
                    <Grid ColumnSpacing="8">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Margin="8"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">

                            <Button Margin="5,0,5,0"
                                    Command="{Binding NewCommand}"
                                    IsEnabled="{Binding IsEditMode, Converter={StaticResource InverseBoolConverter}}"
                                    Style="{StaticResource AtisPrimaryButton}">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="6">
                                    <FontIcon Glyph="&#xE710;" />
                                    <TextBlock loc:Uids.Uid="TextBlock_Add" />
                                </StackPanel>
                            </Button>

                            <Button Margin="5,0,5,0"
                                    Command="{Binding RefreshCommand}"
                                    IsEnabled="{Binding HasItems}"
                                    Style="{StaticResource AtisSecondaryButton}">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="6">
                                    <FontIcon Glyph="&#xE72C;" />
                                    <TextBlock loc:Uids.Uid="TextBlock_Refresh" />
                                </StackPanel>
                            </Button>

                        </StackPanel>

                        <!--  SEARCH  -->
                        <AutoSuggestBox x:Name="SearchBox"
                                        Grid.Column="1"
                                        Width="260"
                                        Height="32"
                                        Margin="12,0"
                                        VerticalAlignment="Center"
                                        IsEnabled="{Binding IsInParentMode, Converter={StaticResource InverseBoolConverter}}"
                                        PlaceholderText="Suchen..."
                                        QueryIcon="Find"
                                        QuerySubmitted="SearchBox_OnQuerySubmitted"
                                        Text="{Binding SearchText, Mode=TwoWay}" />
                    </Grid>
                </layout:BaseBossPageLayout.AppBar>

                <!--  LIST CONTENT  -->
                <layout:BaseBossPageLayout.ListContent>
                    <tbl54Supertribus:Tbl54SupertribusBossControl DataContext="{Binding}" />
                </layout:BaseBossPageLayout.ListContent>

                <!--  DETAIL CONTENT  -->
                <layout:BaseBossPageLayout.DetailContent>
                    <Grid>
                        <Pivot x:Name="DetailPivot"
                               SelectedIndex="{Binding SelectedDetailPivotIndex, Mode=TwoWay}"
                               Visibility="{Binding IsDetailVisible, Converter={StaticResource BoolToVisibilityConverter}}">

                            <!--  Edit Supertribus  -->
                            <PivotItem loc:Uids.Uid="PivotItem_Edit_Supertribus">
                                <ScrollViewer Padding="1">
                                    <tbl54Supertribus:Tbl54SupertribusEditControl Item="{Binding SelectedItem, Mode=TwoWay}" />
                                </ScrollViewer>
                            </PivotItem>

                            <!--  Comments Supertribus  -->
                            <PivotItem x:Name="CommentsSupertribusPivot"
                                       loc:Uids.Uid="PivotItem_Comments">
                                <Grid DataContext="{Binding SupertribusCommentViewModel}"
                                      RowDefinitions="Auto,*">

                                    <tbl93Comment:Tbl93CommentParentControl Grid.Row="0" />

                                    <tbl93Comment:Tbl93CommentEditControl Grid.Row="1"
                                                                          Item="{Binding SelectedItem}"
                                                                          Visibility="{Binding IsDetailVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </Grid>
                            </PivotItem>

                            <!--  References Supertribus  -->
                            <PivotItem x:Name="ReferencesSupertribusPivot"
                                       loc:Uids.Uid="PivotItem_References">

                                <Grid DataContext="{Binding SupertribusReferenceViewModel}"
                                      RowDefinitions="Auto,*">

                                    <tbl90Reference:Tbl90ReferenceParentControl x:Name="ReferenceParentControl"
                                                                                Grid.Row="0" />

                                    <tbl90Reference:Tbl90ReferenceEditControl Grid.Row="1"
                                                                              Item="{Binding SelectedItem}"
                                                                              Visibility="{Binding IsDetailVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </Grid>
                            </PivotItem>

                            <!--  Tribus -->
                            <PivotItem x:Name="TribusPivot"
                                       loc:Uids.Uid="PivotItem_Edit_Tribus">

                                <Grid RowDefinitions="Auto,*">
                                    <tbl57Tribus:Tbl57TribusParentControl x:Name="TribusParentControl"
                                                                                    Grid.Row="0"
                                                                                    DataContext="{Binding TribusViewModel}" />

                                    <tbl57Tribus:Tbl57TribusEditControl Grid.Row="1"
                                                                                  DataContext="{Binding TribusViewModel}"
                                                                                  Item="{Binding SelectedItem}"
                                                                                  Visibility="{Binding IsDetailVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </Grid>
                            </PivotItem>

                            <!--  Comments Tribus  -->
                            <PivotItem x:Name="CommentsTribusPivot"
                                       loc:Uids.Uid="PivotItem_Comments">

                                <Grid DataContext="{Binding TribusViewModel.TribusCommentViewModel}"
                                      RowDefinitions="Auto,*">

                                    <tbl93Comment:Tbl93CommentParentControl Grid.Row="0" />

                                    <tbl93Comment:Tbl93CommentEditControl Grid.Row="1"
                                                                          Item="{Binding SelectedItem}"
                                                                          Visibility="{Binding IsDetailVisible, Converter={StaticResource BoolToVisibilityConverter}}" />

                                </Grid>
                            </PivotItem>

                            <!--  References Tribus  -->
                            <PivotItem x:Name="ReferencesTribusPivot"
                                       loc:Uids.Uid="PivotItem_References">

                                <Grid DataContext="{Binding TribusViewModel.TribusReferenceViewModel}"
                                      RowDefinitions="Auto,*">

                                    <tbl90Reference:Tbl90ReferenceParentControl Grid.Row="0" />

                                    <tbl90Reference:Tbl90ReferenceEditControl Grid.Row="1"
                                                                              Item="{Binding SelectedItem}"
                                                                              Visibility="{Binding IsDetailVisible, Converter={StaticResource BoolToVisibilityConverter}}" />

                                </Grid>
                            </PivotItem>
                        </Pivot>
                    </Grid>

                </layout:BaseBossPageLayout.DetailContent>

            </layout:BaseBossPageLayout>

        </ScrollViewer>

        <!--  2. 🔥 Modernes Lade Overlay  -->
        <components:LoadingOverlayControl Grid.RowSpan="1"
                                          IsLoading="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

    </Grid>
</Page>  
