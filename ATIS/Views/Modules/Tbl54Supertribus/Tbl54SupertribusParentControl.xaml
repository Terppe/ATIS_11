<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="ATIS.Views.Modules.Tbl54Supertribus.Tbl54SupertribusParentControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="using:WinUI3Localizer"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="using:ATIS.Models"
             mc:Ignorable="d">

    <!--  Tbl54SupertribusParentControl Skriptdatum:  22.01.2025  10:32  -->

    <UserControl.Resources>
        <GridLength x:Key="IdWidthResource">120</GridLength>
        <GridLength x:Key="Extra1WidthResource">200</GridLength>
        <GridLength x:Key="Extra2WidthResource">200</GridLength>
        <GridLength x:Key="Extra3WidthResource">80</GridLength>
        <GridLength x:Key="Extra4WidthResource">100</GridLength>
        <GridLength x:Key="Extra5WidthResource">250</GridLength>
        <GridLength x:Key="Extra6WidthResource">100</GridLength>
    </UserControl.Resources>

    <Grid Padding="2"
          RowDefinitions="Auto,Auto,*">
        <!--  HEADER LEFT + RIGHT  -->
        <Grid Grid.Row="0"
              Margin="0,0,0,8"
              ColumnDefinitions="*,Auto">
            <!--  LEFT  -->
            <StackPanel Margin="8,0,0,8"
                        Orientation="Horizontal"
                        Spacing="10">

                <TextBlock Margin="0,4,0,0"
                           loc:Uids.Uid="TextBlock_Supertribusses"
                           Style="{StaticResource AtisSectionTitleTextStyle}" />

                <TextBlock Margin="0,12,0,0"
                           loc:Uids.Uid="TextBlock_DataSetCount"
                           Style="{StaticResource AtisBodyTextStyle}" />

                <TextBlock Margin="0,12,0,0"
                           Style="{StaticResource AtisBodyTextStyle}"
                           Text="{Binding DataSetCount}" />
            </StackPanel>

            <!--  RIGHT  -->
            <StackPanel Grid.Column="2"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <Button Command="{Binding NewCommand}"
                        Style="{StaticResource AtisPrimaryButton}">
                    <StackPanel Orientation="Horizontal"
                                Spacing="6">
                        <FontIcon Glyph="&#xE710;" />
                        <TextBlock Text="Neu" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!--  LIST HEADER  -->
        <Grid Grid.Row="1"
              Padding="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{StaticResource IdWidthResource}" />
                <ColumnDefinition Width="{StaticResource Extra1WidthResource}" />
                <ColumnDefinition Width="{StaticResource Extra2WidthResource}" />
                <ColumnDefinition Width="{StaticResource Extra3WidthResource}" />
                <ColumnDefinition Width="{StaticResource Extra4WidthResource}" />
                <ColumnDefinition Width="{StaticResource Extra5WidthResource}" />
                <ColumnDefinition Width="{StaticResource Extra6WidthResource}" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       loc:Uids.Uid="TextBlock_SupertribusId"
                       FontWeight="Bold" />
            <TextBlock Grid.Column="1"
                       loc:Uids.Uid="TextBlock_SupertribusName"
                       FontWeight="Bold" />
            <TextBlock Grid.Column="2"
                       loc:Uids.Uid="TextBlock_InfrafamilyName"
                       FontWeight="Bold" />
            <TextBlock Grid.Column="3"
                       loc:Uids.Uid="TextBlock_Valid"
                       FontWeight="Bold" />
            <TextBlock Grid.Column="4"
                       loc:Uids.Uid="TextBlock_Year"
                       FontWeight="Bold" />
            <TextBlock Grid.Column="5"
                       loc:Uids.Uid="TextBlock_Author"
                       FontWeight="Bold" />
            <TextBlock Grid.Column="6"
                       loc:Uids.Uid="TextBlock_Year"
                       FontWeight="Bold" />
        </Grid>

        <!--  LIST  -->
        <ListView x:Name="SupertribusListView"
                  Grid.Row="2"
                  MaxHeight="112.5"
                  Margin="0,0,10,0"
                  BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                  BorderThickness="1"
                  CornerRadius="4"
                  IsItemClickEnabled="True"
                  ItemClick="SupertribusListView_ItemClick"
                  ItemContainerStyle="{StaticResource AtisListViewItemStyle}"
                  ItemsSource="{Binding Items}"
                  RightTapped="SupertribusListView_RightTapped"
                  SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                  SelectionMode="Single">

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:Tbl54Supertribus">
                    <Grid Style="{StaticResource AtisListRowGridStyle}">

                        <Grid.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem loc:Uids.Uid="MenuFlyout_Add_Supertribus"
                                                Command="{Binding DataContext.NewCommand, ElementName=SupertribusListView}">
                                    <MenuFlyoutItem.Icon>
                                        <SymbolIcon Symbol="Add" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>

                                <MenuFlyoutItem loc:Uids.Uid="MenuFlyout_Save_Supertribus"
                                                Command="{Binding DataContext.SaveCommand, ElementName=SupertribusListView}">
                                    <MenuFlyoutItem.Icon>
                                        <SymbolIcon Symbol="Save" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>

                                <MenuFlyoutItem loc:Uids.Uid="MenuFlyout_Delete_Supertribus"
                                                Command="{Binding DataContext.DeleteCommand, ElementName=SupertribusListView}">
                                    <MenuFlyoutItem.Icon>
                                        <SymbolIcon Symbol="Delete" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Grid.ContextFlyout>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource IdWidthResource}" />
                            <ColumnDefinition Width="{StaticResource Extra1WidthResource}" />
                            <ColumnDefinition Width="{StaticResource Extra2WidthResource}" />
                            <ColumnDefinition Width="{StaticResource Extra3WidthResource}" />
                            <ColumnDefinition Width="{StaticResource Extra4WidthResource}" />
                            <ColumnDefinition Width="{StaticResource Extra5WidthResource}" />
                            <ColumnDefinition Width="{StaticResource Extra6WidthResource}" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Margin="4,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="{x:Bind SupertribusId}" />

                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Text="{x:Bind SupertribusName}" />
                        <TextBlock Grid.Column="2"
                                   VerticalAlignment="Center"
                                   Text="{x:Bind InfrafamilyName}" />

                        <CheckBox Grid.Column="3"
                                  IsChecked="{x:Bind Valid}"
                                  IsEnabled="False"
                                  IsTabStop="False" />

                        <TextBlock Grid.Column="4"
                                   VerticalAlignment="Center"
                                   Text="{x:Bind ValidYear}" />
                        <TextBlock Grid.Column="5"
                                   VerticalAlignment="Center"
                                   Text="{x:Bind Author}" />
                        <TextBlock Grid.Column="6"
                                   VerticalAlignment="Center"
                                   Text="{x:Bind AuthorYear}" />

                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>

            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsStackPanel />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>

        </ListView>

    </Grid>
</UserControl>
