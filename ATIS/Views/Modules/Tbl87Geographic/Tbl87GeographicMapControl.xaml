<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="ATIS.Views.Modules.Tbl87Geographic.Tbl87GeographicMapControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="using:WinUI3Localizer"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:winUi="using:Mapsui.UI.WinUI"
             mc:Ignorable="d">

    <UserControl.Resources>
        <MenuFlyout x:Key="PointContextFlyout">
            <MenuFlyoutItem x:Name="MenuAddPoint"
                            loc:Uids.Uid="MenuFlyout_Add_Point"
                            Click="MenuAddPoint_Click" />
            <MenuFlyoutItem x:Name="MenuMovePoint"
                            loc:Uids.Uid="MenuFlyout_Move_Point"
                            Click="MenuMovePoint_Click" />
            <MenuFlyoutItem x:Name="MenuDeletePoint"
                            loc:Uids.Uid="MenuFlyout_Delete_Point"
                            Click="MenuDeletePoint_Click" />
        </MenuFlyout>
    </UserControl.Resources>

    <Grid Background="Black"
          RowDefinitions="Auto,*">
        <StackPanel x:Name="GeographicToolbar"
                    Padding="8"
                    Orientation="Horizontal"
                    Spacing="8">
            <Button Click="ResetMapViewButton_Click"
                    Content="Ansicht zurücksetzen" />
            <Button Click="ClearSelectionButton_Click"
                    Content="Bearbeitung abbrechen" />
            <Button Click="CloseWindowButton_Click"
                    Content="Schließen" />
        </StackPanel>

        <Grid Grid.Row="1">

            <Border Width="1100"
                    Height="600">
                <Grid>
                    <winUi:MapControl x:Name="MyMap"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      MapPointerPressed="MyMap_OnMapPointerPressed"
                                      MapPointerReleased="MyMap_OnMapPointerReleased"
                                      RightTapped="MyMap_OnRightTapped"
                                      Tapped="MyMap_OnTapped" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
