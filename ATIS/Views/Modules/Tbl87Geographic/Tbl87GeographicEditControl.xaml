<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="ATIS.Views.Modules.Tbl87Geographic.Tbl87GeographicEditControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="using:WinUI3Localizer"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Name="Root"
             mc:Ignorable="d">

    <!--  Tbl87GeographicEditControl Skriptdatum:  13.09.2026  10:32  -->

    <Border Padding="4"
            Background="{ThemeResource ControlFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="6">

        <StackPanel Spacing="4">

            <!--  HEADER  -->
            <Grid Margin="0,0,8,4"
                  ColumnDefinitions="*,Auto">

                <TextBlock Grid.Column="0"
                           Margin="8,0,0,0"
                           loc:Uids.Uid="TextBlock_Geographic"
                           Style="{StaticResource AtisSectionTitleTextStyle}" />

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">

                    <!--  BACK  -->
                    <Button Command="{Binding BackCommand}">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6">
                            <FontIcon Glyph="&#xE72B;" />
                            <TextBlock Text="Back" />
                        </StackPanel>
                    </Button>

                    <!--  NEW  -->
                    <Button Command="{Binding NewCommand}"
                            Style="{StaticResource AtisPrimaryButton}">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6">
                            <FontIcon Glyph="&#xE710;" />
                            <TextBlock loc:Uids.Uid="TextBlock_Add" />
                        </StackPanel>
                    </Button>

                    <!--  SAVE  -->
                    <Button Command="{Binding SaveCommand}"
                            IsEnabled="{Binding CanSave}"
                            Style="{StaticResource AtisSecondaryButton}">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6">
                            <FontIcon Glyph="&#xE74E;" />
                            <TextBlock loc:Uids.Uid="TextBlock_Save" />
                        </StackPanel>
                    </Button>

                    <!--  DELETE  -->
                    <Button Command="{Binding DeleteCommand}"
                            IsEnabled="{Binding CanDelete}"
                            Style="{StaticResource AtisSecondaryButton}">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6">
                            <FontIcon Glyph="&#xE74D;" />
                            <TextBlock loc:Uids.Uid="TextBlock_Delete" />
                        </StackPanel>
                    </Button>

                    <Button Click="OpenMapButton_Click"
                            Style="{StaticResource AtisSecondaryButton}">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6">
                            <FontIcon Glyph="&#xE707;" />
                            <TextBlock loc:Uids.Uid="TextBlock_ShowMap" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!--  ID + Name  -->
            <StackPanel>
                <StackPanel Orientation="Horizontal"
                            Spacing="4">

                    <!--  ID  -->
                    <TextBox MinWidth="110"
                             VerticalAlignment="Top"
                             loc:Uids.Uid="TextBox_GeographicId"
                             IsReadOnly="True"
                             Style="{StaticResource AtisTextBox}"
                             Text="{Binding Item.GeographicId, ElementName=Root}" />

                    <!--  GenusSpeciesSubspeciesDiversName  -->
                    <TextBox loc:Uids.Uid="TextBox_GenusSpeciesName"
                             IsReadOnly="True"
                             Style="{StaticResource AtisTextBox}"
                             Text="{Binding Item.GenusSpeciesFullName, ElementName=Root, Mode=OneWay}" />

                    <!--  Country Combo  -->
                    <StackPanel MinWidth="200"
                                VerticalAlignment="Top"
                                Spacing="2">
                        <TextBlock Visibility="Collapsed" />

                        <ComboBox x:Name="CountryCombo"
                                  MinWidth="200"
                                  VerticalAlignment="Center"
                                  loc:Uids.Uid="ComboBox_Country"
                                  DisplayMemberPath="Name"
                                  ItemsSource="{Binding CountryList}"
                                  SelectedValue="{Binding Item.Country, ElementName=Root, Mode=TwoWay}"
                                  SelectedValuePath="Name"
                                  SelectionChanged="CountryCombo_OnSelectionChanged"
                                  Style="{StaticResource AtisComboBox}"
                                  TabIndex="1" />

                    </StackPanel>

                    <!--  Continent  -->
                    <ComboBox x:Name="ContinentCombo"
                              MinWidth="200"
                              VerticalAlignment="Center"
                              loc:Uids.Uid="ComboBox_Continent"
                              PlaceholderText="Select"
                              SelectedValue="{Binding Item.Continent, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              SelectionChanged="ContinentCombo_OnSelectionChanged"
                              Style="{StaticResource AtisComboBox}"
                              TabIndex="2">
                        <x:String>Africa</x:String>
                        <x:String>Antarctica</x:String>
                        <x:String>Asia</x:String>
                        <x:String>Australia</x:String>
                        <x:String>Central/South America</x:String>
                        <x:String>Europe</x:String>
                        <x:String>North America/Caribbean</x:String>
                    </ComboBox>

                    <!--  Valid  -->
                    <CheckBox MinWidth="60"
                              VerticalAlignment="Bottom"
                              loc:Uids.Uid="CheckBox_Valid"
                              IsChecked="{Binding Item.Valid, ElementName=Root, Mode=TwoWay}"
                              Style="{StaticResource AtisCheckBox}" />

                    <!--  ValidYear  -->
                    <StackPanel MinWidth="60"
                                VerticalAlignment="Top"
                                Spacing="2">
                        <TextBox x:Name="ValidYearBox"
                                 loc:Uids.Uid="TextBox_ValidYear"
                                 Loaded="ValidYearBox_OnLoaded"
                                 Style="{StaticResource AtisTextBox}"
                                 Text="{Binding Item.ValidYear, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 TextChanged="ValidYearBox_OnTextChanged" />
                        <TextBlock Height="16"
                                   FontSize="10"
                                   Foreground="Red"
                                   Text="{Binding Item.ValidYearError, ElementName=Root}"
                                   Visibility="{Binding Item.HasValidYearError, ElementName=Root, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>

                    <!--  ZoomLevel  -->
                    <TextBox loc:Uids.Uid="TextBox_ZoomLevel"
                             Style="{StaticResource AtisTextBox}"
                             Text="{Binding Item.ZoomLevel, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            Spacing="4">
                    <!--  Address  -->
                    <TextBox loc:Uids.Uid="TextBox_Address"
                             Style="{StaticResource AtisTextBox}"
                             Text="{Binding Item.Address, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <!--  Info  -->
                    <TextBox x:Name="InfoTextBox"
                             loc:Uids.Uid="TextBox_Info"
                             Style="{StaticResource AtisTextBox}"
                             TabIndex="0"
                             Text="{Binding Item.Info, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <!--  Jurisdiction  -->
                    <TextBox loc:Uids.Uid="TextBox_Jurisdiction"
                             Style="{StaticResource AtisTextBox}"
                             Text="{Binding Item.Jurisdiction, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <!--  Author + AuthorYear  -->
                    <StackPanel Orientation="Horizontal"
                                Spacing="4">
                        <TextBox MinWidth="150"
                                 VerticalAlignment="Top"
                                 loc:Uids.Uid="TextBox_Author"
                                 CharacterCasing="Upper"
                                 Style="{StaticResource AtisTextBox}"
                                 Text="{Binding Item.Author, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <StackPanel MinWidth="60"
                                    VerticalAlignment="Top"
                                    Spacing="4">
                            <TextBox x:Name="AuthorYearBox"
                                     loc:Uids.Uid="TextBox_AuthorYear"
                                     Loaded="AuthorYearBox_OnLoaded"
                                     Style="{StaticResource AtisTextBox}"
                                     Text="{Binding Item.AuthorYear, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     TextChanged="AuthorYearBox_OnTextChanged" />
                            <TextBlock Height="16"
                                       FontSize="10"
                                       Foreground="Red"
                                       Text="{Binding Item.AuthorYearError, ElementName=Root}"
                                       Visibility="{Binding Item.HasAuthorYearError, ElementName=Root, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>
                    </StackPanel>
                    <!--  Http  -->
                    <StackPanel MinWidth="150"
                                VerticalAlignment="Top"
                                Spacing="2">
                        <TextBox x:Name="HttpBox"
                                 loc:Uids.Uid="TextBox_Http"
                                 Loaded="HttpBox_OnLoaded"
                                 Style="{StaticResource AtisTextBox}"
                                 Text="{Binding Item.Http, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 TextChanged="HttpBox_OnTextChanged" />
                        <TextBlock Height="18"
                                   FontSize="10"
                                   Foreground="Red"
                                   Text="{Binding Item.HttpError, ElementName=Root}"
                                   Visibility="{Binding Item.HasHttpError, ElementName=Root, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            Spacing="4">
                    <!--  Latitude  -->
                    <TextBox loc:Uids.Uid="TextBox_Latitude"
                             Style="{StaticResource AtisTextBox}"
                             Text="{Binding Item.Latitude, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <!--  Longitude  -->
                    <TextBox loc:Uids.Uid="TextBox_Longitude"
                             Style="{StaticResource AtisTextBox}"
                             Text="{Binding Item.Longitude, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <!--  Latitude1  -->
                    <TextBox loc:Uids.Uid="TextBox_Latitude1"
                             Style="{StaticResource AtisTextBox}"
                             Text="{Binding Item.Latitude1, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <!--  Longitude1  -->
                    <TextBox loc:Uids.Uid="TextBox_Longitude1"
                             Style="{StaticResource AtisTextBox}"
                             Text="{Binding Item.Longitude1, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <!--  Latitude2  -->
                    <TextBox loc:Uids.Uid="TextBox_Latitude2"
                             Style="{StaticResource AtisTextBox}"
                             Text="{Binding Item.Latitude2, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <!--  Longitude2  -->
                    <TextBox loc:Uids.Uid="TextBox_Longitude2"
                             Style="{StaticResource AtisTextBox}"
                             Text="{Binding Item.Longitude2, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <!--  Latitude3  -->
                    <TextBox loc:Uids.Uid="TextBox_Latitude3"
                             Style="{StaticResource AtisTextBox}"
                             Text="{Binding Item.Latitude3, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <!--  Longitude3  -->
                    <TextBox loc:Uids.Uid="TextBox_Longitude3"
                             Style="{StaticResource AtisTextBox}"
                             Text="{Binding Item.Longitude3, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <!--  Memo  -->
                <TextBox MinWidth="200"
                         MinHeight="75"
                         MaxHeight="150"
                         loc:Uids.Uid="TextBox_Memo"
                         Style="{StaticResource AtisTextBoxWrap}"
                         Text="{Binding Item.Memo, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

        </StackPanel>

    </Border>
</UserControl>
