<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="ATIS.Views.Modules.Tbl90RefAuthor.Tbl90RefAuthorEditControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:WinUI3Localizer"
             x:Name="Root">

    <!--  Tbl90RefAuthorEditControl Skriptdatum:  06.01.2025  10:32  -->

    <Border Padding="4"
            Background="{ThemeResource ControlFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="6">

        <StackPanel Spacing="4">

            <!--  HEADER  -->
            <Grid Margin="0,0,0,4"
                  ColumnDefinitions="*,Auto">

                <TextBlock Grid.Column="0"
                           Margin="8,0,0,0"
                           loc:Uids.Uid="TextBlock_RefAuthor"
                           Style="{StaticResource AtisSectionTitleTextStyle}" />

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">

                    <!--  BACK  -->

                    <Button Command="{Binding BackCommand}">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6">
                            <FontIcon Glyph="&#xE72B;" />
                            <TextBlock Text="Back" />
                        </StackPanel>
                    </Button>

                    <!--  NEW  -->
                    <Button Command="{Binding NewCommand}"
                            Style="{StaticResource AtisPrimaryButton}">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6">
                            <FontIcon Glyph="&#xE710;" />
                            <TextBlock loc:Uids.Uid="TextBlock_Add" />
                        </StackPanel>
                    </Button>

                    <!--  SAVE  -->
                    <Button Command="{Binding SaveCommand}"
                            Style="{StaticResource AtisSecondaryButton}">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6">
                            <FontIcon Glyph="&#xE74E;" />
                            <TextBlock loc:Uids.Uid="TextBlock_Save" />
                        </StackPanel>
                    </Button>

                    <!--  DELETE  -->
                    <Button Command="{Binding DeleteCommand}"
                            Style="{StaticResource AtisSecondaryButton}">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6">
                            <FontIcon Glyph="&#xE74D;" />
                            <TextBlock loc:Uids.Uid="TextBlock_Delete" />
                        </StackPanel>
                    </Button>

                </StackPanel>
            </Grid>

            <!--  ID + Name  -->
            <StackPanel Orientation="Horizontal"
                        Spacing="4">

                <!--  ID  -->
                <TextBox MinWidth="110"
                         VerticalAlignment="Top"
                         loc:Uids.Uid="TextBox_RefAuthorId"
                         IsReadOnly="True"
                         Style="{StaticResource AtisTextBox}"
                         Text="{Binding Item.RefAuthorId, ElementName=Root}" />

                <!--  RefAuthorName  -->
                <StackPanel MinWidth="150"
                            VerticalAlignment="Top"
                            Spacing="2">
                    <TextBox x:Name="RefAuthorNameBox"
                             loc:Uids.Uid="TextBox_RefAuthorName"
                             Loaded="RefAuthorNameBox_OnLoaded"
                             Style="{StaticResource AtisTextBox}"
                             Text="{Binding Item.RefAuthorName, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             TextChanged="RefAuthorNameBox_OnTextChanged" />
                    <TextBlock Height="18"
                               FontSize="10"
                               Foreground="Red"
                               Text="{Binding Item.RefAuthorNameError, ElementName=Root}"
                               Visibility="{Binding Item.HasRefAuthorNameError, ElementName=Root, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>


                <!--  Valid  -->
                <CheckBox MinWidth="60"
                          VerticalAlignment="Bottom"
                          loc:Uids.Uid="CheckBox_Valid"
                          IsChecked="{Binding Item.Valid, ElementName=Root, Mode=TwoWay}"
                          Style="{StaticResource AtisCheckBox}" />

                <!--  ValidYear  -->
                <StackPanel MinWidth="60"
                            VerticalAlignment="Top"
                            Spacing="2">
                    <TextBox x:Name="ValidYearBox"
                             loc:Uids.Uid="TextBox_ValidYear"
                             Loaded="ValidYearBox_OnLoaded"
                             Style="{StaticResource AtisTextBox}"
                             Text="{Binding Item.ValidYear, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             TextChanged="ValidYearBox_OnTextChanged" />
                    <TextBlock Height="16"
                               FontSize="10"
                               Foreground="Red"
                               Text="{Binding Item.ValidYearError, ElementName=Root}"
                               Visibility="{Binding Item.HasValidYearError, ElementName=Root, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>

                <!--  PublicationYear  -->
            </StackPanel>
            <StackPanel Orientation="Horizontal"
                        Spacing="4">
                <StackPanel MinWidth="60"
                            VerticalAlignment="Top"
                            Spacing="2">
                    <TextBox x:Name="PublicationYearBox"
                             loc:Uids.Uid="TextBox_PublicationYear"
                             Loaded="PublicationYearBox_OnLoaded"
                             Style="{StaticResource AtisTextBox}"
                             Text="{Binding Item.PublicationYear, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             TextChanged="PublicationYearBox_OnTextChanged" />
                    <TextBlock Height="16"
                               FontSize="10"
                               Foreground="Red"
                               Text="{Binding Item.ValidYearError, ElementName=Root}"
                               Visibility="{Binding Item.HasValidYearError, ElementName=Root, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>

                <!--  BookName  -->
                <TextBox loc:Uids.Uid="TextBox_BookName"
                         Style="{StaticResource AtisTextBox}"
                         Text="{Binding Item.BookName, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            </StackPanel>
            <StackPanel>
                <TextBox loc:Uids.Uid="TextBox_ArticelTitle"
                         Style="{StaticResource AtisTextBox}"
                         Text="{Binding Item.ArticelTitle, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            </StackPanel>
            <StackPanel Orientation="Horizontal"
                        Spacing="4">
                <TextBox loc:Uids.Uid="TextBox_Publisher"
                         Style="{StaticResource AtisTextBox}"
                         Text="{Binding Item.Publisher, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox loc:Uids.Uid="TextBox_PublicationPlace"
                         Style="{StaticResource AtisTextBox}"
                         Text="{Binding Item.PublicationPlace, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            </StackPanel>

            <!--  Language Pivot  -->
            <Pivot>
                <PivotItem loc:Uids.Uid="PivotItem_EngName">
                    <TextBox loc:Uids.Uid="TextBox_ISBN"
                             Style="{StaticResource AtisTextBox}"
                             Text="{Binding Item.ISBN, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </PivotItem>
                <PivotItem loc:Uids.Uid="PivotItem_GerName">
                    <TextBox loc:Uids.Uid="TextBox_Info"
                             Style="{StaticResource AtisTextBox}"
                             Text="{Binding Item.Info, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </PivotItem>
                <PivotItem loc:Uids.Uid="PivotItem_FraName">
                    <TextBox loc:Uids.Uid="TextBox_Page"
                             Style="{StaticResource AtisTextBox}"
                             Text="{Binding Item.Page1, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </PivotItem>
                <PivotItem loc:Uids.Uid="PivotItem_SpaName">
                    <TextBox loc:Uids.Uid="TextBox_Publisher"
                             Style="{StaticResource AtisTextBox}"
                             Text="{Binding Item.Publisher, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </PivotItem>

            </Pivot>

            <!--  Notes  -->
            <TextBox MinWidth="200"
                     MinHeight="75"
                     MaxHeight="150"
                     loc:Uids.Uid="TextBox_Notes"
                     AcceptsReturn="True"
                     Style="{StaticResource AtisTextBox}"
                     Text="{Binding Item.Notes, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     TextWrapping="Wrap" />
            <!--  Memo  -->
            <TextBox MinWidth="200"
                     MinHeight="75"
                     MaxHeight="150"
                     loc:Uids.Uid="TextBox_Memo"
                     AcceptsReturn="True"
                     Style="{StaticResource AtisTextBox}"
                     Text="{Binding Item.Memo, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     TextWrapping="Wrap" />

        </StackPanel>

    </Border>
</UserControl>
