<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="ATIS.Views.Modules.Tbl90RefAuthor.Tbl90RefAuthorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:atis="using:ATIS.DesignSystem.Components"
      xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:helpers="using:ATIS.Helpers"
      xmlns:loc="using:WinUI3Localizer"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      x:Name="RootPage"
      mc:Ignorable="d">

    <Grid x:Name="RootGrid">
        <ScrollViewer VerticalScrollBarVisibility="Visible">

            <atis:Base1List1DetailPageLayout>

                <!--  HEADER LEFT  -->
                <atis:Base1List1DetailPageLayout.Header>
                    <StackPanel Margin="8,0,0,8"
                                Orientation="Horizontal"
                                Spacing="10">

                        <TextBlock Margin="0,4,0,0"
                                   loc:Uids.Uid="TextBlock_RefAuthors"
                                   Style="{StaticResource AtisSectionTitleTextStyle}" />

                        <TextBlock Margin="0,12,0,0"
                                   loc:Uids.Uid="TextBlock_DataSetCount"
                                   Style="{StaticResource AtisBodyTextStyle}" />

                        <TextBlock Margin="0,12,0,0"
                                   Style="{StaticResource AtisBodyTextStyle}"
                                   Text="{Binding DataSetCount, Mode=OneWay}" />

                    </StackPanel>
                </atis:Base1List1DetailPageLayout.Header>


                <!--  HEADER RIGHT BUTTONS + SEARCHBOX  -->
                <atis:Base1List1DetailPageLayout.AppBar>
                    <Grid ColumnSpacing="8">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Margin="8"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">

                            <Button Margin="5,0,5,0"
                                    Command="{Binding NewCommand}"
                                    Style="{StaticResource AtisPrimaryButton}">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="6">
                                    <FontIcon Glyph="&#xE710;" />
                                    <TextBlock loc:Uids.Uid="TextBlock_Add" />
                                </StackPanel>
                            </Button>

                            <Button Margin="5,0,5,0"
                                    Command="{Binding DeleteCommand}"
                                    Style="{StaticResource AtisSecondaryButton}">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="6">
                                    <FontIcon Glyph="&#xE74D;" />
                                    <TextBlock loc:Uids.Uid="TextBlock_Delete" />
                                </StackPanel>
                            </Button>

                            <Button Margin="5,0,5,0"
                                    Command="{Binding RefreshCommand}"
                                    Style="{StaticResource AtisSecondaryButton}">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="6">
                                    <FontIcon Glyph="&#xE72C;" />
                                    <TextBlock loc:Uids.Uid="TextBlock_Refresh" />
                                </StackPanel>
                            </Button>

                        </StackPanel>

                        <!--  RIGHT SEARCH  -->
                        <AutoSuggestBox x:Name="SearchBox"
                                        Grid.Column="1"
                                        Width="260"
                                        Height="32"
                                        Margin="10,0,18,0"
                                        VerticalAlignment="Center"
                                        loc:Uids.Uid="AutoSuggestBox_Search"
                                        KeyUp="SearchBox_OnKeyUp"
                                        QueryIcon="Find"
                                        Text="{Binding SearchText, Mode=TwoWay}" />
                    </Grid>
                </atis:Base1List1DetailPageLayout.AppBar>


                <!--  LIST (DATAGRID)  -->
                <atis:Base1List1DetailPageLayout.ListContent>
                    <Border Style="{StaticResource AtisCard}">
                        <Grid>

                            <controls:DataGrid x:Name="RefAuthorDataGrid"
                                               Height="Auto"
                                               MinHeight="150"
                                               MaxHeight="200"
                                               HorizontalAlignment="Stretch"
                                               VerticalAlignment="Top"
                                               AlternatingRowBackground="{ThemeResource AtisGridRowAlternateBackground}"
                                               AreRowDetailsFrozen="True"
                                               CanUserSortColumns="True"
                                               GridLinesVisibility="Vertical"
                                               IsEnabled="{Binding IsInEdit, Converter={StaticResource InverseBoolConverter}}"
                                               ItemsSource="{Binding Items}"
                                               RowBackground="{ThemeResource AtisGridRowBackground}"
                                               SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                               SelectionMode="Single"
                                               Sorting="DataGrid_Sorting"
                                               Style="{StaticResource AtisDataGridStyle}">

                                <!--  ContextFlyout  -->
                                <controls:DataGrid.ContextFlyout>
                                    <MenuFlyout>

                                        <MenuFlyoutItem loc:Uids.Uid="MenuFlyout_Add"
                                                        Command="{Binding NewCommand}"
                                                        Icon="Add"
                                                        Style="{StaticResource AtisPrimaryMenuFlyoutItem}" />

                                        <MenuFlyoutItem loc:Uids.Uid="MenuFlyout_Edit"
                                                        Command="{Binding EditCommand}"
                                                        Icon="Edit" />

                                        <MenuFlyoutItem loc:Uids.Uid="MenuFlyout_Save"
                                                        Command="{Binding SaveCommand}"
                                                        Icon="Save"
                                                        IsEnabled="{Binding SelectedItem, Converter={StaticResource NullToBoolConverter}}" />

                                        <MenuFlyoutItem loc:Uids.Uid="MenuFlyout_Delete"
                                                        Command="{Binding DeleteCommand}"
                                                        Icon="Delete" />

                                    </MenuFlyout>
                                </controls:DataGrid.ContextFlyout>

                                <!--  RowStyle  -->
                                <controls:DataGrid.RowStyle>
                                    <Style TargetType="controls:DataGridRow">
                                        <Setter Property="Background" Value="{Binding IsAlternate, Converter={StaticResource BoolToRowBackgroundConverter}}" />
                                    </Style>
                                </controls:DataGrid.RowStyle>

                                <!--  Columns  -->
                                <controls:DataGrid.Columns>

                                    <controls:DataGridTextColumn loc:Uids.Uid="DataGridTextColumn_RefAuthorId"
                                                                 Binding="{Binding RefAuthorId}"
                                                                 CanUserSort="True"
                                                                 IsReadOnly="True"
                                                                 Tag="RefAuthorId" />

                                    <controls:DataGridTextColumn loc:Uids.Uid="DataGridTextColumn_RefAuthorName"
                                                                 Binding="{Binding RefAuthorName}"
                                                                 CanUserSort="True"
                                                                 Tag="RefAuthorName" />

                                    <controls:DataGridTextColumn loc:Uids.Uid="DataGridTextColumn_ValidYear"
                                                                 Binding="{Binding ValidYear}"
                                                                 CanUserSort="True"
                                                                 Tag="ValidYear" />

                                    <controls:DataGridCheckBoxColumn loc:Uids.Uid="DataGridCheckBoxColumn_Valid"
                                                                     Binding="{Binding Valid}"
                                                                     CanUserSort="True"
                                                                     Tag="Valid" />

                                </controls:DataGrid.Columns>

                            </controls:DataGrid>

                            <!--  Overlay blockiert Klicks im Edit-Modus  -->
                            <Border Background="#40FFFFFF"
                                    Visibility="{Binding IsInEdit, Converter={StaticResource BoolToVisibilityConverter}}" />

                        </Grid>
                    </Border>
                </atis:Base1List1DetailPageLayout.ListContent>


                <!--  DETAIL FORM  -->
                <atis:Base1List1DetailPageLayout.DetailContent>
                    <Border Style="{StaticResource AtisCard}"
                            Visibility="{Binding SelectedItem, Converter={StaticResource NullToVisibilityConverter}}">
                        <StackPanel Spacing="8">

                            <!--  Detail Header  -->
                            <atis:AtisDetailHeader IsEnabled="True">

                                <atis:AtisDetailHeader.LeftContent>
                                    <TextBlock loc:Uids.Uid="TextBlock_RefAuthorDetail"
                                               Style="{StaticResource AtisSectionTitleTextStyle}" />
                                </atis:AtisDetailHeader.LeftContent>

                                <atis:AtisDetailHeader.RightContent>
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="8">

                                        <Button Margin="5,0,5,0"
                                                Command="{Binding SaveCommand}"
                                                Style="{StaticResource AtisSecondaryButton}"
                                                Visibility="{Binding IsInEdit, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="6">
                                                <FontIcon Glyph="&#xE74E;" />
                                                <TextBlock loc:Uids.Uid="TextBlock_Save" />
                                            </StackPanel>
                                        </Button>

                                        <Button Margin="5,0,5,0"
                                                Command="{Binding CancelCommand}"
                                                Style="{StaticResource AtisSecondaryButton}"
                                                Visibility="{Binding IsInEdit, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="6">
                                                <FontIcon Glyph="&#xE8BB;" />
                                                <TextBlock loc:Uids.Uid="TextBlock_Cancel" />
                                            </StackPanel>
                                        </Button>

                                        <Button Command="{Binding EditCommand}"
                                                IsEnabled="{Binding SelectedItem, Converter={StaticResource NullToBoolConverter}}"
                                                Style="{StaticResource AtisSecondaryButton}">
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="6">
                                                <FontIcon Glyph="&#xE70F;" />
                                                <TextBlock loc:Uids.Uid="TextBlock_Edit" />
                                            </StackPanel>
                                        </Button>

                                    </StackPanel>
                                </atis:AtisDetailHeader.RightContent>

                            </atis:AtisDetailHeader>


                            <!--  ⭐ Detail Fields  -->
                            <Grid RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <!--  0 RefAuthorName  -->
                                    <RowDefinition Height="Auto" />
                                    <!--  1 ValidYear, Valid, ISBN  -->
                                    <RowDefinition Height="Auto" />
                                    <!--  2 ArticelTitle  -->
                                    <RowDefinition Height="Auto" />
                                    <!--  3 BookName, Page1  -->
                                    <RowDefinition Height="Auto" />
                                    <!--  4 Publisher  -->
                                    <RowDefinition Height="Auto" />
                                    <!--  5 PublicationPlace, PublicationYear  -->
                                    <RowDefinition Height="Auto" />
                                    <!--  6 Info  -->
                                    <RowDefinition Height="Auto" />
                                    <!--  7 Notes  -->
                                    <RowDefinition Height="Auto" />
                                    <!--  8 Memo  -->
                                </Grid.RowDefinitions>


                                <!--  Row 0: RefAuthorName  -->
                                <Grid Grid.Row="0"
                                      RowDefinitions="Auto,Auto,Auto">
                                    <TextBox x:Name="RefAuthorName"
                                             Grid.Row="1"
                                             MinWidth="600"
                                             HorizontalAlignment="Left"
                                             helpers:ValidationHelper.HasError="{Binding EditItem.HasRefAuthorNameError}"
                                             loc:Uids.Uid="TextBox_RefAuthorName"
                                             IsEnabled="{Binding IsInEdit}"
                                             MaxLength="200"
                                             Style="{StaticResource AtisTextBox}"
                                             Text="{Binding EditItem.RefAuthorName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock Grid.Row="2"
                                               Foreground="Red"
                                               Text="{Binding EditItem.RefAuthorNameError}"
                                               Visibility="{Binding EditItem.HasRefAuthorNameError, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </Grid>


                                <!--  Row 1: ValidYear, Valid, ISBN  -->
                                <Grid Grid.Row="1"
                                      ColumnDefinitions="Auto,Auto,Auto"
                                      RowDefinitions="Auto,Auto,Auto">

                                    <TextBox Grid.Row="1"
                                             Grid.Column="0"
                                             helpers:ValidationHelper.HasError="{Binding EditItem.HasValidYearError}"
                                             loc:Uids.Uid="TextBox_ValidYear"
                                             IsEnabled="{Binding IsInEdit}"
                                             MaxLength="4"
                                             Style="{StaticResource AtisTextBox}"
                                             Text="{Binding EditItem.ValidYear, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                    <CheckBox Grid.Row="1"
                                              Grid.Column="1"
                                              Margin="12,0,0,0"
                                              VerticalAlignment="Bottom"
                                              loc:Uids.Uid="CheckBox_Valid"
                                              IsChecked="{Binding EditItem.Valid, Mode=TwoWay}"
                                              IsEnabled="{Binding IsInEdit}"
                                              Style="{StaticResource AtisCheckBox}" />

                                    <TextBox Grid.Row="1"
                                             Grid.Column="2"
                                             Margin="12,0,0,0"
                                             loc:Uids.Uid="TextBox_ISBN"
                                             IsEnabled="{Binding IsInEdit}"
                                             MaxLength="60"
                                             Style="{StaticResource AtisTextBox}"
                                             Text="{Binding EditItem.ISBN, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock Grid.Row="2"
                                               Grid.Column="0"
                                               Grid.ColumnSpan="3"
                                               Foreground="Red"
                                               Text="{Binding EditItem.ValidYearError}"
                                               Visibility="{Binding EditItem.HasValidYearError, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </Grid>


                                <!--  Row 2: ArticelTitle  -->
                                <TextBox Grid.Row="2"
                                         MinWidth="600"
                                         loc:Uids.Uid="TextBox_ArticelTitle"
                                         IsEnabled="{Binding IsInEdit}"
                                         MaxLength="300"
                                         Style="{StaticResource AtisTextBox}"
                                         Text="{Binding EditItem.ArticelTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />


                                <!--  Row 3: BookName + Page1  -->
                                <Grid Grid.Row="3"
                                      ColumnDefinitions="*,120">
                                    <TextBox Grid.Column="0"
                                             loc:Uids.Uid="TextBox_BookName"
                                             IsEnabled="{Binding IsInEdit}"
                                             MaxLength="200"
                                             Style="{StaticResource AtisTextBox}"
                                             Text="{Binding EditItem.BookName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBox Grid.Column="1"
                                             Margin="12,0,0,0"
                                             loc:Uids.Uid="TextBox_Page"
                                             IsEnabled="{Binding IsInEdit}"
                                             MaxLength="60"
                                             Style="{StaticResource AtisTextBox}"
                                             Text="{Binding EditItem.Page1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>


                                <!--  Row 4: Publisher  -->
                                <TextBox Grid.Row="4"
                                         MinWidth="400"
                                         loc:Uids.Uid="TextBox_Publisher"
                                         IsEnabled="{Binding IsInEdit}"
                                         MaxLength="200"
                                         Style="{StaticResource AtisTextBox}"
                                         Text="{Binding EditItem.Publisher, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />


                                <!--  Row 5: PublicationPlace + PublicationYear  -->
                                <Grid Grid.Row="5"
                                      ColumnDefinitions="*,120">
                                    <TextBox Grid.Column="0"
                                             loc:Uids.Uid="TextBox_PublicationPlace"
                                             IsEnabled="{Binding IsInEdit}"
                                             MaxLength="100"
                                             Style="{StaticResource AtisTextBox}"
                                             Text="{Binding EditItem.PublicationPlace, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                    <!--<TextBox Grid.Column="1"
                                    Margin="12,0,0,0"
                                    loc:Uids.Uid="TextBox_PublicationYear"
                                    IsEnabled="{Binding IsInEdit}"
                                    MaxLength="4"
                                    Style="{StaticResource AtisTextBox}"
                                    Text="{Binding EditItem.PublicationYear, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />-->
                                </Grid>


                                <!--  Row 6: Info  -->
                                <Grid Grid.Row="6"
                                      ColumnDefinitions="Auto">
                                    <TextBox x:Name="Info"
                                             MinWidth="300"
                                             HorizontalAlignment="Left"
                                             loc:Uids.Uid="TextBox_Info"
                                             IsEnabled="{Binding IsInEdit}"
                                             MaxLength="100"
                                             Style="{StaticResource AtisTextBox}"
                                             Text="{Binding EditItem.Info, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>


                                <!--  Row 7: Notes  -->
                                <Grid Grid.Row="7"
                                      ColumnDefinitions="Auto,*">
                                    <TextBox Grid.Column="1"
                                             Height="80"
                                             loc:Uids.Uid="TextBox_Notes"
                                             AcceptsReturn="True"
                                             IsEnabled="{Binding IsInEdit}"
                                             Style="{StaticResource AtisTextBox}"
                                             Text="{Binding EditItem.Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             TextWrapping="Wrap" />
                                </Grid>


                                <!--  Row 8: Memo  -->
                                <Grid Grid.Row="8"
                                      ColumnDefinitions="Auto,*">
                                    <TextBox Grid.Column="1"
                                             Height="80"
                                             loc:Uids.Uid="TextBox_Memo"
                                             AcceptsReturn="True"
                                             IsEnabled="{Binding IsInEdit}"
                                             Style="{StaticResource AtisTextBox}"
                                             Text="{Binding EditItem.Memo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             TextWrapping="Wrap" />
                                </Grid>

                            </Grid>

                        </StackPanel>
                    </Border>
                </atis:Base1List1DetailPageLayout.DetailContent>

            </atis:Base1List1DetailPageLayout>

        </ScrollViewer>


        <!--  🔥 Modernes Lade Overlay  -->
        <atis:LoadingOverlayControl Grid.RowSpan="1"
                                    IsLoading="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

    </Grid>

</Page>
