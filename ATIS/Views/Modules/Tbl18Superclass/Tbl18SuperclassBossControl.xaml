<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="ATIS.Views.Modules.Tbl18Superclass.Tbl18SuperclassBossControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="using:WinUI3Localizer"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="using:ATIS.Models"
             mc:Ignorable="d">

    <!--    Tbl18SuperclassBossControl Skriptdatum:  15.06.2024  12:32 -->

    <UserControl.Resources>
        <!--  ID -->
        <GridLength x:Key="IdWidthResource">150</GridLength>
        <!--  Name -->
        <GridLength x:Key="Extra1WidthResource">200</GridLength>
        <!--  FK-ID -->
        <GridLength x:Key="Extra2WidthResource">200</GridLength>
        <!--  Valid -->
        <GridLength x:Key="Extra3WidthResource">80</GridLength>
        <!--  ValidYear -->
        <GridLength x:Key="Extra4WidthResource">100</GridLength>
        <!--  Author -->
        <GridLength x:Key="Extra5WidthResource">250</GridLength>
        <!--  AuthorYear -->
        <GridLength x:Key="Extra6WidthResource">100</GridLength>
    </UserControl.Resources>

    <Grid Padding="2"
          RowDefinitions="Auto,*">

        <!--  HEADER  -->
        <Grid Padding="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{StaticResource IdWidthResource}" />
                <ColumnDefinition Width="{StaticResource Extra1WidthResource}" />
                <ColumnDefinition Width="{StaticResource Extra2WidthResource}" />
                <ColumnDefinition Width="{StaticResource Extra3WidthResource}" />
                <ColumnDefinition Width="{StaticResource Extra4WidthResource}" />
                <ColumnDefinition Width="{StaticResource Extra5WidthResource}" />
                <ColumnDefinition Width="{StaticResource Extra6WidthResource}" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{x:Bind ViewModel.SortCommand}"
                    CommandParameter="Id"
                    FontWeight="Bold">
                <TextBlock Text="{x:Bind ViewModel.IdHeaderText, Mode=OneWay}" />
            </Button>

            <Button Grid.Column="1"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{x:Bind ViewModel.SortCommand}"
                    CommandParameter="Name"
                    FontWeight="Bold">
                <TextBlock Text="{x:Bind ViewModel.NameHeaderText, Mode=OneWay}" />
            </Button>

            <TextBlock Grid.Column="2"
                       Margin="0,6,0,0"
                       loc:Uids.Uid="TextBlock_SubphylumName"
                       FontWeight="Bold" />
            <TextBlock Grid.Column="3"
                       Margin="0,6,0,0"
                       loc:Uids.Uid="TextBlock_Valid"
                       FontWeight="Bold" />
            <TextBlock Grid.Column="4"
                       Margin="0,6,0,0"
                       loc:Uids.Uid="TextBlock_Year"
                       FontWeight="Bold" />
            <TextBlock Grid.Column="5"
                       Margin="0,6,0,0"
                       loc:Uids.Uid="TextBlock_Author"
                       FontWeight="Bold" />
            <TextBlock Grid.Column="6"
                       Margin="0,6,0,0"
                       loc:Uids.Uid="TextBlock_Year"
                       FontWeight="Bold" />
        </Grid>

        <ListView x:Name="SuperclassListView"
                  Grid.Row="1"
                  MaxHeight="150"
                  Margin="0,0,10,0"
                  BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                  BorderThickness="1"
                  CornerRadius="4"
                  IsItemClickEnabled="True"
                  ItemContainerStyle="{StaticResource AtisListViewItemStyle}"
                  ItemsSource="{Binding Items}"
                  RightTapped="SuperclassListView_RightTapped"
                  SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                  SelectionMode="Single">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:Tbl18Superclass">
                    <Grid Style="{StaticResource AtisListRowGridStyle}">

                        <!--  Kontextmenü direkt am Row-Root  -->
                        <Grid.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem loc:Uids.Uid="MenuFlyout_Add_Superclass"
                                                Command="{Binding DataContext.NewCommand, ElementName=SuperclassListView}">
                                    <MenuFlyoutItem.Icon>
                                        <SymbolIcon Symbol="Add" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem loc:Uids.Uid="MenuFlyout_Save_Superclass"
                                                Command="{Binding DataContext.SaveCommand, ElementName=SuperclassListView}"
                                                CommandParameter="{Binding}">
                                    <MenuFlyoutItem.Icon>
                                        <SymbolIcon Symbol="Save" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem loc:Uids.Uid="MenuFlyout_Delete_Superclass"
                                                Command="{Binding DataContext.DeleteCommand, ElementName=SuperclassListView}"
                                                CommandParameter="{Binding}">
                                    <MenuFlyoutItem.Icon>
                                        <SymbolIcon Symbol="Delete" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem loc:Uids.Uid="MenuFlyout_Refresh"
                                                Command="{Binding DataContext.RefreshCommand, ElementName=SuperclassListView}">
                                    <MenuFlyoutItem.Icon>
                                        <SymbolIcon Symbol="Refresh" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Grid.ContextFlyout>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource IdWidthResource}" />
                            <ColumnDefinition Width="{StaticResource Extra1WidthResource}" />
                            <ColumnDefinition Width="{StaticResource Extra2WidthResource}" />
                            <ColumnDefinition Width="{StaticResource Extra3WidthResource}" />
                            <ColumnDefinition Width="{StaticResource Extra4WidthResource}" />
                            <ColumnDefinition Width="{StaticResource Extra5WidthResource}" />
                            <ColumnDefinition Width="{StaticResource Extra6WidthResource}" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Margin="4,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="{x:Bind SuperclassId}" />
                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Text="{x:Bind SuperclassName}" />
                        <TextBlock Grid.Column="2"
                                   VerticalAlignment="Center"
                                   Text="{x:Bind SubphylumName}" />
                        <CheckBox Grid.Column="3"
                                  IsChecked="{x:Bind Valid}"
                                  IsEnabled="False"
                                  IsTabStop="False" />
                        <TextBlock Grid.Column="4"
                                   VerticalAlignment="Center"
                                   Text="{x:Bind ValidYear}" />
                        <TextBlock Grid.Column="5"
                                   VerticalAlignment="Center"
                                   Text="{x:Bind Author}" />
                        <TextBlock Grid.Column="6"
                                   VerticalAlignment="Center"
                                   Text="{x:Bind AuthorYear}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>

            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsStackPanel />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>

        </ListView>
    </Grid>
</UserControl>    
