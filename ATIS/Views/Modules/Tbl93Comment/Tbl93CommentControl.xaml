<UserControl
    x:Class="ATIS.Views.Modules.Tbl93Comment.Tbl93CommentControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:ATIS.Models"
    xmlns:tbl93="using:ATIS.Views.Modules.Tbl93Comment"
    x:Name="Root">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- HEADER -->
        <StackPanel Orientation="Horizontal"
                    Spacing="10"
                    Margin="0,0,0,8">
            <TextBlock Text="Comments"
                       FontWeight="Bold" />
            <TextBlock Text="Datensätze:" />
            <TextBlock Text="{Binding DataSetCount}" />
        </StackPanel>

        <!-- LISTVIEW -->
        <ListView Grid.Row="1"
                  ItemsSource="{Binding Comments}"
                  SelectedItem="{Binding SelectedComment, Mode=TwoWay}"
                  HorizontalContentAlignment="Stretch">

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:Tbl93Comment">
                    <tbl93:Tbl93CommentRowControl Comment="{x:Bind}" />
                </DataTemplate>
            </ListView.ItemTemplate>

        </ListView>

        <!-- EDIT -->
        <tbl93:Tbl93CommentEditControl Grid.Row="2"
                                       Margin="0,8,0,0"
                                       Item="{Binding SelectedComment}" />

    </Grid>
</UserControl>
