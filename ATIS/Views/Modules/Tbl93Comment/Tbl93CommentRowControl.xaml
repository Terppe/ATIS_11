<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="ATIS.Views.Modules.Tbl93Comment.Tbl93CommentRowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:WinUI3Localizer" 
             >

    <Grid x:Name="Root" 
          Padding="4"
          Background="#F2F2F2"
          BorderBrush="#CCCCCC"
          BorderThickness="1"
          CornerRadius="4" MinHeight="24"
          PointerEntered="Root_PointerEntered"
          PointerExited="Root_PointerExited"
          Tapped="Root_Tapped">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding IdWidth}" />
            <ColumnDefinition Width="{Binding InfoWidth}" />
        </Grid.ColumnDefinitions>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="RowStates">

                <VisualState x:Name="Normal">
                    <VisualState.Setters>
                        <Setter Target="Root.Background" Value="#F2F2F2" />
                        <Setter Target="Root.BorderBrush" Value="#CCCCCC" />
                        <Setter Target="Root.BorderThickness" Value="1" />
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="Hover">
                    <VisualState.Setters>
                        <Setter Target="Root.Background" Value="#E5E5E5" />
                        <Setter Target="Root.BorderBrush" Value="#BBBBBB" />
                        <Setter Target="Root.BorderThickness" Value="1" />
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="Selected">
                    <VisualState.Setters>
                        <Setter Target="Root.Background" Value="#CCE0FF" />
                        <Setter Target="Root.BorderBrush" Value="#6699FF" />
                        <Setter Target="Root.BorderThickness" Value="2" />
                    </VisualState.Setters>
                </VisualState>

            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!--  Spalte 0  -->
        <TextBlock Grid.Column="0"
                   VerticalAlignment="Center"
                   loc:Uids.Uid="TextBlock_CommentId"
                   Text="{x:Bind Comment.CommentId}" />

        <!--  Spalte 1  -->
        <TextBlock Grid.Column="1"
                   VerticalAlignment="Center"
                   loc:Uids.Uid="TextBlock_Info"
                   Text="{x:Bind Comment.Info}" />


    </Grid>
</UserControl>
