<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="ATIS.Views.Modules.Tbl93Comment.Tbl93CommentBossControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="using:WinUI3Localizer"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="using:ATIS.Models"
             mc:Ignorable="d">

    <UserControl.Resources>
        <GridLength x:Key="IdWidthResource">120</GridLength>
        <GridLength x:Key="Extra1WidthResource">500</GridLength>
        <GridLength x:Key="Extra2WidthResource">80</GridLength>
        <GridLength x:Key="Extra3WidthResource">100</GridLength>

    </UserControl.Resources>

    <Grid Padding="2"
          RowDefinitions="Auto,*">

        <!--  LIST HEADER  -->
        <Grid Grid.Row="0"
              Padding="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{StaticResource IdWidthResource}" />
                <ColumnDefinition Width="{StaticResource Extra1WidthResource}" />
                <ColumnDefinition Width="{StaticResource Extra2WidthResource}" />
                <ColumnDefinition Width="{StaticResource Extra3WidthResource}" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       loc:Uids.Uid="TextBlock_CommentId"
                       FontWeight="Bold" />
            <TextBlock Grid.Column="1"
                       loc:Uids.Uid="TextBlock_Info"
                       FontWeight="Bold" />
            <TextBlock Grid.Column="2"
                       loc:Uids.Uid="TextBlock_Valid"
                       FontWeight="Bold" />
            <TextBlock Grid.Column="3"
                       loc:Uids.Uid="TextBlock_Year"
                       FontWeight="Bold" />
        </Grid>

        <ListView x:Name="CommentListView"
                  Grid.Row="1"
                  MaxHeight="112.5"
                  Margin="0,0,10,0"
                  BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                  BorderThickness="1"
                  CornerRadius="4"
                  ItemContainerStyle="{StaticResource AtisListViewItemStyle}"
                  ItemsSource="{Binding Items}"
                  RightTapped="CommentListView_RightTapped"
                  SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                  SelectionMode="Single">

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:Tbl93Comment">
                    <Grid Style="{StaticResource AtisListRowGridStyle}">

                        <Grid.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem loc:Uids.Uid="MenuFlyout_Add_Comment"
                                                Command="{Binding DataContext.NewCommand, ElementName=CommentListView}">
                                    <MenuFlyoutItem.Icon>
                                        <SymbolIcon Symbol="Add" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem loc:Uids.Uid="MenuFlyout_Save_Comment"
                                                Command="{Binding DataContext.SaveCommand, ElementName=CommentListView}">
                                    <MenuFlyoutItem.Icon>
                                        <SymbolIcon Symbol="Save" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem loc:Uids.Uid="MenuFlyout_Delete_Comment"
                                                Command="{Binding DataContext.DeleteCommand, ElementName=CommentListView}">
                                    <MenuFlyoutItem.Icon>
                                        <SymbolIcon Symbol="Delete" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Grid.ContextFlyout>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource IdWidthResource}" />
                            <ColumnDefinition Width="{StaticResource Extra1WidthResource}" />
                            <ColumnDefinition Width="{StaticResource Extra2WidthResource}" />
                            <ColumnDefinition Width="{StaticResource Extra3WidthResource}" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Margin="4,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="{x:Bind CommentId}" />
                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Text="{x:Bind Info}" />
                        <CheckBox Grid.Column="2"
                                  IsChecked="{x:Bind Valid}"
                                  IsEnabled="False"
                                  IsTabStop="False" />
                        <TextBlock Grid.Column="3"
                                   VerticalAlignment="Center"
                                   Text="{x:Bind ValidYear}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>

            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsStackPanel />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>

        </ListView>

    </Grid>
</UserControl>
