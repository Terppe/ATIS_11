<UserControl x:Class="ATIS.Views.Modules.Tbl93Comment.Tbl93CommentEditControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:WinUI3Localizer"
             x:Name="EditRoot">

    <Border Padding="4"
            Background="{ThemeResource ControlFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="6">

        <StackPanel Spacing="4">

            <!--  HEADER  -->
            <Grid Margin="0,0,0,4"
                  ColumnDefinitions="*,Auto">

                <!--  Titel links  -->
                <TextBlock Grid.Column="0"
                           Margin="8,0,0,0"
                           loc:Uids.Uid="TextBlock_Comment"
                           Style="{StaticResource AtisSectionTitleTextStyle}" />

                <!--  Buttons rechts  -->
                <StackPanel Grid.Column="1"
                            Margin="8,0,8,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">
                    <Button Command="{Binding CloseEditCommand}">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6">
                            <FontIcon Glyph="&#xE72B;" />
                            <TextBlock Text="Back" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NewCommand}"
                            Style="{StaticResource AtisPrimaryButton}">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6">
                            <FontIcon Glyph="&#xE710;" />
                            <TextBlock loc:Uids.Uid="TextBlock_Add" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding SaveCommand}"
                            Style="{StaticResource AtisSecondaryButton}">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6">
                            <FontIcon Glyph="&#xE74E;" />
                            <TextBlock loc:Uids.Uid="TextBlock_Save" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding DeleteCommand}"
                            Style="{StaticResource AtisSecondaryButton}">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6">
                            <FontIcon Glyph="&#xE74D;" />
                            <TextBlock loc:Uids.Uid="TextBlock_Delete" />
                        </StackPanel>
                    </Button>

                </StackPanel>
            </Grid>
            <!--  ID + Valid + Year  -->
            <StackPanel Orientation="Horizontal"
                        Spacing="4">
                <TextBox Width="120"
                         loc:Uids.Uid="TextBox_CommentId"
                         IsReadOnly="True"
                         Style="{StaticResource AtisTextBox}"
                         Text="{x:Bind Item.CommentId, Mode=OneWay}" />

                <!--  CheckBox  -->
                <CheckBox MinWidth="60"
                          VerticalAlignment="Bottom"
                          loc:Uids.Uid="CheckBox_Valid"
                          IsChecked="{x:Bind Item.Valid, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          Style="{StaticResource AtisCheckBox}" />

                <!--  ValidYear mit Validierung  -->
                <StackPanel MinWidth="60"
                            VerticalAlignment="Top"
                            Spacing="2">

                    <TextBox x:Name="ValidYearBox"
                             loc:Uids.Uid="TextBox_ValidYear"
                             Loaded="ValidYearBox_OnLoaded"
                             Style="{StaticResource AtisTextBox}"
                             Text="{x:Bind Item.ValidYear, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             TextChanged="ValidYearBox_OnTextChanged" />

                    <TextBlock Height="16"
                               FontSize="10"
                               Foreground="Red"
                               Text="{x:Bind Item.ValidYearError, Mode=OneWay}"
                               Visibility="{x:Bind Item.HasValidYearError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
            </StackPanel>

            <!--  Info mit Validierung  -->
            <StackPanel MinWidth="300"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Spacing="2">

                <TextBox x:Name="InfoBox"
                         loc:Uids.Uid="TextBox_Info"
                         Loaded="InfoBox_OnLoaded"
                         Style="{StaticResource AtisTextBox}"
                         Text="{x:Bind Item.Info, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         TextChanged="InfoBox_OnTextChanged" />

                <TextBlock Height="16"
                           FontSize="10"
                           Foreground="Red"
                           Text="{x:Bind Item.InfoError, Mode=OneWay}"
                           Visibility="{x:Bind Item.HasInfoError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
            </StackPanel>
            <!--  Memo  -->
            <TextBox MinHeight="75"
                     MaxHeight="150"
                     loc:Uids.Uid="TextBox_Memo"
                     AcceptsReturn="True"
                     Style="{StaticResource AtisTextBox}"
                     Text="{x:Bind Item.Memo, Mode=TwoWay}"
                     TextWrapping="Wrap" />

        </StackPanel>
    </Border>

</UserControl>
