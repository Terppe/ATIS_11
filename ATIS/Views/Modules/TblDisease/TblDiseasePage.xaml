<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="ATIS.Views.Modules.TblDisease.TblDiseasePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:components="using:ATIS.DesignSystem.Components"
      xmlns:layout="using:ATIS.DesignSystem.Layout"
      xmlns:loc="using:WinUI3Localizer"
      xmlns:tbl81Image="using:ATIS.Views.Modules.Tbl81Image"
      xmlns:tblDisease="using:ATIS.Views.Modules.TblDisease"
      x:Name="RootPage">

    <!--  TblDiseasePage Skriptdatum:  11.09.2026  10:32  -->

    <Grid x:Name="RootGrid">
        <ScrollViewer VerticalScrollBarVisibility="Visible">

            <layout:BaseBossPageLayout>

                <!--  HEADER LEFT  -->
                <layout:BaseBossPageLayout.Header>
                    <StackPanel Margin="8,0,0,8"
                                Orientation="Horizontal"
                                Spacing="10">

                        <TextBlock Margin="0,4,0,0"
                                   loc:Uids.Uid="TextBlock_Diseases"
                                   Style="{StaticResource AtisSectionTitleTextStyle}" />

                        <TextBlock Margin="0,12,0,0"
                                   loc:Uids.Uid="TextBlock_DataSetCount"
                                   Style="{StaticResource AtisBodyTextStyle}" />

                        <TextBlock Margin="0,12,0,0"
                                   Style="{StaticResource AtisBodyTextStyle}"
                                   Text="{Binding DataSetCount}" />
                    </StackPanel>
                </layout:BaseBossPageLayout.Header>

                <!--  APPBAR RIGHT  -->
                <layout:BaseBossPageLayout.AppBar>
                    <Grid ColumnSpacing="8">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Margin="8"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">

                            <Button Margin="5,0,5,0"
                                    Command="{Binding NewCommand}"
                                    IsEnabled="{Binding IsEditMode, Converter={StaticResource InverseBoolConverter}}"
                                    Style="{StaticResource AtisPrimaryButton}">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="6">
                                    <FontIcon Glyph="&#xE710;" />
                                    <TextBlock loc:Uids.Uid="TextBlock_Add" />
                                </StackPanel>
                            </Button>

                            <Button Margin="5,0,5,0"
                                    Command="{Binding RefreshCommand}"
                                    IsEnabled="{Binding HasItems}"
                                    Style="{StaticResource AtisSecondaryButton}">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="6">
                                    <FontIcon Glyph="&#xE72C;" />
                                    <TextBlock loc:Uids.Uid="TextBlock_Refresh" />
                                </StackPanel>
                            </Button>

                        </StackPanel>

                        <!--  SEARCH  -->
                        <AutoSuggestBox x:Name="SearchBox"
                                        Grid.Column="1"
                                        Width="260"
                                        Height="32"
                                        Margin="12,0"
                                        VerticalAlignment="Center"
                                        IsEnabled="{Binding IsInParentMode, Converter={StaticResource InverseBoolConverter}}"
                                        PlaceholderText="Suchen..."
                                        QueryIcon="Find"
                                        QuerySubmitted="SearchBox_OnQuerySubmitted"
                                        Text="{Binding SearchText, Mode=TwoWay}" />
                    </Grid>
                </layout:BaseBossPageLayout.AppBar>

                <!--  LIST CONTENT  -->
                <layout:BaseBossPageLayout.ListContent>
                    <tblDisease:TblDiseaseBossControl DataContext="{Binding}" />
                </layout:BaseBossPageLayout.ListContent>

                <!--  DETAIL CONTENT  -->

                <layout:BaseBossPageLayout.DetailContent>
                    <Grid RowDefinitions="Auto,*"
                          Visibility="{Binding IsDetailVisible, Converter={StaticResource BoolToVisibilityConverter}}">

                        <!--  Headerleiste  -->
                        <ScrollViewer Grid.Row="0"
                                      HorizontalScrollBarVisibility="Hidden"
                                      HorizontalScrollMode="Auto"
                                      VerticalScrollBarVisibility="Disabled"
                                      VerticalScrollMode="Disabled"
                                      ZoomMode="Disabled">
                            <StackPanel Margin="0,10,0,10"
                                        Orientation="Horizontal"
                                        Spacing="4">

                                <Button x:Name="EditDiseaseTab"
                                        x:FieldModifier="public"
                                        Click="DetailTabButton_Click"
                                        Style="{StaticResource TabButtonStyle}"
                                        Tag="0">
                                    <StackPanel Spacing="4">
                                        <TextBlock HorizontalAlignment="Center"
                                                   loc:Uids.Uid="TextBlock_Edit_Disease" />
                                        <Border x:Name="EditDiseaseTabUnderline"
                                                Height="2"
                                                x:FieldModifier="public"
                                                Background="Transparent" />
                                    </StackPanel>
                                </Button>

                                <Button x:Name="ImageTab"
                                        x:FieldModifier="public"
                                        Click="DetailTabButton_Click"
                                        Style="{StaticResource TabButtonStyle}"
                                        Tag="1">
                                    <StackPanel Spacing="4">
                                        <TextBlock HorizontalAlignment="Center"
                                                   loc:Uids.Uid="TextBlock_Images" />
                                        <Border x:Name="ImageTabUnderline"
                                                Height="2"
                                                x:FieldModifier="public"
                                                Background="Transparent" />
                                    </StackPanel>
                                </Button>

                            </StackPanel>
                        </ScrollViewer>

                        <!--  Inhalte  -->
                        <Grid Grid.Row="1">

                            <ScrollViewer x:Name="EditDiseaseContent"
                                          Padding="1">
                                <tblDisease:TblDiseaseEditControl Item="{Binding SelectedItem, Mode=TwoWay}" />
                            </ScrollViewer>

                            <Grid x:Name="ImageContent"
                                  x:FieldModifier="public"
                                  DataContext="{Binding ImageViewModel}"
                                  RowDefinitions="Auto,*">
                                <tbl81Image:Tbl81ImageParentControl x:Name="ImageParentControl"
                                                                    Grid.Row="0" />
                                <tbl81Image:Tbl81ImageEditControl Grid.Row="1"
                                                                  Item="{Binding Item}"
                                                                  Visibility="{Binding HasActiveItem, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <!--<tbl81Image:Tbl81ImageEditControl Grid.Row="1"
                                Item="{Binding Item}"
                                Visibility="{Binding HasActiveItem, Converter={StaticResource BoolToVisibilityConverter}}" />-->
                            </Grid>
                            <Grid x:Name="ImageContentLoadingOverlay"
                                  Background="#66000000"
                                  IsHitTestVisible="True"
                                  Visibility="{x:Bind ViewModel.ShowImageTabLoadingOverlay, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Spacing="12">
                                    <ProgressRing Width="48"
                                                  Height="48"
                                                  IsActive="True" />
                                    <TextBlock HorizontalAlignment="Center"
                                               loc:Uids.Uid="TextBlock_Mediaload"
                                               Foreground="White" />
                                </StackPanel>
                            </Grid>

                        </Grid>

                    </Grid>
                </layout:BaseBossPageLayout.DetailContent>

            </layout:BaseBossPageLayout>

        </ScrollViewer>

        <!--  2. 🔥 Modernes Lade Overlay  -->
        <components:LoadingOverlayControl Grid.RowSpan="1"
                                          IsLoading="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

    </Grid>
</Page>
