                    <!--<ListView
                    Grid.Row="0"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Margin="-12,0,0,0"
                    ItemContainerStyle="{StaticResource NoSpacesListViewItemStyle}"
                    ItemTemplate="{StaticResource ReportItemTemplateHeaderFood}"
                    ItemsSource="{x:Bind ViewModel.FoodItems}" />-->
                    <!--<ListView Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Margin="-12,0,0,0"
