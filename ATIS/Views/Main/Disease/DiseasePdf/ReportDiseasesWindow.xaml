<?xml version="1.0" encoding="utf-8" ?>
<winUiEx:WindowEx x:Class="ATIS.Views.Main.Disease.DiseasePdf.ReportDiseasesWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:converters="using:ATIS.Helpers.Converters"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:dataTemplates="using:ATIS.Views.Report.DataTemplates"
                  xmlns:loca="using:WinUI3Localizer"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:models="using:ATIS.Models"
                  xmlns:winUiEx="using:WinUIEx"
                  xmlns:diseasePdf="using:ATIS.Views.Main.Disease.DiseasePdf"
                  mc:Ignorable="d">

    <!--  ReportDiseasesWindow.xaml  Skriptdatum:  15.06.2024  12:32  -->

    <Grid>
        <Grid.Resources>
            <converters:ImageSourceConverter x:Key="ImageSourceConverter" />

            <Style x:Key="NoSpacesListViewItemStyle"
                   TargetType="ListViewItem">
                <Setter Property="MinHeight" Value="24" />
            </Style>
            <DataTemplate x:Key="ReportItemTemplateImage"
                          x:DataType="models:Tbl81Image">
                <diseasePdf:ReportItemTemplateImageControl />
            </DataTemplate>

        </Grid.Resources>

        <!--  Part 1  -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button x:Uid="Button_PrintPdf"
                        Margin="50,5,10,5"
                        Click="PdfDiseaseCommand"
                        Style="{StaticResource CrudButtonStyle}" />
                <Button x:Uid="Button_Close_Window"
                        Margin="50,5,10,5"
                        HorizontalAlignment="Right"
                        Click="OnCloseClick"
                        Style="{StaticResource CrudButtonStyle}" />
            </StackPanel>
            <ScrollViewer Grid.Row="1"
                          Padding="{StaticResource SmallDetailPageMargin}"
                          HorizontalAlignment="Stretch"
                          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                          IsTabStop="True"
                          VerticalScrollMode="Enabled">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!--<ColumnDefinition Width="260" />-->
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock FontSize="18"
                                   FontWeight="Bold"
                                   Style="{StaticResource HeaderTextBlockStyle}"
                                   Text="{x:Bind ViewModel.DiseaseSelected.DiseaseName, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1"
                                Grid.Column="0"
                                Orientation="Horizontal">
                        <TextBlock Width="Auto"
                                   loca:Uids.Uid="TextBlock_CountId" />
                        <TextBlock Width="Auto"
                                   Margin="8,0,0,0"
                                   Text="{x:Bind ViewModel.DiseaseSelected.CountId, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Grid.Row="2"
                                Grid.Column="0"
                                Orientation="Horizontal">
                        <TextBlock Width="Auto"
                                   loca:Uids.Uid="TextBlock_Valid" />
                        <CheckBox Width="80"
                                  Margin="{StaticResource SmallLeftMargin}"
                                  Content="Valid"
                                  IsChecked="{x:Bind ViewModel.DiseaseSelected.Valid, Mode=OneWay}" />
                        <TextBlock Width="Auto"
                                   loca:Uids.Uid="TextBlock_ValidYear" />
                        <TextBlock Margin="{StaticResource XSmallLeftTopRightBottomMargin}"
                                   Style="{StaticResource ListSubTitleStyle}"
                                   Text="{x:Bind ViewModel.DiseaseSelected.ValidYear, Mode=OneWay}" />

                    </StackPanel>
                    <StackPanel Grid.Row="3"
                                Grid.Column="0">
                        <TextBlock Width="Auto"
                                   loca:Uids.Uid="TextBlock_ShortInfo"
                                   FontSize="18"
                                   FontWeight="Bold" />
                    </StackPanel>
                    <StackPanel Grid.Row="4"
                                Grid.Column="0">
                        <TextBlock Width="Auto"
                                   Margin="8,0,0,0"
                                   Text="{x:Bind ViewModel.DiseaseSelected.ShortInfo, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Grid.Row="5"
                                Grid.Column="0">
                        <TextBlock Width="Auto"
                                   loca:Uids.Uid="TextBlock_Symptom"
                                   FontSize="18"
                                   FontWeight="Bold" />
                    </StackPanel>
                    <StackPanel Grid.Row="6"
                                Grid.Column="0">
                        <TextBlock Width="Auto"
                                   Margin="8,0,0,0"
                                   Text="{x:Bind ViewModel.DiseaseSelected.Symptom, Mode=OneWay}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Row="7"
                                Grid.Column="0">
                        <TextBlock Width="Auto"
                                   loca:Uids.Uid="TextBlock_Reason"
                                   FontSize="18"
                                   FontWeight="Bold" />
                    </StackPanel>
                    <StackPanel Grid.Row="8"
                                Grid.Column="0">
                        <TextBlock Width="Auto"
                                   Margin="8,0,0,0"
                                   Text="{x:Bind ViewModel.DiseaseSelected.Reason, Mode=OneWay}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Row="9"
                                Grid.Column="0">
                        <TextBlock Width="Auto"
                                   loca:Uids.Uid="TextBlock_Curability"
                                   FontSize="18"
                                   FontWeight="Bold" />
                    </StackPanel>
                    <StackPanel Grid.Row="11"
                                Grid.Column="0">
                        <TextBlock Width="Auto"
                                   loca:Uids.Uid="TextBlock_Therapie"
                                   FontSize="18"
                                   FontWeight="Bold" />
                    </StackPanel>
                    <StackPanel Grid.Row="12"
                                Grid.Column="0">
                        <TextBlock Width="Auto"
                                   Margin="8,0,0,0"
                                   Text="{x:Bind ViewModel.DiseaseSelected.Therapie, Mode=OneWay}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Row="13"
                                Grid.Column="0">
                        <TextBlock Width="Auto"
                                   loca:Uids.Uid="TextBlock_Info"
                                   FontSize="18"
                                   FontWeight="Bold" />
                    </StackPanel>
                    <StackPanel Grid.Row="14"
                                Grid.Column="0">
                        <TextBlock Width="Auto"
                                   Margin="8,0,0,0"
                                   Text="{x:Bind ViewModel.DiseaseSelected.Info, Mode=OneWay}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Row="15"
                                Grid.Column="0">
                        <TextBlock Width="Auto"
                                   loca:Uids.Uid="TextBlock_Memo"
                                   FontSize="18"
                                   FontWeight="Bold" />
                    </StackPanel>
                    <StackPanel Grid.Row="16"
                                Grid.Column="0">
                        <TextBlock Width="Auto"
                                   Margin="8,0,0,0"
                                   Text="{x:Bind ViewModel.DiseaseSelected.Memo, Mode=OneWay}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <!--<StackPanel
                    Grid.Row="15"
                    Grid.Column="0">
                    <TextBlock
                    Width="Auto"
                    loca:Uids.Uid="TextBlock_ImageId"
                    FontSize="18"
                    FontWeight="Bold" />
                    </StackPanel>
                    <StackPanel
