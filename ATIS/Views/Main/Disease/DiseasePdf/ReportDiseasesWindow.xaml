                    ItemTemplate="{StaticResource ReportItemTemplateHeaderTaxoNomenHeader}"
                    ItemsSource="{x:Bind ViewModel.FoodItems}" />-->
                    <!--<ListView Grid.Row="2"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Margin="-12,0,0,0"
                    ItemContainerStyle="{StaticResource NoSpacesListViewItemStyle}"
                    ItemTemplate="{StaticResource ReportItemTemplateHeaderTaxoNomenHeaderBodyFood}"
                    ItemsSource="{x:Bind ViewModel.FoodItems}" />-->

                    <!--<ListView Grid.Row="5"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Margin="-12,0,0,0"
                    ItemContainerStyle="{StaticResource NoSpacesListViewItemStyle}"
                    ItemTemplate="{StaticResource ReportItemTemplateHyperlinkFood}"
                    ItemsSource="{x:Bind ViewModel.FoodItems}" />-->

                    <!--  Part 2  -->

                    <!--<TextBlock Grid.Row="15"
                    Grid.Column="0"
                    Margin="0,0,0,10"
                    loca:Uids.Uid="TextBlock_ImagesInformation"
                    FontSize="18"
                    FontWeight="Bold" />
                    <ListView Grid.Row="16"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Margin="-12,0,0,0"
                    ItemContainerStyle="{StaticResource NoSpacesListViewItemStyle}"
                    ItemTemplate="{StaticResource ReportItemTemplateImage}"
                    ItemsSource="{x:Bind ViewModel.ImageItems}" />-->

                    <!--  Part 3  -->
                    <TextBlock x:Uid="TextBlock_ImagesInformation"
                               Grid.Row="17"
                               Grid.Column="0"
                               Margin="0,0,0,10"
                               FontSize="18"
                               FontWeight="Bold" />
                    <ListView Grid.Row="18"
                              Grid.Column="0"
                              Margin="-12,0,0,0"
                              ItemContainerStyle="{StaticResource NoSpacesListViewItemStyle}"
                              ItemTemplate="{StaticResource ReportItemTemplateImage}"
                              ItemsSource="{x:Bind ViewModel.ImageItems}" />

                </Grid>


            </ScrollViewer>
        </Grid>
    </Grid>
</winUiEx:WindowEx>
