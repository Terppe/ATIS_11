<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="ATIS.Views.Main.Disease.DiseasePdf.ReportItemTemplateImageControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="using:ATIS.Helpers.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <converters:ImageSourceConverter x:Key="ImageSourceConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Uid="TextBlock_Name"
                       Width="Auto"
                       Margin="8,0,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="0"
                    Grid.Column="1">
            <TextBlock Width="Auto"
                       Text="{Binding ImageId}" />
        </StackPanel>
        <StackPanel Grid.Row="1"
                    Grid.Column="1">
            <Border Name="Border1"
                    Width="Auto">
                <Image Name="img"
                       Width="300"
                       Height="200"
                       Source="{Binding Filestream, Converter={StaticResource ResourceKey=ImageSourceConverter}}"
                       Stretch="Uniform" />
            </Border>
        </StackPanel>
        <StackPanel Grid.Row="2"
                    Grid.Column="0">
            <TextBlock x:Uid="TextBlock_ShotDate"
                       Margin="8,0,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="2"
                    Grid.Column="1">
            <TextBlock Width="Auto"
                       Text="{Binding ShotDate}" />
        </StackPanel>
        <StackPanel Grid.Row="3"
                    Grid.Column="0">
            <TextBlock x:Uid="TextBlock_ImageMimeType"
                       Margin="8,0,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="3"
                    Grid.Column="1">
            <TextBlock Width="Auto"
                       Text="{Binding ImageMimeType}" />
        </StackPanel>
        <StackPanel Grid.Row="4"
                    Grid.Column="0">
            <TextBlock x:Uid="TextBlock_Info"
                       Margin="8,0,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="4"
                    Grid.Column="1">
            <TextBlock Width="Auto"
                       Text="{Binding Info}" />
        </StackPanel>
        <StackPanel Grid.Row="5"
                    Grid.Column="0">
            <TextBlock x:Uid="TextBlock_Notes"
                       Margin="8,0,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="5"
                    Grid.Column="1">
            <TextBlock Width="Auto"
                       Text="{Binding Memo}"
                       TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
