<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="ATIS.Views.Main.Disease.DiseasePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:loca="using:WinUI3Localizer"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:toolkit="using:CommunityToolkit.WinUI.UI.Controls"
      NavigationCacheMode="Disabled"
      mc:Ignorable="d">

    <!--  DiseasePage.xaml  Skriptdatum:  28.09.2025 12:32  -->

    <Page.Resources>
        <!--  DataContextMenu  -->
        <MenuFlyout x:Key="DiseaseDataContextMenu">
            <MenuFlyoutItem x:Uid="MenuFlyout_Select"
                            Click="DiseaseSelect_Click">
                <MenuFlyoutItem.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/select.png" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem x:Uid="MenuFlyout_Print"
                            Command="{x:Bind PdfDiseaseCommand}">
                <MenuFlyoutItem.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/pdf.png" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>

        <!--<DataTemplate x:Key="SearchItemTemplateTblDisease"
        x:DataType="models:TblDisease">
        <diseasePdf1:SearchItemTemplateTblDiseaseControl />
        </DataTemplate>-->

    </Page.Resources>

    <RelativePanel x:Name="DiseaseRoot"
                   Margin="{StaticResource SmallLeftTopRightBottomMargin}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource LargeWindowSnapPoint}" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource MediumWindowSnapPoint}" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource MinWindowSnapPoint}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="DiseaseCommandBar.DefaultLabelPosition" Value="Bottom" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <TextBlock x:Name="PageTitle"
                   loca:Uids.Uid="TextBlock_Diseases"
                   RelativePanel.AlignLeftWithPanel="True"
                   Style="{StaticResource PageTitleTextBlockStyle}" />
        <TextBlock x:Name="DiseaseDatasetText"
                   Margin="5,17,0,0"
                   loca:Uids.Uid="TextBlock_DataSetCount"
                   RelativePanel.RightOf="PageTitle"
                   Style="{StaticResource DatasetTitleStyle}" />
        <TextBlock x:Name="DiseaseDatasetCountText"
                   Margin="5,17,0,0"
                   RelativePanel.RightOf="DiseaseDatasetText"
                   Style="{StaticResource DatasetTitleStyle}"
                   Text="{x:Bind ViewModel.DiseaseDataSetCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <CommandBar x:Name="DiseaseCommandBar"
                    HorizontalAlignment="Stretch"
                    Background="Transparent"
                    DefaultLabelPosition="Right"
                    RelativePanel.LeftOf="DiseaseSearchBox"
                    RelativePanel.RightOf="DiseaseDatasetCountText" />

        <AutoSuggestBox Name="DiseaseSearchBox"
                        Width="200"
                        Margin="4,8,4,0"
                        loca:Uids.Uid="AutoSuggestBox_Search"
                        Loaded="DiseaseSearchBox_OnLoaded"
                        QuerySubmitted="GetDiseasesByNameOrId"
                        RelativePanel.AlignRightWithPanel="True">
            <AutoSuggestBox.QueryIcon>
                <BitmapIcon ShowAsMonochrome="False"
                            UriSource="/Assets/Fluent/search.png" />
            </AutoSuggestBox.QueryIcon>
        </AutoSuggestBox>

        <ScrollViewer x:Name="PanelDisease"
                      RelativePanel.AlignLeftWithPanel="True"
                      RelativePanel.AlignRightWithPanel="True"
                      RelativePanel.Below="PageTitle"
                      VerticalScrollBarVisibility="Auto"
                      VerticalScrollMode="Auto">
            <StackPanel Margin="-10,8,4,0">
                <StackPanel.Resources>
                    <Style TargetType="Expander">
                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                    </Style>
                </StackPanel.Resources>
                <toolkit:DataGrid x:Name="DiseaseDataGrid"
                                  MaxHeight="430"
                                  Margin="0,0,20,0"
                                  VerticalAlignment="Top"
                                  x:FieldModifier="public"
                                  AlternatingRowBackground="LightGray"
                                  AutoGenerateColumns="False"
                                  ContextFlyout="{StaticResource DiseaseDataContextMenu}"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  CanUserReorderColumns="False"
                                  CanUserResizeColumns="False"
                                  GridLinesVisibility="Horizontal"
                                  ItemsSource="{x:Bind ViewModel.DiseaseItems}"
                                  SelectedItem="{x:Bind ViewModel.DiseaseSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  SelectionMode="Single"
                                  Sorting="DiseaseDataGrid_Sorting">
                    <toolkit:DataGrid.Columns>
                        <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_DiseaseId"
                                                    Binding="{Binding DiseaseId}"
                                                    Tag="DiseaseId" />
                        <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_DiseaseName"
                                                    Binding="{Binding DiseaseName}"
                                                    CanUserSort="True"
                                                    Tag="DiseaseName" />
                        <toolkit:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_ShortInfo"
                                                    Binding="{Binding ShortInfo}"
                                                    Tag="ShortInfo" />
                    </toolkit:DataGrid.Columns>
                </toolkit:DataGrid>
                <StackPanel>
                    <!--<ListView x:Name="ListViewDisease"
                    MaxHeight="650"
                    ContextFlyout="{StaticResource DiseaseDataContextMenu}"
                    ItemTemplate="{StaticResource SearchItemTemplateTblDisease}"
                    ItemsSource="{x:Bind ViewModel.DiseaseItems, Mode=OneWay}"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.IsDeferredScrollingEnabled="True"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    SelectedItem="{x:Bind ViewModel.DiseaseSelected, Mode=TwoWay}" />-->
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <ProgressRing x:Name="LoadingProgressRing"
                      Width="40"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                      RelativePanel.AlignHorizontalCenterWithPanel="True"
                      RelativePanel.AlignVerticalCenterWithPanel="True"
                      Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
    </RelativePanel>

</Page>
