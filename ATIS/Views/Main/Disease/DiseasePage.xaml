<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="ATIS.Views.Main.Disease.DiseasePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:loca="using:WinUI3Localizer"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:winui="using:Microsoft.UI.Xaml"
      mc:Ignorable="d">

    <Page.Resources>

        <!--  Context Menu  -->
        <MenuFlyout x:Key="DiseaseDataContextMenu">
            <MenuFlyoutItem x:Uid="MenuFlyout_Select"
                            Click="DiseaseSelect_Click">
                <MenuFlyoutItem.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/select.png" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>

            <MenuFlyoutItem x:Uid="MenuFlyout_Print"
                            Command="{x:Bind ViewModel.PdfDiseaseCommand}">
                <MenuFlyoutItem.Icon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/pdf.png" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>

    </Page.Resources>


    <Grid Padding="{StaticResource AtisPagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  HEADER + SEARCH  -->
        <Grid Grid.Row="0"
              ColumnSpacing="{StaticResource AtisSpacingL}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  LEFT: Title + Dataset  -->
            <StackPanel VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="{StaticResource AtisSpacingS}">
                <TextBlock loca:Uids.Uid="TextBlock_Diseases"
                           Style="{StaticResource AtisTextTitle}" />

                <TextBlock Margin="0,12,0,0"
                           loca:Uids.Uid="TextBlock_DataSetCount"
                           Style="{StaticResource AtisTextSubtitle}" />

                <TextBlock Margin="0,12,0,0"
                           Style="{StaticResource AtisTextSubtitle}"
                           Text="{x:Bind ViewModel.DiseaseDataSetCount, Mode=OneWay}" />
            </StackPanel>

            <!--  RIGHT: SearchBox  -->
            <AutoSuggestBox x:Name="SearchBox"
                            Grid.Column="1"
                            Width="260"
                            Height="32"
                            loca:Uids.Uid="AutoSuggestBox_Search"
                            Loaded="SearchBox_OnLoaded"
                            QuerySubmitted="AutoSuggestBox_QuerySubmitted"
                            TextChanged="AutoSuggestBox_TextChanged">
                <AutoSuggestBox.QueryIcon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/search.png" />
                </AutoSuggestBox.QueryIcon>
            </AutoSuggestBox>
        </Grid>


        <!--  CONTENT  -->
        <Border Grid.Row="1"
                winui:UIElement.Translation="0,0,16"
                Style="{StaticResource AtisCard}">

            <controls:DataGrid AutoGenerateColumns="False"
                               ContextFlyout="{StaticResource DiseaseDataContextMenu}"
                               ItemsSource="{x:Bind ViewModel.Diseases}"
                               SelectedItem="{x:Bind ViewModel.DiseaseSelected, Mode=TwoWay}"
                               Sorting="DiseaseDataGrid_Sorting"
                               Style="{StaticResource AtisDataGridStyle}">


                <controls:DataGrid.Columns>

                    <controls:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_DiseaseId"
                                                 Binding="{Binding DiseaseId}"
                                                 Tag="DiseaseId" />
                    <controls:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_DiseaseName"
                                                 Binding="{Binding DiseaseName}"
                                                 CanUserSort="True"
                                                 Tag="DiseaseName" />
                    <controls:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_ShortInfo"
                                                 Binding="{Binding ShortInfo}"
                                                 Tag="ShortInfo" />

                </controls:DataGrid.Columns>

            </controls:DataGrid>

        </Border>

    </Grid>
</Page>


