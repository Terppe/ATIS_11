<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="ATIS.Views.Main.FoodPdf.ReportItemTemplateHyperlinkFoodControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel>
            <TextBlock x:Uid="TextBlock_Class1"
                       Width="Auto"
                       Margin="40,0,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="1"
                    Orientation="Horizontal">
            <TextBlock x:Name="TbClass"  
                       Width="Auto"
                       Foreground="DarkBlue"
                       Tag="{Binding FoodId}"  
                       Text="{Binding FoodName}"
                       TextDecorations="Underline" />
            <TextBlock Margin="2,0,0,0"
                Text="{Binding RegionMiddle}" />
            <TextBlock Margin="2,0,0,0"
                Text="{Binding RegionBottom}" />
            <TextBlock Margin="2,0,0,0"
                Text="{Binding Kind}" />
            <TextBlock Margin="2,0,0,0"
                Text="{Binding Help}" />
        </StackPanel>
    </Grid>
</UserControl>


<!--Tapped="TextBlock_Tapped"-->
