<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="ATIS.Views.Main.Food.FoodPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:loca="using:WinUI3Localizer"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <Grid Padding="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  HEADER + SEARCH  -->
        <Grid Grid.Row="0"
              ColumnSpacing="{StaticResource SpacingL}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  LEFT: Title + Dataset  -->
            <StackPanel VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="{StaticResource SpacingS}">
                <TextBlock loca:Uids.Uid="TextBlock_Foods"
                           Style="{StaticResource PageTitleTextStyle}" />

                <TextBlock Margin="0,12,0,0"
                           loca:Uids.Uid="TextBlock_DataSetCount"
                           Style="{StaticResource PageSubtitleTextStyle}" />

                <TextBlock Margin="0,12,0,0"
                           Style="{StaticResource PageSubtitleTextStyle}"
                           Text="{x:Bind ViewModel.FoodDataSetCount, Mode=OneWay}" />
            </StackPanel>

            <!--  RIGHT: SearchBox  -->
            <AutoSuggestBox x:Name="SearchBox"
                            Grid.Column="1"
                            Width="260"
                            Height="32"
                            loca:Uids.Uid="AutoSuggestBox_Search"
                            Loaded="SearchBox_OnLoaded"
                            QuerySubmitted="AutoSuggestBox_QuerySubmitted"
                            TextChanged="AutoSuggestBox_TextChanged">
                <AutoSuggestBox.QueryIcon>
                    <BitmapIcon ShowAsMonochrome="False"
                                UriSource="/Assets/Fluent/search.png" />
                </AutoSuggestBox.QueryIcon>
            </AutoSuggestBox>
        </Grid>


        <!--  CONTENT  -->
        <Border xmlns:winui="using:Microsoft.UI.Xaml"
                Grid.Row="1"
                winui:UIElement.Translation="0,0,16"
                Style="{StaticResource AtisCard}">
            <controls:DataGrid AutoGenerateColumns="False"
                               ItemsSource="{x:Bind ViewModel.Foods}"
                               SelectedItem="{x:Bind ViewModel.FoodSelected, Mode=TwoWay}"
                               Sorting="FoodDataGrid_Sorting"
                               Style="{StaticResource AtisDataGridStyle}">

                <!--  ContextFlyout  -->
                <controls:DataGrid.ContextFlyout>
                    <MenuFlyout>

                        <MenuFlyoutItem x:Uid="MenuFlyout_Select"
                                        Click="FoodSelect_Click">
                            <MenuFlyoutItem.Icon>
                                <BitmapIcon ShowAsMonochrome="False"
                                            UriSource="/Assets/Fluent/select.png" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>

                        <MenuFlyoutItem x:Uid="MenuFlyout_Print"
                                        Command="{x:Bind ViewModel.PdfFoodCommand}">
                            <MenuFlyoutItem.Icon>
                                <BitmapIcon ShowAsMonochrome="False"
                                            UriSource="/Assets/Fluent/pdf.png" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>

                    </MenuFlyout>
                </controls:DataGrid.ContextFlyout>

                <controls:DataGrid.Columns>
                    <!--  Columns  -->
                    <controls:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_FoodId"
                                                 Binding="{Binding FoodId}"
                                                 Tag="FoodId" />
                    <controls:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_FoodName"
                                                 Binding="{Binding FoodName}"
                                                 CanUserSort="True"
                                                 Tag="FoodName" />
                    <controls:DataGridTextColumn loca:Uids.Uid="DataGridTextColumn_ShortInfo"
                                                 Binding="{Binding ShortInfo}"
                                                 Tag="ShortInfo" />

                </controls:DataGrid.Columns>

            </controls:DataGrid>
        </Border>

    </Grid>
</Page>



