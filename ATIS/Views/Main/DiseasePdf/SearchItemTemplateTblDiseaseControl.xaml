<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="ATIS.Views.Main.DiseasePdf.SearchItemTemplateTblDiseaseControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:ATIS.Views.Main.DiseasePdf"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Row="0"
                    Grid.Column="0"
                    Orientation="Horizontal">
            <Ellipse Width="16"
                     Height="16"
                     Margin="3"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Fill="{ThemeResource SystemControlBackgroundBaseMediumBrush}" />
            <TextBlock Width="50"
                       Margin="{StaticResource XSmallLeftTopRightBottomMargin}"
                       Style="{StaticResource ListTitleStyle}"
                       Text="{Binding DiseaseId}" />
            <CheckBox Width="80"
                      Margin="{StaticResource SmallLeftMargin}"
                      Content="Valid"
                      IsChecked="{Binding Valid}" />
            <TextBlock Margin="{StaticResource XSmallLeftTopRightBottomMargin}"
                       Style="{StaticResource ListSubTitleStyle}"
                       Text="{Binding DiseaseName}" />
            <TextBlock Margin="{StaticResource XSmallLeftTopRightBottomMargin}"
                       Style="{StaticResource ListSubTitleStyle}"
                       Text="{Binding ShortInfo}" />
            <TextBlock Margin="{StaticResource XSmallLeftTopRightBottomMargin}"
                       Style="{StaticResource ListSubTitleStyle}"
                       Text="{Binding Symptom}" />
        </StackPanel>
    </Grid>
</UserControl>
