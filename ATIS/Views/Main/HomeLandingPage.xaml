<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="ATIS.Views.Main.HomeLandingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:loca="using:WinUI3Localizer"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:wuc="using:WinUICommunity"
      mc:Ignorable="d">


    <wuc:MainLandingPage x:Name="MainLandingsPage"
                         Margin="0,-20,0,0"
                         loca:Uids.Uid="MainLanding_Header"
                         HeaderImage="{ThemeResource HeaderCover}"
                         HeaderOverlayImage="{ThemeResource HeaderCover}"
                         Loaded="MainLandingsPage_Loaded"
                         OnItemClick="MainLandingsPage_OnItemClick">
        <!--  HeaderText="Aquaristic Taxonomic Information System"  -->
        <!--  HeaderSubtitleText="Based On WinAppSDK 1.7"  -->
        <wuc:MainLandingPage.HeaderContent>
            <StackPanel>
                <StackPanel>
                    <TextBlock x:Name="LbVersion"
                               Margin="0,0,0,10" />
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            Spacing="10">
                    <wuc:HeaderTile x:Name="HeaderTileDocCenter"
                                    loca:Uids.Uid="HeaderTile_DocCenter"
                                    Link="https://ghost1372.github.io/winUICommunity/">
                        <wuc:HeaderTile.Source>
                            <Image Source="/Assets/HomeHeaderTiles/Header-WinUIGallery.png" />
                        </wuc:HeaderTile.Source>
                    </wuc:HeaderTile>
                    <!--  Title="Documentation Center"  -->
                    <!--  Description="Learn how to work with controls and styles."  -->
                    <wuc:HeaderTile x:Name="HeaderTileDocuments"
                                    loca:Uids.Uid="HeaderTile_Components"
                                    Link="https://github.com/WinUICommunity/Components">
                        <wuc:HeaderTile.Source>
                            <Image Source="/Assets/HomeHeaderTiles/icon.png" />
                        </wuc:HeaderTile.Source>
                    </wuc:HeaderTile>
                    <!--  Title="Components"  -->
                    <!--  Description="Experience WinUI 3 quickly and easily with the help of Components, Everything you need to develop an application is gathered in one place."  -->
                    <wuc:HeaderTile x:Name="HeaderTileContextMenuExt"
                                    loca:Uids.Uid="HeaderTile_ContextMenuExt"
                                    Link="https://github.com/WinUICommunity/ContextMenuExtensions">
                        <wuc:HeaderTile.Source>
                            <Image Source="/Assets/HomeHeaderTiles/icon.png" />
                        </wuc:HeaderTile.Source>
                    </wuc:HeaderTile>
                    <!--
                    Title="ContextMenuExtensions"
                    Description="add a new ContextMenu for Windows 11/10."
                    -->

                </StackPanel>

                <StackPanel Margin="0,10,0,0"
                            Orientation="Horizontal"
                            Spacing="10">
                    <wuc:HeaderTile x:Name="HeaderTileItisUsa"
                                    loca:Uids.Uid="HeaderTile_ItisUsa"
                                    Link="https://itis.gov/">
                        <wuc:HeaderTile.Source>
                            <Image Source="/Assets/Usa.png" />
                        </wuc:HeaderTile.Source>
                    </wuc:HeaderTile>
                    <!--
                    Title="ITIS-USA"
                    Description="Basic Web-Site for Taxonomic"
                    -->
                    <wuc:HeaderTile x:Name="HeaderTileItisCanada"
                                    loca:Uids.Uid="HeaderTile_ItisCanada"
                                    Link="http://www.cbif.gc.ca/">
                        <wuc:HeaderTile.Source>
                            <Image Source="/Assets/Canada.png" />
                        </wuc:HeaderTile.Source>
                    </wuc:HeaderTile>
                    <!--
                    Title="ITIS-Canada"
                    Description="Web-Site for Taxonomic"
                    -->
                    <wuc:HeaderTile x:Name="HeaderTileCatalogOfLife"
                                    loca:Uids.Uid="HeaderTile_CatalogOfLife"
                                    Link="http://www.catalogueoflife.org/annual-checklist/2015/">
                        <wuc:HeaderTile.Source>
                            <Image Source="/Assets/Life.png" />
                        </wuc:HeaderTile.Source>
                    </wuc:HeaderTile>
                    <!--
                    Title="Catalog of Life"
                    Description="Web-Site for Taxonomic"
                    -->
                    <wuc:HeaderTile x:Name="HeaderTileMexico"
                                    loca:Uids.Uid="HeaderTile_Mexico"
                                    Link="http://www.conabio.gob.mx/">
                        <wuc:HeaderTile.Source>
                            <Image Source="/Assets/Mexico.png" />
                        </wuc:HeaderTile.Source>
                    </wuc:HeaderTile>
                    <!--
                    Title="Mexico"
                    Description="Web-Site for Taxonomic"
                    -->
                    <wuc:HeaderTile x:Name="HeaderTileGlobalBio"
                                    loca:Uids.Uid="HeaderTile_GlobalBio"
                                    Link="http://www.gbif.org/">
                        <wuc:HeaderTile.Source>
                            <Image Source="/Assets/Bio.png" />
                        </wuc:HeaderTile.Source>
                    </wuc:HeaderTile>
                    <!--
                    Title="Global Bio"
                    Description="Web-Site for Taxonomic"
                    -->
                    <wuc:HeaderTile x:Name="HeaderTileEol"
                                    loca:Uids.Uid="HeaderTile_Eol"
                                    Link="http://www.eol.org/">
                        <wuc:HeaderTile.Source>
                            <Image Source="/Assets/Eol.png" />
                        </wuc:HeaderTile.Source>
                    </wuc:HeaderTile>
                    <!--
                    Title="EOL"
                    Description="Web-Site for Taxonomic"
                    -->
                </StackPanel>
            </StackPanel>
        </wuc:MainLandingPage.HeaderContent>
