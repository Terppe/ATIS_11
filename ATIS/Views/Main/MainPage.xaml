                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>

                            <MenuFlyoutItem loc:Uids.Uid="es-ES"
                                            Click="MenuFlyoutLanguage_Click"
                                            Tag="es-ES">
                                <MenuFlyoutItem.Icon>
                                    <BitmapIcon ShowAsMonochrome="False"
                                                UriSource="ms-appx:///Assets/Fluent/spain.png" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuBarItem>
                    </MenuBar>
                    <TextBlock x:Name="TbDataBase"
                               Width="Auto"
                               Margin="10,16,10,0"
                               HorizontalAlignment="Left"
                               loc:Uids.Uid="TextBlock_DbExist_SQLActiv"
                               Foreground="Red"
                               TextWrapping="NoWrap"
                               Visibility="Visible" />
                    <AutoSuggestBox Name="SearchSearchBox"
                                    Width="200"
                                    Height="32"
                                    Margin="10,0,10,-4"
                                    loc:Uids.Uid="AutoSuggestBox_Search"
                                    Loaded="SearchSearchBox_OnLoaded"
                                    PlaceholderText="Search"
                                    QueryIcon="Find"
                                    QuerySubmitted="AutoSuggestBox_QuerySubmitted"
                                    TextChanged="AutoSuggestBox_TextChanged" />
                    <ContentDialog x:Name="ContentDialogLogIn"
                                   CloseButtonStyle="{StaticResource AtisButtonPrimary}"
                                   CloseButtonText="Close">
                        <StackPanel>
                            <!--<contentDialogs:SignInContentDialog />-->
                            <userControls:LogInControl />
                        </StackPanel>
                    </ContentDialog>
                    <ContentDialog x:Name="ContentDialogRegister"
                                   CloseButtonStyle="{StaticResource AtisButtonPrimary}"
                                   CloseButtonText="Close">
                        <StackPanel>
                            <userControls:RegisterControl />
                        </StackPanel>
                    </ContentDialog>
                    <ContentDialog x:Name="ContentDialogPasswordChange"
                                   CloseButtonStyle="{StaticResource AtisButtonPrimary}"
                                   CloseButtonText="Close">
                        <StackPanel>
                            <userControls:PasswordChangeControl />
                        </StackPanel>
                    </ContentDialog>
                    <ContentDialog x:Name="ContentDialogPasswordForgot"
                                   CloseButtonStyle="{StaticResource AtisButtonPrimary}"
                                   CloseButtonText="Close">
                        <StackPanel>
                            <userControls:PasswordForgotControl />
                        </StackPanel>
                    </ContentDialog>

                    <TextBlock x:Name="TbUser"
                               Width="Auto"
                               Margin="10,16,10,0"
                               HorizontalAlignment="Right"
                               loc:Uids.Uid="TextBlock_NoLogin"
                               Foreground="Red" />
                </StackPanel>
            </TitleBar.Content>
            <TitleBar.RightHeader>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="ThemeButton"
                            Height="32"
                            Margin="0,0,4,0"
                            Click="ThemeButton_Click"
                            Content="{wuc:FontIcon GlyphCode=E793,
                            FontSize=16}"
                            Style="{ThemeResource SubtleButtonStyle}"
                            ToolTipService.ToolTip="Toggle Theme" />
                </StackPanel>
            </TitleBar.RightHeader>
        </TitleBar>
