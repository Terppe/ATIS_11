                                            Click="MenuFlyoutSpainItem_Click"
                                            Tag="spanisch">
                                <MenuFlyoutItem.Icon>
                                    <BitmapIcon ShowAsMonochrome="False"
                                                UriSource="/Assets/Fluent/spain.png" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuBarItem>
                    </MenuBar>
                    <TextBlock x:Name="TbDataBase"
                               Width="Auto"
                               Margin="10,16,10,0"
                               HorizontalAlignment="Left"
                               loca:Uids.Uid="TextBlock_DbExist_SQLActiv"
                               Foreground="Green"
                               TextWrapping="NoWrap"
                               Visibility="Visible" />
                    <AutoSuggestBox Name="SearchSearchBox"
                                    Width="200"
                                    Height="32"
                                    Margin="10,0,10,-4"
                                    loca:Uids.Uid="AutoSuggestBox_Search"
                                    Loaded="SearchSearchBox_OnLoaded"
                                    PlaceholderText="Search"
                                    QueryIcon="Find"
                                    QuerySubmitted="AutoSuggestBox_QuerySubmitted"
                                    TextChanged="AutoSuggestBox_TextChanged" />
                    <ContentDialog x:Name="ContentDialogLogIn"
                                   CloseButtonStyle="{StaticResource CrudButtonStyle}"
                                   CloseButtonText="Close">
                        <StackPanel>
                            <!--<contentDialogs:SignInContentDialog />-->
                            <userControls:LogInControl />
                        </StackPanel>
                    </ContentDialog>
                    <ContentDialog x:Name="ContentDialogRegister"
                                   CloseButtonStyle="{StaticResource CrudButtonStyle}"
                                   CloseButtonText="Close">
                        <StackPanel>
                            <userControls:RegisterControl />
                        </StackPanel>
                    </ContentDialog>
                    <ContentDialog x:Name="ContentDialogPasswordChange"
                                   CloseButtonStyle="{StaticResource CrudButtonStyle}"
                                   CloseButtonText="Close">
                        <StackPanel>
                            <userControls:PasswordChangeControl />
                        </StackPanel>
                    </ContentDialog>
                    <ContentDialog x:Name="ContentDialogPasswordForgot"
                                   CloseButtonStyle="{StaticResource CrudButtonStyle}"
                                   CloseButtonText="Close">
                        <StackPanel>
                            <userControls:PasswordForgotControl />
                        </StackPanel>
                    </ContentDialog>

                    <TextBlock x:Name="TbUser"
                               Width="Auto"
                               Margin="10,16,10,0"
                               HorizontalAlignment="Right"
                               loca:Uids.Uid="TextBlock_NoLogin"
                               Foreground="Red" />
                </StackPanel>
            </TitleBar.Content>
            <TitleBar.RightHeader>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="ThemeButton"
                            Height="32"
                            Margin="0,0,4,0"
                            Click="ThemeButton_Click"
                            Content="{wuc:FontIcon GlyphCode=E793,
                            FontSize=16}"
                            Style="{ThemeResource SubtleButtonStyle}"
                            ToolTipService.ToolTip="Toggle Theme" />
                </StackPanel>
            </TitleBar.RightHeader>
        </TitleBar>
