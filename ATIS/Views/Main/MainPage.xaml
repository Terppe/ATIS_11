                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>

                            <MenuFlyoutItem loc:Uids.Uid="fr-FR"
                                            Click="MenuFlyoutLanguage_Click"
                                            Tag="fr-FR">
                                <MenuFlyoutItem.Icon>
                                    <BitmapIcon ShowAsMonochrome="False"
