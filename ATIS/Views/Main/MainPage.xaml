<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="ATIS.Views.Main.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:loc="using:WinUI3Localizer"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:userControls="using:ATIS.Views.UserControls"
      xmlns:wuc="using:WinUICommunity"
      mc:Ignorable="d">

    <Grid RowDefinitions="45, *">
        <TitleBar x:Name="AppTitleBar"
                  Title="{x:Bind wuc:ProcessInfoHelper.ProductName}"
                  Grid.Row="0"
                  BackRequested="AppTitleBar_OnBackRequested"
                  IconSource="{wuc:BitmapIconSource Source=ms-appx:///Assets/icon.png}"
                  IsBackButtonVisible="True"
                  IsPaneToggleButtonVisible="True"
                  PaneToggleRequested="AppTitleBar_OnPaneToggleRequested"
                  Subtitle="{x:Bind wuc:ProcessInfoHelper.VersionWithPrefix}">
            <TitleBar.Content>
                <StackPanel Orientation="Horizontal">
                    <MenuBar x:Name="MenuBar"
                             Width="Auto"
                             Height="32"
                             Margin="0,4,0,0"
                             HorizontalAlignment="Left">
                        <MenuBarItem loc:Uids.Uid="MenuBarItemFile">
                            <MenuFlyoutItem loc:Uids.Uid="MenuFlyoutItemNew">
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="N"
                                                         Modifiers="Control" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem loc:Uids.Uid="MenuFlyoutItemOpen">
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="O"
                                                         Modifiers="Control" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem loc:Uids.Uid="MenuFlyoutItemSave">
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="S"
                                                         Modifiers="Control" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem loc:Uids.Uid="MenuFlyoutItemLog"
                                            Click="MenuFlyoutItem_Click"
                                            Tag="showlogfile">
                                <MenuFlyoutItem.Icon>
                                    <BitmapIcon ShowAsMonochrome="False"
                                                UriSource="/Assets/Fluent/log.png" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem loc:Uids.Uid="MenuFlyoutItemClose"
                                            Click="MenuFlyoutItem_Click"
                                            Tag="close">
                                <MenuFlyoutItem.Icon>
                                    <BitmapIcon ShowAsMonochrome="False"
                                                UriSource="/Assets/Fluent/close.png" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuBarItem>
                        <MenuBarItem loc:Uids.Uid="MenuBarItemAuth">
                            <MenuFlyoutItem loc:Uids.Uid="MenuFlyoutItemLogin"
                                            Click="MenuFlyoutItem_Click"
                                            Tag="login">
                                <MenuFlyoutItem.Icon>
                                    <BitmapIcon ShowAsMonochrome="False"
                                                UriSource="/Assets/Fluent/arrowleft.png" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem loc:Uids.Uid="MenuFlyoutItemRegister"
                                            Click="MenuFlyoutItem_Click"
                                            Tag="register">
                                <MenuFlyoutItem.Icon>
                                    <BitmapIcon ShowAsMonochrome="False"
                                                UriSource="/Assets/Fluent/arrowright.png" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem loc:Uids.Uid="MenuFlyoutItemChangePw"
                                            Click="MenuFlyoutItem_Click"
                                            Tag="changepw">
                                <MenuFlyoutItem.Icon>
                                    <BitmapIcon ShowAsMonochrome="False"
                                                UriSource="/Assets/Fluent/arrowright.png" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem loc:Uids.Uid="MenuFlyoutItemForgotPw"
                                            Click="MenuFlyoutItem_Click"
                                            Tag="forgotpw">
                                <MenuFlyoutItem.Icon>
                                    <BitmapIcon ShowAsMonochrome="False"
                                                UriSource="/Assets/Fluent/replace.png" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Click="MenuFlyoutItem_Click"
                                            Tag="update"
                                            Text="Update">
                                <MenuFlyoutItem.Icon>
                                    <BitmapIcon ShowAsMonochrome="False"
                                                UriSource="/Assets/Fluent/update.png" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem loc:Uids.Uid="MenuFlyoutItemLogout"
                                            Click="MenuFlyoutItem_Click"
                                            Tag="logout">
                                <MenuFlyoutItem.Icon>
                                    <BitmapIcon ShowAsMonochrome="False"
                                                UriSource="/Assets/Fluent/arrowright.png" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuBarItem>
                        <MenuBarItem loc:Uids.Uid="MenuBarItemHelp">
                            <MenuFlyoutItem loc:Uids.Uid="MenuFlyoutItemAbout">
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="I"
                                                         Modifiers="Control" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                        </MenuBarItem>
                        <MenuBarItem loc:Uids.Uid="MenuBarItemLanguage">
                            <MenuFlyoutItem loc:Uids.Uid="de-DE"
                                            Click="MenuFlyoutLanguage_Click"
                                            Tag="de-DE">
                                <MenuFlyoutItem.Icon>
                                    <BitmapIcon ShowAsMonochrome="False"
