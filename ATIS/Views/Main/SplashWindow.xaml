<?xml version="1.0" encoding="utf-8" ?>
<winUiEx:WindowEx x:Class="ATIS.Views.Main.SplashWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:loca="using:WinUI3Localizer"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:winUiEx="using:WinUIEx"
                  Title="SplashWindow"
                  Width="800"
                  Height="700"
                  mc:Ignorable="d">

    <Grid>
        <StackPanel>
            <Image Width="700"
                   Height="400"
                   Margin="0,50,0,0"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Source="ms-appx:///Assets/splash.jpg"
                   Stretch="UniformToFill" />
            <TextBlock Margin="0,20,0,10"
                       HorizontalAlignment="Center"
                       FontSize="50"
                       Foreground="Black"
                       Text="ATIS" />
        </StackPanel>

        <StackPanel VerticalAlignment="Bottom">
            <!--<TextBlock Margin="0,0,0,10"
                       HorizontalAlignment="Center"
                       FontSize="50"
                       Foreground="Black"
                       Text="ATIS" />-->
            <TextBlock x:Name="Status"
                       Margin="0,0,0,10"
                       HorizontalAlignment="Center"
                       loca:Uids.Uid="TextBlock_Status" />
            <ProgressBar Width="150"
                         Margin="0,10,0,20"
                         IsIndeterminate="True" />
            <Border Background="LightSteelBlue">
                <TextBlock x:Name="Copyright"
                           Margin="10,10,0,10"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Bottom"
                           Foreground="White" />
            </Border>

        </StackPanel>
    </Grid>
</winUiEx:WindowEx>
