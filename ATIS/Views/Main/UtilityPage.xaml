<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="ATIS.Views.Main.UtilityPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:database="using:ATIS.Views.Database"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:tbl90RefSource="using:ATIS.Views.Modules.Tbl90RefSource"
      NavigationCacheMode="Required"
      mc:Ignorable="d">

    <Grid x:Name="UtilityContentArea"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <TabView x:Name="TabViewUtility"
                 MinHeight="475"
                 IsAddTabButtonVisible="False">
            <TabView.TabItems>
                <TabViewItem x:Uid="TabViewItem_Names"
                             IsClosable="False">
                    <database:Tbl78NameListPage />
                </TabViewItem>
                <TabViewItem x:Uid="TabViewItem_Images"
                             IsClosable="False">
                    <database:Tbl81ImageListPage />
                </TabViewItem>
                <TabViewItem x:Uid="TabViewItem_Synonyms"
                             IsClosable="False">
                    <database:Tbl84SynonymListPage />
                </TabViewItem>
                <TabViewItem x:Uid="TabViewItem_Geographics"
                             IsClosable="False">
                    <database:Tbl87GeographicListPage />
                </TabViewItem>
                <TabViewItem x:Uid="TabViewItem_RefAuthors"
                             IsClosable="False">
                    <database:Tbl90RefAuthorListPage />
                </TabViewItem>
                <!--<TabViewItem x:Uid="TabViewItem_RefExperts"
                IsClosable="False">
                <database:Tbl90RefExpertListPage />
                </TabViewItem>-->
                <TabViewItem x:Uid="TabViewItem_RefSources"
                             IsClosable="False">
                    <tbl90RefSource:Tbl90RefSourcePage />
                </TabViewItem>
                <TabViewItem x:Uid="TabViewItem_References"
                             IsClosable="False">
                    <database:Tbl90ReferenceListPage />
                </TabViewItem>
                <TabViewItem x:Uid="TabViewItem_Comments"
                             IsClosable="False">
                    <database:Tbl93CommentListPage />
                </TabViewItem>
                <TabViewItem x:Uid="TabViewItem_Countries"
                             IsClosable="False">
                    <database:TblCountryListPage />
                </TabViewItem>
                <TabViewItem x:Uid="TabViewItem_UserProfiles"
                             IsClosable="False">
                    <database:TblUserProfileListPage />
                </TabViewItem>
            </TabView.TabItems>
        </TabView>

    </Grid>
</Page>
