<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ATIS.Views.Main.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="using:WinUI3Localizer"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <Grid RowDefinitions="*,Auto">

        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">

            <Grid
                MaxWidth="1120"
                Padding="32,24,32,10"
                HorizontalAlignment="Center">
                <StackPanel Spacing="12">

                    <Border
                        MinHeight="280"
                        Padding="24"
                        CornerRadius="22">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Offset="0" Color="#073B4C" />
                                <GradientStop Offset="0.58" Color="#075B63" />
                                <GradientStop Offset="1" Color="#128078" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel
                                MaxWidth="700"
                                VerticalAlignment="Center"
                                Spacing="14">
                                <TextBlock
                                    loc:Uids.Uid="TextBlock_Home_Eyebrow.Text"
                                    CharacterSpacing="120"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="#A7F3D0" />
                                <TextBlock
                                    loc:Uids.Uid="TextBlock_Home_Title.Text"
                                    FontSize="36"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    MaxWidth="600"
                                    loc:Uids.Uid="TextBlock_Home_Subtitle.Text"
                                    FontSize="16"
                                    Foreground="#E0F2F1"
                                    TextWrapping="Wrap" />

                                <Grid
                                    MaxWidth="640"
                                    Margin="0,8,0,0"
                                    ColumnDefinitions="*,Auto"
                                    ColumnSpacing="10">
                                    <AutoSuggestBox
                                        x:Name="HomeSearchBox"
                                        Grid.Column="0"
                                        MinHeight="46"
                                        VerticalContentAlignment="Center"
                                        loc:Uids.Uid="SearchBox_Search"
                                        Background="White"
                                        Foreground="#15333A"
                                        QueryIcon="Find"
                                        QuerySubmitted="HomeSearchBox_QuerySubmitted" />
                                    <Button
                                        Grid.Column="1"
                                        MinHeight="46"
                                        Padding="20,8"
                                        Background="#C8F7E5"
                                        BorderBrush="#C8F7E5"
                                        Click="HomeSearchButton_Click"
                                        CornerRadius="8"
                                        Foreground="#073B4C">
                                        <TextBlock loc:Uids.Uid="TextBlock_Home_SearchButton.Text" FontWeight="SemiBold" />
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <Grid
                                Grid.Column="1"
                                Width="220"
                                Height="220"
                                Margin="28,0,4,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <Ellipse
                                    Width="206"
                                    Height="206"
                                    Fill="#1FFFFFFF" />
                                <Ellipse
                                    Width="154"
                                    Height="154"
                                    Fill="#20B7E4C7" />
                                <Image
                                    Width="112"
                                    Height="112"
                                    Source="ms-appx:///Assets/Fluent/fish.png"
                                    Stretch="Uniform" />
                                <Ellipse
                                    Width="14"
                                    Height="14"
                                    Margin="0,0,24,168"
                                    Fill="#C8F7E5" />
                                <Ellipse
                                    Width="9"
                                    Height="9"
                                    Margin="0,150,176,0"
                                    Fill="#FDE68A" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!--<StackPanel Spacing="4">
                    <TextBlock
                    loc:Uids.Uid="Home_ExploreTitle"
                    FontSize="23"
                    FontWeight="SemiBold" />
                    <TextBlock
                    loc:Uids.Uid="Home_ExploreSubtitle"
                    Foreground="{ThemeResource AtisTextCaptionBrush}"
                    TextWrapping="Wrap" />
                    </StackPanel>-->

                    <Grid
                        ColumnDefinitions="*,*"
                        ColumnSpacing="8"
                        RowDefinitions="Auto,Auto"
                        RowSpacing="8">
                        <Button
                            Grid.Row="0"
                            Grid.Column="0"
                            Padding="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Click="CategoryCard_Click"
                            Tag="Genus">
                            <Border
                                MinHeight="138"
                                Padding="20"
                                Background="{ThemeResource AtisCardBackgroundBrush}"
                                BorderBrush="{ThemeResource AtisCardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14">
                                <Grid ColumnDefinitions="64,*" ColumnSpacing="18">
                                    <Border
                                        Width="58"
                                        Height="58"
                                        VerticalAlignment="Top"
                                        Background="#162E9B72"
                                        CornerRadius="12">
                                        <Image
                                            Width="34"
                                            Height="34"
                                            Source="ms-appx:///Assets/Fluent/creature.png"
                                            Stretch="Uniform" />
                                    </Border>
                                    <StackPanel
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="6">
                                        <TextBlock
                                            loc:Uids.Uid="TextBlock_Home_CreatureTitle"
                                            FontSize="18"
                                            FontWeight="SemiBold" />
                                        <TextBlock
                                            loc:Uids.Uid="TextBlock_Home_CreatureSubtitle"
                                            Foreground="{ThemeResource AtisTextCaptionBrush}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Button>

                        <Button
                            Grid.Row="0"
                            Grid.Column="1"
                            Padding="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Click="CategoryCard_Click"
                            Tag="Disease">
                            <Border
                                MinHeight="138"
                                Padding="20"
                                Background="{ThemeResource AtisCardBackgroundBrush}"
                                BorderBrush="{ThemeResource AtisCardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14">
                                <Grid ColumnDefinitions="64,*" ColumnSpacing="18">
                                    <Border
                                        Width="58"
                                        Height="58"
                                        VerticalAlignment="Top"
                                        Background="#16D97777"
                                        CornerRadius="12">
                                        <Image
                                            Width="34"
                                            Height="34"
                                            Source="ms-appx:///Assets/Fluent/disease.png"
                                            Stretch="Uniform" />
                                    </Border>
                                    <StackPanel
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="6">
                                        <TextBlock
                                            loc:Uids.Uid="TextBlock_Home_DiseaseTitle"
                                            FontSize="18"
                                            FontWeight="SemiBold" />
                                        <TextBlock
                                            loc:Uids.Uid="TextBlock_Home_DiseaseSubtitle"
                                            Foreground="{ThemeResource AtisTextCaptionBrush}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Button>

                        <Button
                            Grid.Row="1"
                            Grid.Column="0"
                            Padding="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Click="CategoryCard_Click"
                            Tag="Food">
                            <Border
                                MinHeight="138"
                                Padding="20"
                                Background="{ThemeResource AtisCardBackgroundBrush}"
                                BorderBrush="{ThemeResource AtisCardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14">
                                <Grid ColumnDefinitions="64,*" ColumnSpacing="18">
                                    <Border
                                        Width="58"
                                        Height="58"
                                        VerticalAlignment="Top"
                                        Background="#16EABF72"
                                        CornerRadius="12">
                                        <Image
                                            Width="34"
                                            Height="34"
                                            Source="ms-appx:///Assets/Fluent/food.png"
                                            Stretch="Uniform" />
                                    </Border>
                                    <StackPanel
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="6">
                                        <TextBlock
                                            loc:Uids.Uid="TextBlock_Home_FoodTitle"
                                            FontSize="18"
                                            FontWeight="SemiBold" />
                                        <TextBlock
                                            loc:Uids.Uid="TextBlock_Home_FoodSubtitle"
                                            Foreground="{ThemeResource AtisTextCaptionBrush}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Button>

                        <Button
                            Grid.Row="1"
                            Grid.Column="1"
                            Padding="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Click="CategoryCard_Click"
                            Tag="Miscellaneous">
                            <Border
                                MinHeight="138"
                                Padding="20"
                                Background="{ThemeResource AtisCardBackgroundBrush}"
                                BorderBrush="{ThemeResource AtisCardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14">
                                <Grid ColumnDefinitions="64,*" ColumnSpacing="18">
                                    <Border
                                        Width="58"
                                        Height="58"
                                        VerticalAlignment="Top"
                                        Background="#164C91E2"
                                        CornerRadius="12">
                                        <Image
                                            Width="34"
                                            Height="34"
                                            Source="ms-appx:///Assets/Fluent/miscellaneous.png"
                                            Stretch="Uniform" />
                                    </Border>
                                    <StackPanel
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="6">
                                        <TextBlock
                                            loc:Uids.Uid="TextBlock_Home_MiscellaneousTitle"
                                            FontSize="18"
                                            FontWeight="SemiBold" />
                                        <TextBlock
                                            loc:Uids.Uid="TextBlock_Home_MiscellaneousSubtitle"
                                            Foreground="{ThemeResource AtisTextCaptionBrush}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Button>
                    </Grid>

                    <Border
                        Padding="20,12"
                        Background="{ThemeResource AtisCardBackgroundBrush}"
                        BorderBrush="{ThemeResource AtisCardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14">

                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Image
                                    Width="34"
                                    Height="34"
                                    Source="ms-appx:///Assets/Fluent/database.png"
                                    Stretch="Uniform" />

                                <TextBlock
                                    VerticalAlignment="Center"
                                    loc:Uids.Uid="TextBlock_Home_InfoTitle"
                                    FontWeight="SemiBold" />
                            </StackPanel>

                            <ScrollViewer
                                HorizontalScrollBarVisibility="Auto"
                                HorizontalScrollMode="Enabled"
                                VerticalScrollBarVisibility="Disabled">

                                <ItemsControl ItemsSource="{x:Bind ExternalLinks, Mode=OneWay}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="8" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <HyperlinkButton
                                                Content="{Binding Name, Mode=OneWay}"
                                                NavigateUri="{Binding Uri, Mode=OneWay}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock
                                x:Name="WebsiteSettingsError"
                                Foreground="{ThemeResource AtisTextCaptionBrush}"
                                TextWrapping="Wrap"
                                Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <TextBlock
            x:Name="LbVersion"
            Grid.Row="1"
            Margin="20,0,20,10"
            VerticalAlignment="Bottom"
            FontSize="11"
            Foreground="{ThemeResource AtisTextCaptionBrush}"
            TextWrapping="Wrap" />
    </Grid>
</Page>
