<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ATIS.Views.Main.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="using:WinUI3Localizer"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <Grid
            MaxWidth="1120"
            Padding="32,18,32,10"
            HorizontalAlignment="Center">
            <StackPanel Spacing="24">

                <Border
                    MinHeight="280"
                    Padding="24"
                    CornerRadius="22">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Offset="0" Color="#073B4C" />
                            <GradientStop Offset="0.58" Color="#075B63" />
                            <GradientStop Offset="1" Color="#128078" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel
                            MaxWidth="700"
                            Spacing="14"
                            VerticalAlignment="Center">
                            <TextBlock
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="#A7F3D0"
                                CharacterSpacing="120"
                                loc:Uids.Uid="TextBlock_Home_Eyebrow.Text" />
                            <TextBlock
                                FontSize="36"
                                FontWeight="SemiBold"
                                Foreground="White"
                                TextWrapping="Wrap"
                                loc:Uids.Uid="TextBlock_Home_Title.Text" />
                            <TextBlock
                                MaxWidth="600"
                                FontSize="16"
                                Foreground="#E0F2F1"
                                TextWrapping="Wrap"
                                loc:Uids.Uid="TextBlock_Home_Subtitle.Text" />

                            <Grid
                                MaxWidth="640"
                                Margin="0,8,0,0"
                                ColumnDefinitions="*,Auto"
                                ColumnSpacing="10">
                                <AutoSuggestBox 
                                    x:Name="HomeSearchBox"
                                    Grid.Column="0"
                                    MinHeight="46"
                                    Background="White"
                                    Foreground="#15333A"
                                    PlaceholderText="Search"
                                    QueryIcon="Find"
                                    QuerySubmitted="HomeSearchBox_QuerySubmitted"
                                    loc:Uids.Uid="AutoSuggestBox_Home_Search.Header" />
                                <Button
                                    Grid.Column="1"
                                    MinHeight="46"
                                    Padding="20,8"
                                    Background="#C8F7E5"
                                    BorderBrush="#C8F7E5"
                                    Click="HomeSearchButton_Click"
                                    CornerRadius="8"
                                    Foreground="#073B4C">
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        loc:Uids.Uid="TextBlock_Home_SearchButton.Text" />
                                </Button>
                            </Grid>
                        </StackPanel>

                        <Grid
                            Grid.Column="1"
                            Width="220"
                            Height="220"
                            Margin="28,0,4,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                            <Ellipse
                                Width="206"
                                Height="206"
                                Fill="#1FFFFFFF" />
                            <Ellipse
                                Width="154"
                                Height="154"
                                Fill="#20B7E4C7" />
                            <Image
                                Width="112"
                                Height="112"
                                Source="ms-appx:///Assets/Fluent/fish.png"
                                Stretch="Uniform" />
                            <Ellipse
                                Width="14"
                                Height="14"
                                Margin="0,0,24,168"
                                Fill="#C8F7E5" />
                            <Ellipse
                                Width="9"
                                Height="9"
                                Margin="0,150,176,0"
                                Fill="#FDE68A" />
                        </Grid>
                    </Grid>
                </Border>

                <StackPanel Spacing="4">
                    <TextBlock
                        FontSize="23"
                        FontWeight="SemiBold"
                        loc:Uids.Uid="Home_ExploreTitle" />
                    <TextBlock
                        Foreground="{ThemeResource AtisTextCaptionBrush}"
                        TextWrapping="Wrap"
                        loc:Uids.Uid="Home_ExploreSubtitle" />
                </StackPanel>

                <Grid
                    ColumnDefinitions="*,*"
                    ColumnSpacing="8"
                    RowDefinitions="Auto,Auto"
                    RowSpacing="8">
                    <Button
                        Grid.Row="0"
                        Grid.Column="0"
                        Padding="0"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Click="CategoryCard_Click"
                        Tag="Species">
                        <Border
                            MinHeight="138"
                            Padding="20"
                            Background="{ThemeResource AtisCardBackgroundBrush}"
                            BorderBrush="{ThemeResource AtisCardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14">
                            <Grid ColumnDefinitions="64,*" ColumnSpacing="18">
                                <Border
                                    Width="58"
                                    Height="58"
                                    Background="#162E9B72"
                                    CornerRadius="12"
                                    VerticalAlignment="Top">
                                    <Image
                                        Width="34"
                                        Height="34"
                                        Source="ms-appx:///Assets/Fluent/fish.png"
                                        Stretch="Uniform" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock
                                        FontSize="18"
                                        FontWeight="SemiBold"
                                        loc:Uids.Uid="Home_SpeciesTitle" />
                                    <TextBlock
                                        Foreground="{ThemeResource AtisTextCaptionBrush}"
                                        TextWrapping="Wrap"
                                        loc:Uids.Uid="Home_SpeciesSubtitle" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Button>

                    <Button
                        Grid.Row="0"
                        Grid.Column="1"
                        Padding="0"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Click="CategoryCard_Click"
                        Tag="Disease">
                        <Border
                            MinHeight="138"
                            Padding="20"
                            Background="{ThemeResource AtisCardBackgroundBrush}"
                            BorderBrush="{ThemeResource AtisCardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14">
                            <Grid ColumnDefinitions="64,*" ColumnSpacing="18">
                                <Border
                                    Width="58"
                                    Height="58"
                                    Background="#16D97777"
                                    CornerRadius="12"
                                    VerticalAlignment="Top">
                                    <Image
                                        Width="34"
                                        Height="34"
                                        Source="ms-appx:///Assets/Fluent/disease.png"
                                        Stretch="Uniform" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock
                                        FontSize="18"
                                        FontWeight="SemiBold"
                                        loc:Uids.Uid="Home_DiseaseTitle" />
                                    <TextBlock
                                        Foreground="{ThemeResource AtisTextCaptionBrush}"
                                        TextWrapping="Wrap"
                                        loc:Uids.Uid="Home_DiseaseSubtitle" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Button>

                    <Button
                        Grid.Row="1"
                        Grid.Column="0"
                        Padding="0"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Click="CategoryCard_Click"
                        Tag="Food">
                        <Border
                            MinHeight="138"
                            Padding="20"
                            Background="{ThemeResource AtisCardBackgroundBrush}"
                            BorderBrush="{ThemeResource AtisCardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14">
                            <Grid ColumnDefinitions="64,*" ColumnSpacing="18">
                                <Border
                                    Width="58"
                                    Height="58"
                                    Background="#16EABF72"
                                    CornerRadius="12"
                                    VerticalAlignment="Top">
                                    <Image
                                        Width="34"
                                        Height="34"
                                        Source="ms-appx:///Assets/Fluent/food.png"
                                        Stretch="Uniform" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock
                                        FontSize="18"
                                        FontWeight="SemiBold"
                                        loc:Uids.Uid="Home_FoodTitle" />
                                    <TextBlock
                                        Foreground="{ThemeResource AtisTextCaptionBrush}"
                                        TextWrapping="Wrap"
                                        loc:Uids.Uid="Home_FoodSubtitle" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Button>

                    <Button
                        Grid.Row="1"
                        Grid.Column="1"
                        Padding="0"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Click="CategoryCard_Click"
                        Tag="Miscellaneous">
                        <Border
                            MinHeight="138"
                            Padding="20"
                            Background="{ThemeResource AtisCardBackgroundBrush}"
                            BorderBrush="{ThemeResource AtisCardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14">
                            <Grid ColumnDefinitions="64,*" ColumnSpacing="18">
                                <Border
                                    Width="58"
                                    Height="58"
                                    Background="#164C91E2"
                                    CornerRadius="12"
                                    VerticalAlignment="Top">
                                    <Image
                                        Width="34"
                                        Height="34"
                                        Source="ms-appx:///Assets/Fluent/miscellaneous.png"
                                        Stretch="Uniform" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock
                                        FontSize="18"
                                        FontWeight="SemiBold"
                                        loc:Uids.Uid="Home_MoreTitle" />
                                    <TextBlock
                                        Foreground="{ThemeResource AtisTextCaptionBrush}"
                                        TextWrapping="Wrap"
                                        loc:Uids.Uid="Home_MoreSubtitle" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Button>
                </Grid>

                <Border
                    Padding="20,8"
                    Background="{ThemeResource AtisCardBackgroundBrush}"
                    BorderBrush="{ThemeResource AtisCardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                        <Image
                            Width="34"
                            Height="34"
                            VerticalAlignment="Center"
                            Source="ms-appx:///Assets/Fluent/database.png"
                            Stretch="Uniform" />
                        <StackPanel Grid.Column="1" Spacing="3">
                            <TextBlock
                                FontWeight="SemiBold"
                                loc:Uids.Uid="Home_InfoTitle" />
                            <TextBlock
                                Foreground="{ThemeResource AtisTextCaptionBrush}"
                                TextWrapping="Wrap"
                                loc:Uids.Uid="Home_InfoBody" />
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock
                    x:Name="LbVersion"
                    HorizontalAlignment="Right"
                    FontSize="11"
                    Foreground="{ThemeResource AtisTextCaptionBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>

