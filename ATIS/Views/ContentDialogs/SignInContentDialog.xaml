<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog x:Class="ATIS.Views.ContentDialogs.SignInContentDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               Title="SIGN IN"
               CloseButtonClick="ContentDialog_CloseButtonClick"
               CloseButtonText="Cancel"
               PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
               PrimaryButtonText="Sign In"
               mc:Ignorable="d">

    <ContentDialog.Resources>
        <!--  Uncomment this Style if using WinUI 2.2 or later.  -->
        <!--<Style TargetType="contentDialogs:SignInContentDialog" BasedOn="{StaticResource DefaultContentDialogStyle}"/>-->

        <!--
        These flyouts or used for confirmation when the user changes
        the option to save their user name.
        -->
        <Flyout x:Key="DiscardNameFlyout"
                Closed="Flyout_Closed">
            <StackPanel>
                <TextBlock Text="Discard user name?" />
                <Button Click="DiscardButton_Click"
                        Content="Discard" />
            </StackPanel>
        </Flyout>
        <Flyout x:Key="SaveNameFlyout"
                Closed="Flyout_Closed">
            <StackPanel>
                <TextBlock Text="Save user name?" />
                <Button Click="SaveButton_Click"
                        Content="Save" />
            </StackPanel>
        </Flyout>
    </ContentDialog.Resources>

    <StackPanel HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
        <TextBox Name="UserNameTextBox"
                 Header="User name" />
        <PasswordBox Name="PasswordTextBox"
                     Header="Password"
                     IsPasswordRevealButtonEnabled="True" />
        <CheckBox Name="SaveUserNameCheckBox"
                  Content="Save user name" />

        <TextBlock x:Name="ErrorTextBlock"
                   Style="{StaticResource ControlContextualInfoTextBlockStyle}" />

        <!--  Content body  -->
        <TextBlock Name="Body"
                   Style="{StaticResource MessageDialogContentStyle}"
                   TextWrapping="Wrap">
            <TextBlock.Text>
                Lorem ipsum dolor sit amet, consectetur adipisicing elit,
                sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.
            </TextBlock.Text>
        </TextBlock>
    </StackPanel>
</ContentDialog>
