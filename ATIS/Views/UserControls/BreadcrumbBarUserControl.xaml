<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ATIS.Views.UserControls.BreadcrumbBarUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="using:Microsoft.Xaml.Interactivity"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <BreadcrumbBar
        Margin="10"
        ItemsSource="{x:Bind ViewModel.BreadcrumbBarCollection, Mode=OneWay}">
        <BreadcrumbBar.ItemTemplate>
            <DataTemplate
                x:DataType="x:String">
                <TextBlock
                    Style="{ThemeResource TitleTextBlockStyle}"
                    Text="{x:Bind}" />
            </DataTemplate>
        </BreadcrumbBar.ItemTemplate>
        <i:Interaction.Behaviors>
            <i:EventTriggerBehavior
                EventName="ItemClicked">
                <i:EventTriggerBehavior.Actions>
                    <i:InvokeCommandAction
                        Command="{x:Bind ViewModel.ItemClickCommand}" />
                </i:EventTriggerBehavior.Actions>
            </i:EventTriggerBehavior>
        </i:Interaction.Behaviors>
    </BreadcrumbBar>
</UserControl>
