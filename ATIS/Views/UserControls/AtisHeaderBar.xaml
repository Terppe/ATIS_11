<UserControl x:Class="ATIS.Views.UserControls.AtisHeaderBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:userControls="using:ATIS.Views.UserControls"
             x:Name="Root"
             IsTabStop="False">

    <Grid VerticalAlignment="Center"
          ColumnDefinitions="*,Auto,Auto">

        <!--  PageTitle  -->
        <TextBlock Grid.Column="0"
                   VerticalAlignment="Center"
                   FontSize="20"
                   Text="{x:Bind PageTitle, Mode=OneWay}" />

        <!--  Dataset  -->
        <StackPanel Grid.Column="1"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="6">
            <TextBlock Text="{x:Bind DatasetText, Mode=OneWay}" />
            <TextBlock Text="{x:Bind DatasetCount, Mode=OneWay}" />
        </StackPanel>

        <!--  SearchBox  -->
        <AutoSuggestBox x:Name="SearchBox"
                        x:Uid="AutoSuggestBox_Search"
                        Grid.Column="2"
                        Width="260"
                        IsTabStop="True"
                        PlaceholderText="{x:Bind SearchPlaceholder, Mode=OneWay}"
                        QuerySubmitted="SearchBox_QuerySubmitted">
            <AutoSuggestBox.QueryIcon>
                <BitmapIcon ShowAsMonochrome="False"
                            UriSource="/Assets/Fluent/search.png" />
            </AutoSuggestBox.QueryIcon>
        </AutoSuggestBox>

    </Grid>
</UserControl>

