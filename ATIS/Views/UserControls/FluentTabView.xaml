<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="ATIS.Views.UserControls.FluentTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:ATIS.Themes.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid Background="{ThemeResource AppBackgroundBrush}">

        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  =============================  -->
        <!--  TAB STRIP  -->
        <!--  =============================  -->
        <Grid Height="48"
              Background="{ThemeResource AppSurfaceBrush}">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="48" />
            </Grid.ColumnDefinitions>

            <!--  Tabs  -->
            <ItemsRepeater x:Name="TabRepeater"
                           ItemsSource="{x:Bind Tabs, Mode=OneWay}">
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="local:FluentTabItem">

                        <Grid x:Name="TabRoot"
                              Height="40"
                              Margin="4,4,0,4"
                              Background="Transparent"
                              CornerRadius="8">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="32" />
                            </Grid.ColumnDefinitions>

                            <!--  Visual States  -->
                            <VisualStateManager.VisualStateGroups>

                                <VisualStateGroup x:Name="CommonStates">

                                    <VisualState x:Name="Normal" />

                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="TabRoot.Background" Value="{ThemeResource ControlHoverBrush}" />
                                            <Setter Target="CloseButton.Visibility" Value="Visible" />
                                        </VisualState.Setters>
                                    </VisualState>

                                    <VisualState x:Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Target="TabRoot.Background" Value="{ThemeResource ControlPressedBrush}" />
                                            <Setter Target="CloseButton.Visibility" Value="Visible" />
                                        </VisualState.Setters>
                                    </VisualState>

                                </VisualStateGroup>

                            </VisualStateManager.VisualStateGroups>

                            <!--  Header  -->
                            <TextBlock Margin="12,0"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextPrimaryBrush}"
                                       Text="{x:Bind Header}" />

                            <!--  Close Button  -->
                            <Button x:Name="CloseButton"
                                    Grid.Column="1"
                                    Width="24"
                                    Height="24"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Visibility="Collapsed">
                                <FontIcon Glyph="&#xE8BB;" />
                            </Button>

                        </Grid>

                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <!--  Add Button  -->
            <Button x:Name="AddButton"
                    Grid.Column="1"
                    Width="32"
                    Height="32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0">
                <FontIcon Glyph="&#xE710;" />
            </Button>

        </Grid>

        <!--  =============================  -->
        <!--  CONTENT  -->
        <!--  =============================  -->
        <ContentPresenter Grid.Row="1"
                          Content="{x:Bind SelectedContent}" />

    </Grid>

</UserControl>
